import re

from qgis.core import (
    QgsProject,
    QgsGeometry,
    QgsPointXY
)


# ---------------------------------------------------------
# НАСТРОЙКИ
# ---------------------------------------------------------

POINT_LAYER_NAME = "Копия точек"
PIPE_LAYER_NAME = "pipeline_1"

POINT_NAME_FIELD = "Name"
PIPE_NAME_FIELD = "name"


# ---------------------------------------------------------
# ФУНКЦИИ
# ---------------------------------------------------------

def normalize_name(value):
    """
    Приводит название к виду, удобному для сравнения.

    Например:
        'Ухта — Торжок 1' -> 'ухтаторжок1'
        'Ухта-Торжок'     -> 'ухтаторжок'
    """
    if value is None:
        return ""

    value = str(value).strip().lower()
    value = value.replace("ё", "е")

    # Оставляем только буквы и цифры
    value = re.sub(r"[^0-9a-zа-я]+", "", value)

    return value


def get_pipeline_name_from_point(value):
    """
    Убирает километраж в начале названия точки.

    Примеры:
        '741 км Ухта-Торжок'
            -> 'Ухта-Торжок'

        '2224,5 км Бухара-Урал'
            -> 'Бухара-Урал'
    """
    if value is None:
        return ""

    value = str(value).strip()

    value = re.sub(
        r"^\s*\d+(?:[.,]\d+)?\s*км\b[\s\-–—]*",
        "",
        value,
        flags=re.IGNORECASE
    )

    return value.strip()


# ---------------------------------------------------------
# ПОЛУЧАЕМ СЛОИ
# ---------------------------------------------------------

point_layers = QgsProject.instance().mapLayersByName(POINT_LAYER_NAME)
pipe_layers = QgsProject.instance().mapLayersByName(PIPE_LAYER_NAME)

if not point_layers:
    raise Exception(f"Слой '{POINT_LAYER_NAME}' не найден")

if not pipe_layers:
    raise Exception(f"Слой '{PIPE_LAYER_NAME}' не найден")

points = point_layers[0]
pipes = pipe_layers[0]


# ---------------------------------------------------------
# ПРОВЕРКИ
# ---------------------------------------------------------

if points.fields().indexFromName(POINT_NAME_FIELD) == -1:
    raise Exception(
        f"В слое '{POINT_LAYER_NAME}' нет поля '{POINT_NAME_FIELD}'"
    )

if pipes.fields().indexFromName(PIPE_NAME_FIELD) == -1:
    raise Exception(
        f"В слое '{PIPE_LAYER_NAME}' нет поля '{PIPE_NAME_FIELD}'"
    )

selected = points.selectedFeatures()

if not selected:
    raise Exception(
        f"В слое '{POINT_LAYER_NAME}' нет выделенных объектов"
    )


# ---------------------------------------------------------
# ЗАРАНЕЕ ЧИТАЕМ pipeline_1
# ---------------------------------------------------------

pipe_features = []

for pipe in pipes.getFeatures():

    if not pipe.hasGeometry():
        continue

    pipe_name = pipe[PIPE_NAME_FIELD]

    if pipe_name is None:
        continue

    pipe_name_text = str(pipe_name).strip()
    pipe_name_norm = normalize_name(pipe_name_text)

    if not pipe_name_norm:
        continue

    pipe_features.append(
        (
            pipe.id(),
            pipe_name_text,
            pipe_name_norm,
            pipe.geometry()
        )
    )


print("=" * 70)
print(f"pipeline_1: подготовлено объектов: {len(pipe_features)}")
print(f"Выделено точек: {len(selected)}")
print("=" * 70)


# ---------------------------------------------------------
# РЕЖИМ РЕДАКТИРОВАНИЯ
# ---------------------------------------------------------

if not points.isEditable():
    points.startEditing()


moved_count = 0
not_found_count = 0
error_count = 0


# ---------------------------------------------------------
# ОБРАБОТКА ВЫДЕЛЕННЫХ ТОЧЕК
# ---------------------------------------------------------

for point_feature in selected:

    try:
        if not point_feature.hasGeometry():
            print(
                f"\nFID {point_feature.id()}: "
                f"нет геометрии — ПРОПУЩЕНО"
            )
            error_count += 1
            continue

        full_point_name = point_feature[POINT_NAME_FIELD]

        if full_point_name is None:
            print(
                f"\nFID {point_feature.id()}: "
                f"Name = NULL — ПРОПУЩЕНО"
            )
            not_found_count += 1
            continue

        full_point_name = str(full_point_name).strip()

        # Например:
        # 741 км Ухта-Торжок
        # -> Ухта-Торжок

        base_name = get_pipeline_name_from_point(full_point_name)
        base_norm = normalize_name(base_name)

        if not base_norm:
            print(
                f"\n{full_point_name}: "
                f"не удалось определить название газопровода"
            )
            not_found_count += 1
            continue

        point_geom = point_feature.geometry()

        candidates = []

        # -------------------------------------------------
        # ИЩЕМ КАНДИДАТОВ ПО НАЗВАНИЮ
        # -------------------------------------------------

        for (
            pipe_fid,
            pipe_name,
            pipe_norm,
            pipe_geom
        ) in pipe_features:

            # Например:
            #
            # базовое:
            # ухтаторжок
            #
            # подходят:
            # ухтаторжок1
            # ухтаторжок2
            # ухтаторжок2ямал
            # ухтаторжок3

            if (
                pipe_norm == base_norm
                or pipe_norm.startswith(base_norm)
            ):

                distance = point_geom.distance(pipe_geom)

                candidates.append(
                    (
                        distance,
                        pipe_fid,
                        pipe_name,
                        pipe_geom
                    )
                )

        # -------------------------------------------------
        # НИЧЕГО НЕ НАШЛИ
        # -------------------------------------------------

        if not candidates:

            print("\n" + "-" * 70)
            print(f"Точка: {full_point_name}")
            print(f"Определено название: {base_name}")
            print("Результат: НИЧЕГО НЕ НАЙДЕНО")
            print("Точка НЕ перемещена")

            not_found_count += 1
            continue

        # -------------------------------------------------
        # БЕРЁМ БЛИЖАЙШИЙ ИЗ ПОДХОДЯЩИХ
        # -------------------------------------------------

        candidates.sort(key=lambda x: x[0])

        (
            min_distance,
            best_pipe_fid,
            best_pipe_name,
            best_pipe_geom
        ) = candidates[0]

        # Ближайшая геометрическая точка на линии
        snapped_geom = best_pipe_geom.nearestPoint(point_geom)

        if snapped_geom.isEmpty():
            print(
                f"\n{full_point_name}: "
                f"не удалось вычислить ближайшую точку"
            )
            error_count += 1
            continue

        snapped_point = snapped_geom.asPoint()

        new_geometry = QgsGeometry.fromPointXY(
            QgsPointXY(
                snapped_point.x(),
                snapped_point.y()
            )
        )

        success = points.changeGeometry(
            point_feature.id(),
            new_geometry
        )

        if not success:
            print(
                f"\n{full_point_name}: "
                f"QGIS не смог изменить геометрию"
            )
            error_count += 1
            continue

        moved_count += 1

        # -------------------------------------------------
        # ОТЧЁТ
        # -------------------------------------------------

        print("\n" + "-" * 70)
        print(f"Точка:             {full_point_name}")
        print(f"Искомый маршрут:   {base_name}")
        print(f"Кандидатов:        {len(candidates)}")
        print(f"Выбрана линия:     {best_pipe_name}")
        print(f"FID pipeline_1:    {best_pipe_fid}")
        print(f"Смещение:          {min_distance:.1f} м")

        if min_distance > 7000:
            print("ВНИМАНИЕ: смещение больше 7 км")


# ---------------------------------------------------------
# ОБНОВЛЯЕМ КАРТУ
# ---------------------------------------------------------

points.triggerRepaint()


# ---------------------------------------------------------
# ИТОГ
# ---------------------------------------------------------

print("\n")
print("=" * 70)
print("ГОТОВО")
print("=" * 70)
print(f"Перемещено:       {moved_count}")
print(f"Не найдено:       {not_found_count}")
print(f"Ошибок:           {error_count}")
print("")
print("Изменения пока НЕ сохранялись автоматически.")
print(
    "Проверь положение точек на карте. "
    "При необходимости изменения можно отменить."
)
print("=" * 70)
