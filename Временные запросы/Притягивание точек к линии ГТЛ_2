import re

from qgis.core import (
    QgsProject,
    QgsGeometry,
    QgsPointXY
)


# =========================================================
# НАСТРОЙКИ
# =========================================================

POINT_LAYER_NAME = "Копия точек"
PIPE_LAYER_NAME = "pipeline_1"

POINT_NAME_FIELD = "Name"
PIPE_NAME_FIELD = "name"

# Только для предупреждения.
# Точка всё равно будет перенесена.
WARNING_DISTANCE_M = 10000


# =========================================================
# ФУНКЦИИ
# =========================================================

def normalize_name(value):
    """
    Нормализация названий только для сравнения.

    'КС Нюксеница-Архангельск'
    'КС Нюксеница — Архангельск'
    -> 'кснюксеницаархангельск'
    """

    if value is None:
        return ""

    value = str(value).strip().lower()
    value = value.replace("ё", "е")

    # Убираем пробелы, тире, скобки и прочие знаки.
    # Оставляем буквы и цифры.
    value = re.sub(r"[^0-9a-zа-я]+", "", value)

    return value


def parse_point_name(value):
    """
    Из:
        37,5 км КС Нюксеница-Архангельск

    получаем:
        km = 37.5
        route = КС Нюксеница-Архангельск
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.match(
        r"^\s*(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    km_text = match.group(1).replace(",", ".")
    route_name = match.group(2).strip()

    try:
        km_value = float(km_text)
    except ValueError:
        return None, None

    return km_value, route_name


# =========================================================
# СЛОИ
# =========================================================

point_layers = QgsProject.instance().mapLayersByName(
    POINT_LAYER_NAME
)

pipe_layers = QgsProject.instance().mapLayersByName(
    PIPE_LAYER_NAME
)

if not point_layers:
    raise Exception(
        f"Не найден слой '{POINT_LAYER_NAME}'"
    )

if not pipe_layers:
    raise Exception(
        f"Не найден слой '{PIPE_LAYER_NAME}'"
    )

points = point_layers[0]
pipes = pipe_layers[0]


# =========================================================
# ПРОВЕРКИ
# =========================================================

if points.fields().indexFromName(POINT_NAME_FIELD) == -1:
    raise Exception(
        f"Нет поля '{POINT_NAME_FIELD}' "
        f"в слое '{POINT_LAYER_NAME}'"
    )

if pipes.fields().indexFromName(PIPE_NAME_FIELD) == -1:
    raise Exception(
        f"Нет поля '{PIPE_NAME_FIELD}' "
        f"в слое '{PIPE_LAYER_NAME}'"
    )

selected = points.selectedFeatures()

if not selected:
    raise Exception(
        "В слое 'Копия точек' ничего не выделено"
    )


# =========================================================
# ПОДГОТАВЛИВАЕМ pipeline_1
# =========================================================

pipe_features = []

for feature in pipes.getFeatures():

    if not feature.hasGeometry():
        continue

    value = feature[PIPE_NAME_FIELD]

    if value is None:
        continue

    pipe_name = str(value).strip()
    pipe_norm = normalize_name(pipe_name)

    if not pipe_norm:
        continue

    geom = feature.geometry()

    if geom.isEmpty():
        continue

    pipe_features.append(
        (
            feature.id(),
            pipe_name,
            pipe_norm,
            geom
        )
    )


print("=" * 80)
print(f"Выделено точек: {len(selected)}")
print(f"Линий pipeline_1: {len(pipe_features)}")
print("=" * 80)


# =========================================================
# РЕДАКТИРОВАНИЕ
# =========================================================

if not points.isEditable():
    points.startEditing()


moved_count = 0
not_found_count = 0
error_count = 0


# =========================================================
# ОСНОВНОЙ ЦИКЛ
# =========================================================

for point_feature in selected:

    print("\n" + "-" * 80)

    if not point_feature.hasGeometry():
        print(
            f"FID {point_feature.id()}: "
            f"нет геометрии"
        )
        error_count += 1
        continue

    point_name = point_feature[POINT_NAME_FIELD]

    if point_name is None:
        print(
            f"FID {point_feature.id()}: "
            f"Name = NULL"
        )
        error_count += 1
        continue

    point_name = str(point_name).strip()

    # -----------------------------------------------------
    # РАЗБИРАЕМ НАЗВАНИЕ ТОЧКИ
    # -----------------------------------------------------

    km_value, route_name = parse_point_name(point_name)

    if km_value is None:
        print(f"Точка: {point_name}")
        print("Не удалось получить километровую отметку.")
        print("Точка НЕ перемещена.")

        error_count += 1
        continue

    km_meters = km_value * 1000.0

    route_norm = normalize_name(route_name)

    if not route_norm:
        print(f"Точка: {point_name}")
        print("Не удалось получить название маршрута.")
        error_count += 1
        continue

    point_geom = point_feature.geometry()

    candidates = []


    # =====================================================
    # ИЩЕМ ПОДХОДЯЩИЕ МАРШРУТЫ
    # =====================================================

    for (
        pipe_fid,
        pipe_name,
        pipe_norm,
        pipe_geom
    ) in pipe_features:

        # Например:
        #
        # точка:
        #   Ухта-Торжок
        #
        # pipeline_1:
        #   Ухта — Торжок 1
        #   Ухта — Торжок 2
        #   Ухта — Торжок 3

        if not (
            pipe_norm == route_norm
            or pipe_norm.startswith(route_norm)
        ):
            continue


        line_length = pipe_geom.length()

        # -------------------------------------------------
        # Если линия короче указанного километража,
        # на ней физически нет такой отметки.
        # -------------------------------------------------

        if line_length < km_meters:
            continue


        # =================================================
        # ВАРИАНТ 1:
        # километраж от начала геометрии
        # =================================================

        forward_geom = pipe_geom.interpolate(
            km_meters
        )

        if not forward_geom.isEmpty():

            forward_distance = point_geom.distance(
                forward_geom
            )

            candidates.append(
                {
                    "distance": forward_distance,
                    "pipe_fid": pipe_fid,
                    "pipe_name": pipe_name,
                    "position": forward_geom,
                    "direction": "от начала",
                    "line_length": line_length
                }
            )


        # =================================================
        # ВАРИАНТ 2:
        # если линия оцифрована наоборот
        # =================================================

        reverse_position = line_length - km_meters

        if reverse_position >= 0:

            reverse_geom = pipe_geom.interpolate(
                reverse_position
            )

            if not reverse_geom.isEmpty():

                reverse_distance = point_geom.distance(
                    reverse_geom
                )

                candidates.append(
                    {
                        "distance": reverse_distance,
                        "pipe_fid": pipe_fid,
                        "pipe_name": pipe_name,
                        "position": reverse_geom,
                        "direction": "от другого конца",
                        "line_length": line_length
                    }
                )


    # =====================================================
    # НИ ОДНОГО КАНДИДАТА
    # =====================================================

    if not candidates:

        print(f"Точка:       {point_name}")
        print(f"Отметка:     {km_value} км")
        print(f"Маршрут:     {route_name}")
        print("")
        print("Подходящая линия не найдена.")
        print("Точка НЕ перемещена.")

        not_found_count += 1
        continue


    # =====================================================
    # ВЫБИРАЕМ НАИБОЛЕЕ БЛИЗКУЮ РАСЧЁТНУЮ ОТМЕТКУ
    # =====================================================

    candidates.sort(
        key=lambda item: item["distance"]
    )

    best = candidates[0]

    new_point_geom = best["position"]

    new_point = new_point_geom.asPoint()

    new_geometry = QgsGeometry.fromPointXY(
        QgsPointXY(
            new_point.x(),
            new_point.y()
        )
    )


    success = points.changeGeometry(
        point_feature.id(),
        new_geometry
    )

    if not success:
        print(f"Точка: {point_name}")
        print("Не удалось изменить геометрию.")

        error_count += 1
        continue


    moved_count += 1


    # =====================================================
    # ОТЧЁТ
    # =====================================================

    print(f"Точка:             {point_name}")
    print(f"Маршрут:           {route_name}")
    print(f"Отметка:           {km_value} км")
    print(f"Отметка в метрах:  {km_meters:.1f}")
    print("")
    print(f"Выбрана линия:     {best['pipe_name']}")
    print(f"FID pipeline_1:    {best['pipe_fid']}")
    print(f"Длина линии:       {best['line_length'] / 1000:.2f} км")
    print(f"Отсчёт:            {best['direction']}")
    print(
        f"Смещение точки:    "
        f"{best['distance'] / 1000:.3f} км"
    )

    # Показываем ещё несколько вариантов
    if len(candidates) > 1:

        print("")
        print("Ближайшие расчётные варианты:")

        for number, candidate in enumerate(
            candidates[:6],
            start=1
        ):

            print(
                f"  {number}. "
                f"{candidate['pipe_name']} | "
                f"{candidate['direction']} | "
                f"{candidate['distance'] / 1000:.3f} км"
            )


    if best["distance"] > WARNING_DISTANCE_M:

        print("")
        print(
            "!!! ВНИМАНИЕ: большое смещение "
            f"({best['distance'] / 1000:.1f} км)"
        )
        print(
            "Точка перенесена, но её нужно "
            "проверить визуально."
        )


# =========================================================
# ОБНОВЛЕНИЕ
# =========================================================

points.triggerRepaint()


# =========================================================
# ИТОГ
# =========================================================

print("\n" + "=" * 80)
print("ГОТОВО")
print("=" * 80)

print(f"Перемещено:   {moved_count}")
print(f"Не найдено:   {not_found_count}")
print(f"Ошибок:       {error_count}")

print("")
print(
    "Изменения НЕ сохранены автоматически."
)
print(
    "Проверь результат на карте перед сохранением слоя."
)
print("=" * 80)
