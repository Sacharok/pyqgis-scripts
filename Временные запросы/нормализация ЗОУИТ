-- Заполнение bgd_PAO
-- id, project_id, geom, class_code, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, nomer_rees, nomer_poys
do $$
declare
	v_source_table text := 'ZM_ZonySOsobUslovIspolTerrit_A_klass_prav';
	v_target_table text  := 'ZM_ZonySOsobUslovIspolTerrit_A';
	v_db text;
	v_conn_str text;
	v_sql text;
	v_count text;
	remote_sql text;
	dblink_sql text;
begin
	v_conn_str := format('host=tmn-nst-test-db.tm.novatek.int port=5432 dbname=normalize user=admin password=admin123', '');
	v_sql := format('
		insert into %I (id, project_id, geom, class_code, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, nomer_rees, nomer_poys)
		select id, project_id, geom, class_code, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, nomer_rees, nomer_poys
		from dblink(''%s'', 
			''select id, project_id, geom, class_code, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, nomer_rees, nomer_poys
			from ready.%I'')
		as t(id uuid, project_id uuid, geom geometry(MultiPolygon,3857), class_code character varying(10), class_name character varying(100),
			naim text, vid_zon varchar(255), plosh_pokr float8, sub_rf varchar(255), munc_obrzv varchar(255), nomer_rees varchar(255),
			nomer_poys varchar(255))',
		v_target_table,
		v_conn_str,
		v_source_table
	);

	remote_sql := format('select dblink_exec(
		''host=tmn-nst-test-db.tm.novatek.int port=5432 dbname=bgd_PAO user=admin password=admin123'', 
		%L);', v_sql);
			
	raise notice 'SQL for db %: %', v_db, v_sql;
	
	begin 
		execute remote_sql;
		get diagnostics v_count = ROW_COUNT;
		raise notice 'Inserted % rows into %', v_count, v_db;

	exception when others then
		raise warning 'Error inserting into %: %', v_db, sqlerrm;
	end;
end $$;

