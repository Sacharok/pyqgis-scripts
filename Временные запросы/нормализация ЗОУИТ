create table if not exists "ZM_ZonySOsobUslovIspolTerrit_A_klass_prav" (
	id uuid NOT null default uuid_generate_v4(),
	project_id uuid,
	geom public.geometry(multipolygon, 3857) null,
	class_code varchar(10) null,
	class_name varchar(100) null,
	naim text null,
	vid_zon varchar(255) NULL,
	plosh_pokr float8 NULL,
	sub_rf varchar(255) NULL,
	munc_obrzv varchar(255) NULL,
	nomer_rees varchar(255) NULL,
	nomer_poys varchar(255) NULL,
	dzo varchar(5) null,
	CONSTRAINT "ZM_ZonySOsobUslovIspolTerrit_A_klass_prav_pkey" PRIMARY KEY (id)
);

-- id, project_id, geom, class_code, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, nomer_rees, nomer_poys

-- Динамически создаём столбец ДО/ДЗО (на всякий) и заполняем его --

do $$
declare
	codes text[] := ARRAY['AGAZ', 'ASPG2', 'OGHK', 'TSNG', 'YGEO', 'YSPG', 'YUNG'];
	code text;
begin
	foreach code in array codes 
	loop
		execute format('ALTER TABLE public."ZM_ZonySOsobUslovIspolTerrit_A_%s" ADD COLUMN dzo varchar(5) NULL;', code); 
		execute format('UPDATE public."ZM_ZonySOsobUslovIspolTerrit_A_%s" set dzo = %L;', code, code);
		execute format('INSERT INTO public."ZM_ZonySOsobUslovIspolTerrit_A_klass_prav"
			(geom, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, nomer_rees, nomer_poys, dzo)
			select geom, class_name, naim, vid_zon, plosh_pokr, sub_rf, munc_obrzv, trim(nomer_rees) as nomer_rees, nomer_poys, dzo
			from public."ZM_ZonySOsobUslovIspolTerrit_A_%s";', code);
	end loop;
end $$;

