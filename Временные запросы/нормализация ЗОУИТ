update public."ZonesWithSpecialConditionsForUseOfTerritories" ld
set vid_zon = p.id
from dblink('dbname=normalize',
	'select id, vid_zon
	 from public."ZM_ZonySOsobUslovIspolTerrit_A_klass_prav" where vid_zon is not null')
as n(id uuid, vid_zon varchar(255))
join public."TypesOfZonesWithSpecialConditionsUse" p on n.vid_zon = p.naim
where ld.id  = n.id;

