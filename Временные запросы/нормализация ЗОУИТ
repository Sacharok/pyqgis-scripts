-- заполнение справочника с видами зон --
insert into public."TypesOfZonesWithSpecialConditionsUse" (id, naim)
select uuid_generate_v4(), n.vid_zon 
from dblink('dbname=normalize',
	'select distinct vid_zon
	 from public."ZM_ZonySOsobUslovIspolTerrit_A_klass_prav" where vid_zon is not null')
	as n(vid_zon varchar(255))
left join public."TypesOfZonesWithSpecialConditionsUse" t on t.naim = n.vid_zon
