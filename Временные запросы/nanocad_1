from qgis.core import (
    QgsProject,
    QgsWkbTypes
)

# ============================================================
# НАСТРОЙКИ
# ============================================================

ROOT_GROUP_NAME = "DXF — NanoCAD"

# Только те NanoCAD-слои, которые нам нужны
CAD_LAYERS = [
    "3. Заземление",
    "4. Технологические трубопроводы",
    "9. Резервуары",
    "10. Подземные емкости",
    "2. Покрытие песок газон щебень",
    "3. Инженерные сети",
    "5. Здания и сооружения",
    "2. Покрытия асфальт бетон",
    "Радиусы",
]


# ============================================================
# ПРОВЕРКА ИСХОДНЫХ СЛОЁВ
# ============================================================

source_layers = iface.layerTreeView().selectedLayers()

if len(source_layers) != 3:
    raise Exception(
        "Нужно выделить ровно 3 исходных слоя DXF: "
        "точки, линии и полигоны."
    )


point_layer = None
line_layer = None
polygon_layer = None


for layer in source_layers:

    if layer.fields().indexFromName("Layer") == -1:
        raise Exception(
            f'В слое "{layer.name()}" нет поля Layer.'
        )

    geom_type = QgsWkbTypes.geometryType(
        layer.wkbType()
    )

    if geom_type == QgsWkbTypes.PointGeometry:
        point_layer = layer

    elif geom_type == QgsWkbTypes.LineGeometry:
        line_layer = layer

    elif geom_type == QgsWkbTypes.PolygonGeometry:
        polygon_layer = layer


if point_layer is None:
    raise Exception("Не найден исходный точечный DXF-слой.")

if line_layer is None:
    raise Exception("Не найден исходный линейный DXF-слой.")

if polygon_layer is None:
    raise Exception("Не найден исходный полигональный DXF-слой.")


print("Точки:", point_layer.name())
print("Линии:", line_layer.name())
print("Полигоны:", polygon_layer.name())


# ============================================================
# ПРОЕКТ И ГЛАВНАЯ ГРУППА
# ============================================================

project = QgsProject.instance()
root = project.layerTreeRoot()


# Если результат предыдущего запуска уже существует —
# удаляем его полностью
old_group = root.findGroup(ROOT_GROUP_NAME)

if old_group is not None:

    old_layer_ids = [
        node.layerId()
        for node in old_group.findLayers()
    ]

    for layer_id in old_layer_ids:
        project.removeMapLayer(layer_id)

    root.removeChildNode(old_group)


result_group = root.addGroup(ROOT_GROUP_NAME)


# ============================================================
# ФУНКЦИИ
# ============================================================

def escape_sql(value):
    """Экранирование апострофов для subset string."""
    return str(value).replace("'", "''")


def has_features(layer):
    """Есть ли после фильтра хотя бы один объект."""
    request = layer.getFeatures()

    try:
        next(request)
        return True
    except StopIteration:
        return False


def create_filtered_clone(
        source,
        cad_layer,
        display_name,
        text_only=False
    ):

    # КЛЮЧЕВОЙ МОМЕНТ:
    # clone() сохраняет исходный renderer DXF,
    # включая встроенные OGR/CAD-стили.
    clone = source.clone()

    clone.setName(display_name)

    cad_value = escape_sql(cad_layer)

    expression = (
        f"\"Layer\" = '{cad_value}'"
    )

    # Только для точечного слоя.
    # В полигонах Text = SOLID / ANSI37 и т.п.,
    # поэтому их Text трогать нельзя.
    if text_only:

        if clone.fields().indexFromName("Text") == -1:
            return None

        expression += (
            ' AND "Text" IS NOT NULL'
            ' AND "Text" <> \'\''
        )

    ok = clone.setSubsetString(expression)

    if not ok:
        print(
            f"Не удалось применить фильтр: "
            f"{cad_layer} / {display_name}"
        )
        return None

    # Если такой геометрии в CAD-слое нет —
    # пустой слой вообще не создаём
    if not has_features(clone):
        return None

    return clone


def add_clone_to_group(
        source,
        cad_layer,
        display_name,
        group,
        text_only=False
    ):

    clone = create_filtered_clone(
        source,
        cad_layer,
        display_name,
        text_only
    )

    if clone is None:
        return None

    project.addMapLayer(
        clone,
        False
    )

    group.addLayer(clone)

    return clone


# ============================================================
# СОЗДАЁМ СТРУКТУРУ
# ============================================================

created = []


for cad_layer in CAD_LAYERS:

    cad_group = result_group.addGroup(
        cad_layer
    )

    # --------------------------------------------------------
    # ПОДПИСИ
    # --------------------------------------------------------

    text_clone = add_clone_to_group(
        point_layer,
        cad_layer,
        "Подписи",
        cad_group,
        text_only=True
    )

    if text_clone is not None:
        created.append(text_clone)


    # --------------------------------------------------------
    # ЛИНИИ
    # --------------------------------------------------------

    line_clone = add_clone_to_group(
        line_layer,
        cad_layer,
        "Линии",
        cad_group
    )

    if line_clone is not None:
        created.append(line_clone)


    # --------------------------------------------------------
    # ПОЛИГОНЫ / HATCH
    # --------------------------------------------------------

    polygon_clone = add_clone_to_group(
        polygon_layer,
        cad_layer,
        "Полигоны",
        cad_group
    )

    if polygon_clone is not None:
        created.append(polygon_clone)


    # Если в конкретном CAD-слое вообще ничего нет —
    # удаляем пустую группу
    if len(cad_group.children()) == 0:
        result_group.removeChildNode(
            cad_group
        )


# ============================================================
# СКРЫВАЕМ ТРИ ИСХОДНЫХ DXF-СЛОЯ
# ============================================================

for source in source_layers:

    node = root.findLayer(
        source.id()
    )

    if node is not None:
        node.setItemVisibilityChecked(False)


# Раскрываем главную группу
result_group.setExpanded(True)

iface.mapCanvas().refresh()


# ============================================================
# РЕЗУЛЬТАТ
# ============================================================

print("")
print("========================================")
print("ГОТОВО")
print("========================================")
print("Создана группа:", ROOT_GROUP_NAME)
print("Создано слоёв:", len(created))
print("")
print("Стиль не создавался заново.")
print("Все клоны используют оформление исходного DXF.")
print("")
print("Точки:")
print("  показывается только Text <> NULL / пусто")
print("")
print("Линии:")
print("  OGR PEN сохранён")
print("")
print("Полигоны:")
print("  Text (SOLID, ANSI37 и т.д.) сохранён")
print("")
print("Исходные DXF-слои скрыты, но не изменены.")
print("========================================")
