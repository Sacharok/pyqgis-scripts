        raise Exception(
            f'В слое "{cad_layer_name}" '
            f'получилось {len(colors)} цветов. '
            f'Диапазона {base_code}–{base_code + 99} '
            f'не хватит.'
        )


    for i, color in enumerate(colors):

        code = base_code + i

        # Если цвет в тематике только один,
        # не засоряем class_name HEX-кодом.
        if len(colors) == 1:

            class_name = base_name

        elif color == "NO_COLOR":

