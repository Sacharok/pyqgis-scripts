def create_clean_layer(
    source,
    memory_name,
    with_text=False
):
    """
    Создаёт временный слой с той же геометрией и CRS,
    но БЕЗ исходных CAD-полей.
    """

    geom_name = QgsWkbTypes.displayString(
        source.wkbType()
    )

    mem = QgsVectorLayer(
        geom_name,
        memory_name,
        "memory"
    )

    if not mem.isValid():
        raise Exception(
            f"Не удалось создать слой {memory_name}"
        )

    mem.setCrs(
        source.crs()
    )

    provider = mem.dataProvider()

    fields = [
        QgsField(
            "class_code",
            TYPE_INT
        ),
        QgsField(
            "class_name",
            TYPE_STRING,
            len=150
        )
    ]

    if with_text:
        fields.append(
            QgsField(
                "text",
                TYPE_STRING,
                len=500
            )
        )

    provider.addAttributes(
        fields
    )

    mem.updateFields()

    return mem


def fill_clean_layer(
    source,
    cad_layer_name,
    class_code,
    class_name,
    with_text=False
):
    """
    Берёт геометрию из DXF, но переносит
    только нужные атрибуты.
    """

    mem = create_clean_layer(
        source,
        f"tmp_{class_code}",
        with_text
    )

    quoted_layer = QgsExpression.quotedString(
        cad_layer_name
    )

    expression = (
        f'"Layer" = {quoted_layer}'
    )

    # Для точек используем только реальные подписи
    if with_text:
        expression += (
            ' AND "Text" IS NOT NULL'
            ' AND trim("Text") <> \'\''
        )

    request = QgsFeatureRequest()

    request.setFilterExpression(
        expression
    )

    new_features = []

    for source_feature in source.getFeatures(
        request
    ):

        new_feature = QgsFeature(
            mem.fields()
        )

        new_feature.setGeometry(
            source_feature.geometry()
        )

        new_feature[
            "class_code"
        ] = class_code

        new_feature[
            "class_name"
        ] = class_name

        if with_text:

            text_value = source_feature[
                "Text"
            ]

            if text_value is None:
                text_value = ""

            new_feature[
                "text"
            ] = str(
                text_value
            )

        new_features.append(
            new_feature
        )


    if not new_features:
        return None


    mem.dataProvider().addFeatures(
        new_features
    )

    mem.updateExtents()

    return mem


def save_to_gpkg(
    layer,
    gpkg_path,
    table_name,
    overwrite_file=False
):
    """
    Записывает слой в выбранный GeoPackage.
    """

    options = QgsVectorFileWriter.SaveVectorOptions()

    options.driverName = "GPKG"
    options.fileEncoding = "UTF-8"
    options.layerName = table_name

    if overwrite_file:

        options.actionOnExistingFile = (
            QgsVectorFileWriter.CreateOrOverwriteFile
        )

    else:

        options.actionOnExistingFile = (
            QgsVectorFileWriter.CreateOrOverwriteLayer
        )


    result = QgsVectorFileWriter.writeAsVectorFormatV3(
        layer,
        gpkg_path,
        QgsProject.instance().transformContext(),
        options
    )

    error_code = result[0]

    if error_code != QgsVectorFileWriter.NoError:

        message = (
            result[1]
            if len(result) > 1
            else "Неизвестная ошибка"
        )

        raise Exception(
            f"Ошибка записи слоя {table_name}: "
            f"{message}"
        )


