# ============================================================
# СБОР НОРМАЛИЗОВАННЫХ КЛАССОВ
# ============================================================

result = defaultdict(
    lambda: defaultdict(
        lambda: {
            "count": 0,
            "handles": []
        }
    )
)

for f in layer:

    cad_layer = f.GetField("Layer")

    if cad_layer not in TARGET_NAMES:
        continue

    key = normalized_style(f)

    result[cad_layer][key]["count"] += 1

    if len(result[cad_layer][key]["handles"]) < 3:
        handle = f.GetField("EntityHandle")

        if handle:
            result[cad_layer][key]["handles"].append(
                str(handle)
            )


