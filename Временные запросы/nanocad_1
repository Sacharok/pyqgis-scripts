def setup_labels(layer):

    pal = QgsPalLayerSettings()

    pal.enabled = True
    pal.fieldName = "text"

    text_format = QgsTextFormat()
    text_format.setSize(8)

    pal.setFormat(
        text_format
    )

    layer.setLabeling(
        QgsVectorLayerSimpleLabeling(
            pal
        )
    )

    layer.setLabelsEnabled(
        True
    )


    # Саму точку не показываем —
    # показываем только текст.
    symbol = QgsMarkerSymbol.createSimple(
        {
            "size": "0"
        }
    )

    layer.setRenderer(
        QgsSingleSymbolRenderer(
            symbol
        )
    )


