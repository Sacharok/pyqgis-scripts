from qgis.core import (
    QgsProject,
    QgsWkbTypes
)
from osgeo import ogr
from collections import defaultdict
import re


# ============================================================
# НАСТРОЙКИ
# ============================================================

GROUP_NAME = "CHECK — покрытия"

TARGET_LAYERS = {
    "2. Покрытие песок газон щебень",
    "2. Покрытия асфальт бетон",
}


# ============================================================
# ИСХОДНЫЕ QGIS-СЛОИ
# ============================================================

selected = iface.layerTreeView().selectedLayers()

if len(selected) != 3:
    raise Exception(
        "Выдели ровно 3 исходных DXF-слоя: "
        "точки, линии и полигоны."
    )

qgis_by_geom = {}

for lyr in selected:

    geom_type = QgsWkbTypes.geometryType(lyr.wkbType())

    if geom_type == QgsWkbTypes.PointGeometry:
        qgis_by_geom["POINT"] = lyr

    elif geom_type == QgsWkbTypes.LineGeometry:
        qgis_by_geom["LINE"] = lyr

    elif geom_type == QgsWkbTypes.PolygonGeometry:
        qgis_by_geom["POLYGON"] = lyr


if set(qgis_by_geom.keys()) != {"POINT", "LINE", "POLYGON"}:
    raise Exception(
        "Не удалось определить точечный, линейный "
        "и полигональный исходные слои."
    )


# ============================================================
# ПУТЬ К DXF
# ============================================================

any_layer = selected[0]

path = (
    any_layer
    .dataProvider()
    .dataSourceUri()
    .split("|")[0]
)

ds = ogr.Open(path)

if ds is None:
    raise Exception("Не удалось открыть DXF через OGR.")

ogr_layer = ds.GetLayerByName("entities")

if ogr_layer is None:
    ogr_layer = ds.GetLayer(0)


# ============================================================
# ФУНКЦИИ
# ============================================================

def get_param(style, name):

    if not style:
        return None

    m = re.search(
        rf'(?:^|[,(]){re.escape(name)}:(?:"([^"]*)"|([^,\)]+))',
        style
    )

    if not m:
        return None

    return (
        m.group(1)
        if m.group(1) is not None
        else m.group(2)
    )


def geom_group(f):

    subclass = str(f.GetField("SubClasses") or "")
    style = f.GetStyleString() or ""

    if (
        "AcDbText" in subclass
        or "AcDbMText" in subclass
        or style.startswith("LABEL(")
    ):
        return "POINT"

    if "AcDbHatch" in subclass:
        return "POLYGON"

    geom = f.GetGeometryRef()

    if geom is None:
        return None

    name = geom.GetGeometryName().upper()

    if "POLYGON" in name:
        return "POLYGON"

    if "LINE" in name or "CURVE" in name:
        return "LINE"

    if name == "GEOMETRYCOLLECTION":
        return "LINE"

    if name == "POINT":
        return "POINT"

    return None


def style_key(f):

    geom = geom_group(f)
    style = f.GetStyleString() or ""

    color = (
        get_param(style, "fc")
        or get_param(style, "c")
        or "-"
    ).lower()

    if geom == "POLYGON":

        hatch = str(
            f.GetField("Text") or "SOLID"
        ).strip().upper()

        return (
            geom,
            hatch,
            color
        )

    if geom == "LINE":

        lt = str(
            f.GetField("Linetype") or "Continuous"
        ).strip()

        return (
            geom,
            lt,
            color
        )

    if geom == "POINT":

        text = str(
            f.GetField("Text") or ""
        ).strip()

        return (
            geom,
            color
        )

    return None


def nice_name(key):

    geom = key[0]

    if geom == "POLYGON":
        _, hatch, color = key
        return f"POLYGON — {hatch} — {color}"

    if geom == "LINE":
        _, linetype, color = key
        return f"LINE — {linetype} — {color}"

    if geom == "POINT":
        _, color = key
        return f"POINT — {color}"

    return str(key)


def sql_escape(value):
    return str(value).replace("'", "''")


# ============================================================
# СОБИРАЕМ ENTITYHANDLE ПО СТИЛЯМ
# ============================================================

groups = defaultdict(
    lambda: defaultdict(list)
)

for f in ogr_layer:

    cad_layer = f.GetField("Layer")

    if cad_layer not in TARGET_LAYERS:
        continue

    key = style_key(f)

    if key is None:
        continue

    handle = f.GetField("EntityHandle")

    if handle is None:
        continue

    groups[cad_layer][key].append(
        str(handle)
    )


# ============================================================
# ГРУППА В ПРОЕКТЕ
# ============================================================

project = QgsProject.instance()
root = project.layerTreeRoot()

old_group = root.findGroup(GROUP_NAME)

if old_group:

    ids = [
        n.layerId()
        for n in old_group.findLayers()
    ]

    for layer_id in ids:
        project.removeMapLayer(layer_id)

    root.removeChildNode(old_group)


main_group = root.addGroup(GROUP_NAME)


# ============================================================
# СОЗДАЁМ ФИЛЬТРОВАННЫЕ КЛОНЫ
# ============================================================

for cad_layer in [
    "2. Покрытие песок газон щебень",
    "2. Покрытия асфальт бетон",
]:

    cad_group = main_group.addGroup(cad_layer)

    print("\n" + "=" * 70)
    print(cad_layer)
    print("=" * 70)

    items = groups.get(cad_layer, {})

    for key, handles in sorted(
        items.items(),
        key=lambda x: str(x[0])
    ):

        geom = key[0]

        src = qgis_by_geom.get(geom)

        if src is None:
            continue

        clone = src.clone()

        display_name = (
            f"{nice_name(key)} "
            f"[{len(handles)}]"
        )

        clone.setName(display_name)

        handles_sql = ", ".join(
            f"'{sql_escape(h)}'"
            for h in handles
        )

        expression = (
            f"\"EntityHandle\" IN "
            f"({handles_sql})"
        )

        if not clone.setSubsetString(expression):
            print(
                "НЕ УДАЛОСЬ:",
                display_name
            )
            continue

        project.addMapLayer(
            clone,
            False
        )

        cad_group.addLayer(clone)

        # По умолчанию выключаем,
        # чтобы включать по одному
        node = cad_group.findLayer(
            clone.id()
        )

        if node:
            node.setItemVisibilityChecked(False)

        print(
            display_name,
            "| объектов:",
            len(handles)
        )


main_group.setExpanded(True)

print("\n====================================")
print("ГОТОВО")
print("Группа:", GROUP_NAME)
print("Все диагностические слои выключены.")
print("Включай их по одному и сравнивай с NanoCAD.")
print("====================================")
