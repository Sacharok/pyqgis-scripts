def norm_handle(value):

    if value is None:
        return ""

    return str(value).strip()


def norm_color(value):

    if not value:
        return "NO_COLOR"

    value = value.strip().upper()

    if not value.startswith("#"):
        value = "#" + value

    return value


def color_from_ogr_style(style):

    if not style:
        return "NO_COLOR"

    # Для полигонов сначала цвет заливки BRUSH(fc:...)
    m = re.search(
        r'(?:^|[,(])fc:(#[0-9A-Fa-f]{6})',
        style
    )

    if m:
        return norm_color(
            m.group(1)
        )

    # Для линий, текста и остальных
    m = re.search(
        r'(?:^|[,(])c:(#[0-9A-Fa-f]{6})',
        style
    )

    if m:
        return norm_color(
            m.group(1)
        )

    return "NO_COLOR"


def quoted(value):
    return QgsExpression.quotedString(value)


# ============================================================
# СОЗДАЁМ:
#
# (Layer, EntityHandle) -> COLOR
#
# Никакие эти технические сведения
# в итоговый GPKG не попадут.
# ============================================================

feature_colors = {}


ogr_layer.ResetReading()

for f in ogr_layer:

    cad_layer = f.GetField("Layer")

    if cad_layer is None:
        continue

    handle = norm_handle(
        f.GetField("EntityHandle")
    )

    if not handle:
        continue

    color = color_from_ogr_style(
        f.GetStyleString() or ""
    )

    feature_colors[
        (
            str(cad_layer),
            handle
        )
    ] = color


# ============================================================
# ПОЛУЧЕНИЕ ЦВЕТА QGIS-ОБЪЕКТА
# ============================================================

def feature_color(feature, cad_layer_name):

    handle = norm_handle(
        feature["EntityHandle"]
    )

    return feature_colors.get(
        (
            cad_layer_name,
            handle
        ),
        "NO_COLOR"
    )


