def set_write_action(
    options,
    overwrite_file
):

    try:

        if overwrite_file:

            options.actionOnExistingFile = (
                QgsVectorFileWriter.CreateOrOverwriteFile
            )

        else:

            options.actionOnExistingFile = (
                QgsVectorFileWriter.CreateOrOverwriteLayer
            )

    except AttributeError:

        if overwrite_file:

            options.actionOnExistingFile = (
                QgsVectorFileWriter
                .ActionOnExistingFile
                .CreateOrOverwriteFile
            )

        else:

            options.actionOnExistingFile = (
                QgsVectorFileWriter
                .ActionOnExistingFile
                .CreateOrOverwriteLayer
            )


def save_layer(
    layer,
    table_name,
    first_write
):

    options = (
        QgsVectorFileWriter.SaveVectorOptions()
    )

    options.driverName = "GPKG"
    options.fileEncoding = "UTF-8"
    options.layerName = table_name

    set_write_action(
        options,
        first_write
    )


    result = (
        QgsVectorFileWriter
        .writeAsVectorFormatV3(
            layer,
            gpkg_path,
            QgsProject.instance()
            .transformContext(),
            options
        )
    )


    error_code = result[0]

    if error_code != QgsVectorFileWriter.NoError:

        message = (
            result[1]
            if len(result) > 1
            else "Неизвестная ошибка"
        )

        raise Exception(
            f"Ошибка записи {table_name}: "
            f"{message}"
        )


# ============================================================
# ВИЗУАЛИЗАЦИЯ ПО class_code
#
# Это НЕ добавляет поля.
# Просто после загрузки в QGIS
# разные классы снова видны разными цветами.
# ============================================================

def apply_color_renderer(
    layer,
    cad_layer_name
):

    if layer.geometryType() == (
        QgsWkbTypes.PointGeometry
    ):
        return


    categories = []


    counts = theme_color_counts[
        cad_layer_name
    ]


    for color in sorted(
        counts.keys(),
        key=lambda x: (
            x == "NO_COLOR",
            x
        )
    ):

        code, class_name = class_map[
            (
                cad_layer_name,
                color
            )
        ]


        symbol = QgsSymbol.defaultSymbol(
            layer.geometryType()
        )


        if color == "NO_COLOR":
            qcolor = QColor("#808080")

        else:
            qcolor = QColor(color)


        symbol.setColor(
            qcolor
        )


        category = QgsRendererCategory(
            code,
            symbol,
            class_name
        )

        categories.append(
            category
        )


    renderer = QgsCategorizedSymbolRenderer(
        "class_code",
        categories
    )

    layer.setRenderer(
        renderer
    )

    layer.triggerRepaint()


# ============================================================
