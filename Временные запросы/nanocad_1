def get_param(style, name):
    """
    Получение параметра из OGR STYLE:
    c:#00ffff
    w:0.05g
    f:"Arial"
    s:1.8g
    """
    if not style:
        return None

    m = re.search(
        rf'(?:^|[,(]){re.escape(name)}:(?:"([^"]*)"|([^,\)]+))',
        style
    )

    if not m:
        return None

    return m.group(1) if m.group(1) is not None else m.group(2)


def normalize_linetype(linetype, style):
    """
    Схлопываем технические варианты CAD-типа линии.
    """

    lt = str(linetype or "").strip().upper()

    if "CENTER" in lt:
        return "CENTER"

    if "FENCELINE" in lt:
        return "FENCELINE"

    if "ACAD_ISO" in lt:
        return "ACAD_ISO"

    if "ОГРАЖД" in lt:
        return "ОГРАЖДЕНИЕ"

    if "DASH" in lt:
        return "DASHED"

    if "DOT" in lt:
        return "DOTTED"

    # Если в PEN есть pattern, но Linetype ничего полезного
    # не сказал — оставляем общий PATTERN.
    if style and 'p:"' in style:
        return "PATTERN"

    return "CONTINUOUS"


def geometry_group(feature):
    """
    Нормализованный тип геометрии:
    LINE / POLYGON / TEXT
    """

    subclass = str(feature.GetField("SubClasses") or "")
    style = feature.GetStyleString() or ""

    if (
        "AcDbText" in subclass
        or "AcDbMText" in subclass
        or style.startswith("LABEL(")
    ):
        return "TEXT"

    if "AcDbHatch" in subclass:
        return "POLYGON"

    geom = feature.GetGeometryRef()

    if geom is None:
        return "OTHER"

    name = geom.GetGeometryName().upper()

    if "POLYGON" in name:
        return "POLYGON"

    if (
        "LINE" in name
        or "CURVE" in name
        or name == "GEOMETRYCOLLECTION"
    ):
        return "LINE"

    if name == "POINT":
        return "POINT"

    return name


def normalized_style(feature):
    """
    Возвращает нормализованный ключ стиля.
    Технические различия DXF здесь уже схлопываются.
    """

    group = geometry_group(feature)

    style = feature.GetStyleString() or ""
    linetype = feature.GetField("Linetype")
    text = feature.GetField("Text")

    # --------------------------------------------------------
    # ЛИНИИ
    # --------------------------------------------------------

    if group == "LINE":

        color = get_param(style, "c") or "-"
        width = get_param(style, "w") or "-"

        family = normalize_linetype(
            linetype,
            style
        )

        # ВАЖНО:
        # конкретную длину штрихов p:...
        # намеренно НЕ включаем.
        # Center 2 / Center 5 и разные масштабы
        # превращаются в один стиль.

        return (
            "LINE",
            color.lower(),
            width,
            family
        )


    # --------------------------------------------------------
    # ТЕКСТ
    # --------------------------------------------------------

    if group == "TEXT":

        color = get_param(style, "c") or "-"
        font = get_param(style, "f") or "-"
        size = get_param(style, "s") or "-"
        width_factor = get_param(style, "w") or "-"

        # НЕ включаем:
        # t = сам текст
        # a = угол поворота
        # p = положение привязки
        #
        # Они не создают новый class_code.

        return (
            "TEXT",
            color.lower(),
            font,
            size,
            width_factor
        )


    # --------------------------------------------------------
    # HATCH / POLYGON
    # --------------------------------------------------------

    if group == "POLYGON":

        hatch = str(text or "SOLID").strip().upper()

        fill_color = (
            get_param(style, "fc")
            or get_param(style, "c")
            or "-"
        )

        # Масштаб s намеренно не включаем:
        # AR-CONC scale 0.1 и 0.4
        # → один нормализованный класс.

        return (
            "POLYGON",
            hatch,
            fill_color.lower()
        )


    # --------------------------------------------------------
    # ПРОЧЕЕ
    # --------------------------------------------------------

    color = get_param(style, "c") or "-"

    return (
        group,
        color.lower()
    )


def style_description(key):
    """
    Человекочитаемое описание нормализованного стиля.
    """

    geom = key[0]

    if geom == "LINE":

        _, color, width, family = key

        return (
            f"линия | цвет {color} | "
            f"тип {family} | толщина {width}"
        )

    if geom == "TEXT":

        _, color, font, size, width_factor = key

        return (
            f"подпись | цвет {color} | "
            f"шрифт {font} | размер {size} | "
            f"ширина {width_factor}"
        )

    if geom == "POLYGON":

        _, hatch, color = key

        return (
            f"полигон | HATCH {hatch} | "
            f"цвет {color}"
        )

    return " | ".join(str(v) for v in key)


