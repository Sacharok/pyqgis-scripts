def create_memory_layer(
    source,
    name,
    with_text=False
):

    geom_name = QgsWkbTypes.displayString(
        source.wkbType()
    )

    layer = QgsVectorLayer(
        geom_name,
        name,
        "memory"
    )

    if not layer.isValid():
        raise Exception(
            f"Не удалось создать {name}"
        )

    layer.setCrs(
        source.crs()
    )

    fields = [
        QgsField(
            "class_code",
            TYPE_INT
        ),
        QgsField(
            "class_name",
            TYPE_STRING,
            len=200
        )
    ]

    if with_text:
        fields.append(
            QgsField(
                "text",
                TYPE_STRING,
                len=500
            )
        )


    layer.dataProvider().addAttributes(
        fields
    )

    layer.updateFields()

    return layer


# ============================================================
# ЗАПОЛНЯЕМ ЧИСТЫЙ СЛОЙ
# ============================================================

def build_output_layer(
    source,
    cad_layer_name,
    memory_name,
    with_text=False
):

    result = create_memory_layer(
        source,
        memory_name,
        with_text
    )


    expression = (
        f'"Layer" = {quoted(cad_layer_name)}'
    )

    request = QgsFeatureRequest()
    request.setFilterExpression(
        expression
    )


    output_features = []


    for src_feature in source.getFeatures(
        request
    ):

        # Для точек оставляем только подписи
        if with_text:

            value = src_feature["Text"]

            if value is None:
                continue

            text_value = str(value).strip()

            if not text_value:
                continue


        color = feature_color(
            src_feature,
            cad_layer_name
        )


        key = (
            cad_layer_name,
            color
        )


        if key not in class_map:
            continue


        code, class_name = class_map[
            key
        ]


        new_feature = QgsFeature(
            result.fields()
        )

        new_feature.setGeometry(
            src_feature.geometry()
        )

        new_feature[
            "class_code"
        ] = code

        new_feature[
            "class_name"
        ] = class_name


        if with_text:

            new_feature[
                "text"
            ] = text_value


        output_features.append(
            new_feature
        )


    if not output_features:
        return None


    result.dataProvider().addFeatures(
        output_features
    )

    result.updateExtents()

    return result


