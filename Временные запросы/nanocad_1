from qgis.core import (
    QgsProject,
    QgsWkbTypes,
    QgsFields,
    QgsField,
    QgsFeature,
    QgsMemoryProviderUtils,
    QgsVectorFileWriter,
    QgsCoordinateTransformContext
)
from qgis.PyQt.QtCore import QVariant
from qgis.PyQt.QtWidgets import QFileDialog

import os


# ============================================================
# КЛАССИФИКАТОР
# ============================================================

CLASS_MAP = {
    "3. Заземление":
        (1000, "Заземление"),

    "4. Технологические трубопроводы":
        (1100, "Технологические трубопроводы"),

    "9. Резервуары":
        (1200, "Резервуары"),

    "10. Подземные емкости":
        (1300, "Подземные емкости"),

    "2. Покрытие песок газон щебень":
        (1400, "Покрытие песок, газон, щебень"),

    "3. Инженерные сети":
        (1500, "Инженерные сети"),

    "5. Здания и сооружения":
        (1600, "Здания и сооружения"),

    "2. Покрытия асфальт бетон":
        (1700, "Покрытия асфальт, бетон"),

    "Радиусы":
        (1800, "Радиусы"),
}


# ============================================================
# НОРМАЛИЗАЦИЯ НАЗВАНИЙ CAD-СЛОЁВ
# ============================================================

def norm(value):

    if value is None:
        return ""

    return " ".join(
        str(value).strip().split()
    ).casefold()


CLASS_MAP_NORM = {
    norm(k): v
    for k, v in CLASS_MAP.items()
}


# ============================================================
# ВЫБРАННЫЕ ИСХОДНЫЕ СЛОИ
# ============================================================

selected = iface.layerTreeView().selectedLayers()

if len(selected) != 3:
    raise Exception(
        "Нужно выделить ровно 3 исходных DXF-слоя: "
        "точки, линии и полигоны."
    )


point_src = None
line_src = None
polygon_src = None


for layer in selected:

    if layer.fields().indexFromName("Layer") == -1:
        raise Exception(
            f'В слое "{layer.name()}" нет поля Layer. '
            f'Выбран не исходный DXF-слой.'
        )

    geom_type = QgsWkbTypes.geometryType(
        layer.wkbType()
    )

    if geom_type == QgsWkbTypes.PointGeometry:
        point_src = layer

    elif geom_type == QgsWkbTypes.LineGeometry:
        line_src = layer

    elif geom_type == QgsWkbTypes.PolygonGeometry:
        polygon_src = layer


if point_src is None:
    raise Exception(
        "Не найден исходный точечный слой."
    )

if line_src is None:
    raise Exception(
        "Не найден исходный линейный слой."
    )

if polygon_src is None:
    raise Exception(
        "Не найден исходный полигональный слой."
    )


# ============================================================
# ВЫБОР ФАЙЛА
# ============================================================

output_path, _ = QFileDialog.getSaveFileName(
    iface.mainWindow(),
    "Сохранить данные для геопортала",
    "",
    "GeoPackage (*.gpkg)"
)

if not output_path:
    raise Exception(
        "Сохранение отменено."
    )

if not output_path.lower().endswith(".gpkg"):
    output_path += ".gpkg"


# ============================================================
# ПОЛЯ
# ============================================================

common_fields = QgsFields()

common_fields.append(
    QgsField(
        "class_code",
        QVariant.Int
    )
)

common_fields.append(
    QgsField(
        "class_name",
        QVariant.String,
        len=150
    )
)


text_fields = QgsFields()

text_fields.append(
    QgsField(
        "class_code",
        QVariant.Int
    )
)

text_fields.append(
    QgsField(
        "class_name",
        QVariant.String,
        len=150
    )
)

text_fields.append(
    QgsField(
        "text",
        QVariant.String,
        len=500
    )
)


# ============================================================
# СОЗДАЁМ ЧИСТЫЕ ВРЕМЕННЫЕ СЛОИ
# ============================================================

line_out = QgsMemoryProviderUtils.createMemoryLayer(
    "objects_line",
    common_fields,
    line_src.wkbType(),
    line_src.crs()
)

polygon_out = QgsMemoryProviderUtils.createMemoryLayer(
    "objects_polygon",
    common_fields,
    polygon_src.wkbType(),
    polygon_src.crs()
)

text_out = QgsMemoryProviderUtils.createMemoryLayer(
    "objects_text",
    text_fields,
    point_src.wkbType(),
    point_src.crs()
)


# ============================================================
# СТАТИСТИКА
# ============================================================

stats = {}

for code, name in CLASS_MAP.values():

    stats[code] = {
        "name": name,
        "line": 0,
        "polygon": 0,
        "text": 0
    }


# ============================================================
# ПЕРЕНОС ЛИНИЙ
# ============================================================

line_features = []

for src_feature in line_src.getFeatures():

    cad_layer = norm(
        src_feature["Layer"]
    )

    cls = CLASS_MAP_NORM.get(
        cad_layer
    )

    if cls is None:
        continue

    class_code, class_name = cls

    new_feature = QgsFeature(
        line_out.fields()
    )

    new_feature.setGeometry(
        src_feature.geometry()
    )

    new_feature.setAttributes([
        class_code,
        class_name
    ])

    line_features.append(
        new_feature
    )

    stats[class_code]["line"] += 1


line_out.dataProvider().addFeatures(
    line_features
)

line_out.updateExtents()


# ============================================================
# ПЕРЕНОС ПОЛИГОНОВ
# ============================================================

polygon_features = []

for src_feature in polygon_src.getFeatures():

    cad_layer = norm(
        src_feature["Layer"]
    )

    cls = CLASS_MAP_NORM.get(
        cad_layer
    )

    if cls is None:
        continue

    class_code, class_name = cls

    new_feature = QgsFeature(
        polygon_out.fields()
    )

    new_feature.setGeometry(
        src_feature.geometry()
    )

    new_feature.setAttributes([
        class_code,
        class_name
    ])

    polygon_features.append(
        new_feature
    )

    stats[class_code]["polygon"] += 1


polygon_out.dataProvider().addFeatures(
    polygon_features
)

polygon_out.updateExtents()


# ============================================================
# ПЕРЕНОС ТЕКСТА
# ============================================================

if point_src.fields().indexFromName("Text") == -1:

    raise Exception(
        "В точечном исходном слое нет поля Text."
    )


text_features = []

for src_feature in point_src.getFeatures():

    cad_layer = norm(
        src_feature["Layer"]
    )

    cls = CLASS_MAP_NORM.get(
        cad_layer
    )

    if cls is None:
        continue

    text_value = src_feature["Text"]

    # Не переносим пустые точки
    if text_value is None:
        continue

    text_value = str(
        text_value
    ).strip()

    if not text_value:
        continue

    class_code, class_name = cls

    new_feature = QgsFeature(
        text_out.fields()
    )

    new_feature.setGeometry(
        src_feature.geometry()
    )

    new_feature.setAttributes([
        class_code,
        class_name,
        text_value
    ])

    text_features.append(
        new_feature
    )

    stats[class_code]["text"] += 1


text_out.dataProvider().addFeatures(
    text_features
)

text_out.updateExtents()


# ============================================================
# СОХРАНЕНИЕ В GEOPACKAGE
# ============================================================

transform_context = QgsProject.instance().transformContext()


def save_layer(
    layer,
    layer_name,
    first=False
):

    options = QgsVectorFileWriter.SaveVectorOptions()

    options.driverName = "GPKG"
    options.layerName = layer_name

    if first:

        options.actionOnExistingFile = (
            QgsVectorFileWriter.CreateOrOverwriteFile
        )

    else:

        options.actionOnExistingFile = (
            QgsVectorFileWriter.CreateOrOverwriteLayer
        )


    result = QgsVectorFileWriter.writeAsVectorFormatV3(
        layer,
        output_path,
        transform_context,
        options
    )

    error_code = result[0]

    if error_code != QgsVectorFileWriter.NoError:

        raise Exception(
            f"Ошибка записи слоя {layer_name}: "
            f"{result}"
        )


save_layer(
    line_out,
    "objects_line",
    first=True
)

save_layer(
    polygon_out,
    "objects_polygon"
)

save_layer(
    text_out,
    "objects_text"
)


# ============================================================
# ДОБАВЛЯЕМ РЕЗУЛЬТАТ В QGIS
# ============================================================

from qgis.core import QgsVectorLayer


result_group_name = "ГОТОВО — для геопортала"

root = QgsProject.instance().layerTreeRoot()

old = root.findGroup(
    result_group_name
)

if old is not None:

    old_ids = [
        n.layerId()
        for n in old.findLayers()
    ]

    for layer_id in old_ids:
        QgsProject.instance().removeMapLayer(
            layer_id
        )

    root.removeChildNode(
        old
    )


result_group = root.addGroup(
    result_group_name
)


for layer_name in [
    "objects_polygon",
    "objects_line",
    "objects_text"
]:

    uri = (
        f"{output_path}"
        f"|layername={layer_name}"
    )

    layer = QgsVectorLayer(
        uri,
        layer_name,
        "ogr"
    )

    if not layer.isValid():

        print(
            "Не удалось добавить:",
            layer_name
        )

        continue

    QgsProject.instance().addMapLayer(
        layer,
        False
    )

    result_group.addLayer(
        layer
    )


# ============================================================
# СКРЫВАЕМ ИСХОДНИКИ
# ============================================================

for layer in selected:

    node = root.findLayer(
        layer.id()
    )

    if node is not None:

        node.setItemVisibilityChecked(
            False
        )


result_group.setExpanded(True)

iface.mapCanvas().refresh()


# ============================================================
# ИТОГ
# ============================================================

print("")
print("=" * 80)
print("ГОТОВО")
print("=" * 80)

print(
    "GeoPackage:",
    output_path
)

print("")
print(
    "objects_line:",
    len(line_features)
)

print(
    "objects_polygon:",
    len(polygon_features)
)

print(
    "objects_text:",
    len(text_features)
)

print("")
print("По классам:")

for code in sorted(stats):

    x = stats[code]

    total = (
        x["line"]
        + x["polygon"]
        + x["text"]
    )

    print(
        code,
        "—",
        x["name"],
        "| линии:",
        x["line"],
        "| полигоны:",
        x["polygon"],
        "| текст:",
        x["text"],
        "| всего:",
        total
    )

print("")
print("Поля:")
print(
    "objects_line    -> class_code, class_name"
)
print(
    "objects_polygon -> class_code, class_name"
)
print(
    "objects_text    -> class_code, class_name, text"
)

print("=" * 80)
