def choose_local_feature(
    point_xy,
    route_norm
):

    point_geom = QgsGeometry.fromPointXY(
        point_xy
    )

    candidates = []


    for item in pipe_features:

        nearest_geom = (
            item["geom"]
            .nearestPoint(point_geom)
        )

        if nearest_geom.isEmpty():
            continue

        nearest_xy = QgsPointXY(
            nearest_geom.asPoint()
        )

        distance_m = real_distance(
            point_xy,
            nearest_xy
        )

        # Первый фильтр — близость
        if distance_m > SEARCH_RADIUS_M:
            continue

        priority = name_priority(
            route_norm,
            item["norm"]
        )

        candidates.append(
            {
                "fid": item["fid"],
                "name": item["name"],
                "distance": distance_m,
                "priority": priority
            }
        )


    if not candidates:
        return None


    candidates.sort(
        key=lambda x: x["distance"]
    )


    # Второй этап — имя
    matches = [
        item
        for item in candidates
        if item["priority"] is not None
    ]


    if matches:

        best_priority = min(
            item["priority"]
            for item in matches
        )

        matches = [
            item
            for item in matches
            if item["priority"]
            == best_priority
        ]

        matches.sort(
            key=lambda x:
            x["distance"]
        )

        chosen = dict(
            matches[0]
        )

        chosen["reason"] = "MATCH"

    else:

        chosen = dict(
            candidates[0]
        )

        chosen["reason"] = "NEAREST"


    return chosen


