# ПРОЕКЦИЯ ТОЧКИ НА РЕБРО
# ============================================================

def project_point_to_edge(
    point,
    edge
):

    coords = edge["coords"]

    accumulated = 0.0

    best = None
    best_map_dist_sq = None


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]

        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()

        map_len_sq = (
            dx * dx
            + dy * dy
        )

        if map_len_sq == 0:
            continue


        vx = point.x() - p1.x()
        vy = point.y() - p1.y()


        t = (
            vx * dx
            + vy * dy
        ) / map_len_sq


        t = max(
            0.0,
            min(
                1.0,
                t
            )
        )


        px = (
            p1.x()
            + t * dx
        )

        py = (
            p1.y()
            + t * dy
        )


        ddx = point.x() - px
        ddy = point.y() - py

        map_dist_sq = (
            ddx * ddx
            + ddy * ddy
        )


        seg_real = real_distance(
            p1,
            p2
        )


        if (
            best_map_dist_sq is None
            or
            map_dist_sq
            < best_map_dist_sq
        ):

            projection = QgsPointXY(
                px,
                py
            )

            best = {
                "point": projection,
                "chainage": (
                    accumulated
                    + seg_real * t
                ),
                "distance": real_distance(
                    point,
                    projection
                )
            }

            best_map_dist_sq = (
                map_dist_sq
            )


        accumulated += seg_real


    return best


# ============================================================
# БЛИЖАЙШИЕ РЁБРА К ТОЧКЕ
# ============================================================

projection_cache = {}


def nearest_edges_for_point(
    point_id,
    point,
    count
):

    key = (
        point_id,
        count
    )

    if key in projection_cache:

        return projection_cache[
            key
        ]


    result = []


    for edge_id, edge in enumerate(
        edges
    ):

        projection = (
            project_point_to_edge(
                point,
                edge
            )
        )

        if projection is None:
            continue

        if (
            projection["distance"]
            >
            MAX_POINT_TO_LINE_DISTANCE_M
        ):
            continue


        result.append(
            {
                "edge_id": edge_id,
                "projection": projection
            }
        )


    result.sort(
        key=lambda x:
        x["projection"]["distance"]
    )


    result = result[:count]

    projection_cache[
        key
    ] = result

    return result


