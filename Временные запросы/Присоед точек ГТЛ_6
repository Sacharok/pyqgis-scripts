# ============================================================
# DIJKSTRA
# ============================================================

dijkstra_cache = {}


def dijkstra(start_node):

    if start_node in dijkstra_cache:

        return dijkstra_cache[
            start_node
        ]


    distances = {
        start_node: 0.0
    }

    previous = {}

    heap = [
        (0.0, start_node)
    ]


    while heap:

        dist, node = heapq.heappop(
            heap
        )

        if dist != distances.get(node):
            continue


        for edge_id in adjacency.get(
            node,
            []
        ):

            edge = edges[
                edge_id
            ]

            if edge["n1"] == node:

                other = edge["n2"]

            else:

                other = edge["n1"]


            new_dist = (
                dist
                + edge["length"]
            )


            if (
                other not in distances
                or
                new_dist
                < distances[other]
            ):

                distances[
                    other
                ] = new_dist

                previous[
                    other
                ] = (
                    node,
                    edge_id
                )

                heapq.heappush(
                    heap,
                    (
                        new_dist,
                        other
                    )
                )


    dijkstra_cache[
        start_node
    ] = (
        distances,
        previous
    )

    return (
        distances,
        previous
    )


# ============================================================
# ВОССТАНОВЛЕНИЕ ПУТИ МЕЖДУ УЗЛАМИ
# ============================================================

def reconstruct_path(
    start_node,
    end_node,
    previous
):

    if start_node == end_node:

        return (
            [start_node],
            []
        )


    node_seq_rev = [
        end_node
    ]

    edge_seq_rev = []

    current = end_node


    while current != start_node:

        if current not in previous:
            return None

        prev_node, edge_id = previous[
            current
        ]

        edge_seq_rev.append(
            edge_id
        )

        current = prev_node

        node_seq_rev.append(
            current
        )


    return (
        list(
            reversed(node_seq_rev)
        ),
        list(
            reversed(edge_seq_rev)
        )
    )


# ============================================================
# КООРДИНАТЫ РЕБРА ПО НАПРАВЛЕНИЮ УЗЛОВ
# ============================================================

def oriented_edge_coords(
    edge,
    from_node,
    to_node
):

    if (
        edge["n1"] == from_node
        and
        edge["n2"] == to_node
    ):

        return list(
            edge["coords"]
        )

    return list(
        reversed(
            edge["coords"]
        )
    )


# ============================================================
# ПРОЕКЦИЯ -> КОНЕЦ РЕБРА
# ============================================================

def projection_to_node_coords(
    edge,
    projection,
    node
):

    coords = edge["coords"]

    i = projection[
        "seg_index"
    ]

    pp = projection[
        "point"
    ]


    if node == edge["n1"]:

        result = [
            pp
        ]

        result.extend(
            reversed(
                coords[:i + 1]
            )
        )

        return result


    result = [
        pp
    ]

    result.extend(
        coords[
            i + 1:
        ]
    )

    return result


def node_to_projection_coords(
    edge,
    projection,
    node
):

    result = projection_to_node_coords(
        edge,
        projection,
        node
    )

    result.reverse()

    return result


# ============================================================
# СОЕДИНЕНИЕ МАССИВОВ КООРДИНАТ
# ============================================================

def append_coords(
    result,
    addition
):

    if not addition:
        return

    if not result:

        result.extend(
            addition
        )

        return


    first = addition[0]

    if (
        result[-1].x()
        == first.x()
        and
        result[-1].y()
        == first.y()
    ):

        result.extend(
            addition[1:]
        )

    else:

        result.extend(
            addition
        )


# ============================================================
# ПУТЬ ВНУТРИ ОДНОГО РЕБРА
# ============================================================

def same_edge_subpath(
    edge,
    p1,
    p2
):

    # Путь от меньшего chainage к большему
    reverse_result = False

    if p1["chainage"] > p2["chainage"]:

        p1, p2 = p2, p1

        reverse_result = True


    coords = edge["coords"]

    result = [
        p1["point"]
    ]


    i1 = p1["seg_index"]
    i2 = p2["seg_index"]


    if i1 == i2:

        result.append(
            p2["point"]
        )

    else:

        result.extend(
            coords[
                i1 + 1:
                i2 + 1
            ]
        )

        result.append(
            p2["point"]
        )


    if reverse_result:

        result.reverse()


    return result


# ============================================================
# СТРОИМ КАНДИДАТ МЕЖДУ ДВУМЯ РЁБРАМИ
# ============================================================

def build_candidate(
    start_candidate,
    end_candidate
):

    start_edge_id = start_candidate[
        "edge_id"
    ]

    end_edge_id = end_candidate[
        "edge_id"
    ]

    sp = start_candidate[
        "projection"
    ]

    ep = end_candidate[
        "projection"
    ]

    start_edge = edges[
        start_edge_id
    ]

    end_edge = edges[
        end_edge_id
    ]


    # ====================================================
    # ОБЕ КОНТРОЛЬНЫЕ ТОЧКИ ПОПАЛИ
    # НА ОДНО РЕБРО
    # ====================================================

    if start_edge_id == end_edge_id:

        coords = same_edge_subpath(
            start_edge,
            sp,
            ep
        )

        length = abs(
            ep["chainage"]
            - sp["chainage"]
        )

        return {
            "coords": coords,
            "length": length,
            "edge_ids": {
                start_edge_id
            }
        }


    # ====================================================
    # ПРОБУЕМ 4 СОЧЕТАНИЯ КОНЦОВ
    # ====================================================

    start_options = [
        (
            start_edge["n1"],
            sp["chainage"]
        ),
        (
            start_edge["n2"],
            start_edge["length"]
            - sp["chainage"]
        )
    ]


    end_options = [
        (
            end_edge["n1"],
            ep["chainage"]
        ),
        (
            end_edge["n2"],
            end_edge["length"]
            - ep["chainage"]
        )
    ]


    possibilities = []


    for start_node, start_partial in start_options:

        distances, previous = dijkstra(
            start_node
        )


        for end_node, end_partial in end_options:

            if end_node not in distances:
                continue


            network_length = distances[
                end_node
            ]


            total_length = (
                start_partial
                + network_length
                + end_partial
            )


            possibilities.append({
                "start_node": start_node,
                "end_node": end_node,
                "start_partial": start_partial,
                "end_partial": end_partial,
                "network_length": network_length,
                "total_length": total_length,
                "previous": previous
            })


    if not possibilities:
        return None


    # Из четырёх направлений выбираем то,
    # длина которого ближе к ожидаемой
    # разнице километров.
    possibilities.sort(
        key=lambda x: abs(
            x["total_length"]
            - expected_span_m
        )
    )

    choice = possibilities[0]


    restored = reconstruct_path(
        choice["start_node"],
        choice["end_node"],
        choice["previous"]
    )


    if restored is None:
        return None


    node_seq, network_edges = restored


    result_coords = []


    # Проекция первой точки -> узел
    append_coords(
        result_coords,
        projection_to_node_coords(
            start_edge,
            sp,
            choice["start_node"]
        )
    )


    # Сеть между узлами
    for i, edge_id in enumerate(
        network_edges
    ):

        edge = edges[
            edge_id
        ]

        coords = oriented_edge_coords(
            edge,
            node_seq[i],
            node_seq[i + 1]
        )

        append_coords(
            result_coords,
            coords
        )


    # Последний узел -> проекция
    append_coords(
        result_coords,
        node_to_projection_coords(
            end_edge,
            ep,
            choice["end_node"]
        )
    )


    used_edges = set(
        network_edges
    )

    used_edges.add(
        start_edge_id
    )

    used_edges.add(
        end_edge_id
    )


    return {
        "coords": result_coords,
        "length": choice[
            "total_length"
        ],
        "edge_ids": used_edges
    }


# ============================================================
# ПОДГОТОВКА СЕГМЕНТОВ ПУТИ
# ============================================================

def prepare_path_segments(coords):

    result = []

    accumulated = 0.0


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]

        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()

        map_sq = (
            dx * dx
            + dy * dy
        )

        if map_sq == 0:
            continue


        real_len = real_distance(
            p1,
            p2
        )


        result.append({
            "p1": p1,
            "p2": p2,
            "dx": dx,
            "dy": dy,
            "map_sq": map_sq,
            "real_len": real_len,
            "start": accumulated
        })


        accumulated += real_len


    return result


# ============================================================
# ПРОЕКЦИЯ КОНТРОЛЬНОЙ ТОЧКИ НА ВЕСЬ ПУТЬ
# ============================================================

def project_to_path(
    point,
    segments
):

    best = None
    best_map_sq = None


    for seg in segments:

        p1 = seg["p1"]

        vx = point.x() - p1.x()
        vy = point.y() - p1.y()

        t = (
            vx * seg["dx"]
            + vy * seg["dy"]
        ) / seg["map_sq"]

        t = max(
            0.0,
            min(1.0, t)
        )


        px = (
            p1.x()
            + t * seg["dx"]
        )

        py = (
            p1.y()
            + t * seg["dy"]
        )


        dx = point.x() - px
        dy = point.y() - py

        map_sq = (
            dx * dx
            + dy * dy
        )


        if (
            best_map_sq is None
            or
            map_sq < best_map_sq
        ):

            projection = QgsPointXY(
                px,
                py
            )

            best = {
                "chainage": (
                    seg["start"]
                    + t
                    * seg["real_len"]
                ),
                "distance": real_distance(
                    point,
                    projection
                )
            }

            best_map_sq = map_sq


    return best


# ============================================================
# ОЦЕНКА ГОТОВОГО ПУТИ
# ============================================================

def evaluate_candidate(candidate):

    segments = prepare_path_segments(
        candidate["coords"]
    )

    if not segments:
        return None


    observations = []

    residuals = []

    distances = []

    previous_chainage = None
    inversions = 0


    for cp in control_points:

        projection = project_to_path(
            cp["point"],
            segments
        )

        if projection is None:
            return None


        expected = (
            cp["km"]
            - first_control["km"]
        ) * 1000.0


        residual = abs(
            projection["chainage"]
            - expected
        )


        if (
            previous_chainage is not None
            and
            projection["chainage"]
            + 100
            < previous_chainage
        ):

            inversions += 1


        previous_chainage = projection[
            "chainage"
        ]


        residuals.append(
            residual
        )

        distances.append(
            projection["distance"]
        )


        observations.append({
            "km": cp["km"],
            "chainage": projection[
                "chainage"
            ],
            "residual": residual,
            "distance": projection[
                "distance"
            ]
        })


    length_error = abs(
        candidate["length"]
        - expected_span_m
    )


    med_residual = median(
        residuals
    )

    med_distance = median(
        distances
    )


    # ====================================================
    # SCORE
    #
    # Разница длины — главный показатель.
    # Промежуточный километраж — следующий.
    # Удалённость новой трассы имеет небольшой вес,
    # т.к. правильная линия может быть в 30 км.
    # ====================================================

    score = (
        2.0 * length_error
        + med_residual
        + 0.10 * med_distance
        + inversions * 100000.0
    )


    return {
        **candidate,
        "score": score,
        "length_error": length_error,
        "median_residual": med_residual,
        "median_distance": med_distance,
        "inversions": inversions,
        "observations": observations
    }


