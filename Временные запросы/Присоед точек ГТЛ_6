# ЧИТАЕМ pipeline_1
#
# Разрешаем:
# 1. NULL / пустые name;
# 2. при наличии — лучший вариант имени маршрута.
# ============================================================

for feature in pipes.getFeatures():

    if not feature.hasGeometry():
        continue

    raw_name = feature[
        PIPE_NAME_FIELD
    ]


    allowed = False

    if is_empty_name(raw_name):

        allowed = True

    else:

        pipe_norm = normalize_name(
            raw_name
        )

        p = name_priority(
            route_norm,
            pipe_norm
        )

        if (
            p is not None
            and
            best_named_priority is not None
            and
            p == best_named_priority
        ):
            allowed = True


    if not allowed:
        continue


    geom = feature.geometry()

    if geom.isEmpty():
        continue


    if geom.isMultipart():

        parts = geom.asMultiPolyline()

    else:

        parts = [
            geom.asPolyline()
        ]


    for part_no, part in enumerate(parts):

        if len(part) < 2:
            continue

        coords = [
            QgsPointXY(p)
            for p in part
        ]

        n1 = get_or_create_node(
            coords[0]
        )

        n2 = get_or_create_node(
            coords[-1]
        )

        length_m = coords_real_length(
            coords
        )

        edge_id = len(edges)

        edges.append({
            "fid": feature.id(),
            "part": part_no,
            "n1": n1,
            "n2": n2,
            "coords": coords,
            "length": length_m,
            "name": (
                ""
                if is_empty_name(raw_name)
                else str(raw_name)
            )
        })

        add_adj(
            n1,
            edge_id
        )

        add_adj(
            n2,
            edge_id
        )


