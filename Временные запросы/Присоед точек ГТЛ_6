# ============================================================
# DIJKSTRA
# ============================================================

def dijkstra(
    start_node,
    forbidden_edges
):

    distances = {
        start_node: 0.0
    }

    previous = {}

    heap = [
        (0.0, start_node)
    ]


    while heap:

        current_distance, node = (
            heapq.heappop(
                heap
            )
        )


        if (
            current_distance
            != distances.get(node)
        ):
            continue


        for edge_id in adjacency.get(
            node,
            []
        ):

            if edge_id in forbidden_edges:
                continue

            edge = edges[
                edge_id
            ]

            if edge["n1"] == node:
                other = edge["n2"]
            else:
                other = edge["n1"]

            new_distance = (
                current_distance
                + edge["length"]
            )


            if (
                other not in distances
                or
                new_distance
                < distances[other]
            ):

                distances[other] = (
                    new_distance
                )

                previous[other] = (
                    node,
                    edge_id
                )

                heapq.heappush(
                    heap,
                    (
                        new_distance,
                        other
                    )
                )


    return distances, previous


def reconstruct(
    start_node,
    end_node,
    previous
):

    if start_node == end_node:

        return (
            [start_node],
            []
        )


    nodes_rev = [
        end_node
    ]

    edges_rev = []

    current = end_node


    while current != start_node:

        if current not in previous:
            return None

        previous_node, edge_id = (
            previous[current]
        )

        edges_rev.append(
            edge_id
        )

        current = previous_node

        nodes_rev.append(
            current
        )


    return (
        list(
            reversed(nodes_rev)
        ),
        list(
            reversed(edges_rev)
        )
    )


# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ СБОРКИ ПУТИ
# ============================================================

def oriented_edge_coords(
    edge,
    from_node,
    to_node
):

    if (
        edge["n1"] == from_node
        and
        edge["n2"] == to_node
    ):

        return list(
            edge["coords"]
        )

    return list(
        reversed(
            edge["coords"]
        )
    )


def projection_to_node_coords(
    edge,
    projection,
    node
):

    coords = edge["coords"]

    i = projection[
        "seg_index"
    ]

    pp = projection["point"]


    if node == edge["n1"]:

        result = [
            pp
        ]

        result.extend(
            reversed(
                coords[:i + 1]
            )
        )

        return result


    result = [
        pp
    ]

    result.extend(
        coords[
            i + 1:
        ]
    )

    return result


def node_to_projection_coords(
    edge,
    projection,
    node
):

    result = projection_to_node_coords(
        edge,
        projection,
        node
    )

    result.reverse()

    return result


def append_coords(
    result,
    addition
):

    if not addition:
        return

    if not result:

        result.extend(
            addition
        )

        return

    first = addition[0]

    if (
        result[-1].x() == first.x()
        and
        result[-1].y() == first.y()
    ):

        result.extend(
            addition[1:]
        )

    else:

        result.extend(
            addition
        )


def same_edge_subpath(
    edge,
    p1,
    p2
):

    reverse_result = False

    if (
        p1["chainage"]
        >
        p2["chainage"]
    ):

        p1, p2 = p2, p1
        reverse_result = True


    coords = edge["coords"]

    result = [
        p1["point"]
    ]

    i1 = p1[
        "seg_index"
    ]

    i2 = p2[
        "seg_index"
    ]


    if i1 == i2:

        result.append(
            p2["point"]
        )

    else:

        result.extend(
            coords[
                i1 + 1:
                i2 + 1
            ]
        )

        result.append(
            p2["point"]
        )


    if reverse_result:
        result.reverse()

    return result


# ============================================================
# СОБИРАЕМ ПУТЬ ОТ КРАЙНЕЙ КРАЙНЕЙ
# ============================================================

def build_path(
    anchor_a,
    anchor_b,
    expected_distance
):

    edge_a_id = anchor_a[
        "edge_id"
    ]

    edge_b_id = anchor_b[
        "edge_id"
    ]

    edge_a = edges[
        edge_a_id
    ]

    edge_b = edges[
        edge_b_id
    ]

    pa = anchor_a[
        "projection"
    ]

    pb = anchor_b[
        "projection"
    ]


    # Одна и та же линия
    if edge_a_id == edge_b_id:

        coords = same_edge_subpath(
            edge_a,
            pa,
            pb
        )

        return {
            "coords": coords,
            "edge_ids": {
                edge_a_id
            }
        }


    options_a = [
        (
            edge_a["n1"],
            pa["chainage"]
        ),
        (
            edge_a["n2"],
            edge_a["length"]
            -
            pa["chainage"]
        )
    ]

    options_b = [
        (
            edge_b["n1"],
            pb["chainage"]
        ),
        (
            edge_b["n2"],
            edge_b["length"]
            -
            pb["chainage"]
        )
    ]


    possibilities = []


    for node_a, partial_a in options_a:

        forbidden = {
            edge_a_id,
            edge_b_id
        }

        distances, previous = dijkstra(
            node_a,
            forbidden
        )


        for node_b, partial_b in options_b:

            if node_b not in distances:
                continue


            total = (
                partial_a
                + distances[node_b]
                + partial_b
            )


            restored = reconstruct(
                node_a,
                node_b,
                previous
            )

            if restored is None:
                continue


            path_nodes, path_edges = (
                restored
            )


            possibilities.append(
                {
                    "difference": abs(
                        total
                        - expected_distance
                    ),
                    "total": total,
                    "node_a": node_a,
                    "node_b": node_b,
                    "path_nodes": path_nodes,
                    "path_edges": path_edges
                }
            )


    if not possibilities:
        return None


    possibilities.sort(
        key=lambda x:
        x["difference"]
    )


    best = possibilities[0]


    result_coords = []


    # Проекция A -> узел
    append_coords(
        result_coords,
        projection_to_node_coords(
            edge_a,
            pa,
            best["node_a"]
        )
    )


    # Середина сети
    for i, edge_id in enumerate(
        best["path_edges"]
    ):

        edge = edges[
            edge_id
        ]

        coords = oriented_edge_coords(
            edge,
            best["path_nodes"][i],
            best["path_nodes"][i + 1]
        )

        append_coords(
            result_coords,
            coords
        )


    # Узел -> проекция B
    append_coords(
        result_coords,
        node_to_projection_coords(
            edge_b,
            pb,
            best["node_b"]
        )
    )


    used_edges = set(
        best["path_edges"]
    )

    used_edges.add(
        edge_a_id
    )

    used_edges.add(
        edge_b_id
    )


    return {
        "coords": result_coords,
        "edge_ids": used_edges
    }


