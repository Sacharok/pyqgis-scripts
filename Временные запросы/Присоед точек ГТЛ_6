nodes = {}
node_grid = {}

edges = []
adjacency = {}

next_node_id = 0


def map_distance(p1, p2):

    return math.hypot(
        p1.x() - p2.x(),
        p1.y() - p2.y()
    )


def grid_key(point):

    return (
        int(
            math.floor(
                point.x()
                / CONNECT_TOLERANCE
            )
        ),
        int(
            math.floor(
                point.y()
                / CONNECT_TOLERANCE
            )
        )
    )


def get_or_create_node(point):

    global next_node_id

    key = grid_key(
        point
    )


    for dx in (-1, 0, 1):

        for dy in (-1, 0, 1):

            test_key = (
                key[0] + dx,
                key[1] + dy
            )

            for node_id in node_grid.get(
                test_key,
                []
            ):

                if (
                    map_distance(
                        point,
                        nodes[node_id]
                    )
                    <= CONNECT_TOLERANCE
                ):

                    return node_id


    node_id = next_node_id
    next_node_id += 1

    nodes[node_id] = QgsPointXY(
        point
    )

    node_grid.setdefault(
        key,
        []
    ).append(
        node_id
    )

    return node_id


def add_adj(node, edge_id):

    adjacency.setdefault(
        node,
        []
    ).append(
        edge_id
    )


