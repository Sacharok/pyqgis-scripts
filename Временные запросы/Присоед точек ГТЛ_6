import re
import math
import heapq

from qgis.core import (
    QgsProject,
    QgsGeometry,
    QgsPointXY,
    QgsDistanceArea
)


# ============================================================
# НАСТРОЙКИ
# ============================================================

POINT_LAYER_NAME = "Копия точек"
PIPE_LAYER_NAME = "pipeline_1"

POINT_NAME_FIELD = "Name"
PIPE_NAME_FIELD = "name"

# Радиус, внутри которого ищем локальную линию для точки.
# Это не означает, что обязательно выберем ближайшую:
# если есть подходящий name, он получает приоритет.
SEARCH_RADIUS_M = 80000

# Сколько соседних точек маршрута использовать
# с каждой стороны от выбранной.
CONTROL_POINTS_EACH_SIDE = 3

# Допуск соединения КОНЦОВ объектов pipeline_1.
#
# ВАЖНО:
# это координатные единицы EPSG:3857,
# а не расчётное расстояние километража.
CONNECT_TOLERANCE = 5.0


# ============================================================
# НОРМАЛИЗАЦИЯ
# ============================================================

def normalize_name(value):

    if value is None:
        return ""

    text = str(value).strip().lower()
    text = text.replace("ё", "е")

    return re.sub(
        r"[^0-9a-zа-я]+",
        "",
        text
    )


# ============================================================
# РАЗБОР NAME ТОЧКИ
# ============================================================

def parse_point_name(value):
    """
    Примеры:

    76,6 км Елец-Курск-Диканька
        -> 76.6
        -> Елец-Курск-Диканька

    ТСГ 31 км УКПГ-15-КС Ямбургская
        -> 31
        -> УКПГ-15-КС Ямбургская
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.search(
        r"(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    try:

        km_value = float(
            match.group(1).replace(",", ".")
        )

    except ValueError:

        return None, None

    route_name = match.group(2).strip()

    return km_value, route_name


# ============================================================
# СОВПАДЕНИЕ НАЗВАНИЯ
# ============================================================

def name_priority(route_norm, pipe_norm):
    """
    Та же логика, которая уже хорошо сработала.

    Меньше значение = лучше совпадение.
    """

    if not pipe_norm:
        return None

    if pipe_norm == route_norm:
        return 0

    if not pipe_norm.startswith(route_norm):
        return None

    suffix = pipe_norm[
        len(route_norm):
    ]

    if suffix == "":
        return 0

    if suffix == "1":
        return 1

    if suffix.isdigit():

        number = int(suffix)

        if number == 1:
            return 1

        return number * 10


    match = re.match(
        r"^(\d+)(.*)$",
        suffix
    )

    if match:

        number = int(
            match.group(1)
        )

        extra = match.group(2)

        priority = number * 10

        if extra:
            priority += 100

        return priority


    return 500


