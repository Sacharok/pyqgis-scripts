)


if not route_points:

    raise Exception(
        "Не найдено точек этого маршрута."
    )


print("")
print("=" * 100)
print("ПОИСК БЕЗЫМЯННОЙ ТРАССЫ")
print("=" * 100)

print(
    f"Маршрут: {selected_route}"
)

print(
    f"Выбранная отметка: "
