            }
        )

        continue


    all_chain_edges.update(
        result["edge_ids"]
    )


    results.append(
        {
            "km": cp["km"],
            "status": "OK",
            "expected": expected_distance,
            "actual": result["distance"],
            "difference": abs(
                result["distance"]
                - expected_distance
            )
        }
    )


# ============================================================
