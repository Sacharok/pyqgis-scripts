def normalize_name(value):

    if value is None:
        return ""

    text = str(value).strip().lower()
    text = text.replace("ё", "е")

    return re.sub(
        r"[^0-9a-zа-я]+",
        "",
        text
    )


def parse_point_name(value):

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.search(
        r"(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    try:
        km = float(
            match.group(1).replace(",", ".")
        )
    except ValueError:
        return None, None

    route = match.group(2).strip()

    return km, route


def name_priority(route_norm, pipe_norm):

    if not pipe_norm:
        return None

    if pipe_norm == route_norm:
        return 0

    if not pipe_norm.startswith(route_norm):
        return None

    suffix = pipe_norm[len(route_norm):]

    if suffix == "":
        return 0

    if suffix == "1":
        return 1

    if suffix.isdigit():

        number = int(suffix)

        if number == 1:
            return 1

        return number * 10

    match = re.match(
        r"^(\d+)(.*)$",
        suffix
    )

    if match:

        number = int(
            match.group(1)
        )

        extra = match.group(2)

        priority = number * 10

        if extra:
            priority += 100

        return priority

    return 500


