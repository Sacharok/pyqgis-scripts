def normalize_name(value):

    if value is None:
        return ""

    text = str(value).strip().lower()
    text = text.replace("ё", "е")

    return re.sub(
        r"[^0-9a-zа-я]+",
        "",
        text
    )


# ============================================================
# РАЗБОР ТОЧКИ
# ============================================================

def parse_point_name(value):
    """
    Примеры:

    81,5 км Елец-Курск-Диканька

    ТСГ 31 км УКПГ-15-КС Ямбургская
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.search(
        r"(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    try:
        km = float(
            match.group(1).replace(",", ".")
        )
    except ValueError:
        return None, None

    route = match.group(2).strip()

    return km, route


def is_empty_name(value):

    if value is None:
        return True

    text = str(value).strip().lower()

    return text in (
        "",
        "null",
        "none",
        "<null>"
    )


