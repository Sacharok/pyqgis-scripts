# ============================================================
# REAL DISTANCE
# ============================================================

da = QgsDistanceArea()

da.setSourceCrs(
    pipes.crs(),
    QgsProject.instance().transformContext()
)

da.setEllipsoid(
    "WGS84"
)


def real_distance(p1, p2):

    return da.measureLine(
        QgsPointXY(p1),
        QgsPointXY(p2)
    )


def coords_real_length(coords):

    total = 0.0

    for i in range(
        len(coords) - 1
    ):

        total += real_distance(
            coords[i],
            coords[i + 1]
        )

    return total


# ============================================================
# ЧИТАЕМ ВСЕ ОБЪЕКТЫ pipeline_1
#
# Здесь НИЧЕГО не фильтруем по name.
# ============================================================

pipe_features = []


for feature in pipes.getFeatures():

    if not feature.hasGeometry():
        continue

    geom = feature.geometry()

    if geom.isEmpty():
        continue


    raw_name = feature[
        PIPE_NAME_FIELD
    ]


    if raw_name is None:

        pipe_name = ""

    else:

        pipe_name = str(
            raw_name
        ).strip()


    pipe_features.append(
        {
            "fid": feature.id(),
            "name": pipe_name,
            "norm": normalize_name(
                pipe_name
            ),
            "geom": geom
        }
    )


# ============================================================
# РАБОЧИЙ ВЫБОР ЛОКАЛЬНОЙ ЛИНИИ
#
# 1. сначала пространственный фильтр;
# 2. если есть совпадение name — берём его;
# 3. если совпадения нет — ближайший объект вообще.
# ============================================================

def choose_local_feature(
    point_xy,
    route_norm
):

    point_geom = (
        QgsGeometry.fromPointXY(
            point_xy
        )
    )

    candidates = []


    for item in pipe_features:

        nearest_geom = (
            item["geom"]
            .nearestPoint(
                point_geom
            )
        )

        if nearest_geom.isEmpty():
            continue


        nearest_xy = QgsPointXY(
            nearest_geom.asPoint()
        )


        distance_m = real_distance(
            point_xy,
            nearest_xy
        )


        if distance_m > SEARCH_RADIUS_M:
            continue


        priority = name_priority(
            route_norm,
            item["norm"]
        )


        candidates.append(
            {
                "fid": item["fid"],
                "name": item["name"],
                "norm": item["norm"],
                "distance": distance_m,
                "priority": priority
            }
        )


    if not candidates:

        return None


    # Сначала всё сортируем по расстоянию
    candidates.sort(
        key=lambda x:
        x["distance"]
    )


    name_matches = [
        item
        for item in candidates
        if item["priority"] is not None
    ]


    if name_matches:

        best_priority = min(
            item["priority"]
            for item in name_matches
        )


        best_name_matches = [
            item
            for item in name_matches
            if item["priority"]
            == best_priority
        ]


        best_name_matches.sort(
            key=lambda x:
            x["distance"]
        )


        chosen = dict(
            best_name_matches[0]
        )

        chosen["reason"] = "MATCH"


    else:

        chosen = dict(
            candidates[0]
        )

        chosen["reason"] = "NEAREST"


    return chosen


