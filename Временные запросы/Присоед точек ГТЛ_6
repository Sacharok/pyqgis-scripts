def name_priority(route_norm, pipe_norm):
    """
    Только для определения,
    какие именованные линии разрешать в графе.

    NULL всегда разрешены отдельно.
    """

    if not pipe_norm:
        return None

    if pipe_norm == route_norm:
        return 0

    if not pipe_norm.startswith(route_norm):
        return None

    suffix = pipe_norm[
        len(route_norm):
    ]

    if suffix == "":
        return 0

    if suffix == "1":
        return 1

    if suffix.isdigit():

        number = int(suffix)

        if number == 1:
            return 1

        return number * 10

    match = re.match(
        r"^(\d+)(.*)$",
        suffix
    )

    if match:

        number = int(
            match.group(1)
        )

        extra = match.group(2)

        result = number * 10

        if extra:
            result += 100

        return result

    return 500


