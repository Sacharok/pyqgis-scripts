def anchor_to_graph(
    point,
    anchor
):

    if anchor is None:
        return None


    edge_ids = edges_by_fid.get(
        anchor["fid"],
        []
    )


    best = None


    for edge_id in edge_ids:

        projection = project_point_to_edge(
            point,
            edges[edge_id]
        )

        if projection is None:
            continue

        if (
            best is None
            or
            projection["distance"]
            <
            best["projection"]["distance"]
        ):

            best = {
                "edge_id": edge_id,
                "projection": projection
            }


    return best


