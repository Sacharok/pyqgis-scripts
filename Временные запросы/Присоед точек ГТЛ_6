def name_priority(route_norm, pipe_norm):
    """
    None = название не соответствует.

    Меньшее число = лучше.

    Например:

    Ухта-Торжок        -> 0
    Ухта-Торжок 1      -> 1
    Ухта-Торжок 2      -> 20
    Ухта-Торжок 3      -> 30
    Ухта-Торжок 2 Ямал -> 120
    """

    if not pipe_norm:
        return None

    if pipe_norm == route_norm:
        return 0

    if not pipe_norm.startswith(route_norm):
        return None

    suffix = pipe_norm[
        len(route_norm):
    ]

    if suffix == "":
        return 0

    if suffix == "1":
        return 1

    if suffix.isdigit():

        number = int(suffix)

        if number == 1:
            return 1

        return number * 10


    match = re.match(
        r"^(\d+)(.*)$",
        suffix
    )

    if match:

        number = int(
            match.group(1)
        )

        extra = match.group(2)

        priority = number * 10

        if extra:
            priority += 100

        return priority


    return 500


