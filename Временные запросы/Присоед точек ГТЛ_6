def normalize_name(value):

    if value is None:
        return ""

    text = str(value).strip().lower()
    text = text.replace("ё", "е")

    return re.sub(
        r"[^0-9a-zа-я]+",
        "",
        text
    )


def parse_point_name(value):
    """
    Поддерживает, например:

        23 км Шебелинка-Острогожск
        37,5 км КС Нюксеница-Архангельск
        ТСГ 31 км УКПГ-15-КС Ямбургская
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.search(
        r"(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    try:

        km_value = float(
            match.group(1).replace(",", ".")
        )

    except ValueError:

        return None, None

    route_name = match.group(2).strip()

    return km_value, route_name


