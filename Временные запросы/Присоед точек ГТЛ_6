# ============================================================
# СТРОИМ ГРАФ ИЗ ВСЕГО pipeline_1
#
# Name здесь вообще НЕ используется.
# Только геометрическое соединение концов.
# ============================================================

nodes = {}
node_grid = {}

edges = []
adjacency = {}

edges_by_fid = {}

next_node_id = 0


def map_distance(
    p1,
    p2
):

    return math.hypot(
        p1.x() - p2.x(),
        p1.y() - p2.y()
    )


def node_grid_key(point):

    return (
        int(
            math.floor(
                point.x()
                / CONNECT_TOLERANCE
            )
        ),
        int(
            math.floor(
                point.y()
                / CONNECT_TOLERANCE
            )
        )
    )


def get_or_create_node(
    point
):

    global next_node_id

    key = node_grid_key(
        point
    )


    for dx in (-1, 0, 1):

        for dy in (-1, 0, 1):

            check_key = (
                key[0] + dx,
                key[1] + dy
            )


            for node_id in node_grid.get(
                check_key,
                []
            ):

                if (
                    map_distance(
                        point,
                        nodes[node_id]
                    )
                    <= CONNECT_TOLERANCE
                ):

                    return node_id


    node_id = next_node_id
    next_node_id += 1


    nodes[node_id] = QgsPointXY(
        point
    )


    node_grid.setdefault(
        key,
        []
    ).append(
        node_id
    )


    return node_id


def add_adj(
    node_id,
    edge_id
):

    adjacency.setdefault(
        node_id,
        []
    ).append(
        edge_id
    )


for item in pipe_features:

    geom = item["geom"]


    if geom.isMultipart():

        parts = geom.asMultiPolyline()

    else:

        parts = [
            geom.asPolyline()
        ]


    for part_number, part in enumerate(
        parts
    ):

        if len(part) < 2:
            continue


        coords = [
            QgsPointXY(p)
            for p in part
        ]


        node1 = get_or_create_node(
            coords[0]
        )

        node2 = get_or_create_node(
            coords[-1]
        )


        length_m = coords_real_length(
            coords
        )


        edge_id = len(
            edges
        )


        edges.append(
            {
                "fid": item["fid"],
                "part": part_number,
                "n1": node1,
                "n2": node2,
                "coords": coords,
                "length": length_m,
                "name": item["name"]
            }
        )


        edges_by_fid.setdefault(
            item["fid"],
            []
        ).append(
            edge_id
        )


        add_adj(
            node1,
            edge_id
        )

        add_adj(
            node2,
            edge_id
        )


