# ============================================================
# ВЫБОР ЛОКАЛЬНОЙ ЛИНИИ
#
# РАБОЧАЯ ЛОГИКА:
#
# 1. сначала близость;
# 2. внутри радиуса смотрим name;
# 3. если есть совпадающий name —
#    выбираем его;
# 4. если совпадения нет —
#    выбираем просто ближайший объект.
#
# NULL НЕ имеет преимущества перед другим именем.
# ============================================================

local_anchor_cache = {}


def choose_local_feature(
    point_item
):

    cache_key = (
        point_item["fid"],
        point_item["route_norm"]
    )


    if cache_key in local_anchor_cache:

        return local_anchor_cache[
            cache_key
        ]


    point_xy = point_item[
        "point"
    ]

    route_norm = point_item[
        "route_norm"
    ]


    point_geom = QgsGeometry.fromPointXY(
        point_xy
    )


    candidates = []


    for pipe in pipe_features:

        nearest_geom = (
            pipe["geom"]
            .nearestPoint(
                point_geom
            )
        )


        if nearest_geom.isEmpty():
            continue


        nearest_xy = QgsPointXY(
            nearest_geom.asPoint()
        )


        distance_m = real_distance(
            point_xy,
            nearest_xy
        )


        # --------------------------------------------
        # ПЕРВЫЙ ФИЛЬТР:
        # географическая близость
        # --------------------------------------------

        if distance_m > SEARCH_RADIUS_M:
            continue


        priority = name_priority(
            route_norm,
            pipe["norm"]
        )


        candidates.append(
            {
                "fid": pipe["fid"],
                "name": pipe["name"],
                "distance": distance_m,
                "priority": priority
            }
        )


    if not candidates:

        local_anchor_cache[
            cache_key
        ] = None

        return None


    candidates.sort(
        key=lambda x:
        x["distance"]
    )


    # --------------------------------------------
    # ВТОРОЙ ЭТАП:
    # название
    # --------------------------------------------

    matches = [
        item
        for item in candidates
        if item["priority"] is not None
    ]


    if matches:

        best_priority = min(
            item["priority"]
            for item in matches
        )


        best_matches = [
            item
            for item in matches
            if item["priority"]
            == best_priority
        ]


        best_matches.sort(
            key=lambda x:
            x["distance"]
        )


        chosen = dict(
            best_matches[0]
        )

        chosen[
            "reason"
        ] = "MATCH"


    else:

        chosen = dict(
            candidates[0]
        )

        chosen[
            "reason"
        ] = "NEAREST"


    local_anchor_cache[
        cache_key
    ] = chosen


    return chosen


# ============================================================
# СТРОИМ ГРАФ ВСЕГО pipeline_1
#
# Здесь name больше НЕ влияет.
# Используется только физическая связанность концов.
# ============================================================

nodes = {}
node_grid = {}

edges = []
edges_by_fid = {}
adjacency = {}

next_node_id = 0


def map_distance(
    p1,
    p2
):

    return math.hypot(
        p1.x() - p2.x(),
        p1.y() - p2.y()
    )


def grid_key(point):

    return (
        int(
            math.floor(
                point.x()
                / CONNECT_TOLERANCE
            )
        ),
        int(
            math.floor(
                point.y()
                / CONNECT_TOLERANCE
            )
        )
    )


def get_or_create_node(
    point
):

    global next_node_id

    key = grid_key(
        point
    )


    for dx in (-1, 0, 1):

        for dy in (-1, 0, 1):

            check_key = (
                key[0] + dx,
                key[1] + dy
            )


            for node_id in node_grid.get(
                check_key,
                []
            ):

                if (
                    map_distance(
                        point,
                        nodes[node_id]
                    )
                    <= CONNECT_TOLERANCE
                ):

                    return node_id


    node_id = next_node_id
    next_node_id += 1


    nodes[
        node_id
    ] = QgsPointXY(
        point
    )


    node_grid.setdefault(
        key,
        []
    ).append(
        node_id
    )


    return node_id


def add_adj(
    node_id,
    edge_id
):

    adjacency.setdefault(
        node_id,
        []
    ).append(
        edge_id
    )


for pipe in pipe_features:

    geom = pipe[
        "geom"
    ]


    if geom.isMultipart():

        parts = geom.asMultiPolyline()

    else:

        parts = [
            geom.asPolyline()
        ]


    for part_number, part in enumerate(
        parts
    ):

        if len(part) < 2:
            continue


        coords = [
            QgsPointXY(p)
            for p in part
        ]


        n1 = get_or_create_node(
            coords[0]
        )

        n2 = get_or_create_node(
            coords[-1]
        )


        edge_id = len(
            edges
        )


        edge = {
            "fid": pipe["fid"],
            "part": part_number,
            "n1": n1,
            "n2": n2,
            "coords": coords,
            "length": coords_real_length(
                coords
            )
        }


        edges.append(
            edge
        )


        edges_by_fid.setdefault(
            pipe["fid"],
            []
        ).append(
            edge_id
        )


        add_adj(
            n1,
            edge_id
        )

        add_adj(
            n2,
            edge_id
        )


