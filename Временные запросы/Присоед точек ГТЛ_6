    )


# ============================================================
# РЕАЛЬНЫЕ РАССТОЯНИЯ
# ============================================================

distance_area = QgsDistanceArea()

distance_area.setSourceCrs(
    pipes.crs(),
    QgsProject.instance().transformContext()
)

distance_area.setEllipsoid(
    "WGS84"
)


def real_distance(p1, p2):

    return distance_area.measureLine(
        QgsPointXY(p1),
        QgsPointXY(p2)
    )


def real_line_length(geom):

    return distance_area.measureLength(
        geom
    )


# ============================================================
# УЗЛЫ ГРАФА
#
# Объединяем только КОНЦЫ линий,
# а не линии, которые просто проходят рядом.
# ============================================================

nodes = {}
grid = {}

next_node_id = 0


def grid_key(point):

    return (
        int(math.floor(
            point.x() / CONNECT_TOLERANCE
        )),
        int(math.floor(
            point.y() / CONNECT_TOLERANCE
        ))
    )


def map_distance(p1, p2):

    return math.hypot(
        p1.x() - p2.x(),
        p1.y() - p2.y()
    )


def get_or_create_node(point):

    global next_node_id

    key = grid_key(point)

    # Проверяем соседние клетки,
    # чтобы не потерять точку на границе клетки.
    for dx in (-1, 0, 1):

        for dy in (-1, 0, 1):

            test_key = (
                key[0] + dx,
                key[1] + dy
            )

            for node_id in grid.get(
                test_key,
                []
            ):

                existing = nodes[
                    node_id
                ]

                if (
                    map_distance(
                        point,
                        existing["point"]
                    )
                    <= CONNECT_TOLERANCE
                ):

                    return node_id


    node_id = next_node_id
    next_node_id += 1

    nodes[node_id] = {
        "point": QgsPointXY(point)
    }

    grid.setdefault(
        key,
        []
    ).append(
        node_id
    )

    return node_id


# ============================================================
# РЁБРА ГРАФА:
# ТОЛЬКО pipeline_1 С NULL / ПУСТЫМ NAME
# ============================================================

edges = []

adjacency = {}


def add_adjacency(node, edge_id):

    adjacency.setdefault(
        node,
        []
    ).append(
        edge_id
    )


for feature in pipes.getFeatures():

    if not feature.hasGeometry():
        continue

    raw_name = feature[
        PIPE_NAME_FIELD
    ]

    # Для этого теста рассматриваем
    # только безымянные линии.
    if not is_empty_name(raw_name):
        continue


    geom = feature.geometry()

    if geom.isEmpty():
        continue


    if geom.isMultipart():

        parts = geom.asMultiPolyline()

    else:

        parts = [
            geom.asPolyline()
        ]


    for part_number, part in enumerate(parts):

        if len(part) < 2:
            continue


        coords = [
            QgsPointXY(p)
            for p in part
        ]


        start_node = get_or_create_node(
            coords[0]
        )

        end_node = get_or_create_node(
            coords[-1]
        )


        part_geom = QgsGeometry.fromPolylineXY(
            coords
        )


        length_m = real_line_length(
            part_geom
        )


        edge_id = len(edges)


        edges.append(
            {
                "fid": feature.id(),
                "part": part_number,
                "n1": start_node,
                "n2": end_node,
                "coords": coords,
                "length": length_m
            }
        )


        add_adjacency(
            start_node,
            edge_id
        )

        add_adjacency(
            end_node,
            edge_id
        )


print("")
print(
    f"Безымянных линейных частей: "
    f"{len(edges)}"
)

print(
    f"Узлов графа: "
    f"{len(nodes)}"
)


if not edges:

    raise Exception(
        "В pipeline_1 не найдено "
        "безымянных линий."
    )


# ============================================================
# СВЯЗНЫЕ КОМПОНЕНТЫ
# ============================================================

visited_edges = set()

components = []


for first_edge in range(len(edges)):

    if first_edge in visited_edges:
        continue


    component_edges = set()
    component_nodes = set()

    stack = [
        first_edge
    ]


    while stack:

        edge_id = stack.pop()

        if edge_id in visited_edges:
            continue

        visited_edges.add(
            edge_id
        )

        component_edges.add(
            edge_id
        )

        edge = edges[
            edge_id
        ]


        for node_id in (
            edge["n1"],
            edge["n2"]
        ):

            component_nodes.add(
                node_id
            )

            for next_edge in adjacency.get(
                node_id,
                []
            ):

                if next_edge not in visited_edges:

                    stack.append(
                        next_edge
                    )


    components.append(
        {
            "edges": component_edges,
            "nodes": component_nodes
        }
    )


print(
    f"Связных безымянных компонентов: "
    f"{len(components)}"
)


# ============================================================
# DIJKSTRA
# ============================================================

def dijkstra(
    start_node,
    allowed_edges
):

    distances = {
        start_node: 0.0
    }

    previous = {}

    queue = [
        (0.0, start_node)
    ]


    while queue:

        current_dist, node = heapq.heappop(
            queue
        )

        if (
            current_dist
            != distances.get(node)
        ):
            continue


        for edge_id in adjacency.get(
            node,
            []
        ):

            if edge_id not in allowed_edges:
                continue

            edge = edges[
                edge_id
            ]


            if edge["n1"] == node:
                other = edge["n2"]
            else:
                other = edge["n1"]


            new_dist = (
                current_dist
                + edge["length"]
            )


            if (
                other not in distances
                or
                new_dist
                < distances[other]
            ):

                distances[other] = new_dist

                previous[other] = (
                    node,
                    edge_id
                )

                heapq.heappush(
                    queue,
                    (
                        new_dist,
                        other
                    )
                )


    return distances, previous


# ============================================================
# ДИАМЕТР / ОСНОВНАЯ ЦЕПОЧКА КОМПОНЕНТА
#
# Для дерева это самый длинный путь.
# Маленькие боковые ветки обычно остаются за пределами.
# ============================================================

def component_main_path(component):

    component_nodes = component[
        "nodes"
    ]

    component_edges = component[
        "edges"
    ]


    if not component_nodes:
        return None


    start = next(
        iter(component_nodes)
    )


    distances, _ = dijkstra(
        start,
        component_edges
    )


    if not distances:
        return None


    node_a = max(
        distances,
        key=distances.get
    )


    distances, previous = dijkstra(
        node_a,
        component_edges
    )


    node_b = max(
        distances,
        key=distances.get
    )


    # Восстанавливаем путь
    path_edges_rev = []
    path_nodes_rev = [
        node_b
    ]

    current = node_b


    while current != node_a:

        if current not in previous:
            return None

        prev_node, edge_id = previous[
            current
        ]

        path_edges_rev.append(
            edge_id
        )

        current = prev_node

        path_nodes_rev.append(
            current
        )


    path_edges = list(
        reversed(
            path_edges_rev
        )
    )

    path_nodes = list(
        reversed(
            path_nodes_rev
        )
    )


    return (
        path_nodes,
        path_edges
    )


# ============================================================
# СОБИРАЕМ КООРДИНАТЫ ПУТИ В ПРАВИЛЬНОМ ПОРЯДКЕ
# ============================================================

def build_path_coords(
    path_nodes,
    path_edges
):

    result = []


    for i, edge_id in enumerate(
        path_edges
    ):

        edge = edges[
            edge_id
        ]

        from_node = path_nodes[
            i
        ]

        to_node = path_nodes[
            i + 1
        ]


        if (
            edge["n1"] == from_node
            and
            edge["n2"] == to_node
        ):

            coords = edge[
                "coords"
            ]

        else:

            coords = list(
                reversed(
                    edge["coords"]
                )
            )


        if not result:

            result.extend(
                coords
            )

        else:

            # Если из-за допуска концы немного
            # различаются, соединение добавится
            # коротким техническим сегментом.
            if (
                result[-1].x()
                != coords[0].x()
                or
                result[-1].y()
                != coords[0].y()
            ):

                result.append(
                    coords[0]
                )


            result.extend(
                coords[1:]
            )


    return result


# ============================================================
# ПОДГОТАВЛИВАЕМ СЕГМЕНТЫ ПУТИ
# ============================================================

def prepare_path_segments(coords):

    segments = []

    accumulated = 0.0


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]


        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()

        map_len_sq = (
            dx * dx
            + dy * dy
        )


        if map_len_sq == 0:
            continue


        real_len = real_distance(
            p1,
            p2
        )


        segments.append(
            {
                "p1": p1,
                "p2": p2,
                "dx": dx,
                "dy": dy,
                "map_len_sq": map_len_sq,
                "real_len": real_len,
                "start_m": accumulated
            }
        )


        accumulated += real_len


    return segments, accumulated


# ============================================================
# ПРОЕКЦИЯ СТАРОЙ ТОЧКИ НА КАНДИДАТА
#
# Возвращает:
# - расстояние вдоль кандидата;
# - реальное поперечное расстояние;
# - координату проекции.
# ============================================================

def project_point_to_path(
    point,
    segments
):

    best = None
    best_map_dist_sq = None


    for segment in segments:

        p1 = segment["p1"]

        dx = segment["dx"]
        dy = segment["dy"]


        vx = point.x() - p1.x()
        vy = point.y() - p1.y()


        t = (
            vx * dx
            + vy * dy
        ) / segment[
            "map_len_sq"
        ]


        t = max(
            0.0,
            min(1.0, t)
        )


        px = (
            p1.x()
            + t * dx
        )

        py = (
            p1.y()
            + t * dy
        )


        ddx = point.x() - px
        ddy = point.y() - py

        map_dist_sq = (
            ddx * ddx
            + ddy * ddy
        )


        if (
            best_map_dist_sq is None
            or
            map_dist_sq
            < best_map_dist_sq
        ):

            projection = QgsPointXY(
                px,
                py
            )

            chainage = (
                segment["start_m"]
                + t
                * segment["real_len"]
            )

            perpendicular = real_distance(
                point,
                projection
            )


            best = {
                "chainage": chainage,
                "distance": perpendicular,
                "projection": projection
            }

            best_map_dist_sq = (
                map_dist_sq
            )


    return best


# ============================================================
# ОЦЕНКА КАНДИДАТА
# ============================================================

def evaluate_candidate(
    path_coords
):

    segments, path_length = (
        prepare_path_segments(
            path_coords
        )
    )


    if not segments:
        return None


    observations = []


    for rp in route_points:

        projection = project_point_to_path(
            rp["point"],
            segments
        )


        if projection is None:
            continue


        observations.append(
            {
                "km": rp["km"],
                "name": rp["name"],
                "chainage": projection[
                    "chainage"
                ],
                "distance": projection[
                    "distance"
                ]
            }
        )


    if not observations:
        return None


    # ====================================================
    # ВАРИАНТ A
    #
    # Расстояние вдоль новой линии растёт
    # вместе с километровой отметкой.
    #
    # s = km + OFFSET
    # ====================================================

    forward_offsets = [
        obs["chainage"]
        - obs["km"] * 1000.0
        for obs in observations
    ]


    forward_offset = median(
        forward_offsets
    )


    forward_residuals = [
        abs(
            obs["chainage"]
            -
            (
                obs["km"] * 1000.0
                + forward_offset
            )
        )
        for obs in observations
    ]


    forward_median_residual = median(
        forward_residuals
    )


    # ====================================================
    # ВАРИАНТ B
    #
    # Линия оцифрована в обратную сторону:
    #
    # s = OFFSET - km
    # ====================================================

    reverse_offsets = [
        obs["chainage"]
        + obs["km"] * 1000.0
        for obs in observations
    ]


    reverse_offset = median(
        reverse_offsets
    )


    reverse_residuals = [
        abs(
            obs["chainage"]
            -
            (
                reverse_offset
                - obs["km"] * 1000.0
            )
        )
        for obs in observations
    ]


    reverse_median_residual = median(
        reverse_residuals
    )


    if (
        forward_median_residual
        <=
        reverse_median_residual
    ):

        direction = "прямое"

        offset = forward_offset

        residuals = forward_residuals

    else:

        direction = "обратное"

        offset = reverse_offset

        residuals = reverse_residuals


    median_residual = median(
        residuals
    )


    median_distance = median(
        [
            obs["distance"]
            for obs in observations
        ]
    )


    max_residual = max(
        residuals
    )


    # Диапазон километровых отметок
    if len(observations) >= 2:

        km_span = (
            max(
                obs["km"]
                for obs in observations
            )
            -
            min(
                obs["km"]
                for obs in observations
            )
        ) * 1000.0

    else:

        km_span = 0.0


    # Если кандидат физически короче диапазона
    # наших точек, добавляем большой штраф.
    shortfall = max(
        0.0,
        km_span - path_length
    )


    # ----------------------------------------------------
    # ОЦЕНКА
    #
    # Главный критерий:
    # сохранение километровых расстояний.
    #
    # Поперечная удалённость имеет меньший вес,
    # потому что новая трасса может быть
    # в 20-30 км от старой.
    # ----------------------------------------------------

    if len(observations) >= 2:

        score = (
            median_residual
            +
            0.10 * median_distance
            +
            5.0 * shortfall
        )

    else:

        # С одной точкой километраж ничего
        # доказать не может.
        score = median_distance


    # Добавляем residual в observations
    for obs, residual in zip(
        observations,
        residuals
    ):

        obs["residual"] = residual


    return {
        "score": score,
        "direction": direction,
        "offset": offset,
        "median_residual": median_residual,
        "max_residual": max_residual,
        "median_distance": median_distance,
        "length": path_length,
        "observations": observations
    }


# ============================================================
# СТРОИМ КАНДИДАТЫ
# ============================================================

candidates = []


for component_number, component in enumerate(
    components,
    start=1
):

    path = component_main_path(
        component
    )


    if path is None:
        continue


    path_nodes, path_edges = path


    if not path_edges:
        continue


    coords = build_path_coords(
        path_nodes,
        path_edges
    )


    if len(coords) < 2:
        continue


    evaluation = evaluate_candidate(
        coords
    )


    if evaluation is None:
        continue


    source_fids = sorted(
        set(
            edges[edge_id]["fid"]
            for edge_id in path_edges
        )
    )


    candidates.append(
        {
            "component": component_number,
            "path_edges": path_edges,
            "path_nodes": path_nodes,
            "source_fids": source_fids,
            "coords": coords,
            **evaluation
        }
    )


if not candidates:

    raise Exception(
        "Не удалось построить ни одного "
        "кандидата из безымянных линий."
    )


# ============================================================
# СОРТИРОВКА
# ============================================================

candidates.sort(
    key=lambda item: item[
        "score"
    ]
)


print("")
print("=" * 100)
print("ЛУЧШИЕ КАНДИДАТЫ")
print("=" * 100)


for number, candidate in enumerate(
    candidates[
        :TOP_CANDIDATES
    ],
    start=1
):

    print("")
    print(
        f"{number}. Компонент "
