# ПРОЕКЦИЯ ТОЧКИ НА ОДНО РЕБРО
# ============================================================

def project_point_to_edge(
    point,
    edge
):

    coords = edge["coords"]

    best = None
    best_map_dist_sq = None

    accumulated = 0.0


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]

        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()

        seg_map_sq = (
            dx * dx
            + dy * dy
        )

        if seg_map_sq == 0:
            continue


        vx = point.x() - p1.x()
        vy = point.y() - p1.y()

        t = (
            vx * dx
            + vy * dy
        ) / seg_map_sq

        t = max(
            0.0,
            min(1.0, t)
        )

        px = (
            p1.x()
            + t * dx
        )

        py = (
            p1.y()
            + t * dy
        )

        ddx = point.x() - px
        ddy = point.y() - py

        map_d2 = (
            ddx * ddx
            + ddy * ddy
        )


        seg_real = real_distance(
            p1,
            p2
        )


        if (
            best_map_dist_sq is None
            or
            map_d2
            < best_map_dist_sq
        ):

            projection = QgsPointXY(
                px,
                py
            )

            best = {
                "point": projection,
                "seg_index": i,
                "t": t,
                "chainage": (
                    accumulated
                    + seg_real * t
                ),
                "distance": real_distance(
                    point,
                    projection
                )
            }

            best_map_dist_sq = map_d2


        accumulated += seg_real


    return best


# ============================================================
# БЛИЖАЙШИЕ РЁБРА К КРАЙНЕЙ ТОЧКЕ
# ============================================================

def nearest_edges(point):

    result = []

    for edge_id, edge in enumerate(edges):

        projection = project_point_to_edge(
            point,
            edge
        )

        if projection is None:
            continue

        if (
            projection["distance"]
            > MAX_ENDPOINT_DISTANCE_M
        ):
            continue

        result.append({
            "edge_id": edge_id,
            "projection": projection
        })


    result.sort(
        key=lambda x: x[
            "projection"
        ]["distance"]
    )

    return result[
        :END_EDGE_CANDIDATES
    ]


