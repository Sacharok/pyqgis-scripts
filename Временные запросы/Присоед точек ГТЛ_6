# ВЫБРАННУЮ ТОЧКУ НЕ ИСПОЛЬЗУЕМ
# ============================================================

calibration = []


for cp in usable_controls:

    if cp["fid"] == selected_feature.id():
        continue

    projection = project_to_path(
        cp["point"],
        path_segments
    )

    if projection is None:
        continue

    calibration.append(
        {
            "km": cp["km"],
            "chainage": projection[
                "chainage"
            ],
            "distance": projection[
                "distance"
            ]
        }
    )


if len(calibration) < MIN_CALIBRATION_POINTS:

    raise Exception(
        f"Для калибровки найдено только "
        f"{len(calibration)} соседних точек. "
        f"Нужно минимум "
        f"{MIN_CALIBRATION_POINTS}."
    )


# ============================================================
# ПРОВЕРЯЕМ ОБА НАПРАВЛЕНИЯ
# ============================================================

# Прямое:
# chainage = km * 1000 + offset

forward_offsets = [
    item["chainage"]
    -
    item["km"] * 1000.0

    for item in calibration
]

forward_offset = median(
    forward_offsets
)

forward_residuals = [
    abs(
        item["chainage"]
        -
        (
            item["km"] * 1000.0
            + forward_offset
        )
    )

    for item in calibration
]

forward_error = median(
    forward_residuals
)


# Обратное:
# chainage = offset - km * 1000

reverse_offsets = [
    item["chainage"]
    +
    item["km"] * 1000.0

    for item in calibration
]

reverse_offset = median(
    reverse_offsets
)

reverse_residuals = [
    abs(
        item["chainage"]
        -
        (
            reverse_offset
            -
            item["km"] * 1000.0
        )
    )

    for item in calibration
]

reverse_error = median(
    reverse_residuals
)


if forward_error <= reverse_error:

    direction = "ПРЯМОЕ"

    offset = forward_offset

    target_chainage = (
        selected_km * 1000.0
        + offset
    )

    residuals = forward_residuals

else:

    direction = "ОБРАТНОЕ"

    offset = reverse_offset

    target_chainage = (
        offset
        -
        selected_km * 1000.0
    )

    residuals = reverse_residuals


# ============================================================
# ПРОВЕРКА: ПОПАДАЕМ ЛИ В НАШУ ЦЕПОЧКУ
# ============================================================

