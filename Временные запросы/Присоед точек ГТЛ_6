# ============================================================
# DIJKSTRA
# ============================================================

dijkstra_cache = {}


def dijkstra(start_node):

    if start_node in dijkstra_cache:

        return dijkstra_cache[
            start_node
        ]


    distances = {
        start_node: 0.0
    }

    previous = {}

    heap = [
        (0.0, start_node)
    ]


    while heap:

        current_distance, node = (
            heapq.heappop(
                heap
            )
        )


        if (
            current_distance
            != distances.get(node)
        ):
            continue


        for edge_id in adjacency.get(
            node,
            []
        ):

            edge = edges[
                edge_id
            ]


            if edge["n1"] == node:

                other = edge["n2"]

            else:

                other = edge["n1"]


            new_distance = (
                current_distance
                + edge["length"]
            )


            if (
                other not in distances
                or
                new_distance
                < distances[other]
            ):

                distances[
                    other
                ] = new_distance

                previous[
                    other
                ] = (
                    node,
                    edge_id
                )

                heapq.heappush(
                    heap,
                    (
                        new_distance,
                        other
                    )
                )


    dijkstra_cache[
        start_node
    ] = (
        distances,
        previous
    )


    return (
        distances,
        previous
    )


# ============================================================
# ВОССТАНОВЛЕНИЕ ПУТИ
# ============================================================

def reconstruct_path_edges(
    start_node,
    end_node,
    previous
):

    if start_node == end_node:

        return []


    result = []

    current = end_node


    while current != start_node:

        if current not in previous:
            return None

        prev_node, edge_id = (
            previous[current]
        )

        result.append(
            edge_id
        )

        current = prev_node


    result.reverse()

    return result


# ============================================================
# СЕТЕВОЕ РАССТОЯНИЕ
# ОТ ПРОЕКЦИИ SEED
# ДО ПРОЕКЦИИ КОНТРОЛЬНОЙ ТОЧКИ
# ============================================================

def network_distance_between_projections(
    seed_edge_id,
    seed_projection,
    target_edge_id,
    target_projection
):

    seed_edge = edges[
        seed_edge_id
    ]

    target_edge = edges[
        target_edge_id
    ]


    # -----------------------------------------
    # ОДНО РЕБРО
    # -----------------------------------------

    if seed_edge_id == target_edge_id:

        distance = abs(
            target_projection[
                "chainage"
            ]
            -
            seed_projection[
                "chainage"
            ]
        )

        return {
            "distance": distance,
            "edge_ids": {
                seed_edge_id
            }
        }


    # -----------------------------------------
    # РАССТОЯНИЕ ОТ ПРОЕКЦИИ SEED
    # ДО ДВУХ КОНЦОВ ЕГО РЕБРА
    # -----------------------------------------

    seed_options = [
        (
            seed_edge["n1"],
            seed_projection[
                "chainage"
            ]
        ),
        (
            seed_edge["n2"],
            seed_edge["length"]
            -
            seed_projection[
                "chainage"
            ]
        )
    ]


    target_options = [
        (
            target_edge["n1"],
            target_projection[
                "chainage"
            ]
        ),
        (
            target_edge["n2"],
            target_edge["length"]
            -
            target_projection[
                "chainage"
            ]
        )
    ]


    best = None


    for seed_node, seed_part in seed_options:

        distances, previous = dijkstra(
            seed_node
        )


        for target_node, target_part in target_options:

            if target_node not in distances:
                continue


            network_part = distances[
                target_node
            ]


            total = (
                seed_part
                + network_part
                + target_part
            )


            if (
                best is None
                or
                total < best["distance"]
            ):

                path_edges = (
                    reconstruct_path_edges(
                        seed_node,
                        target_node,
                        previous
                    )
                )

                if path_edges is None:
                    continue


                used_edges = set(
                    path_edges
                )

                used_edges.add(
                    seed_edge_id
                )

                used_edges.add(
                    target_edge_id
                )


                best = {
                    "distance": total,
                    "edge_ids": used_edges
                }


    return best


