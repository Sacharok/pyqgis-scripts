# ============================================================
# ПРОЕКЦИЯ ТОЧКИ НА РЕБРО
# ============================================================

def project_point_to_edge(
    point,
    edge
):

    coords = edge[
        "coords"
    ]

    accumulated = 0.0

    best = None
    best_map_sq = None


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]


        dx = (
            p2.x()
            - p1.x()
        )

        dy = (
            p2.y()
            - p1.y()
        )


        map_sq = (
            dx * dx
            + dy * dy
        )


        if map_sq == 0:
            continue


        vx = (
            point.x()
            - p1.x()
        )

        vy = (
            point.y()
            - p1.y()
        )


        t = (
            vx * dx
            + vy * dy
        ) / map_sq


        t = max(
            0.0,
            min(1.0, t)
        )


        px = (
            p1.x()
            + t * dx
        )

        py = (
            p1.y()
            + t * dy
        )


        ddx = (
            point.x()
            - px
        )

        ddy = (
            point.y()
            - py
        )


        dist_sq = (
            ddx * ddx
            + ddy * ddy
        )


        seg_real = real_distance(
            p1,
            p2
        )


        if (
            best_map_sq is None
            or
            dist_sq < best_map_sq
        ):

            projection = QgsPointXY(
                px,
                py
            )


            best = {
                "point": projection,
                "chainage": (
                    accumulated
                    + seg_real * t
                ),
                "distance": real_distance(
                    point,
                    projection
                )
            }

            best_map_sq = dist_sq


        accumulated += seg_real


    return best


# ============================================================
# ПРИВЯЗЫВАЕМ ЛОКАЛЬНЫЙ FID
# К КОНКРЕТНОЙ ЧАСТИ ГРАФА
# ============================================================

def anchor_to_graph(
    point,
    anchor
):

    if anchor is None:
        return None


    edge_ids = edges_by_fid.get(
        anchor["fid"],
        []
    )


    best = None


    for edge_id in edge_ids:

        projection = project_point_to_edge(
            point,
            edges[edge_id]
        )


        if projection is None:
            continue


        if (
            best is None
            or
            projection["distance"]
            <
            best["projection"]["distance"]
        ):

            best = {
                "edge_id": edge_id,
                "projection": projection
            }


    return best


for cp in control_points:

    cp["graph_anchor"] = (
        anchor_to_graph(
            cp["point"],
            cp["anchor"]
        )
    )


# ============================================================
# DIJKSTRA
#
# ВАЖНО:
# начало и конец соединяются только через
# существующие узлы графа.
# Через разрыв перепрыгивания нет.
# ============================================================

def dijkstra(
    start_node,
    forbidden_edges=None
):

    if forbidden_edges is None:

        forbidden_edges = set()


    distances = {
        start_node: 0.0
    }

    previous = {}

    heap = [
        (
            0.0,
            start_node
        )
    ]


    while heap:

        current_distance, node = (
            heapq.heappop(
                heap
            )
        )


        if (
            current_distance
            != distances.get(node)
        ):

            continue


        for edge_id in adjacency.get(
            node,
            []
        ):

            if edge_id in forbidden_edges:
                continue


            edge = edges[
                edge_id
            ]


            if edge["n1"] == node:

                other = edge["n2"]

            else:

                other = edge["n1"]


            new_distance = (
                current_distance
                + edge["length"]
            )


            if (
                other not in distances
                or
                new_distance
                <
                distances[other]
            ):

                distances[
                    other
                ] = new_distance

                previous[
                    other
                ] = (
                    node,
                    edge_id
                )


                heapq.heappush(
                    heap,
                    (
                        new_distance,
                        other
                    )
                )


    return (
        distances,
        previous
    )


# ============================================================
# ВОССТАНОВЛЕНИЕ ПУТИ
# ============================================================

def reconstruct_edges(
    start_node,
    end_node,
    previous
):

    if start_node == end_node:

        return []


    current = end_node

    result = []


    while current != start_node:

        if current not in previous:

            return None


        previous_node, edge_id = (
            previous[current]
        )


        result.append(
            edge_id
        )

        current = previous_node


    result.reverse()

    return result


# ============================================================
# ПУТЬ МЕЖДУ ДВУМЯ ПРОЕКЦИЯМИ
#
# Из четырёх вариантов концов выбираем
# тот, который лучше соответствует
# ожидаемой разнице километров.
# ============================================================

def path_between_anchors(
    anchor_a,
    anchor_b,
    expected_distance
):

    edge_a_id = anchor_a[
        "edge_id"
    ]

    edge_b_id = anchor_b[
        "edge_id"
    ]


    edge_a = edges[
        edge_a_id
    ]

    edge_b = edges[
        edge_b_id
    ]


    projection_a = anchor_a[
        "projection"
    ]

    projection_b = anchor_b[
        "projection"
    ]


    # --------------------------------------------------------
    # ОБЕ ТОЧКИ НА ОДНОМ РЕБРЕ
    # --------------------------------------------------------

    if edge_a_id == edge_b_id:

        distance = abs(
            projection_b[
                "chainage"
            ]
            -
            projection_a[
                "chainage"
            ]
        )


        return {
            "distance": distance,
            "edge_ids": {
                edge_a_id
            }
        }


    # --------------------------------------------------------
    # РАССТОЯНИЕ ОТ ПРОЕКЦИИ ДО КОНЦОВ
    # --------------------------------------------------------

    options_a = [
        (
            edge_a["n1"],
            projection_a[
                "chainage"
            ]
        ),
        (
            edge_a["n2"],
            edge_a["length"]
            -
            projection_a[
                "chainage"
            ]
        )
    ]


    options_b = [
        (
            edge_b["n1"],
            projection_b[
                "chainage"
            ]
        ),
        (
            edge_b["n2"],
            edge_b["length"]
            -
            projection_b[
                "chainage"
            ]
        )
    ]


    candidates = []


    for node_a, partial_a in options_a:

        # Стартовое и конечное ребро
        # нельзя повторно использовать в сетевом пути.
        forbidden = {
            edge_a_id,
            edge_b_id
        }


        distances, previous = dijkstra(
            node_a,
            forbidden
        )


        for node_b, partial_b in options_b:

            if node_b not in distances:
                continue


            total_distance = (
                partial_a
                + distances[node_b]
                + partial_b
            )


            path_edges = reconstruct_edges(
                node_a,
                node_b,
                previous
            )


            if path_edges is None:
                continue


            all_edges = set(
                path_edges
            )

            all_edges.add(
                edge_a_id
            )

            all_edges.add(
                edge_b_id
            )


            candidates.append(
                {
                    "distance": total_distance,
                    "difference": abs(
                        total_distance
                        - expected_distance
                    ),
                    "edge_ids": all_edges
                }
            )


    if not candidates:

        return None


    # Не просто кратчайший путь.
    # Выбираем тот, чья длина лучше соответствует
    # километровым отметкам.
    candidates.sort(
        key=lambda x:
        x["difference"]
    )


    return candidates[0]


