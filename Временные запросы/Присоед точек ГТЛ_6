    )

    print(
        f"   направление: "
        f"{candidate['direction']}"
    )

    print(
        f"   медианное отклонение километража: "
        f"{candidate['median_residual'] / 1000:.3f} км"
    )

    print(
        f"   максимальное отклонение километража: "
        f"{candidate['max_residual'] / 1000:.3f} км"
    )

    print(
        f"   медианное расстояние "
        f"от старых точек до трассы: "
        f"{candidate['median_distance'] / 1000:.2f} км"
    )

