# ============================================================
# ОЦЕНКА ОДНОГО ЛОКАЛЬНОГО SEED
# ============================================================

def evaluate_seed(seed):

    seed_edge_id = seed[
        "edge_id"
    ]

    seed_projection = seed[
        "projection"
    ]


    observations = []

    union_edges = {
        seed_edge_id
    }


    # Выбранная точка имеет нулевую
    # километровую разницу относительно себя.
    selected_distance = (
        seed_projection["distance"]
    )


    for cp in control_points:

        # Саму выбранную точку отдельно
        if cp["fid"] == selected_feature.id():

            observations.append(
                {
                    "km": cp["km"],
                    "expected": 0.0,
                    "network": 0.0,
                    "residual": 0.0,
                    "perpendicular": selected_distance
                }
            )

            continue


        expected_distance = abs(
            cp["km"]
            - selected_km
        ) * 1000.0


        best_cp = None


        for target in control_candidates[
            cp["fid"]
        ]:

            network = (
                network_distance_between_projections(
                    seed_edge_id,
                    seed_projection,
                    target[
                        "edge_id"
                    ],
                    target[
                        "projection"
                    ]
                )
            )


            if network is None:
                continue


            residual = abs(
                network["distance"]
                -
                expected_distance
            )


            perpendicular = (
                target[
                    "projection"
                ]["distance"]
            )


            # -----------------------------------------
            # ВНУТРЕННЯЯ ОЦЕНКА:
            #
            # километраж важнее,
            # но географию тоже учитываем.
            # -----------------------------------------

            candidate_score = (
                residual
                +
                0.25
                * perpendicular
            )


            if (
                best_cp is None
                or
                candidate_score
                <
                best_cp["score"]
            ):

                best_cp = {
                    "score": candidate_score,
                    "network": network[
                        "distance"
                    ],
                    "residual": residual,
                    "perpendicular": perpendicular,
                    "edge_ids": network[
                        "edge_ids"
                    ]
                }


        if best_cp is None:

            # Контрольная точка
            # не объясняется этой сетью.
            continue


        union_edges.update(
            best_cp["edge_ids"]
        )


        observations.append(
            {
                "km": cp["km"],
                "expected": expected_distance,
                "network": best_cp[
                    "network"
                ],
                "residual": best_cp[
                    "residual"
                ],
                "perpendicular": best_cp[
                    "perpendicular"
                ]
            }
        )


    if not observations:

        return None


    residuals = [
        item["residual"]
        for item in observations
    ]

    perpendiculars = [
        item["perpendicular"]
        for item in observations
    ]


    median_residual = median(
        residuals
    )

    median_perpendicular = median(
        perpendiculars
    )


    # Диапазон расстояний от старых точек
    # до выбранной новой сети.
    distance_spread = (
        max(perpendiculars)
        -
        min(perpendiculars)
    )


    explained_controls = len(
        observations
    )

    missing_controls = (
        len(control_points)
        -
        explained_controls
    )


    # ====================================================
    # ГЛАВНЫЙ SCORE
    #
    # Очень важное изменение:
    #
    # выбранная точка имеет большой вес.
    #
    # Поэтому линия в 3.5 км имеет серьёзное
    # преимущество перед линией в 66 км.
    #
    # Но 30 км всё ещё допустимы,
    # если маршрут действительно так смещён.
    # ====================================================

    score = (
        2.5 * selected_distance
        +
        1.5 * median_residual
        +
        0.50 * median_perpendicular
        +
        0.50 * distance_spread
        +
        missing_controls
        * 50000.0
    )


    return {
        "score": score,
        "seed_edge_id": seed_edge_id,
        "selected_distance": selected_distance,
        "median_residual": median_residual,
        "median_perpendicular": median_perpendicular,
        "distance_spread": distance_spread,
        "explained": explained_controls,
        "missing": missing_controls,
        "observations": observations,
        "edge_ids": union_edges
    }


# ============================================================
# ПРОВЕРЯЕМ ВСЕ ЛОКАЛЬНЫЕ SEED
# ============================================================

results = []


for seed in seed_candidates:

