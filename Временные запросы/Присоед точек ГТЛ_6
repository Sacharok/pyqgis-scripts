# ============================================================
# ТОЧКА НА ЦЕПОЧКЕ ПО РЕАЛЬНОМУ РАССТОЯНИЮ
# ============================================================

def point_at_chainage(
    target,
    segments
):

    for seg in segments:

        seg_end = (
            seg["start"]
            + seg["real_len"]
        )

        if target <= seg_end:

            remaining = (
                target
                - seg["start"]
            )

            if seg["real_len"] <= 0:
                return QgsPointXY(
                    seg["p1"]
                )

            fraction = (
                remaining
                / seg["real_len"]
            )

            fraction = max(
                0.0,
                min(1.0, fraction)
            )

            x = (
                seg["p1"].x()
                +
                fraction
                * seg["dx"]
            )

            y = (
                seg["p1"].y()
                +
                fraction
                * seg["dy"]
            )

            return QgsPointXY(
                x,
                y
            )

    return QgsPointXY(
        segments[-1]["p2"]
    )


new_point = point_at_chainage(
    target_chainage,
    path_segments
)


old_point = QgsPointXY(
