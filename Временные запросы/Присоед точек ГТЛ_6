import re
import math
import heapq
from statistics import median

from qgis.core import (
    QgsProject,
    QgsGeometry,
    QgsPointXY,
    QgsDistanceArea
)


# ============================================================
# НАСТРОЙКИ
# ============================================================

POINT_LAYER_NAME = "Копия точек"
PIPE_LAYER_NAME = "pipeline_1"

POINT_NAME_FIELD = "Name"
PIPE_NAME_FIELD = "name"

# Соединяем линии только если их КОНЦЫ находятся
# не дальше этого значения друг от друга.
#
# Слои EPSG:3857.
# Начинаем с маленького допуска.
CONNECT_TOLERANCE = 5.0

# Сколько лучших вариантов выводить
TOP_CANDIDATES = 10


# ============================================================
# НОРМАЛИЗАЦИЯ НАЗВАНИЙ
# ============================================================

def normalize_name(value):

    if value is None:
        return ""

    text = str(value).strip().lower()
    text = text.replace("ё", "е")

    return re.sub(
        r"[^0-9a-zа-я]+",
        "",
        text
    )


# ============================================================
# РАЗБОР НАЗВАНИЯ ТОЧКИ
# ============================================================

def parse_point_name(value):
    """
    Работает в том числе с:

    177 км Елец-Новопсков-Североставропольская СПХГ

    ТСГ 31 км УКПГ-15-КС Ямбургская

    37,5 км КС Нюксеница-Архангельск
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.search(
        r"(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    km_text = match.group(1).replace(",", ".")
    route_name = match.group(2).strip()

    try:
        km_value = float(km_text)
    except ValueError:
        return None, None

    return km_value, route_name


# ============================================================
# ПРОВЕРКА ПУСТОГО NAME
# ============================================================

def is_empty_name(value):

    if value is None:
        return True

    text = str(value).strip().lower()

    return text in (
        "",
        "null",
        "none",
        "<null>"
    )


# ============================================================
# СЛОИ
# ============================================================

point_layers = QgsProject.instance().mapLayersByName(
    POINT_LAYER_NAME
)

pipe_layers = QgsProject.instance().mapLayersByName(
    PIPE_LAYER_NAME
)


if not point_layers:
    raise Exception(
        f"Не найден слой '{POINT_LAYER_NAME}'"
    )

if not pipe_layers:
    raise Exception(
        f"Не найден слой '{PIPE_LAYER_NAME}'"
    )


points = point_layers[0]
pipes = pipe_layers[0]


# ============================================================
# ВЫБРАННАЯ ТОЧКА
# ============================================================

selected = points.selectedFeatures()

if len(selected) != 1:

    raise Exception(
        "Для теста выдели ровно ОДНУ точку "
        "в слое 'Копия точек'."
    )


selected_point = selected[0]

selected_name = selected_point[
    POINT_NAME_FIELD
]


selected_km, selected_route = parse_point_name(
