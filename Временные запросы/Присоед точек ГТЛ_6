# ПОДГОТАВЛИВАЕМ СЕГМЕНТЫ ЦЕПОЧКИ
# ============================================================

def prepare_path_segments(
    coords
):

    segments = []

    accumulated = 0.0


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]

        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()

        map_sq = (
            dx * dx
            + dy * dy
        )

        if map_sq == 0:
            continue

        real_len = real_distance(
            p1,
            p2
        )

        segments.append(
            {
                "p1": p1,
                "p2": p2,
                "dx": dx,
                "dy": dy,
                "map_sq": map_sq,
                "real_len": real_len,
                "start": accumulated
            }
        )

        accumulated += real_len


    return segments, accumulated


path_segments, path_length = (
    prepare_path_segments(
        path_coords
    )
)


# ============================================================
# ПРОЕКЦИЯ ТОЧКИ НА СОБРАННУЮ ЦЕПОЧКУ
# ============================================================

def project_to_path(
    point,
    segments
):

    best = None
    best_map_sq = None


    for seg in segments:

        p1 = seg["p1"]

        vx = point.x() - p1.x()
        vy = point.y() - p1.y()

        t = (
            vx * seg["dx"]
            + vy * seg["dy"]
        ) / seg["map_sq"]

        t = max(
            0.0,
            min(1.0, t)
        )

        px = (
            p1.x()
            + t * seg["dx"]
        )

        py = (
            p1.y()
            + t * seg["dy"]
        )

        dx = point.x() - px
        dy = point.y() - py

        map_sq = (
            dx * dx
            + dy * dy
        )


        if (
            best_map_sq is None
            or
            map_sq < best_map_sq
        ):

            projected = QgsPointXY(
                px,
                py
            )

            best = {
                "point": projected,
                "chainage": (
                    seg["start"]
                    + t
                    * seg["real_len"]
                ),
                "distance": real_distance(
                    point,
                    projected
                )
            }

            best_map_sq = map_sq


    return best


