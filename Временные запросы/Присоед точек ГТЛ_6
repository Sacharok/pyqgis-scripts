def project_point_to_edge(
    point,
    edge
):

    coords = edge["coords"]

    accumulated = 0.0

    best = None
    best_map_sq = None


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]

        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()

        map_sq = (
            dx * dx
            + dy * dy
        )

        if map_sq == 0:
            continue

        vx = point.x() - p1.x()
        vy = point.y() - p1.y()

        t = (
            vx * dx
            + vy * dy
        ) / map_sq

        t = max(
            0.0,
            min(1.0, t)
        )

        px = p1.x() + t * dx
        py = p1.y() + t * dy

        ddx = point.x() - px
        ddy = point.y() - py

        map_dist_sq = (
            ddx * ddx
            + ddy * ddy
        )

        seg_real = real_distance(
            p1,
            p2
        )


        if (
            best_map_sq is None
            or
            map_dist_sq < best_map_sq
        ):

            projection = QgsPointXY(
                px,
                py
            )

            best = {
                "point": projection,
                "seg_index": i,
                "t": t,
                "chainage": (
                    accumulated
                    + seg_real * t
                ),
                "distance": real_distance(
                    point,
                    projection
                )
            }

            best_map_sq = (
                map_dist_sq
            )


        accumulated += seg_real


    return best


