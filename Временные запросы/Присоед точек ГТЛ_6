# ============================================================
# ПРОЕКЦИЯ ТОЧКИ НА ОДНО РЕБРО
# ============================================================

def project_point_to_edge(
    point,
    edge
):

    coords = edge[
        "coords"
    ]

    accumulated = 0.0

    best = None
    best_map_sq = None


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]


        dx = (
            p2.x()
            - p1.x()
        )

        dy = (
            p2.y()
            - p1.y()
        )


        map_sq = (
            dx * dx
            + dy * dy
        )


        if map_sq == 0:
            continue


        vx = (
            point.x()
            - p1.x()
        )

        vy = (
            point.y()
            - p1.y()
        )


        t = (
            vx * dx
            + vy * dy
        ) / map_sq


        t = max(
            0.0,
            min(1.0, t)
        )


        px = (
            p1.x()
            + t * dx
        )

        py = (
            p1.y()
            + t * dy
        )


        ddx = (
            point.x()
            - px
        )

        ddy = (
            point.y()
            - py
        )


        map_dist_sq = (
            ddx * ddx
            + ddy * ddy
        )


        seg_real = real_distance(
            p1,
            p2
        )


        if (
            best_map_sq is None
            or
            map_dist_sq
            < best_map_sq
        ):

            projected = QgsPointXY(
                px,
                py
            )


            best = {
                "point": projected,
                "seg_index": i,
                "t": t,
                "chainage": (
                    accumulated
                    + seg_real * t
                ),
                "distance": real_distance(
                    point,
                    projected
                )
            }


            best_map_sq = (
                map_dist_sq
            )


        accumulated += seg_real


    return best


# ============================================================
# ЛОКАЛЬНЫЙ FID -> КОНКРЕТНОЕ РЕБРО ГРАФА
# ============================================================

def anchor_to_graph(
    point_item,
    anchor
):

    if anchor is None:
        return None


    edge_ids = edges_by_fid.get(
        anchor["fid"],
        []
    )


    if not edge_ids:
        return None


    best = None


    for edge_id in edge_ids:

        projection = project_point_to_edge(
            point_item["point"],
            edges[edge_id]
        )


        if projection is None:
            continue


        if (
            best is None
            or
            projection["distance"]
            <
            best["projection"]["distance"]
        ):

            best = {
                "edge_id": edge_id,
                "projection": projection
            }


    return best


# ============================================================
# DIJKSTRA
# ============================================================

dijkstra_cache = {}


def dijkstra(
    start_node,
    forbidden_edges
):

    cache_key = (
        start_node,
        tuple(
            sorted(
                forbidden_edges
            )
        )
    )


    if cache_key in dijkstra_cache:

        return dijkstra_cache[
            cache_key
        ]


    distances = {
        start_node: 0.0
    }

    previous = {}


    heap = [
        (
            0.0,
            start_node
        )
    ]


    while heap:

        current_distance, node = (
            heapq.heappop(
                heap
            )
        )


        if (
            current_distance
            != distances.get(node)
        ):
            continue


        for edge_id in adjacency.get(
            node,
            []
        ):

            if edge_id in forbidden_edges:
                continue


            edge = edges[
                edge_id
            ]


            if edge["n1"] == node:

                other = edge["n2"]

            else:

                other = edge["n1"]


            new_distance = (
                current_distance
                + edge["length"]
            )


            if (
                other not in distances
                or
                new_distance
                <
                distances[other]
            ):

                distances[
                    other
                ] = new_distance


                previous[
                    other
                ] = (
                    node,
                    edge_id
                )


                heapq.heappush(
                    heap,
                    (
                        new_distance,
                        other
                    )
                )


    result = (
        distances,
        previous
    )


    dijkstra_cache[
        cache_key
    ] = result


    return result


# ============================================================
# ВОССТАНОВЛЕНИЕ СЕТЕВОГО ПУТИ
# ============================================================

def reconstruct(
    start_node,
    end_node,
    previous
):

    if start_node == end_node:

        return (
            [start_node],
            []
        )


    nodes_rev = [
        end_node
    ]

    edges_rev = []

    current = end_node


    while current != start_node:

        if current not in previous:

            return None


        previous_node, edge_id = (
            previous[
                current
            ]
        )


        edges_rev.append(
            edge_id
        )


        current = (
            previous_node
        )


        nodes_rev.append(
            current
        )


    return (
        list(
            reversed(
                nodes_rev
            )
        ),
        list(
            reversed(
                edges_rev
            )
        )
    )


# ============================================================
# ОРИЕНТАЦИЯ ГЕОМЕТРИИ РЕБРА
# ============================================================

def oriented_edge_coords(
    edge,
    from_node,
    to_node
):

    if (
        edge["n1"] == from_node
        and
        edge["n2"] == to_node
    ):

        return list(
            edge["coords"]
        )


    return list(
        reversed(
            edge["coords"]
        )
    )


# ============================================================
# ПРОЕКЦИЯ -> КОНЕЦ РЕБРА
# ============================================================

def projection_to_node_coords(
    edge,
    projection,
    node
):

    coords = edge[
        "coords"
    ]


    i = projection[
        "seg_index"
    ]


    pp = projection[
        "point"
    ]


    if node == edge["n1"]:

        result = [
            pp
        ]


        result.extend(
            reversed(
                coords[
                    :i + 1
                ]
            )
        )


        return result


    result = [
        pp
    ]


    result.extend(
        coords[
            i + 1:
        ]
    )


    return result


def node_to_projection_coords(
    edge,
    projection,
    node
):

    result = projection_to_node_coords(
        edge,
        projection,
        node
    )


    result.reverse()


    return result


# ============================================================
# ДОБАВЛЕНИЕ КООРДИНАТ В ЦЕПОЧКУ
# ============================================================

def append_coords(
    result,
    addition
):

    if not addition:
        return


    if not result:

        result.extend(
            addition
        )

        return


    first = addition[
        0
    ]


    if (
        result[-1].x()
        == first.x()
        and
        result[-1].y()
        == first.y()
    ):

        result.extend(
            addition[
                1:
            ]
        )

    else:

        result.extend(
            addition
        )


# ============================================================
# ДВЕ ТОЧКИ НА ОДНОМ РЕБРЕ
# ============================================================

def same_edge_subpath(
    edge,
    projection1,
    projection2
):

    reverse_result = False


    if (
        projection1["chainage"]
        >
        projection2["chainage"]
    ):

        projection1, projection2 = (
            projection2,
            projection1
        )

        reverse_result = True


    coords = edge[
        "coords"
    ]


    result = [
        projection1[
            "point"
        ]
    ]


    i1 = projection1[
        "seg_index"
    ]

    i2 = projection2[
        "seg_index"
    ]


    if i1 == i2:

        result.append(
            projection2[
                "point"
            ]
        )


    else:

        result.extend(
            coords[
                i1 + 1:
                i2 + 1
            ]
        )


        result.append(
            projection2[
                "point"
            ]
        )


    if reverse_result:

        result.reverse()


    return result


# ============================================================
# СТРОИМ СВЯЗАННУЮ ЦЕПОЧКУ
# МЕЖДУ ДВУМЯ КОНТРОЛЬНЫМИ ТОЧКАМИ
# ============================================================

def build_path(
    anchor_a,
    anchor_b,
    expected_distance
):

    edge_a_id = anchor_a[
        "edge_id"
    ]

    edge_b_id = anchor_b[
        "edge_id"
    ]


    edge_a = edges[
        edge_a_id
    ]

    edge_b = edges[
        edge_b_id
    ]


    pa = anchor_a[
        "projection"
    ]

    pb = anchor_b[
        "projection"
    ]


    # --------------------------------------------------------
    # ОДНО РЕБРО
    # --------------------------------------------------------

    if edge_a_id == edge_b_id:

        coords = same_edge_subpath(
            edge_a,
            pa,
            pb
        )


        return {
            "coords": coords,
            "edge_ids": {
                edge_a_id
            }
        }


    # --------------------------------------------------------
    # ПРОБУЕМ ОБА КОНЦА ОБОИХ РЁБЕР
    # --------------------------------------------------------

    options_a = [
        (
            edge_a["n1"],
            pa["chainage"]
        ),
        (
            edge_a["n2"],
            edge_a["length"]
            -
            pa["chainage"]
        )
    ]


    options_b = [
        (
            edge_b["n1"],
            pb["chainage"]
        ),
        (
            edge_b["n2"],
            edge_b["length"]
            -
            pb["chainage"]
        )
    ]


    possibilities = []


    for node_a, partial_a in options_a:

        forbidden = {
            edge_a_id,
            edge_b_id
        }


        distances, previous = dijkstra(
            node_a,
            forbidden
        )


        for node_b, partial_b in options_b:

            if node_b not in distances:
                continue


            total = (
                partial_a
                + distances[
                    node_b
                ]
                + partial_b
            )


            restored = reconstruct(
                node_a,
                node_b,
                previous
            )


            if restored is None:
                continue


            path_nodes, path_edges = (
                restored
            )


            possibilities.append(
                {
                    "difference": abs(
                        total
                        -
                        expected_distance
                    ),
                    "total": total,
                    "node_a": node_a,
                    "node_b": node_b,
                    "path_nodes": path_nodes,
                    "path_edges": path_edges
                }
            )


    if not possibilities:

        return None


    # --------------------------------------------------------
    # Важный момент:
    # среди возможных связных путей выбираем тот,
    # чья длина лучше соответствует разности
    # километровых отметок.
    # --------------------------------------------------------

    possibilities.sort(
        key=lambda x:
        x["difference"]
    )


    best = possibilities[
        0
    ]


    result_coords = []


    # Проекция A -> узел
    append_coords(
        result_coords,
        projection_to_node_coords(
            edge_a,
            pa,
            best["node_a"]
        )
    )


    # Сеть между узлами
    for i, edge_id in enumerate(
        best["path_edges"]
    ):

        edge = edges[
            edge_id
        ]


        coords = oriented_edge_coords(
            edge,
            best[
                "path_nodes"
            ][i],
            best[
                "path_nodes"
            ][i + 1]
        )


        append_coords(
            result_coords,
            coords
        )


    # Узел -> проекция B
    append_coords(
        result_coords,
        node_to_projection_coords(
            edge_b,
            pb,
            best["node_b"]
        )
    )


    used_edges = set(
        best[
            "path_edges"
        ]
    )


    used_edges.add(
        edge_a_id
    )

    used_edges.add(
        edge_b_id
    )


    return {
        "coords": result_coords,
        "edge_ids": used_edges
    }


# ============================================================
# ПОДГОТАВЛИВАЕМ СЕГМЕНТЫ СОБРАННОЙ ЦЕПОЧКИ
# ============================================================

def prepare_path_segments(
    coords
):

    segments = []

    accumulated = 0.0


    for i in range(
        len(coords) - 1
    ):

        p1 = coords[i]
        p2 = coords[i + 1]


        dx = (
            p2.x()
            - p1.x()
        )

        dy = (
            p2.y()
            - p1.y()
        )


        map_sq = (
            dx * dx
            + dy * dy
        )


        if map_sq == 0:
            continue


        real_len = real_distance(
            p1,
            p2
        )


        segments.append(
            {
                "p1": p1,
                "p2": p2,
                "dx": dx,
                "dy": dy,
                "map_sq": map_sq,
                "real_len": real_len,
                "start": accumulated
            }
        )


        accumulated += real_len


    return (
        segments,
        accumulated
    )


# ============================================================
# ПРОЕКЦИЯ ИСХОДНОЙ ТОЧКИ
# НА СОБРАННУЮ ЦЕПОЧКУ
# ============================================================

def project_to_path(
    point,
    segments
):

    best = None
    best_map_sq = None


    for seg in segments:

        p1 = seg[
            "p1"
        ]


        vx = (
            point.x()
            - p1.x()
        )

        vy = (
            point.y()
            - p1.y()
        )


        t = (
            vx * seg["dx"]
            + vy * seg["dy"]
        ) / seg["map_sq"]


        t = max(
            0.0,
            min(1.0, t)
        )


        px = (
            p1.x()
            + t * seg["dx"]
        )

        py = (
            p1.y()
            + t * seg["dy"]
        )


        dx = (
            point.x()
            - px
        )

        dy = (
            point.y()
            - py
        )


        map_sq = (
            dx * dx
            + dy * dy
        )


        if (
            best_map_sq is None
            or
            map_sq < best_map_sq
        ):

            projected = QgsPointXY(
                px,
                py
            )


            best = {
                "point": projected,
                "chainage": (
                    seg["start"]
                    + t
                    * seg["real_len"]
                ),
                "distance": real_distance(
                    point,
                    projected
                )
            }


            best_map_sq = (
                map_sq
            )


    return best


# ============================================================
# ПОЛУЧЕНИЕ ТОЧКИ ПО КИЛОМЕТРАЖУ ЦЕПОЧКИ
# ============================================================

def point_at_chainage(
    target,
    segments
):

    for seg in segments:

        seg_end = (
            seg["start"]
            + seg["real_len"]
        )


        if target <= seg_end:

            remaining = (
                target
                - seg["start"]
            )


            if seg["real_len"] <= 0:

                return QgsPointXY(
                    seg["p1"]
                )


            fraction = (
                remaining
                / seg["real_len"]
            )


            fraction = max(
                0.0,
                min(1.0, fraction)
            )


            x = (
                seg["p1"].x()
                + fraction
                * seg["dx"]
            )

            y = (
                seg["p1"].y()
                + fraction
                * seg["dy"]
            )


            return QgsPointXY(
                x,
                y
            )


    return QgsPointXY(
        segments[-1][
            "p2"
        ]
    )


