# Сколько точек этого же маршрута брать
# ДО и ПОСЛЕ выбранной точки.
#
# 3 = максимум 7 контрольных точек:
# 3 до + выбранная + 3 после.
CONTROL_POINTS_EACH_SIDE = 3

# Сколько ближайших линий рассматривать
# около первой и последней контрольной точки.
#
# Если нужная трасса в 20-30 км,
# она всё равно может попасть в кандидаты.
END_EDGE_CANDIDATES = 25

# Максимальная удалённость линии-кандидата
# от крайней контрольной точки.
# Реальные метры.
MAX_ENDPOINT_DISTANCE_M = 80000

# Концы двух объектов считаем соединёнными,
# если в координатах EPSG:3857 они ближе этого значения.
#
# Это только топологический допуск,
# не расчёт километража.
CONNECT_TOLERANCE = 5.0

# Сколько лучших вариантов показать
TOP_RESULTS = 10


# ============================================================
# НОРМАЛИЗАЦИЯ НАЗВАНИЙ
# ============================================================

def normalize_name(value):

    if value is None:
        return ""

    text = str(value).strip().lower()
    text = text.replace("ё", "е")

    return re.sub(
        r"[^0-9a-zа-я]+",
        "",
        text
    )


# ============================================================
# РАЗБОР НАЗВАНИЯ ТОЧКИ
# ============================================================

def parse_point_name(value):
    """
    Поддерживает:

    177 км Елец-Новопсков-...
    37,5 км КС Нюксеница-Архангельск
    ТСГ 31 км УКПГ-15-КС Ямбургская
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.search(
        r"(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    try:
        km = float(
            match.group(1).replace(",", ".")
        )
    except ValueError:
        return None, None

    route = match.group(2).strip()

    return km, route


def is_empty_name(value):

    if value is None:
        return True

    text = str(value).strip().lower()

    return text in (
        "",
        "null",
        "none",
        "<null>"
    )


