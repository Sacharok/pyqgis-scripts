def real_distance(p1, p2):

    return distance_area.measureLine(
        QgsPointXY(p1),
        QgsPointXY(p2)
    )


def coords_real_length(coords):

    total = 0.0

    for i in range(
        len(coords) - 1
    ):

        total += real_distance(
            coords[i],
            coords[i + 1]
        )

    return total


