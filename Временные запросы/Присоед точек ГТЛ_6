from qgis.core import (
    QgsProject,
    QgsPointXY,
    QgsDistanceArea
)

POINT_LAYER_NAME = "Копия точек"
PIPE_LAYER_NAME = "pipeline_1"

POINT_NAME_FIELD = "Name"
PIPE_NAME_FIELD = "name"

TOP_COUNT = 15


points = QgsProject.instance().mapLayersByName(
    POINT_LAYER_NAME
)[0]

pipes = QgsProject.instance().mapLayersByName(
    PIPE_LAYER_NAME
)[0]


selected = points.selectedFeatures()

if len(selected) != 1:
    raise Exception(
        "Выдели ровно одну точку в слое 'Копия точек'."
    )


point_feature = selected[0]
point_geom = point_feature.geometry()

print("")
print("=" * 90)
print("БЛИЖАЙШИЕ ОБЪЕКТЫ pipeline_1")
print("=" * 90)

print(
    f"Точка: {point_feature[POINT_NAME_FIELD]}"
)


# ----------------------------------------------------------
# QgsDistanceArea нужен, чтобы расстояния выводить
# нормально при EPSG:3857
# ----------------------------------------------------------

da = QgsDistanceArea()

da.setSourceCrs(
    pipes.crs(),
    QgsProject.instance().transformContext()
)

da.setEllipsoid("WGS84")


candidates = []


for feature in pipes.getFeatures():

    if not feature.hasGeometry():
        continue

    geom = feature.geometry()

    if geom.isEmpty():
        continue

    # Ближайшая точка на линии
    nearest_geom = geom.nearestPoint(
        point_geom
    )

    if nearest_geom.isEmpty():
        continue

    source_point = QgsPointXY(
        point_geom.asPoint()
    )

    nearest_point = QgsPointXY(
        nearest_geom.asPoint()
    )

    # Реальное расстояние
    distance_m = da.measureLine(
        source_point,
        nearest_point
    )

    raw_name = feature[
        PIPE_NAME_FIELD
    ]

    if raw_name is None:
        name = "<NULL>"
    else:
        name = str(raw_name).strip()

        if not name:
            name = "<EMPTY>"

    candidates.append(
        {
            "fid": feature.id(),
            "name": name,
            "distance": distance_m
        }
    )


candidates.sort(
    key=lambda x: x["distance"]
)


print("")

for i, item in enumerate(
    candidates[:TOP_COUNT],
    start=1
):

    print(
        f"{i:2d}. "
        f"{item['distance'] / 1000:8.3f} км | "
        f"FID={item['fid']} | "
        f"name={item['name']}"
    )


# ----------------------------------------------------------
# Для удобства выделяем 5 ближайших линий
# ----------------------------------------------------------

nearest_ids = [
    item["fid"]
    for item in candidates[:5]
]

pipes.removeSelection()
pipes.selectByIds(nearest_ids)
pipes.triggerRepaint()


print("")
print(
    "Пять ближайших объектов pipeline_1 "
    "выделены на карте."
)

print("=" * 90)
