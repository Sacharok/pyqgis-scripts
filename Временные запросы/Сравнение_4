WITH differences AS (

    /* =========================================================
       OT_Truboprovod_A
       ========================================================= */
    SELECT
        'bgd_PAO'::text AS database_name,
        'OT_Truboprovod_A'::text AS table_name,
        COALESCE(p.id, t.id) AS object_id,
        COALESCE(p.object_name, t.object_name) AS object_name,
        NULL::text AS related_id,
        CASE
            WHEN t.id IS NULL THEN 'Нет на TEST'
            WHEN p.id IS NULL THEN 'Нет на PROD'
        END AS difference
    FROM
        dblink(
            'bgd_prod',
            $$
            SELECT
                id::text,
                COALESCE(
                    to_jsonb(x)->>'naim',
                    to_jsonb(x)->>'name'
                )
            FROM public."OT_Truboprovod_A" x
            $$
        ) AS p(id text, object_name text)

    FULL JOIN

        dblink(
            'bgd_test',
            $$
            SELECT
                id::text,
                COALESCE(
                    to_jsonb(x)->>'naim',
                    to_jsonb(x)->>'name'
                )
            FROM public."OT_Truboprovod_A" x
            $$
        ) AS t(id text, object_name text)

    ON p.id = t.id

    WHERE p.id IS NULL
       OR t.id IS NULL


    UNION ALL


    /* =========================================================
       OT_Truboprovod_L
       ========================================================= */
    SELECT
        'bgd_PAO',
        'OT_Truboprovod_L',
        COALESCE(p.id, t.id),
        COALESCE(p.object_name, t.object_name),
        NULL,
        CASE
            WHEN t.id IS NULL THEN 'Нет на TEST'
            WHEN p.id IS NULL THEN 'Нет на PROD'
        END
    FROM
        dblink(
            'bgd_prod',
            $$
            SELECT
                id::text,
                COALESCE(
                    to_jsonb(x)->>'naim',
                    to_jsonb(x)->>'name'
                )
            FROM public."OT_Truboprovod_L" x
            $$
        ) AS p(id text, object_name text)

    FULL JOIN

        dblink(
            'bgd_test',
            $$
            SELECT
                id::text,
                COALESCE(
                    to_jsonb(x)->>'naim',
                    to_jsonb(x)->>'name'
                )
            FROM public."OT_Truboprovod_L" x
            $$
        ) AS t(id text, object_name text)

    ON p.id = t.id

    WHERE p.id IS NULL
       OR t.id IS NULL


    UNION ALL


    /* =========================================================
       OT_Truboprovod_P
       ========================================================= */
    SELECT
        'bgd_PAO',
        'OT_Truboprovod_P',
        COALESCE(p.id, t.id),
        COALESCE(p.object_name, t.object_name),
        NULL,
        CASE
            WHEN t.id IS NULL THEN 'Нет на TEST'
            WHEN p.id IS NULL THEN 'Нет на PROD'
        END
    FROM
        dblink(
            'bgd_prod',
            $$
            SELECT
                id::text,
                COALESCE(
                    to_jsonb(x)->>'naim',
                    to_jsonb(x)->>'name'
                )
            FROM public."OT_Truboprovod_P" x
            $$
        ) AS p(id text, object_name text)

    FULL JOIN

        dblink(
            'bgd_test',
            $$
            SELECT
                id::text,
                COALESCE(
                    to_jsonb(x)->>'naim',
                    to_jsonb(x)->>'name'
                )
            FROM public."OT_Truboprovod_P" x
            $$
        ) AS t(id text, object_name text)

    ON p.id = t.id

    WHERE p.id IS NULL
       OR t.id IS NULL


    UNION ALL


    /* =========================================================
       Pipelines
       ========================================================= */
    SELECT
        'neo_nsi',
        'Pipelines',
        COALESCE(p.id, t.id),
        COALESCE(p.object_name, t.object_name),
        NULL,
        CASE
            WHEN t.id IS NULL THEN 'Нет на TEST'
            WHEN p.id IS NULL THEN 'Нет на PROD'
        END
    FROM
        dblink(
            'nsi_prod',
            $$
            SELECT
                id::text,
                naim_tr::text
            FROM public."Pipelines"
            $$
        ) AS p(id text, object_name text)

    FULL JOIN

        dblink(
            'nsi_test',
            $$
            SELECT
                id::text,
                naim_tr::text
            FROM public."Pipelines"
            $$
        ) AS t(id text, object_name text)

    ON p.id = t.id

    WHERE p.id IS NULL
       OR t.id IS NULL


    UNION ALL


    /* =========================================================
       CompositionOfLinearObjectPipelines

       id      = объект CompositionOfLinearObject
       naim_tr = ссылка на Pipelines.id
       ========================================================= */
    SELECT
        'neo_nsi',
        'CompositionOfLinearObjectPipelines',

        COALESCE(p.object_id, t.object_id),

        COALESCE(p.pipeline_name, t.pipeline_name),

        COALESCE(p.pipeline_id, t.pipeline_id),

        CASE
            WHEN t.object_id IS NULL THEN 'Нет на TEST'
            WHEN p.object_id IS NULL THEN 'Нет на PROD'
        END

    FROM
        dblink(
            'nsi_prod',
            $$
            SELECT
                c.id::text,
                c.naim_tr::text,
                p.naim_tr::text
            FROM public."CompositionOfLinearObjectPipelines" c
            LEFT JOIN public."Pipelines" p
                ON p.id = c.naim_tr
            $$
        ) AS p(
            object_id text,
            pipeline_id text,
            pipeline_name text
        )

    FULL JOIN

        dblink(
            'nsi_test',
            $$
            SELECT
                c.id::text,
                c.naim_tr::text,
                p.naim_tr::text
            FROM public."CompositionOfLinearObjectPipelines" c
            LEFT JOIN public."Pipelines" p
                ON p.id = c.naim_tr
            $$
        ) AS t(
            object_id text,
            pipeline_id text,
            pipeline_name text
        )

    ON  p.object_id = t.object_id
    AND p.pipeline_id = t.pipeline_id

    WHERE p.object_id IS NULL
       OR t.object_id IS NULL
)

SELECT
    database_name AS "База",
    table_name AS "Таблица",
    object_id AS "ID объекта",
    object_name AS "Наименование",
    related_id AS "Связанный Pipeline ID",
    difference AS "Расхождение"
FROM differences
ORDER BY
    table_name,
    difference,
    object_name NULLS LAST,
    object_id;
