import re

from qgis.core import (
    QgsProject,
    QgsGeometry,
    QgsPointXY,
    QgsDistanceArea
)


# =========================================================
# НАСТРОЙКИ
# =========================================================

POINT_LAYER_NAME = "Копия точек"
PIPE_LAYER_NAME = "pipeline_1"

POINT_NAME_FIELD = "Name"
PIPE_NAME_FIELD = "name"

# Только предупреждение.
# Перенос не блокирует.
WARNING_DISTANCE_M = 10000


# =========================================================
# НОРМАЛИЗАЦИЯ НАЗВАНИЙ
# =========================================================

def normalize_name(value):

    if value is None:
        return ""

    value = str(value).strip().lower()
    value = value.replace("ё", "е")

    # Убираем пробелы, тире, скобки и т.д.
    value = re.sub(
        r"[^0-9a-zа-я]+",
        "",
        value
    )

    return value


# =========================================================
# РАЗБОР НАЗВАНИЯ ТОЧКИ
# =========================================================

def parse_point_name(value):
    """
    Например:

    8,7 км КС Нюксеница-Архангельск

    -> 8.7
    -> КС Нюксеница-Архангельск
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.match(
        r"^\s*(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    km_text = match.group(1).replace(",", ".")
    route_name = match.group(2).strip()

    try:
        km_value = float(km_text)
    except ValueError:
        return None, None

    return km_value, route_name


# =========================================================
# ПРИОРИТЕТ НАЗВАНИЯ
# =========================================================

def name_priority(route_norm, pipe_norm):

    # Полное совпадение
    if pipe_norm == route_norm:
        return 0

    # Вообще другой маршрут
    if not pipe_norm.startswith(route_norm):
        return None

    suffix = pipe_norm[len(route_norm):]

    if not suffix:
        return 0

    # Первая нитка
    if suffix == "1":
        return 1

    # Просто номер
    if suffix.isdigit():

        number = int(suffix)

        if number == 1:
            return 1

        return number * 10

    # Например:
    # 2ямал
    # 3резерв
    match = re.match(
        r"^(\d+)(.*)$",
        suffix
    )

    if match:

        number = int(match.group(1))
        extra = match.group(2)

        priority = number * 10

        # Дополнительное название получает штраф
        if extra:
            priority += 100

        return priority

    return 500


# =========================================================
# ПОЛУЧАЕМ СЛОИ
# =========================================================

point_layers = QgsProject.instance().mapLayersByName(
    POINT_LAYER_NAME
)

pipe_layers = QgsProject.instance().mapLayersByName(
    PIPE_LAYER_NAME
)

if not point_layers:
    raise Exception(
        f"Не найден слой '{POINT_LAYER_NAME}'"
    )

if not pipe_layers:
    raise Exception(
        f"Не найден слой '{PIPE_LAYER_NAME}'"
    )

points = point_layers[0]
pipes = pipe_layers[0]


# =========================================================
# ПРОВЕРКИ
# =========================================================

if points.fields().indexFromName(
    POINT_NAME_FIELD
) == -1:

    raise Exception(
        f"Нет поля '{POINT_NAME_FIELD}'"
    )


if pipes.fields().indexFromName(
    PIPE_NAME_FIELD
) == -1:

    raise Exception(
        f"Нет поля '{PIPE_NAME_FIELD}'"
    )


selected = points.selectedFeatures()

if not selected:
    raise Exception(
        "В слое 'Копия точек' ничего не выделено"
    )


# =========================================================
# НАСТРАИВАЕМ РЕАЛЬНЫЕ РАССТОЯНИЯ
# =========================================================

distance_area = QgsDistanceArea()

distance_area.setSourceCrs(
    pipes.crs(),
    QgsProject.instance().transformContext()
)

distance_area.setEllipsoid("WGS84")


# =========================================================
# РАБОТА С ГЕОМЕТРИЕЙ ЛИНИИ
# =========================================================

def get_line_parts(geom):
    """
    Возвращает части линии.
    Работает с LineString и MultiLineString.
    """

    if geom.isMultipart():
        return geom.asMultiPolyline()

    return [geom.asPolyline()]


def real_segment_length(p1, p2):
    """
    Реальная длина сегмента по эллипсоиду, метры.
    """

    return distance_area.measureLine(
        QgsPointXY(p1.x(), p1.y()),
        QgsPointXY(p2.x(), p2.y())
    )


def real_line_length(geom):
    """
    Реальная длина всей линии по эллипсоиду.
    """

    total = 0.0

    parts = get_line_parts(geom)

    for part in parts:

        if len(part) < 2:
            continue

        for i in range(len(part) - 1):

            total += real_segment_length(
                part[i],
                part[i + 1]
            )

    return total


def point_at_real_distance(geom, target_m):
    """
    Возвращает точку на линии на заданном
    РЕАЛЬНОМ расстоянии от начала.

    target_m задаётся в настоящих метрах,
    а не в метрах EPSG:3857.
    """

    parts = get_line_parts(geom)

    accumulated = 0.0
    last_point = None

    for part in parts:

        if not part:
            continue

        last_point = part[-1]

        if len(part) < 2:
            continue

        for i in range(len(part) - 1):

            p1 = part[i]
            p2 = part[i + 1]

            seg_length = real_segment_length(
                p1,
                p2
            )

            if seg_length <= 0:
                continue

            # Нужная отметка находится
            # внутри этого сегмента
            if accumulated + seg_length >= target_m:

                remaining = (
                    target_m - accumulated
                )

                fraction = (
                    remaining / seg_length
                )

                x = (
                    p1.x()
                    + fraction
                    * (p2.x() - p1.x())
                )

                y = (
                    p1.y()
                    + fraction
                    * (p2.y() - p1.y())
                )

                return QgsPointXY(x, y)

            accumulated += seg_length

    return last_point


def real_point_distance(p1, p2):
    """
    Реальное расстояние между двумя точками.
    """

    return distance_area.measureLine(
        QgsPointXY(p1.x(), p1.y()),
        QgsPointXY(p2.x(), p2.y())
    )


# =========================================================
# ПОДГОТАВЛИВАЕМ pipeline_1
# =========================================================

pipe_features = []

for feature in pipes.getFeatures():

    if not feature.hasGeometry():
        continue

    value = feature[PIPE_NAME_FIELD]

    if value is None:
        continue

    pipe_name = str(value).strip()
    pipe_norm = normalize_name(pipe_name)

    if not pipe_norm:
        continue

    geom = feature.geometry()

    if geom.isEmpty():
        continue

    # ВАЖНО:
    # здесь уже реальная длина, а не 3857
    line_length = real_line_length(
        geom
    )

    pipe_features.append(
        (
            feature.id(),
            pipe_name,
            pipe_norm,
            geom,
            line_length
        )
    )


print("=" * 80)
print(
    f"Выделено точек: "
    f"{len(selected)}"
)
print(
    f"Линий pipeline_1: "
    f"{len(pipe_features)}"
)
print("=" * 80)


# =========================================================
# РЕДАКТИРОВАНИЕ
# =========================================================

if not points.isEditable():
    points.startEditing()


moved_count = 0
not_found_count = 0
error_count = 0


# =========================================================
# ОСНОВНОЙ ЦИКЛ
# =========================================================

for point_feature in selected:

    print("\n" + "-" * 80)

    if not point_feature.hasGeometry():

        print(
            f"FID {point_feature.id()}: "
            f"нет геометрии"
        )

        error_count += 1
        continue


    point_name = point_feature[
        POINT_NAME_FIELD
    ]

    if point_name is None:

        print(
            f"FID {point_feature.id()}: "
            f"Name = NULL"
        )

        error_count += 1
        continue


    point_name = str(
        point_name
    ).strip()


    # =====================================================
    # КИЛОМЕТРАЖ + МАРШРУТ
    # =====================================================

    km_value, route_name = parse_point_name(
        point_name
    )

    if km_value is None:

        print(f"Точка: {point_name}")
        print(
            "Не удалось определить километраж."
        )
        print(
            "Точка НЕ перемещена."
        )

        error_count += 1
        continue


    target_m = km_value * 1000.0

    route_norm = normalize_name(
        route_name
    )

    old_point = (
        point_feature
        .geometry()
        .asPoint()
    )


    candidates = []


    # =====================================================
    # ИЩЕМ ПОДХОДЯЩИЕ ЛИНИИ
    # =====================================================

    for (
        pipe_fid,
        pipe_name,
        pipe_norm,
        pipe_geom,
        line_length
    ) in pipe_features:


        priority = name_priority(
            route_norm,
            pipe_norm
        )

        if priority is None:
            continue


        # Линия короче нужной отметки
        if line_length < target_m:
            continue


        # =================================================
        # ОТ НАЧАЛА ЛИНИИ
        # =================================================

        forward_point = point_at_real_distance(
            pipe_geom,
            target_m
        )

        if forward_point is not None:

            dist = real_point_distance(
                old_point,
                forward_point
            )

            candidates.append(
                {
                    "priority": priority,
                    "distance": dist,
                    "pipe_fid": pipe_fid,
                    "pipe_name": pipe_name,
                    "point": forward_point,
                    "direction": "от начала",
                    "line_length": line_length
                }
            )


        # =================================================
        # ОТ ДРУГОГО КОНЦА
        # =================================================

        reverse_target = (
            line_length - target_m
        )

        if reverse_target >= 0:

            reverse_point = point_at_real_distance(
                pipe_geom,
                reverse_target
            )

            if reverse_point is not None:

                dist = real_point_distance(
                    old_point,
                    reverse_point
                )

                candidates.append(
                    {
                        "priority": priority,
                        "distance": dist,
                        "pipe_fid": pipe_fid,
                        "pipe_name": pipe_name,
                        "point": reverse_point,
                        "direction": "от другого конца",
                        "line_length": line_length
                    }
                )


    # =====================================================
    # НИЧЕГО НЕ НАШЛИ
    # =====================================================

    if not candidates:

        print(f"Точка:   {point_name}")
        print(f"Маршрут: {route_name}")
        print(f"Отметка: {km_value} км")

        print(
            "Подходящей линии нет."
        )

        print(
            "Точка НЕ перемещена."
        )

        not_found_count += 1
        continue


    # =====================================================
    # СНАЧАЛА ПРИОРИТЕТ ИМЕНИ
    # =====================================================

    best_priority = min(
        x["priority"]
        for x in candidates
    )


    candidates_best_name = [
        x
        for x in candidates
        if x["priority"] == best_priority
    ]


    # =====================================================
    # ПОТОМ РЕАЛЬНОЕ РАССТОЯНИЕ
    # =====================================================

    candidates_best_name.sort(
        key=lambda x: x["distance"]
    )

    best = candidates_best_name[0]


    # =====================================================
    # ПЕРЕНОС
    # =====================================================

    new_geometry = QgsGeometry.fromPointXY(
        best["point"]
    )


    success = points.changeGeometry(
        point_feature.id(),
        new_geometry
    )


    if not success:

        print(
            f"Не удалось переместить "
            f"{point_name}"
        )

        error_count += 1
        continue


    moved_count += 1


    # =====================================================
    # ОТЧЁТ
    # =====================================================

    print(
        f"Точка:             "
        f"{point_name}"
    )

    print(
        f"Маршрут:           "
        f"{route_name}"
    )

    print(
        f"Километровая отметка: "
        f"{km_value} км"
    )

    print("")
    print(
        f"Выбрана линия:     "
        f"{best['pipe_name']}"
    )

    print(
        f"Реальная длина линии: "
        f"{best['line_length'] / 1000:.3f} км"
    )

    print(
        f"Отсчёт:            "
        f"{best['direction']}"
    )

    print(
        f"Перемещение:       "
        f"{best['distance'] / 1000:.3f} км"
    )


    if best["distance"] > WARNING_DISTANCE_M:

        print("")
        print(
            "!!! БОЛЬШОЕ ПЕРЕМЕЩЕНИЕ: "
            f"{best['distance'] / 1000:.1f} км"
        )


# =========================================================
# ОБНОВЛЯЕМ КАРТУ
# =========================================================

points.triggerRepaint()


# =========================================================
# ИТОГ
# =========================================================

print("\n" + "=" * 80)
print("ГОТОВО")
print("=" * 80)

print(
    f"Перемещено: "
    f"{moved_count}"
)

print(
    f"Не найдено: "
    f"{not_found_count}"
)

print(
    f"Ошибок: "
    f"{error_count}"
)

print("")
print(
    "Изменения автоматически НЕ сохранены."
)

print("=" * 80)
