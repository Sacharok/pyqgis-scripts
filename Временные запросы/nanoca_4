    )

    if not handle:
        continue


    geom_group = ogr_geometry_group(
        feature
    )


    color = extract_color(
        feature.GetStyleString()
        or ""
    )


    if not color:
        continue


    key = (
        str(cad_layer),
        handle,
        geom_group
    )


    source_colors[key] = color


    fallback_key = (
        str(cad_layer),
        handle
    )

    if fallback_key not in fallback_colors:
        fallback_colors[
            fallback_key
        ] = color


def get_source_color(
    feature,
    cad_layer,
    geom_group
):

    handle = clean_handle(
        feature[
            "EntityHandle"
        ]
    )


    color = source_colors.get(
        (
            cad_layer,
            handle,
            geom_group
        )
    )


    if color:
        return color


    return fallback_colors.get(
        (
            cad_layer,
            handle
        )
    )


