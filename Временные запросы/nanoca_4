def clean_handle(value):

    if value is None:
        return ""

    return str(value).strip()


def extract_color(style):

    """
    Извлекаем реальный исходный HEX
    из OGR Feature Style.
    """

    if not style:
        return None


    # Для HATCH сначала цвет заливки
    match = re.search(
        r'(?:^|[,(])fc:(#[0-9A-Fa-f]{6})',
        style
    )

    if match:
        return match.group(1).upper()


    # PEN / LABEL
    match = re.search(
        r'(?:^|[,(])c:(#[0-9A-Fa-f]{6})',
        style
    )

    if match:
        return match.group(1).upper()


    return None


def ogr_geometry_group(feature):

    subclasses = str(
        feature.GetField("SubClasses")
        or ""
    )

    style = (
        feature.GetStyleString()
        or ""
    )


    # Текст в нашем QGIS идёт
    # в точечном слое
    if (
        "AcDbText" in subclasses
        or "AcDbMText" in subclasses
        or "LABEL(" in style
    ):
        return "POINT"


    if "AcDbHatch" in subclasses:
        return "POLYGON"


    geom = feature.GetGeometryRef()

    if geom is None:
        return None


    geom_name = (
        geom.GetGeometryName()
        .upper()
    )


    if "POLYGON" in geom_name:
        return "POLYGON"

    if (
        "LINE" in geom_name
        or "CURVE" in geom_name
        or "GEOMETRYCOLLECTION" in geom_name
    ):
        return "LINE"

    if "POINT" in geom_name:
        return "POINT"


    return None


# ============================================================
# НОРМАЛИЗАЦИЯ ЦВЕТА
#
# Здесь как раз происходит сокращение оттенков.
# ============================================================

def normalize_color(hex_color):

    # Если цвет почему-либо не прочитался,
    # относим его к чёрному, а не создаём
    # отдельный класс "NO_COLOR".
    if not hex_color:
        return "black"


    value = (
        hex_color
        .replace("#", "")
        .strip()
    )


    if len(value) != 6:
        return "black"


    try:

        r = int(
            value[0:2],
            16
        ) / 255.0

        g = int(
            value[2:4],
            16
        ) / 255.0

        b = int(
            value[4:6],
            16
        ) / 255.0

    except Exception:

        return "black"


    h, s, v = colorsys.rgb_to_hsv(
        r,
        g,
        b
    )

    h *= 360.0


    # --------------------------------------------------------
    # Очень тёмные оттенки -> чёрный
    #
    # Например тёмно-серые/тёмно-синие,
    # которые визуально уже почти чёрные.
    # --------------------------------------------------------

    if v <= 0.22:
        return "black"


    # --------------------------------------------------------
    # Низкая насыщенность -> серый
    #
    # #545454
    # #989898
    # #BABABA
    # #DCDCDC
    # и подобные
    # --------------------------------------------------------

    if s <= 0.16:
        return "gray"


    # --------------------------------------------------------
    # Коричневые / оранжево-коричневые
    # --------------------------------------------------------

    if 15 <= h < 45:
        return "brown"


    # --------------------------------------------------------
    # Жёлтые
    # --------------------------------------------------------

    if 45 <= h < 75:
        return "yellow"


    # --------------------------------------------------------
    # Зелёные
    # --------------------------------------------------------

    if 75 <= h < 175:
        return "green"


    # --------------------------------------------------------
    # Голубые / бирюзовые
    # --------------------------------------------------------

    if 175 <= h < 200:
        return "cyan"


    # --------------------------------------------------------
    # Синие
    # --------------------------------------------------------

    if 200 <= h < 265:
        return "blue"


    # --------------------------------------------------------
    # Красные + розовые + пурпурные
    #
    # Специально объединяем,
    # чтобы не плодить классы.
    # --------------------------------------------------------

    return "red"


