def save_layer(
    layer,
    table_name,
    first_write=False
):

    options = (
        QgsVectorFileWriter
        .SaveVectorOptions()
    )


    options.driverName = "GPKG"

    options.fileEncoding = "UTF-8"

    options.layerName = table_name


    try:

        if first_write:

            options.actionOnExistingFile = (
                QgsVectorFileWriter
                .CreateOrOverwriteFile
            )

        else:

            options.actionOnExistingFile = (
                QgsVectorFileWriter
                .CreateOrOverwriteLayer
            )

    except AttributeError:

        if first_write:

            options.actionOnExistingFile = (
                QgsVectorFileWriter
                .ActionOnExistingFile
                .CreateOrOverwriteFile
            )

        else:

            options.actionOnExistingFile = (
                QgsVectorFileWriter
                .ActionOnExistingFile
                .CreateOrOverwriteLayer
            )


    result = (
        QgsVectorFileWriter
        .writeAsVectorFormatV3(
            layer,
            gpkg_path,
            QgsProject.instance()
            .transformContext(),
            options
        )
    )


    if (
        result[0]
        != QgsVectorFileWriter.NoError
    ):

        message = (
            result[1]
            if len(result) > 1
            else "Неизвестная ошибка"
        )

        raise Exception(
            f"Ошибка записи "
            f"{table_name}: "
            f"{message}"
        )


# ============================================================
# СТИЛЬ В QGIS
#
# Здесь уже используются ТОЛЬКО
# нормализованные цвета.
# ============================================================

def apply_normalized_renderer(
    layer,
    cad_layer
):

    if (
        layer.geometryType()
        == QgsWkbTypes.PointGeometry
    ):
        return


    categories = []


    stats = theme_stats[
        cad_layer
    ]


    for group in NORMAL_ORDER:

        if stats[group]["count"] == 0:
            continue


        code, class_name = class_map[
            (
                cad_layer,
                group
            )
        ]


        color = PALETTE[
            group
        ]["color"]


        palette_name = PALETTE[
            group
        ]["name"]


        symbol = QgsSymbol.defaultSymbol(
            layer.geometryType()
        )


        symbol.setColor(
            QColor(
                color
            )
        )


        category = QgsRendererCategory(
            code,
            symbol,
            f"{code} — {palette_name}"
        )


        categories.append(
            category
        )


    renderer = (
        QgsCategorizedSymbolRenderer(
            "class_code",
            categories
        )
    )


    layer.setRenderer(
        renderer
    )


    layer.triggerRepaint()


