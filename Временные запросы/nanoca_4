# СОЗДАЁМ И СОХРАНЯЕМ РЕЗУЛЬТАТ
# ============================================================

first_write = True

created_count = 0


for (
    cad_layer,
    base_code,
    class_name
) in THEMES:


    theme_group = main_group.addGroup(
        f"{base_code}–{base_code + 99} "
        f"— {class_name}"
    )


    # ========================================================
    # ЛИНИИ
    # ========================================================

    line_result = build_layer(
        line_src,
        cad_layer,
        "LINE",
        f"tmp_{base_code}_line"
    )


    if line_result is not None:

        table_name = (
            f"norm_{base_code}_line"
        )


        save_layer(
            line_result,
            table_name,
            first_write
        )


        first_write = False


        saved = QgsVectorLayer(
            f"{gpkg_path}"
            f"|layername={table_name}",
            "Линии",
            "ogr"
        )


        if saved.isValid():

            apply_normalized_renderer(
                saved,
                cad_layer
            )


            project.addMapLayer(
                saved,
                False
            )


            theme_group.addLayer(
                saved
            )


            created_count += 1


    # ========================================================
    # ПОЛИГОНЫ
    # ========================================================

    polygon_result = build_layer(
        polygon_src,
        cad_layer,
        "POLYGON",
        f"tmp_{base_code}_polygon"
    )


    if polygon_result is not None:

        table_name = (
            f"norm_{base_code}_polygon"
        )


        save_layer(
            polygon_result,
            table_name,
            first_write
        )


        first_write = False


        saved = QgsVectorLayer(
            f"{gpkg_path}"
            f"|layername={table_name}",
            "Полигоны",
            "ogr"
        )


        if saved.isValid():

            apply_normalized_renderer(
                saved,
                cad_layer
            )


            project.addMapLayer(
                saved,
                False
            )


            theme_group.addLayer(
                saved
            )


            created_count += 1


    # ========================================================
    # ПОДПИСИ
    # ========================================================

    label_result = build_layer(
        point_src,
        cad_layer,
        "POINT",
        f"tmp_{base_code}_label",
        True
    )


    if label_result is not None:

        table_name = (
            f"norm_{base_code}_label"
        )


        save_layer(
            label_result,
            table_name,
            first_write
        )


        first_write = False


        saved = QgsVectorLayer(
            f"{gpkg_path}"
            f"|layername={table_name}",
            "Подписи",
            "ogr"
        )


        if saved.isValid():

            setup_labels(
                saved
            )


            project.addMapLayer(
                saved,
                False
            )


            theme_group.addLayer(
                saved
            )


            created_count += 1


    # Если тематика пустая
    if len(
        theme_group.children()
    ) == 0:

        main_group.removeChildNode(
            theme_group
        )


