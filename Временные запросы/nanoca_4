def create_clean_layer(
    source,
    name,
    with_text=False
):

    geom_name = (
        QgsWkbTypes.displayString(
            source.wkbType()
        )
    )


    result = QgsVectorLayer(
        geom_name,
        name,
        "memory"
    )


    if not result.isValid():
        raise Exception(
            f"Не удалось создать "
            f"временный слой {name}"
        )


    result.setCrs(
        source.crs()
    )


    fields = [
        QgsField(
            "class_code",
            TYPE_INT
        ),

        QgsField(
            "class_name",
            TYPE_STRING,
            len=200
        )
    ]


    if with_text:

        fields.append(
            QgsField(
                "text",
                TYPE_STRING,
                len=500
            )
        )


    result.dataProvider().addAttributes(
        fields
    )

    result.updateFields()


    return result


# ============================================================
# ЗАПОЛНЯЕМ ЧИСТЫЙ СЛОЙ
# ============================================================

def build_layer(
    source,
    cad_layer,
    geom_group,
    temp_name,
    with_text=False
):

    result = create_clean_layer(
        source,
        temp_name,
        with_text
    )


    expression = (
        f'"Layer" = '
        f'{QgsExpression.quotedString(cad_layer)}'
    )


    request = QgsFeatureRequest()

    request.setFilterExpression(
        expression
    )


    output_features = []


    for feature in source.getFeatures(
        request
    ):


        # ----------------------------------------------------
        # Точки без текста нам не нужны
        # ----------------------------------------------------

        if with_text:

            value = feature[
                "Text"
            ]

            if value is None:
                continue


            text_value = str(
                value
            ).strip()


            if not text_value:
                continue


        # ----------------------------------------------------
        # Исходный цвет
        # ----------------------------------------------------

        raw_color = get_source_color(
            feature,
            cad_layer,
            geom_group
        )


        # ----------------------------------------------------
        # Нормализованный цвет
        # ----------------------------------------------------

        normal_group = normalize_color(
            raw_color
        )


        key = (
            cad_layer,
            normal_group
        )


        if key not in class_map:
            continue


        class_code, class_name = (
            class_map[key]
        )


        # ----------------------------------------------------
        # Новый объект
        # ----------------------------------------------------

        new_feature = QgsFeature(
            result.fields()
        )


        new_feature.setGeometry(
            feature.geometry()
        )


        new_feature[
            "class_code"
        ] = class_code


        new_feature[
            "class_name"
        ] = class_name


        if with_text:

            new_feature[
                "text"
            ] = text_value


        output_features.append(
            new_feature
        )


    if not output_features:
        return None


    result.dataProvider().addFeatures(
        output_features
    )


    result.updateExtents()


    return result


