SELECT
    s."Id" AS "SegmentId",
    p1."Name" AS "Начало_сегмента_БД",
    p2."Name" AS "Конец_сегмента_БД",
    wp."StartDateTime",
    wp."EndDateTime",
    wp."WorkType"
FROM "GasPipeSegments" s
JOIN "GtsPoints" p1
    ON p1."Id" = s."StartGtsPointId"
JOIN "GtsPoints" p2
    ON p2."Id" = s."EndGtsPointId"
LEFT JOIN "SegmentWorkPeriods" wp
    ON wp."GasPipeSegmentId" = s."Id"
WHERE
    p1."Name" IN (
        'КС Кущевская',
        '42 км Ростов-Майкоп',
        '40 км Ростов-Майкоп',
        '18 км Ростов-Майкоп',
        'ГИС Батайск',
        '267 км Краснодарский край-Серпухов',
        '269 км Краснодарский край-Серпухов',
        '272,5 км Краснодарский край-Серпухов',
        '277,8 км Краснодарский край-Серпухов',
        'КС Октябрьская (Ростовская область)'
    )
AND
    p2."Name" IN (
        'КС Кущевская',
        '42 км Ростов-Майкоп',
        '40 км Ростов-Майкоп',
        '18 км Ростов-Майкоп',
        'ГИС Батайск',
        '267 км Краснодарский край-Серпухов',
        '269 км Краснодарский край-Серпухов',
        '272,5 км Краснодарский край-Серпухов',
        '277,8 км Краснодарский край-Серпухов',
        'КС Октябрьская (Ростовская область)'
    )
ORDER BY
    p1."Name",
    p2."Name",
    wp."StartDateTime";
