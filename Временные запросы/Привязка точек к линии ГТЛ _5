def get_line_parts(geom):
    """
    Получаем части LineString / MultiLineString.
    """

    if geom.isMultipart():
        return geom.asMultiPolyline()

    return [geom.asPolyline()]


def real_segment_length(p1, p2):
    """
    Реальная длина одного сегмента
    по эллипсоиду в метрах.
    """

    return distance_area.measureLine(
        QgsPointXY(
            p1.x(),
            p1.y()
        ),
        QgsPointXY(
            p2.x(),
            p2.y()
        )
    )


def real_line_length(geom):
    """
    Реальная длина всей геометрии
    по эллипсоиду.
    """

    total = 0.0

    parts = get_line_parts(geom)

    for part in parts:

        if len(part) < 2:
            continue

        for i in range(
            len(part) - 1
        ):

            total += real_segment_length(
                part[i],
                part[i + 1]
            )

    return total


def point_at_real_distance(
    geom,
    target_m
):
    """
    Находит точку на линии
    на реальном расстоянии target_m
    от начала геометрии.

    target_m — настоящие метры,
    а не метры EPSG:3857.
    """

    parts = get_line_parts(geom)

    accumulated = 0.0

    for part in parts:

        if len(part) < 2:
            continue

        for i in range(
            len(part) - 1
        ):

            p1 = part[i]
            p2 = part[i + 1]

            seg_length = real_segment_length(
                p1,
                p2
            )

            if seg_length <= 0:
                continue

            # Искомая отметка находится
            # внутри текущего сегмента
            if (
                accumulated + seg_length
                >= target_m
            ):

                remaining = (
                    target_m - accumulated
                )

                fraction = (
                    remaining / seg_length
                )

                x = (
                    p1.x()
                    + fraction
                    * (
                        p2.x()
                        - p1.x()
                    )
                )

                y = (
                    p1.y()
                    + fraction
                    * (
                        p2.y()
                        - p1.y()
                    )
                )

                return QgsPointXY(
                    x,
                    y
                )

            accumulated += seg_length

    return None


def real_point_distance(
    p1,
    p2
):
    """
    Реальное расстояние между точками.
    """

    return distance_area.measureLine(
        QgsPointXY(
            p1.x(),
            p1.y()
        ),
        QgsPointXY(
            p2.x(),
            p2.y()
        )
    )


