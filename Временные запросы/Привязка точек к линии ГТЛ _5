def name_priority(route_norm, pipe_norm):
    """
    Чем МЕНЬШЕ число, тем предпочтительнее линия.

    Для точки:

        741 км Ухта-Торжок

    примерно:

        Ухта — Торжок       -> 0
        Ухта — Торжок 1     -> 1
        Ухта — Торжок 2     -> 20
        Ухта — Торжок 3     -> 30
        Ухта — Торжок 2 (Ямал) -> 120
    """

    # Полное совпадение
    if pipe_norm == route_norm:
        return 0

    # Название вообще не начинается
    # с нужного маршрута
    if not pipe_norm.startswith(route_norm):
        return None

    suffix = pipe_norm[len(route_norm):]

    if not suffix:
        return 0

    # Первая нитка
    if suffix == "1":
        return 1

    # Только номер
    if suffix.isdigit():

        number = int(suffix)

        if number == 1:
            return 1

        return number * 10

    # Номер + дополнительный текст
    #
    # Например:
    # 2ямал
    # 3резерв
    match = re.match(
        r"^(\d+)(.*)$",
        suffix
    )

    if match:

        number = int(match.group(1))
        extra = match.group(2)

        priority = number * 10

        # Дополнительный текст делает
        # этот вариант менее предпочтительным
        if extra:
            priority += 100

        return priority

    # Любой непонятный дополнительный текст
    return 500


