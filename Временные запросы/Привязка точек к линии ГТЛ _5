# =========================================================
# НОРМАЛИЗАЦИЯ НАЗВАНИЙ
# =========================================================

def normalize_name(value):
    """
    Примеры:

    Ухта — Торжок 1
    Ухта-Торжок 1

    -> ухтаторжок1
    """

    if value is None:
        return ""

    value = str(value).strip().lower()

    value = value.replace("ё", "е")

    # Оставляем только буквы и цифры
    value = re.sub(
        r"[^0-9a-zа-я]+",
        "",
        value
    )

    return value


# =========================================================
# РАЗБОР НАЗВАНИЯ ТОЧКИ
# =========================================================

def parse_point_name(value):
    """
    Например:

    37,5 км КС Нюксеница-Архангельск

    получаем:

    km_value = 37.5
    route_name = КС Нюксеница-Архангельск
    """

    if value is None:
        return None, None

    text = str(value).strip()

    match = re.match(
        r"^\s*(\d+(?:[.,]\d+)?)\s*км\b[\s\-–—]*(.+)$",
        text,
        flags=re.IGNORECASE
    )

    if not match:
        return None, None

    km_text = match.group(1)
    route_name = match.group(2).strip()

    km_text = km_text.replace(",", ".")

    try:
        km_value = float(km_text)
    except ValueError:
        return None, None

    return km_value, route_name


