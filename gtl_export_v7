            "id": point_id,
            "name": attr(gts_layer, point_feature, "Name"),
            "latitude": attr(gts_layer, point_feature, "Latitude"),
            "longitude": attr(gts_layer, point_feature, "Longitude"),
            "in_zone": in_zone,
            "out_zone": out_zone,
            "out_zone_name": out_zone_name,
