def log(message, level=Qgis.Info):
    QgsMessageLog.logMessage(str(message), LOG_TAG, level)


def clean_value(value):
    """Преобразует QVariant/QDate/QUuid и NULL к обычным Python-значениям."""
    if value is None:
        return None

    if isinstance(value, QDateTime):
        return value.toPyDateTime()

    if isinstance(value, QDate):
        return value.toPyDate()

    if isinstance(value, QUuid):
        return value.toString().strip("{}")

    if isinstance(value, float) and math.isnan(value):
        return None

    text = str(value).strip()
    if text.upper() in {"NULL", "NONE", "<NULL>"}:
        return None

    return value


def uuid_key(value):
    """Нормализованный ключ UUID/идентификатора для словарей."""
    value = clean_value(value)
    if value is None:
        return None
    return str(value).strip().strip("{}").lower()


def get_layer(name):
    """Ищет слой сначала точно, затем без учёта регистра."""
    project = QgsProject.instance()

    exact = project.mapLayersByName(name)
    if exact:
        return exact[0]

    wanted = name.casefold()
    for layer in project.mapLayers().values():
        if layer.name().casefold() == wanted:
            return layer

    return None


def get_field_map(layer):
    if layer is None:
        return {}

    layer_id = layer.id()
    if layer_id not in _FIELD_MAP_CACHE:
        _FIELD_MAP_CACHE[layer_id] = {
            field.name().casefold(): field.name()
            for field in layer.fields()
        }
    return _FIELD_MAP_CACHE[layer_id]


def attr(layer, feature, *candidates, default=None):
    """Получает атрибут по одному из возможных имён, без учёта регистра."""
    if layer is None or feature is None:
        return default

    field_map = get_field_map(layer)
    for candidate in candidates:
        actual = field_map.get(candidate.casefold())
        if actual is not None:
            value = clean_value(feature[actual])
            return default if value is None else value

    return default


def build_index(layer, *id_candidates):
    """Индексирует слой по UUID/ID."""
    result = {}
    if layer is None:
        return result

    candidates = id_candidates or ("Id", "id")
    for feature in layer.getFeatures():
        feature_id = attr(layer, feature, *candidates)
        key = uuid_key(feature_id)
        if key:
            result[key] = feature
    return result


def lookup_feature(index, value):
    return index.get(uuid_key(value))


def as_float(value):
    value = clean_value(value)
    if value is None or value == "":
        return None
    if isinstance(value, (int, float)):
        return float(value)
    try:
        return float(str(value).replace(" ", "").replace(",", "."))
    except (TypeError, ValueError):
        return None


def is_zero(value, tolerance=1e-12):
    number = as_float(value)
    return number is not None and abs(number) <= tolerance


def reference_text(value):
    """Текстовый ключ для сопоставления с исходным Excel."""
    value = clean_value(value)
    if value is None:
        return ""
    text = str(value).replace("\u00a0", " ").strip()
    text = re.sub(r"\s+", " ", text)
    return text.casefold()


def reference_number(value):
    """Числовой ключ: 4,0 / 4.0 / 4 считаются одним значением."""
    value = clean_value(value)
    if value is None or value == "":
        return ""
    if isinstance(value, bool):
        return "1" if value else "0"
    text = str(value).strip().replace(" ", "").replace(",", ".")
    try:
        number = Decimal(text)
        if number == number.to_integral():
            return str(number.quantize(Decimal("1")))
        return format(number.normalize(), "f")
    except (InvalidOperation, ValueError):
        return reference_text(value)


def reference_point(value):
    """Имя точки для сопоставления; технический префикс «ТСГ » игнорируется."""
    text = reference_text(value)
    if text.startswith("тсг "):
        text = text[4:].strip()
    return text


def strip_tsg_prefix(value):
    """Снимает только начальный служебный префикс ТСГ, сохраняя остальное написание."""
    value = clean_value(value)
    if value is None:
        return None
    text = str(value).strip()
    return re.sub(r"^ТСГ\s+", "", text, flags=re.IGNORECASE)


SEGMENT_STRUCTURAL_FIELDS = [
    "pipeline", "start_km", "start_point", "length", "end_point"
]
SEGMENT_EXTENDED_FIELDS = [
    "power", "pressure", "diameter", "state", "transgas", "remark", "region"
]
SEGMENT_ALL_ORDINARY_FIELDS = SEGMENT_STRUCTURAL_FIELDS + SEGMENT_EXTENDED_FIELDS


def segment_record_key(record, fields):
    result = []
    for field in fields:
        if field in {"start_km", "length", "power", "pressure", "diameter"}:
            result.append(reference_number(record.get(field)))
        elif field in {"start_point", "end_point"}:
            result.append(reference_point(record.get(field)))
        else:
            result.append(reference_text(record.get(field)))
    return tuple(result)


def segment_structural_key(record):
    return segment_record_key(record, SEGMENT_STRUCTURAL_FIELDS)


def segment_full_key(record):
    return segment_record_key(record, SEGMENT_ALL_ORDINARY_FIELDS)


def segment_point_pair(record):
    return tuple(sorted((
        reference_point(record.get("start_point")),
        reference_point(record.get("end_point")),
    )))


def segment_structural_key_unordered(record):
    return (
        reference_text(record.get("pipeline")),
        reference_number(record.get("start_km")),
        segment_point_pair(record),
        reference_number(record.get("length")),
    )


def segment_full_key_unordered(record):
    return segment_structural_key_unordered(record) + tuple(
        reference_number(record.get(field))
        if field in {"power", "pressure", "diameter"}
        else reference_text(record.get(field))
        for field in SEGMENT_EXTENDED_FIELDS
    )


def segment_derived_key(record):
    return (
        reference_text(record.get("pipeline")),
        segment_point_pair(record),
        reference_number(record.get("length")),
    )


def segment_endpoint_pair_key(record):
    return (
        reference_text(record.get("pipeline")),
        segment_point_pair(record),
    )


def segment_is_derived_source(record):
    return reference_text(record.get("attr_field")) in {"обратное", "кольцо"}


def segment_mismatch_fields(source, db):
    mismatches = []
    for field in SEGMENT_EXTENDED_FIELDS:
        if field in {"power", "pressure", "diameter"}:
            left = reference_number(source.get(field))
            right = reference_number(db.get(field))
        else:
            left = reference_text(source.get(field))
            right = reference_text(db.get(field))
        if left != right:
            mismatches.append(field)
    return mismatches


def normalize_source_header(value):
    if value is None:
        return ""
    return re.sub(r"\s+", " ", str(value).replace("\xa0", " ")).strip().casefold()


def detect_segment_header(row):
    headers = [normalize_source_header(v) for v in row]
    return (
        "атрибутивное поле" in headers
        and "наименование" in headers
        and "начало участка, км" in headers
        and "точка начала" in headers
        and "длина, км" in headers
        and "точка конца" in headers
    )


def make_segment_header_map(row):
    result = {}
    for idx, value in enumerate(row):
        h = normalize_source_header(value)
        if h == "атрибутивное поле":
            result["attr_field"] = idx
        elif h == "наименование":
            result["pipeline"] = idx
        elif h == "начало участка, км":
            result["start_km"] = idx
        elif h == "точка начала":
            result["start_point"] = idx
        elif h == "длина, км":
            result["length"] = idx
        elif h == "точка конца":
            result["end_point"] = idx
        elif h == "обратное направление":
            result["reverse_direction"] = idx
        elif h.startswith("мощность,"):
            result["power"] = idx
        elif h.startswith("давление,"):
            result["pressure"] = idx
        elif h.startswith("диаметр труб,"):
            result["diameter"] = idx
        elif h == "состояние газопровода":
            result["state"] = idx
        elif h == "принадлежность к трансгазу":
            result["transgas"] = idx
        elif h == "примечание":
            result["remark"] = idx
        elif h == "субъект рф":
            result["region"] = idx
        elif h.startswith("точки перемычки"):
            result["switch_flag"] = idx
    return result


def source_row_value(row, hmap, field):
    idx = hmap.get(field)
    if idx is None or idx >= len(row):
        return None
    return row[idx]


def parse_source_segment_rows(rows):
    header_index = None
    hmap = None
    for i, row in enumerate(rows[:60]):
        if detect_segment_header(row):
            header_index = i
            hmap = make_segment_header_map(row)
            break
    if header_index is None:
        raise RuntimeError("В исходном Excel не найдены заголовки листа «Сегменты».")

    required = set(SEGMENT_STRUCTURAL_FIELDS)
    missing = sorted(required - set(hmap))
    if missing:
        raise RuntimeError("В исходнике не найдены колонки: " + ", ".join(missing))

    records = []
    for source_row_number, row in enumerate(
        rows[header_index + 1:], start=header_index + 2
    ):
        record = {
            "source_row": source_row_number,
            "attr_field": source_row_value(row, hmap, "attr_field"),
            "pipeline": source_row_value(row, hmap, "pipeline"),
            "start_km": source_row_value(row, hmap, "start_km"),
            "start_point": source_row_value(row, hmap, "start_point"),
            "length": source_row_value(row, hmap, "length"),
            "end_point": source_row_value(row, hmap, "end_point"),
            "reverse_direction": source_row_value(row, hmap, "reverse_direction"),
            "power": source_row_value(row, hmap, "power"),
            "pressure": source_row_value(row, hmap, "pressure"),
            "diameter": source_row_value(row, hmap, "diameter"),
            "state": source_row_value(row, hmap, "state"),
            "transgas": source_row_value(row, hmap, "transgas"),
            "remark": source_row_value(row, hmap, "remark"),
            "region": source_row_value(row, hmap, "region"),
            "switch_flag": source_row_value(row, hmap, "switch_flag"),
        }
        if not reference_text(record["pipeline"]):
            continue
        if not reference_text(record["start_point"]) and not reference_text(record["end_point"]):
            continue
        records.append(record)
    return records


def load_source_segment_records(path):
    wb = load_workbook(path, read_only=True, data_only=True)
    try:
        sheets = []
        if "Сегменты" in wb.sheetnames:
            sheets.append(wb["Сегменты"])
        sheets.extend(ws for ws in wb.worksheets if ws.title != "Сегменты")
        last_error = None
        for ws in sheets:
            rows = [list(row) for row in ws.iter_rows(values_only=True)]
            try:
                return parse_source_segment_rows(rows), ws.title
            except RuntimeError as exc:
                last_error = exc
        raise last_error or RuntimeError("Лист «Сегменты» не найден.")
    finally:
        wb.close()


def load_source_coordinate_rows(path):
    """Возвращает строки исходного листа координат по нормализованному имени."""
    wb = load_workbook(path, read_only=True, data_only=True)
    try:
        candidates = []
        if "Координаты отдельных объектов" in wb.sheetnames:
            candidates.append(wb["Координаты отдельных объектов"])
        candidates.extend(
            ws for ws in wb.worksheets
            if ws.title != "Координаты отдельных объектов"
        )

        for ws in candidates:
            rows = [list(row) for row in ws.iter_rows(values_only=True)]
            header_index = None
            hmap = {}
            for i, row in enumerate(rows[:60]):
                for j, value in enumerate(row):
                    h = normalize_source_header(value)
                    if h == "атрибутивное поле":
                        hmap["attr_field"] = j
                    elif h == "наименование":
                        hmap["name"] = j
                    elif "широта" in h and "wgs" in h and "84" in h:
                        hmap["latitude"] = j
                    elif "долгота" in h and "wgs" in h and "84" in h:
                        hmap["longitude"] = j
                if {"name", "latitude", "longitude"}.issubset(hmap):
                    header_index = i
                    break
                hmap = {}
            if header_index is None:
                continue

            result = {}
            for row in rows[header_index + 1:]:
                def get(field):
                    idx = hmap.get(field)
                    return row[idx] if idx is not None and idx < len(row) else None
                name = get("name")
                if not reference_text(name):
                    continue
                result.setdefault(reference_text(name), {
                    "attr_field": get("attr_field"),
                    "name": name,
                    "latitude": get("latitude"),
                    "longitude": get("longitude"),
                })
            return result
        return {}
    finally:
        wb.close()


def build_segment_db_records(
    segment_layer, gts_layer, gts_index, pipeline_layer, pipeline_index,
    transgas_layer, transgas_index, region_layer, region_index
):
    records = []
    for feature in segment_layer.getFeatures():
        segment_id = attr(segment_layer, feature, "Id", "id")
        start_id = attr(segment_layer, feature, "StartGtsPointId")
        end_id = attr(segment_layer, feature, "EndGtsPointId")
        pipeline_id = attr(segment_layer, feature, "GasPipelineId")
        transgas_id = attr(segment_layer, feature, "TransGasId")
        region_id = attr(segment_layer, feature, "RegionId")

        records.append({
            "feature": feature,
            "segment_id": segment_id,
            "pipeline": display_value(pipeline_layer, pipeline_index, pipeline_id, "Name", "naim"),
            "start_km": attr(segment_layer, feature, "StartKilometer"),
            "start_point": display_value(gts_layer, gts_index, start_id, "Name", "naim"),
            "length": attr(segment_layer, feature, "Length"),
            "end_point": display_value(gts_layer, gts_index, end_id, "Name", "naim"),
            "power": attr(segment_layer, feature, "Power"),
            "pressure": attr(segment_layer, feature, "Pressure"),
            "diameter": attr(segment_layer, feature, "Diameter"),
            "state": attr(segment_layer, feature, "State"),
            "transgas": display_value(transgas_layer, transgas_index, transgas_id, "Name", "naim"),
            "remark": attr(segment_layer, feature, "Remark"),
            "region": display_value(region_layer, region_index, region_id, "Name", "naim"),
        })
    return records


def match_source_segments(source_records, db_records):
    ordered_full_pool = defaultdict(list)
    unordered_full_pool = defaultdict(list)
    ordered_struct_pool = defaultdict(list)
    unordered_struct_pool = defaultdict(list)
    derived_pool = defaultdict(list)
    endpoint_pool = defaultdict(list)

    for db_idx, db in enumerate(db_records):
        ordered_full_pool[segment_full_key(db)].append(db_idx)
        unordered_full_pool[segment_full_key_unordered(db)].append(db_idx)
        ordered_struct_pool[segment_structural_key(db)].append(db_idx)
        unordered_struct_pool[segment_structural_key_unordered(db)].append(db_idx)
        derived_pool[segment_derived_key(db)].append(db_idx)
        endpoint_pool[segment_endpoint_pair_key(db)].append(db_idx)

    used_db = set()
    results = [None] * len(source_records)

    def numeric_distance(a, b):
        aa = as_float(a)
        bb = as_float(b)
        if aa is None or bb is None:
            return 1e100
        return abs(aa - bb)

    def choose_unique(candidates, src, allow_used=False):
        if not allow_used:
            candidates = [i for i in candidates if i not in used_db]
        if not candidates:
            return None, [], 0

        scored = []
        for db_idx in candidates:
            mismatches = segment_mismatch_fields(src, db_records[db_idx])
            scored.append((len(mismatches), db_idx, mismatches))
        scored.sort(key=lambda x: (x[0], str(db_records[x[1]].get("segment_id") or "")))

        best_score = scored[0][0]
        best = [item for item in scored if item[0] == best_score]
        if len(best) == 1 or best_score == 0:
            return best[0][1], best[0][2], len(candidates)

        signatures = {segment_full_key_unordered(db_records[item[1]]) for item in best}
        if len(signatures) == 1:
            return best[0][1], best[0][2], len(candidates)
        return None, [], len(candidates)

    def choose_by_endpoints(candidates, src):
        free = [i for i in candidates if i not in used_db]
        pool = free if free else list(candidates)
        if not pool:
            return None, [], 0, False

        src_a = reference_point(src.get("start_point"))
        src_b = reference_point(src.get("end_point"))
        scored = []
        for db_idx in pool:
            db = db_records[db_idx]
            db_a = reference_point(db.get("start_point"))
            db_b = reference_point(db.get("end_point"))
            same_order = src_a == db_a and src_b == db_b
            mismatches = segment_mismatch_fields(src, db)
            score = (
                len(mismatches),
                numeric_distance(src.get("start_km"), db.get("start_km")),
                numeric_distance(src.get("length"), db.get("length")),
                0 if same_order else 1,
                str(db.get("segment_id") or ""),
            )
            scored.append((score, db_idx, mismatches))
        scored.sort(key=lambda x: x[0])
        chosen = scored[0]
        return chosen[1], chosen[2], len(candidates), chosen[1] in used_db

    # Обычные физические строки.
    for src_idx, src in enumerate(source_records):
        if segment_is_derived_source(src):
            continue

        checks = [
            ("ТОЧНО_ПОРЯДОК", ordered_full_pool.get(segment_full_key(src), [])),
            ("ТОЧНО_РАЗВОРОТ", unordered_full_pool.get(segment_full_key_unordered(src), [])),
            ("РЕЗЕРВ_ПОРЯДОК", ordered_struct_pool.get(segment_structural_key(src), [])),
            ("РЕЗЕРВ_РАЗВОРОТ", unordered_struct_pool.get(segment_structural_key_unordered(src), [])),
        ]
        matched = False
        for status, candidates in checks:
            db_idx, mismatches, count = choose_unique(candidates, src)
            if db_idx is not None:
                used_db.add(db_idx)
                results[src_idx] = {
                    "status": status, "db_idx": db_idx,
                    "mismatches": mismatches, "candidate_count": count,
                }
                matched = True
                break
        if matched:
            continue

        candidates = endpoint_pool.get(segment_endpoint_pair_key(src), [])
        db_idx, mismatches, count, reused = choose_by_endpoints(candidates, src)
        if db_idx is not None:
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "ПО_ТОЧКАМ_ПОВТОР" if reused else "ПО_ТОЧКАМ",
                "db_idx": db_idx, "mismatches": mismatches,
                "candidate_count": count,
            }
        else:
            results[src_idx] = {
                "status": "НЕ НАЙДЕНО", "db_idx": None,
                "mismatches": [], "candidate_count": 0,
            }

    # Производные строки «Обратное» / «кольцо».
    for src_idx, src in enumerate(source_records):
        if not segment_is_derived_source(src):
            continue

        candidates = derived_pool.get(segment_derived_key(src), [])
        if candidates:
            used_candidates = [i for i in candidates if i in used_db]
            pool = used_candidates if used_candidates else candidates
            db_idx, mismatches, count = choose_unique(pool, src, allow_used=True)
            if db_idx is not None:
                was_used = db_idx in used_db
                used_db.add(db_idx)
                results[src_idx] = {
                    "status": "ПРОИЗВОДНАЯ_ПОВТОР" if was_used else "ПРОИЗВОДНАЯ_СЕГМЕНТ",
                    "db_idx": db_idx, "mismatches": mismatches,
                    "candidate_count": len(candidates),
                }
                continue

        candidates = endpoint_pool.get(segment_endpoint_pair_key(src), [])
        db_idx, mismatches, count, reused = choose_by_endpoints(candidates, src)
        if db_idx is not None:
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "ПРОИЗВОДНАЯ_ПО_ТОЧКАМ",
                "db_idx": db_idx, "mismatches": mismatches,
                "candidate_count": count,
            }
        else:
            results[src_idx] = {
                "status": "НЕ НАЙДЕНО", "db_idx": None,
                "mismatches": [], "candidate_count": 0,
            }

    return results, used_db


def excel_flag(value):
    """1/0 из исходного текста превращает в число Excel."""
    if value in (None, ""):
        return None
    text = str(value).strip()
    if text == "1":
        return 1
    if text == "0":
        return 0
    return value


def leading_km_from_point_name(value):
    value = clean_value(value)
    if value is None:
        return None
    match = re.match(
        r"^\s*(-?\d+(?:[.,]\d+)?)\s*км\b",
        str(value),
        flags=re.IGNORECASE,
    )
    return as_float(match.group(1)) if match else None


def bool_ru(value):
    value = clean_value(value)
    if value is None:
        return None
    if isinstance(value, bool):
        return "ИСТИНА" if value else "ЛОЖЬ"

    text = str(value).strip().casefold()
    if text in {"true", "1", "да", "истина"}:
        return "ИСТИНА"
    if text in {"false", "0", "нет", "ложь"}:
        return "ЛОЖЬ"
    return str(value)


def work_type_number(value):
    """В Excel: 0 — ремонт, 1 — обратное направление."""
    value = clean_value(value)
    if value is None:
        return None
    if isinstance(value, bool):
        return 1 if value else 0
    text = str(value).strip().casefold()
    if text in {"true", "1", "да", "истина"}:
        return 1
    if text in {"false", "0", "нет", "ложь"}:
        return 0
    return value


def display_value(layer, index, foreign_id, *field_candidates, default=None):
    feature = lookup_feature(index, foreign_id)
    if feature is None:
        return default
    return attr(layer, feature, *field_candidates, default=default)


def split_connections(value):
    value = clean_value(value)
    if value is None:
        return []
    parts = re.split(r"\s*;\s*", str(value))
    return [part.strip() for part in parts if part and part.strip()]


_CONNECTION_KM_FIRST = re.compile(
    r"^(?:(?:ТСГ|ГРС|ГИС|БП|ПХГ)\s+)?"
    r"(?P<km>-?\d+(?:[.,]\d+)?)\s*км\s+"
    r"(?P<pipeline>.+?)\s*$",
    flags=re.IGNORECASE,
)

_CONNECTION_PIPELINE_FIRST = re.compile(
    r"^(?P<pipeline>.+?)\s*\+\s*"
    r"(?P<km>-?\d+(?:[.,]\d+)?)\s*км\s*$",
    flags=re.IGNORECASE,
)


def parse_connection(value):
    """
    Возвращает (газопровод, километр, исходный_текст).
    При невозможности разобрать газопровод/километр сохраняет исходный текст.
    """
    if value is None:
        return None, None, None

    text = str(value).strip()
    if not text:
        return None, None, None

    match = _CONNECTION_KM_FIRST.match(text)
    if not match:
        match = _CONNECTION_PIPELINE_FIRST.match(text)

    if not match:
        return None, None, text

    km = as_float(match.group("km"))
    pipeline = match.group("pipeline").strip()
    return pipeline, km, text


def choose_connection(connection_text, target_name=None):
    """
    Выбирает из текста через ';' подключение, наиболее похожее на название ТСГ.
    """
    parts = split_connections(connection_text)
    if not parts:
        return None

    if not target_name:
        return parts[0]

    target = re.sub(r"\s+", " ", str(target_name).strip()).casefold()

    for part in parts:
        normalized = re.sub(r"\s+", " ", part).casefold()
        if normalized == target:
            return part

    for part in parts:
        normalized = re.sub(r"\s+", " ", part).casefold()
        if target in normalized or normalized in target:
            return part

    return parts[0]


def date_difference_days(start_value, end_value):
    """Разница дат в днях либо None."""
    start_value = clean_value(start_value)
    end_value = clean_value(end_value)

    if isinstance(start_value, datetime):
        start_value = start_value.date()
    if isinstance(end_value, datetime):
        end_value = end_value.date()

    if not isinstance(start_value, date) or not isinstance(end_value, date):
        return None

    return (end_value - start_value).days


def period_sort_key(value):
    value = clean_value(value)
    if value is None:
        return (0, "")
    return (1, str(value))


def build_period_routes(period_edges, point_types, add_error):
    """
    Разбивает периодные сегменты на логические маршруты.

    Главный принцип версии 4:
    маршрут строится не до самого дальнего тупика, а между граничными точками.

    Граничная точка — это:
    1) начало или конец сети;
    2) узел ветвления или соединения;
    3) значимый объект: КС, ГРС, ГИС, ПХГ, БП или ТСГ.

    Поэтому длинная цепочка:
        КС-1 -> техническая точка -> КС-2 -> техническая точка -> КС-3
    превращается в два маршрута:
        КС-1 -> КС-2
        КС-2 -> КС-3

    Повторение одинакового названия точки разрешено.
    Уникальность определяется UUID, а не текстом названия.
    """
    groups = defaultdict(list)

    for edge in period_edges:
        key = (
            uuid_key(edge["pipeline_id"]),
            edge["start_date"],
            edge["end_date"],
            edge["work_type"],
            str(edge["remark"] or "").strip(),
        )
        groups[key].append(edge)

    routes = []

    def edge_key(edge):
        period_id = uuid_key(edge["period_id"])
        if period_id:
            return period_id
        return (
            f"{uuid_key(edge['segment_id'])}|"
            f"{edge['start_date']}|{edge['end_date']}|"
            f"{edge['work_type']}|{edge['remark']}"
        )

    def types_text(node_id):
        values = sorted(point_types.get(node_id, set()))
        return ", ".join(values)

    for group_key, edges in groups.items():
        by_start = defaultdict(list)
        by_end = defaultdict(list)
        edge_by_key = {}

        for edge in edges:
            start_key = uuid_key(edge["start_id"])
            end_key = uuid_key(edge["end_id"])
            by_start[start_key].append(edge)
            by_end[end_key].append(edge)
            edge_by_key[edge_key(edge)] = edge

        def edge_sort_key(edge):
            km = as_float(edge.get("start_km"))
            return (
                km if km is not None else 0,
                str(edge.get("start_name") or ""),
                str(edge.get("end_name") or ""),
                str(edge.get("period_id") or ""),
            )

        for values in by_start.values():
            values.sort(key=edge_sort_key)

        nodes = set(by_start) | set(by_end)

        def is_boundary(node_id):
            if node_id is None:
                return True
            in_degree = len(by_end.get(node_id, []))
            out_degree = len(by_start.get(node_id, []))
            return (
                in_degree != 1
                or out_degree != 1
                or bool(point_types.get(node_id))
            )

        def boundary_reason(node_id):
            reasons = []
            in_degree = len(by_end.get(node_id, []))
            out_degree = len(by_start.get(node_id, []))
            node_types = types_text(node_id)

            if node_types:
                reasons.append(f"значимый объект: {node_types}")
            if in_degree == 0:
                reasons.append("начало сети")
            if out_degree == 0:
                reasons.append("конец сети")
            if in_degree > 1 and out_degree > 1:
                reasons.append("узел соединения и ветвления")
            elif in_degree > 1:
                reasons.append("узел соединения")
            elif out_degree > 1:
                reasons.append("узел ветвления")

            return "; ".join(reasons) or "граница маршрута"

        boundary_nodes = {node for node in nodes if is_boundary(node)}
        covered = set()
        group_paths = []

        def save_path(path, start_reason=None, end_reason=None):
            if not path:
                return

            signature = tuple(edge_key(edge) for edge in path)
            if signature in {
                tuple(edge_key(edge) for edge in existing["path"])
                for existing in group_paths
            }:
                return

            for key in signature:
                covered.add(key)

            group_paths.append({
                "path": path,
                "start_reason": start_reason or boundary_reason(
                    uuid_key(path[0]["start_id"])
                ),
                "end_reason": end_reason or boundary_reason(
                    uuid_key(path[-1]["end_id"])
                ),
            })

        # Маршруты, начинающиеся в каждой граничной точке.
        ordered_boundaries = sorted(
            boundary_nodes,
            key=lambda node: (
                str(
                    by_start.get(node, [{}])[0].get("start_name", "")
                    if by_start.get(node)
                    else ""
                ),
                str(node or ""),
            ),
        )

        for start_node in ordered_boundaries:
            for first_edge in by_start.get(start_node, []):
                first_key = edge_key(first_edge)
                if first_key in covered:
                    continue

                path = [first_edge]
                used = {first_key}
                current_node = uuid_key(first_edge["end_id"])

                while current_node not in boundary_nodes:
                    candidates = [
                        candidate
                        for candidate in by_start.get(current_node, [])
                        if edge_key(candidate) not in used
                    ]

                    if len(candidates) != 1:
                        break

                    next_edge = candidates[0]
                    next_key = edge_key(next_edge)
                    path.append(next_edge)
                    used.add(next_key)
                    current_node = uuid_key(next_edge["end_id"])

                save_path(
                    path,
                    start_reason=boundary_reason(start_node),
                    end_reason=boundary_reason(current_node),
                )

        # Остатки: циклы или компоненты без естественной границы.
        for first_edge in sorted(edges, key=edge_sort_key):
            first_key = edge_key(first_edge)
            if first_key in covered:
                continue

            path = []
            used = set()
            current_edge = first_edge

            while current_edge is not None:
                current_key = edge_key(current_edge)
                if current_key in used:
                    break

                used.add(current_key)
                path.append(current_edge)
                next_node = uuid_key(current_edge["end_id"])

                if next_node in boundary_nodes and len(path) > 0:
                    break

                candidates = [
                    candidate
                    for candidate in by_start.get(next_node, [])
                    if edge_key(candidate) not in used
                ]

                current_edge = candidates[0] if len(candidates) == 1 else None

            save_path(
                path,
                start_reason="цикл или компонент без естественного начала",
                end_reason="цикл или компонент без естественного конца",
            )

        # Контроль: каждый сегмент группы должен войти хотя бы в один маршрут.
        not_covered = [
            key for key in edge_by_key
            if key not in covered
        ]
        if not_covered:
            add_error(
                "Периоды",
                group_key[0] or "",
                "Не включены сегменты",
                f"В маршруты не включено сегментов: {len(not_covered)}.",
            )

        for route_number, item in enumerate(group_paths, start=1):
            path = item["path"]
            first_edge = path[0]
            last_edge = path[-1]
            start_key = uuid_key(first_edge["start_id"])
            end_key = uuid_key(last_edge["end_id"])

            routes.append({
                "route_number_in_group": route_number,
                "pipeline_id": first_edge["pipeline_id"],
                "pipeline_name": first_edge["pipeline_name"],
                "start_id": first_edge["start_id"],
                "end_id": last_edge["end_id"],
                "start_name": first_edge["start_name"],
                "end_name": last_edge["end_name"],
                "start_types": types_text(start_key),
                "end_types": types_text(end_key),
                "start_reason": item["start_reason"],
                "end_reason": item["end_reason"],
                "start_date": first_edge["start_date"],
                "end_date": first_edge["end_date"],
                "work_type": first_edge["work_type"],
                "remark": first_edge["remark"],
                "segment_count": len(path),
                "period_ids": [edge["period_id"] for edge in path],
                "segment_ids": [edge["segment_id"] for edge in path],
            })

    routes.sort(
        key=lambda route: (
            period_sort_key(route["start_date"]),
            period_sort_key(route["end_date"]),
            str(route["pipeline_name"] or ""),
            str(route["start_name"] or ""),
            str(route["end_name"] or ""),
            route["route_number_in_group"],
        )
    )
    return routes


def build_work_mode_routes(period_routes):
    """
    Формирует лист 'Режим работы' как перечень уникальных логических маршрутов.

    В отличие от 'ЗимаЛето', здесь один и тот же маршрут не повторяется
    для каждого сезонного периода. Уникальность:
    газопровод + UUID начала + UUID конца + WorkType + Remark.

    Если у маршрута несколько разных пар дат, даты на листе
    'Режим работы' оставляются пустыми. Все периоды остаются видны
    на листе 'ЗимаЛето' и на контрольном листе.
    """
    grouped = {}

    for route in period_routes:
        key = (
            uuid_key(route["pipeline_id"]),
            uuid_key(route["start_id"]),
            uuid_key(route["end_id"]),
            route["work_type"],
            str(route["remark"] or "").strip(),
        )

        if key not in grouped:
            grouped[key] = {
                **route,
                "period_pairs": set(),
                "occurrence_count": 0,
            }

        grouped[key]["period_pairs"].add(
            (route["start_date"], route["end_date"])
        )
        grouped[key]["occurrence_count"] += 1

    result = []

    for route in grouped.values():
        pairs = route["period_pairs"]

        if len(pairs) == 1:
            start_date, end_date = next(iter(pairs))
        else:
            start_date, end_date = None, None

        item = dict(route)
        item["start_date"] = start_date
        item["end_date"] = end_date
        item["period_variant_count"] = len(pairs)
        result.append(item)

    result.sort(
        key=lambda route: (
            str(route["pipeline_name"] or ""),
            str(route["start_name"] or ""),
            str(route["end_name"] or ""),
            str(route["remark"] or ""),
        )
    )
    return result


def create_sheet(workbook, name, title, headers):
    worksheet = workbook.create_sheet(title=name)
    worksheet.sheet_view.showGridLines = False

    last_col = get_column_letter(len(headers))
    worksheet.merge_cells(f"A1:{last_col}1")
    worksheet["A1"] = title
    worksheet["A1"].font = Font(name="Calibri", size=13, bold=True)
    worksheet["A1"].alignment = Alignment(horizontal="center", vertical="center")
    worksheet.row_dimensions[1].height = 24

    header_fill = PatternFill("solid", fgColor="1F4E78")
    header_font = Font(name="Calibri", size=10, bold=True, color="FFFFFF")
    thin = Side(style="thin", color="B7C9D6")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    for column, header in enumerate(headers, start=1):
        cell = worksheet.cell(row=2, column=column, value=header)
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )
        cell.border = border

    worksheet.freeze_panes = "A3"
    worksheet.row_dimensions[2].height = 42
    return worksheet


def append_row(worksheet, values):
    worksheet.append([clean_value(value) for value in values])


def finalize_sheet(worksheet, max_width=42):
    """Базовое форматирование после заполнения."""
    thin = Side(style="thin", color="D9E2F3")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    max_row = worksheet.max_row
    max_column = worksheet.max_column

    if max_row >= 2 and max_column >= 1:
        worksheet.auto_filter.ref = (
            f"A2:{get_column_letter(max_column)}{max_row}"
        )

    # Ограничиваем расчёт ширины первыми 1000 строками.
    scan_to = min(max_row, 1002)
    for column in range(1, max_column + 1):
        width = 10
        for row in range(1, scan_to + 1):
            value = worksheet.cell(row=row, column=column).value
            if value is None:
                continue
            length = max(
                (len(line) for line in str(value).splitlines()),
                default=0,
            )
            width = max(width, min(length + 2, max_width))
        worksheet.column_dimensions[get_column_letter(column)].width = width

    for row in worksheet.iter_rows(min_row=3, max_row=max_row):
        for cell in row:
            cell.alignment = Alignment(vertical="top", wrap_text=True)
            cell.border = border

            if isinstance(cell.value, datetime):
                cell.number_format = "DD.MM.YYYY HH:MM"
            elif isinstance(cell.value, date):
                cell.number_format = "DD.MM.YYYY"

    # Немного сужаем служебный первый столбец.
    worksheet.column_dimensions["A"].width = min(
        worksheet.column_dimensions["A"].width or 14,
        22,
    )


