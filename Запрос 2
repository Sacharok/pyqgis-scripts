SELECT
    table_name,
    ordinal_position,
    column_name,
    data_type,
    is_nullable,
    column_default
FROM information_schema.columns
WHERE table_schema = 'public'
  AND table_name IN (
      'CableRoutes',
      'AirLines',
      'NodesOfAccountingLiquidAndGaseousHydrocarbons'
  )
ORDER BY table_name, ordinal_position;


SELECT 'AirLines.klass_napr' AS field_name,
       klass_napr AS field_value,
       count(*) AS cnt
FROM public."OE_VozdushnyeLinii_L"
GROUP BY klass_napr

UNION ALL

SELECT 'AirLines.status',
       status,
       count(*)
FROM public."OE_VozdushnyeLinii_L"
GROUP BY status

UNION ALL

SELECT 'Nodes.sist_podgt',
       sist_podgt,
       count(*)
FROM public."OT_UzlyUchtUglvdrd_P"
GROUP BY sist_podgt

UNION ALL

SELECT 'Nodes.un_mest',
       un_mest,
       count(*)
FROM public."OT_UzlyUchtUglvdrd_P"
GROUP BY un_mest

UNION ALL

SELECT 'Nodes.osn_srdstv',
       osn_srdstv,
       count(*)
FROM public."OT_UzlyUchtUglvdrd_P"
GROUP BY osn_srdstv

UNION ALL

SELECT 'Nodes.obekt_str',
       obekt_str,
       count(*)
FROM public."OT_UzlyUchtUglvdrd_P"
GROUP BY obekt_str

ORDER BY field_name, field_value;
