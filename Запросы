WITH phg AS (
    SELECT u."Id"
    FROM "UndergroundGasStorages" u
    JOIN "GtsPoints" p
        ON p."Id" = u."Id"
    WHERE p."Name" ILIKE '%Аманское%'
)
SELECT
    s."StartKilometer",
    s."Length",

    CASE
        WHEN s."StartGtsPointId" = phg."Id"
            THEN s."StartKilometer"
        ELSE s."StartKilometer" + s."Length"
    END AS possible_connection_km

FROM phg
JOIN "GasPipeSegments" s
    ON s."StartGtsPointId" = phg."Id"
    OR s."EndGtsPointId" = phg."Id";

