-- заполнение значений Опасных производственных объектов с заменой на uuid --
update public."Pipelines" target
set opo = relation.id
from dblink('host= port= dbname= user= password=',
	'select id, nomer_opo, naim_opo from public."OT_Truboprovod_L_klass_prav" where nomer_opo is not null or naim_opo is not null')
as source(id uuid, nomer_opo varchar(255), naim_opo varchar(255))
join public."DangerousIndustrialFacilities" relation 
on (source.nomer_opo is not null and source.naim_opo is not null
and relation.nomer_opo = source.nomer_opo
and relation.naim_opo = source.naim_opo)

or (source.nomer_opo is not null and source.naim_opo is null
and relation.nomer_opo = source.nomer_opo
and relation.naim_opo is null)

or (source.nomer_opo is null and source.naim_opo is not null
and relation.nomer_opo is null
and relation.naim_opo = source.naim_opo)
where target.id  = source.id;

