drop table public."OT_Truboprovod_P_klass_prav";
CREATE TABLE public."OT_Truboprovod_P_klass_prav" (
	id uuid NOT null default uuid_generate_v4(),
	project_id uuid null,
	geom public.geometry(point, 3857) NULL,
	class_code varchar(10) null,
	class_name varchar(100) null,
	naim_tr varchar(255) NULL,
	naim varchar(255) NULL,
	rasp_piket varchar(255) NULL,
	funk_nazn varchar(255) NULL,
	teh_hrkt text NULL,
	primechan text NULL,
	dzo varchar(8) null,
	CONSTRAINT "OT_Truboprovod_P_klass_prav_pkey" PRIMARY KEY (id)
);
