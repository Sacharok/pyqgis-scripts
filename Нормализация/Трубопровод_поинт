set rasp_piket = regexp_replace(rasp_piket, '[\n]+', '; ', 'g');

update public."OT_Truboprovod_P_klass_prav"
set rasp_piket = regexp_replace(rasp_piket, '\s{2,}', '; ', 'g');

update public."OT_Truboprovod_P_klass_prav"
set rasp_piket = regexp_replace(rasp_piket, '(ПК)\s*(\d+)\s*(\+)\s*(\d+)', '\1\2\3\4', 'g');

