SELECT
    (SELECT count(*) FROM tmp_point_source)
        AS source_objects,

    (SELECT count(*) FROM tmp_resolved_purposes)
        AS purposes_resolved,

    (SELECT count(*) FROM tmp_source_pikets)
        AS source_pikets,

    (SELECT count(*) FROM tmp_new_pikets)
        AS new_pikets,

    (SELECT count(*) FROM tmp_resolved_pipeline_links)
        AS pipeline_links_resolved,

    (SELECT count(*) FROM tmp_new_pipeline_links)
        AS new_pipeline_links,

    (
        SELECT count(*)
        FROM tmp_stage2_issues
        WHERE severity = 'ERROR'
    )
        AS errors,

    (
        SELECT count(*)
        FROM tmp_stage2_issues
        WHERE severity = 'WARNING'
    )
        AS warnings;


