insert into public."CompositionOfLinearObject"
(id, naim, teh_hrkt, primechan)
select n.id, n.naim, n.teh_hrkt, n.primechan
from dblink('dbname=normalize',
	'select id, naim, teh_hrkt, primechan
	 from ready."OT_Truboprovod_P_klass_prav"')
as n(id uuid, naim text, teh_hrkt text,
	primechan text)
on conflict (id) do nothing;

update public."CompositionOfLinearObject" ld
set funk_nazn = pdo.id
from dblink('dbname=normalize',
	'select id, funk_nazn
	 from ready."OT_Truboprovod_P_klass_prav" where funk_nazn is not null')
as n(id uuid, funk_nazn varchar(255))
join public."PurposesOfPipelineNetworkObjects" pdo on n.funk_nazn = pdo.naim
where ld.id  = n.id;

-- заполнение пикетов --
insert into public."CompositionOfLinerObjectPikets" (id, rasp_piket, "CreatedAt", "UpdatedAt", "IsBlocked")
select distinct n.id, trim(unnest(string_to_array(n.rasp_piket, ';'))), now(), now(), false 
from dblink(
	'dbname=normalize',
	'select id, rasp_piket from "OT_Truboprovod_P_klass_prav"') 
as n(id uuid, rasp_piket text) 
where not exists
(
select 1
from public."CompositionOfLinerObjectPikets" as ex
where ex.id = n.id
);

with source as (
select remote_data.id, unnest(string_to_array(remote_data.naim_tr, ';')) as pipeline_name
from dblink('dbname=normalize',
	'select id, naim_tr
	 from ready."OT_Truboprovod_P_klass_prav" where naim_tr is not null')
	 as remote_data(id uuid, naim_tr text)
)
insert into public."CompositionOfLinearObjectPipelines"  (id, naim_tr, "CreatedAt", "UpdatedAt", "IsBlocked")
select distinct on (sd.id, trim(sd.pipeline_name))
sd.id, p.id, now(), now(), false
from source sd
join public."Pipelines" p on trim(p.naim_tr) = trim(sd.pipeline_name)
on conflict (id, naim_tr) do nothing;

select cp.id from public."CompositionOfLinearObject" cp
where not exists
(
select from public."CompositionOfLinearObjectPipelines" c
where cp.id = c.id
);

