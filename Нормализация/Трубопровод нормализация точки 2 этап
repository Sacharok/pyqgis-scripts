/*
ЭТАП 2. ТОЧЕЧНЫЕ ОБЪЕКТЫ ТРУБОПРОВОДОВ
Сначала диагностика, затем (по явному переключателю) загрузка.

ВАЖНО:
1) По умолчанию v_do_load = false — целевые таблицы НЕ изменяются.
2) После проверки результатов поменять v_do_load на true и запустить скрипт заново.
3) Имя таблицы CompositionOfLinerObjectPikets сохранено ровно как в исходном рабочем SQL.
4) Источник во всех запросах используется один и тот же:
   ready."OT_Truboprovod_P_klass_prav" в БД normalize.
*/

DROP TABLE IF EXISTS tmp_stage2_config;
CREATE TEMP TABLE tmp_stage2_config (
    do_load boolean NOT NULL
);

-- ПЕРЕКЛЮЧАТЕЛЬ ЗАГРУЗКИ:
-- false = только проверить
-- true  = выполнить загрузку, если нет ошибок уровня ERROR
INSERT INTO tmp_stage2_config(do_load)
VALUES (false);


-- ============================================================
-- 1. ОДИН РАЗ ПОЛУЧАЕМ НОРМАЛИЗОВАННЫЕ ДАННЫЕ ЧЕРЕЗ DBLINK
-- ============================================================

DROP TABLE IF EXISTS tmp_point_source;
CREATE TEMP TABLE tmp_point_source (
    id          uuid,
    naim        text,
    teh_hrkt    text,
    primechan   text,
    funk_nazn   text,
    rasp_piket  text,
    naim_tr     text
);

INSERT INTO tmp_point_source
(id, naim, teh_hrkt, primechan, funk_nazn, rasp_piket, naim_tr)
SELECT
    n.id,
    n.naim,
    n.teh_hrkt,
    n.primechan,
    n.funk_nazn,
    n.rasp_piket,
    n.naim_tr
FROM dblink(
    'dbname=normalize',
    'select id, naim, teh_hrkt, primechan, funk_nazn, rasp_piket, naim_tr
     from ready."OT_Truboprovod_P_klass_prav"'
) AS n(
    id uuid,
    naim text,
    teh_hrkt text,
    primechan text,
    funk_nazn text,
    rasp_piket text,
    naim_tr text
);


-- ============================================================
-- 2. РАЗВОРАЧИВАЕМ ПИКЕТЫ И НАИМЕНОВАНИЯ ТРУБОПРОВОДОВ
-- ============================================================

DROP TABLE IF EXISTS tmp_point_pikets;
CREATE TEMP TABLE tmp_point_pikets AS
SELECT
    s.id,
    trim(x.value) AS rasp_piket
FROM tmp_point_source s
CROSS JOIN LATERAL unnest(string_to_array(s.rasp_piket, ';')) AS x(value)
WHERE s.rasp_piket IS NOT NULL
  AND nullif(trim(x.value), '') IS NOT NULL;

DROP TABLE IF EXISTS tmp_point_pipeline_names;
CREATE TEMP TABLE tmp_point_pipeline_names AS
SELECT
    s.id,
    trim(x.value) AS pipeline_name
FROM tmp_point_source s
CROSS JOIN LATERAL unnest(string_to_array(s.naim_tr, ';')) AS x(value)
WHERE s.naim_tr IS NOT NULL
  AND nullif(trim(x.value), '') IS NOT NULL;


