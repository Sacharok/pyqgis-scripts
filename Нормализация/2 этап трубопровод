/*
ЭТАП 2. Подготовка нормализованных линейных трубопроводов к загрузке в public."Pipelines"

Логика:
  1. Один раз получаем нормализованные данные через dblink во временную таблицу.
  2. НИЧЕГО не загружаем в public."Pipelines".
  3. Проверяем строки, которые не смогут быть однозначно распределены по справочникам
     либо могут вызвать ошибку загрузки.
  4. Смотрим таблицу _pipeline_load_issues.
  5. Только после проверки меняем v_do_load := false на v_do_load := true и запускаем скрипт заново.

ВАЖНО:
  - Справочные значения сопоставляются по точному наименованию relation.naim.
  - Для Да/Нет выполняется только безопасное приведение регистра: да/ДА/Да -> Да, нет/НЕТ/Нет -> Нет.
  - Если непустое значение не найдено в справочнике, оно НЕ заменяется значением по умолчанию.
    Такая строка блокирует загрузку и выводится в контроль.
  - Значения по умолчанию используются только тогда, когда соответствующее поле в источнике NULL.
*/

BEGIN;

-- ============================================================================
-- 0. ИСХОДНЫЕ ДАННЫЕ
-- ============================================================================

DROP TABLE IF EXISTS _pipelines_source;

CREATE TEMP TABLE _pipelines_source AS
SELECT *
FROM dblink(
    'host= port= dbname=normalization user= password=',
    $remote$
        SELECT
            id,
            naim_tr,
            nomer_opo,
            naim_opo,
            mestp_nazn,
            vvd_eks,
            dataepb_pl,
            dataepb,
            srok_sluzb,
            protzh_tr,
            ispyt_davl,
            diam_tolsh,
            rab_davl,
            sherohov,
            status_tr,
            vid_tr,
            sposb_ukl,
            tip_rab_sr,
            tip_mat_tr,
            s_termoiz,
            tip_izol,
            vid_obogr
        FROM public."OT_Truboprovod_L_klass_prav"
    $remote$
) AS n(
    id uuid,
    naim_tr character varying,
    nomer_opo character varying,
    naim_opo character varying,
    mestp_nazn character varying,
    vvd_eks date,
    dataepb_pl date,
    dataepb date,
    srok_sluzb character varying,
    protzh_tr double precision,
    ispyt_davl character varying,
    diam_tolsh character varying,
    rab_davl character varying,
    sherohov character varying,
    status_tr character varying,
    vid_tr character varying,
    sposb_ukl character varying,
    tip_rab_sr character varying,
    tip_mat_tr character varying,
    s_termoiz character varying,
    tip_izol character varying,
    vid_obogr character varying
);

-- Смотрим структуру целевой таблицы. Этот SELECT ничего не меняет.
SELECT
    column_name,
    data_type,
    udt_name,
    is_nullable,
    character_maximum_length,
    column_default
FROM information_schema.columns
WHERE table_schema = 'public'
  AND table_name = 'Pipelines'
ORDER BY ordinal_position;

-- ============================================================================
-- 1. ЕДИНАЯ ТАБЛИЦА ПРОБЛЕМ
-- ============================================================================

DROP TABLE IF EXISTS _pipeline_load_issues;

CREATE TEMP TABLE _pipeline_load_issues (
    severity     varchar(10)  NOT NULL,
    issue_type   varchar(60)  NOT NULL,
    source_id    uuid         NULL,
    field_name   varchar(50)  NULL,
    source_value text         NULL,
    details      text         NULL
);

-- ----------------------------------------------------------------------------
-- 1.1. Базовые проблемы идентификаторов
-- ----------------------------------------------------------------------------

INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'NULL_ID',
    NULL,
    'id',
    NULL,
    'В исходной нормализованной таблице id = NULL. Строку нельзя загрузить в Pipelines.'
FROM _pipelines_source
WHERE id IS NULL;

INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'DUPLICATE_SOURCE_ID',
    s.id,
    'id',
    s.id::text,
    'Один id встречается в нормализованном источнике более одного раза.'
FROM _pipelines_source s
JOIN (
    SELECT id
    FROM _pipelines_source
    WHERE id IS NOT NULL
    GROUP BY id
    HAVING count(*) > 1
) d ON d.id = s.id;

-- Старый INSERT при таком id упал бы по PK. Нам важно увидеть это до загрузки.
INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'ID_ALREADY_EXISTS_IN_PIPELINES',
    s.id,
    'id',
    s.id::text,
    'Запись с таким id уже существует в public."Pipelines". Автоматическое перезаписывание не выполняется.'
FROM _pipelines_source s
JOIN public."Pipelines" p ON p.id = s.id;

-- ----------------------------------------------------------------------------
-- 1.2. Проверка числовых значений до CAST
-- ----------------------------------------------------------------------------

INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'INVALID_NUMBER',
    s.id,
    'rab_davl',
    s.rab_davl,
    'Значение нельзя безопасно преобразовать в double precision.'
FROM _pipelines_source s
WHERE NULLIF(btrim(s.rab_davl), '') IS NOT NULL
  AND replace(btrim(s.rab_davl), ',', '.') !~
      '^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$';

INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'INVALID_NUMBER',
    s.id,
    'sherohov',
    s.sherohov,
    'Значение нельзя безопасно преобразовать в double precision.'
FROM _pipelines_source s
WHERE NULLIF(btrim(s.sherohov), '') IS NOT NULL
  AND replace(btrim(s.sherohov), ',', '.') !~
      '^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$';

-- ----------------------------------------------------------------------------
-- 1.3. Проверка длины прямых текстовых полей относительно public."Pipelines"
--      Срабатывает только если целевой столбец действительно имеет ограничение varchar(n).
-- ----------------------------------------------------------------------------

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'VALUE_TOO_LONG', s.id, 'naim_tr', s.naim_tr,
       format('Длина значения %s символов, допустимо не более %s.', char_length(s.naim_tr), c.character_maximum_length)
FROM _pipelines_source s
JOIN information_schema.columns c
  ON c.table_schema = 'public' AND c.table_name = 'Pipelines' AND c.column_name = 'naim_tr'
WHERE s.naim_tr IS NOT NULL
  AND c.character_maximum_length IS NOT NULL
  AND char_length(s.naim_tr) > c.character_maximum_length;

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'VALUE_TOO_LONG', s.id, 'mestp_nazn', s.mestp_nazn,
       format('Длина значения %s символов, допустимо не более %s.', char_length(s.mestp_nazn), c.character_maximum_length)
FROM _pipelines_source s
JOIN information_schema.columns c
  ON c.table_schema = 'public' AND c.table_name = 'Pipelines' AND c.column_name = 'mestp_nazn'
WHERE s.mestp_nazn IS NOT NULL
  AND c.character_maximum_length IS NOT NULL
  AND char_length(s.mestp_nazn) > c.character_maximum_length;

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'VALUE_TOO_LONG', s.id, 'srok_sluzb', s.srok_sluzb,
       format('Длина значения %s символов, допустимо не более %s.', char_length(s.srok_sluzb), c.character_maximum_length)
FROM _pipelines_source s
JOIN information_schema.columns c
  ON c.table_schema = 'public' AND c.table_name = 'Pipelines' AND c.column_name = 'srok_sluzb'
WHERE s.srok_sluzb IS NOT NULL
  AND c.character_maximum_length IS NOT NULL
  AND char_length(s.srok_sluzb) > c.character_maximum_length;

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'VALUE_TOO_LONG', s.id, 'ispyt_davl', s.ispyt_davl,
       format('Длина значения %s символов, допустимо не более %s.', char_length(s.ispyt_davl), c.character_maximum_length)
FROM _pipelines_source s
JOIN information_schema.columns c
  ON c.table_schema = 'public' AND c.table_name = 'Pipelines' AND c.column_name = 'ispyt_davl'
WHERE s.ispyt_davl IS NOT NULL
  AND c.character_maximum_length IS NOT NULL
  AND char_length(s.ispyt_davl) > c.character_maximum_length;

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'VALUE_TOO_LONG', s.id, 'diam_tolsh', s.diam_tolsh,
       format('Длина значения %s символов, допустимо не более %s.', char_length(s.diam_tolsh), c.character_maximum_length)
FROM _pipelines_source s
JOIN information_schema.columns c
  ON c.table_schema = 'public' AND c.table_name = 'Pipelines' AND c.column_name = 'diam_tolsh'
WHERE s.diam_tolsh IS NOT NULL
  AND c.character_maximum_length IS NOT NULL
  AND char_length(s.diam_tolsh) > c.character_maximum_length;

-- ============================================================================
-- 2. ПРОВЕРКА СПРАВОЧНИКОВ
-- ============================================================================

DROP VIEW IF EXISTS _pipeline_dictionary_check;

CREATE TEMP VIEW _pipeline_dictionary_check AS

SELECT s.id AS source_id,
       'status_tr'::text AS field_name,
       'PipelineStatuses'::text AS dictionary_name,
       s.status_tr::text AS source_value,
       count(r.id)::integer AS match_count
FROM _pipelines_source s
LEFT JOIN public."PipelineStatuses" r ON s.status_tr = r.naim
WHERE s.status_tr IS NOT NULL
GROUP BY s.id, s.status_tr

UNION ALL
SELECT s.id, 'vid_tr', 'PipelineTypeByPurposes', s.vid_tr, count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."PipelineTypeByPurposes" r ON s.vid_tr = r.naim
WHERE s.vid_tr IS NOT NULL
GROUP BY s.id, s.vid_tr

UNION ALL
SELECT s.id, 'sposb_ukl', 'PipelineTypesByInstallationMethods', s.sposb_ukl, count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."PipelineTypesByInstallationMethods" r ON s.sposb_ukl = r.naim
WHERE s.sposb_ukl IS NOT NULL
GROUP BY s.id, s.sposb_ukl

UNION ALL
SELECT s.id, 'tip_rab_sr', 'ProductionInjectionAgents', s.tip_rab_sr, count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."ProductionInjectionAgents" r ON s.tip_rab_sr = r.naim
WHERE s.tip_rab_sr IS NOT NULL
GROUP BY s.id, s.tip_rab_sr

UNION ALL
SELECT s.id, 'tip_mat_tr', 'PipelineMaterialTypes', s.tip_mat_tr, count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."PipelineMaterialTypes" r ON s.tip_mat_tr = r.naim
WHERE s.tip_mat_tr IS NOT NULL
GROUP BY s.id, s.tip_mat_tr

UNION ALL
SELECT s.id,
       's_termoiz',
       'StandardYesNoEnums',
       s.s_termoiz,
       count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."StandardYesNoEnums" r
  ON CASE lower(btrim(s.s_termoiz))
         WHEN 'да'  THEN 'Да'
         WHEN 'нет' THEN 'Нет'
         ELSE btrim(s.s_termoiz)
     END = r.naim
WHERE s.s_termoiz IS NOT NULL
GROUP BY s.id, s.s_termoiz

UNION ALL
SELECT s.id, 'tip_izol', 'InsulationTypes', s.tip_izol, count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."InsulationTypes" r ON s.tip_izol = r.naim
WHERE s.tip_izol IS NOT NULL
GROUP BY s.id, s.tip_izol

UNION ALL
SELECT s.id, 'vid_obogr', 'PipelineHeatingTypes', s.vid_obogr, count(r.id)::integer
FROM _pipelines_source s
LEFT JOIN public."PipelineHeatingTypes" r ON s.vid_obogr = r.naim
WHERE s.vid_obogr IS NOT NULL
GROUP BY s.id, s.vid_obogr;

-- Значение не найдено в справочнике.
INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'DICTIONARY_VALUE_NOT_FOUND',
    source_id,
    field_name,
    source_value,
    format('Значение не найдено в справочнике public."%s".', dictionary_name)
FROM _pipeline_dictionary_check
WHERE match_count = 0;

-- Значение найдено более одного раза: UUID нельзя выбрать однозначно.
INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'DICTIONARY_VALUE_AMBIGUOUS',
    source_id,
    field_name,
    source_value,
    format('В справочнике public."%s" найдено совпадений: %s.', dictionary_name, match_count)
FROM _pipeline_dictionary_check
WHERE match_count > 1;

-- ============================================================================
-- 3. ОПАСНЫЕ ПРОИЗВОДСТВЕННЫЕ ОБЪЕКТЫ (ОПО)
--    Логика сопоставления сохранена из исходного скрипта.
-- ============================================================================

DROP VIEW IF EXISTS _pipeline_opo_check;

CREATE TEMP VIEW _pipeline_opo_check AS
SELECT
    s.id AS source_id,
    s.nomer_opo,
    s.naim_opo,
    count(r.id)::integer AS match_count
FROM _pipelines_source s
LEFT JOIN public."DangerousIndustrialFacilities" r
  ON (
        s.nomer_opo IS NOT NULL
        AND s.naim_opo IS NOT NULL
        AND r.nomer_opo = s.nomer_opo
        AND r.naim_opo = s.naim_opo
     )
  OR (
        s.nomer_opo IS NOT NULL
        AND s.naim_opo IS NULL
        AND r.nomer_opo = s.nomer_opo
        AND r.naim_opo IS NULL
     )
  OR (
        s.nomer_opo IS NULL
        AND s.naim_opo IS NOT NULL
        AND r.nomer_opo IS NULL
        AND r.naim_opo = s.naim_opo
     )
WHERE s.nomer_opo IS NOT NULL OR s.naim_opo IS NOT NULL
GROUP BY s.id, s.nomer_opo, s.naim_opo;

INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'OPO_NOT_FOUND',
    source_id,
    'opo',
    concat_ws(' | ', nomer_opo, naim_opo),
    'Не найдено однозначное соответствие в public."DangerousIndustrialFacilities".'
FROM _pipeline_opo_check
WHERE match_count = 0;

INSERT INTO _pipeline_load_issues
SELECT
    'ERROR',
    'OPO_AMBIGUOUS',
    source_id,
    'opo',
    concat_ws(' | ', nomer_opo, naim_opo),
    format('В public."DangerousIndustrialFacilities" найдено совпадений: %s.', match_count)
FROM _pipeline_opo_check
WHERE match_count > 1;

-- ============================================================================
-- 4. ПРОВЕРКА UUID, КОТОРЫЕ В СТАРОМ СКРИПТЕ ИСПОЛЬЗУЮТСЯ КАК ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ
--    Они применяются ТОЛЬКО когда исходное поле = NULL.
-- ============================================================================

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'DEFAULT_UUID_NOT_FOUND', NULL, 'status_tr',
       'ba5bfc98-8507-4130-864d-f767beba54bd',
       'UUID по умолчанию отсутствует в public."PipelineStatuses".'
WHERE NOT EXISTS (
    SELECT 1 FROM public."PipelineStatuses"
    WHERE id = 'ba5bfc98-8507-4130-864d-f767beba54bd'::uuid
