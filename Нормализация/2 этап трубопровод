INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'DEFAULT_UUID_NOT_FOUND', NULL, 'vid_tr',
       'eb128658-e5a6-4d8b-9c77-baabc03e0406',
       'UUID по умолчанию отсутствует в public."PipelineTypeByPurposes".'
WHERE NOT EXISTS (
    SELECT 1 FROM public."PipelineTypeByPurposes"
    WHERE id = 'eb128658-e5a6-4d8b-9c77-baabc03e0406'::uuid
);

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'DEFAULT_UUID_NOT_FOUND', NULL, 'sposb_ukl',
       '139d91e8-b472-48c5-b0e7-f3d0f3353216',
       'UUID по умолчанию отсутствует в public."PipelineTypesByInstallationMethods".'
WHERE NOT EXISTS (
    SELECT 1 FROM public."PipelineTypesByInstallationMethods"
    WHERE id = '139d91e8-b472-48c5-b0e7-f3d0f3353216'::uuid
);

INSERT INTO _pipeline_load_issues
SELECT 'ERROR', 'DEFAULT_UUID_NOT_FOUND', NULL, 'tip_rab_sr',
       '1a3926f9-0a24-4258-9737-028f7de930fc',
       'UUID по умолчанию отсутствует в public."ProductionInjectionAgents".'
WHERE NOT EXISTS (
