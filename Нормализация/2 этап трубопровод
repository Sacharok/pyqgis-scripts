-- ============================================================================
-- 5. РЕЗУЛЬТАТ ПРОВЕРКИ
-- ============================================================================

-- Краткая сводка.
SELECT
    severity,
    issue_type,
    field_name,
    count(*) AS problem_count
FROM _pipeline_load_issues
GROUP BY severity, issue_type, field_name
ORDER BY severity, issue_type, field_name;

-- Все проблемные строки. Именно этот результат нужно разбирать перед загрузкой.
SELECT
    severity,
    issue_type,
    source_id,
    field_name,
    source_value,
    details
FROM _pipeline_load_issues
ORDER BY
    CASE severity WHEN 'ERROR' THEN 1 ELSE 2 END,
    field_name NULLS LAST,
    source_value NULLS LAST,
    source_id NULLS LAST;

-- Уникальные значения, для которых не найден справочник.
-- Удобно разбирать один раз значение, которое встречается сразу у нескольких строк.
SELECT
    field_name,
    source_value,
    count(*) AS affected_rows,
    min(details) AS details
FROM _pipeline_load_issues
WHERE issue_type IN ('DICTIONARY_VALUE_NOT_FOUND', 'OPO_NOT_FOUND')
GROUP BY field_name, source_value
ORDER BY field_name, source_value;

-- Показываем, что именно скрывается за четырьмя UUID по умолчанию из исходного скрипта.
-- Это контроль смысла, а не только существования UUID.
SELECT 'status_tr' AS field_name, id, naim
FROM public."PipelineStatuses"
WHERE id = 'ba5bfc98-8507-4130-864d-f767beba54bd'::uuid
UNION ALL
SELECT 'vid_tr', id, naim
FROM public."PipelineTypeByPurposes"
WHERE id = 'eb128658-e5a6-4d8b-9c77-baabc03e0406'::uuid
UNION ALL
SELECT 'sposb_ukl', id, naim
FROM public."PipelineTypesByInstallationMethods"
WHERE id = '139d91e8-b472-48c5-b0e7-f3d0f3353216'::uuid
UNION ALL
SELECT 'tip_rab_sr', id, naim
FROM public."ProductionInjectionAgents"
WHERE id = '1a3926f9-0a24-4258-9737-028f7de930fc'::uuid
ORDER BY field_name;

-- Сколько строк получат значение по умолчанию из-за NULL в источнике.
SELECT *
FROM (
    SELECT 'status_tr' AS field_name, count(*) AS rows_with_null_source
    FROM _pipelines_source WHERE status_tr IS NULL
    UNION ALL
    SELECT 'vid_tr', count(*) FROM _pipelines_source WHERE vid_tr IS NULL
    UNION ALL
    SELECT 'sposb_ukl', count(*) FROM _pipelines_source WHERE sposb_ukl IS NULL
    UNION ALL
    SELECT 'tip_rab_sr', count(*) FROM _pipelines_source WHERE tip_rab_sr IS NULL
) q
ORDER BY field_name;

-- Дополнительно: источник целиком для ручного просмотра конкретного id из таблицы проблем.
-- SELECT * FROM _pipelines_source WHERE id = '<UUID ИЗ source_id>'::uuid;

-- ============================================================================
-- 6. ЗАГРУЗКА
-- ============================================================================
-- По умолчанию ВЫКЛЮЧЕНА.
-- После проверки поменять только:
--     v_do_load boolean := false;
-- на:
--     v_do_load boolean := true;
-- и запустить ВЕСЬ скрипт заново.
--
-- Если в _pipeline_load_issues остаётся хотя бы одна ERROR, загрузка будет остановлена.
-- ============================================================================

DO $$
DECLARE
    v_do_load boolean := false;   -- <<< МЕНЯТЬ ТОЛЬКО ПОСЛЕ ПРОВЕРКИ
    v_error_count integer;
    v_inserted integer;
BEGIN
    SELECT count(*)
    INTO v_error_count
    FROM _pipeline_load_issues
    WHERE severity = 'ERROR';

    IF NOT v_do_load THEN
        RAISE NOTICE 'Загрузка НЕ выполнялась. Проверка завершена. Ошибок: %.', v_error_count;
        RETURN;
    END IF;

    IF v_error_count > 0 THEN
        RAISE EXCEPTION 'Загрузка остановлена: в _pipeline_load_issues осталось ошибок: %.', v_error_count;
    END IF;

    /*
      В отличие от старого варианта, здесь UUID справочников определяются ДО INSERT.
      Это не оставляет "значение по умолчанию" у непустого, но не найденного справочного значения.
    */
    INSERT INTO public."Pipelines" (
        id,
        naim_tr,
        status_tr,
        vid_tr,
        sposb_ukl,
        tip_rab_sr,
        mestp_nazn,
        vvd_eks,
        dataepb_pl,
        dataepb,
        srok_sluzb,
        protzh_tr,
        ispyt_davl,
        diam_tolsh,
        rab_davl,
        sherohov,
        opo,
        tip_mat_tr,
        s_termoiz,
        tip_izol,
        vid_obogr
    )
    SELECT
        s.id,
        s.naim_tr,

        CASE
            WHEN s.status_tr IS NULL
                THEN 'ba5bfc98-8507-4130-864d-f767beba54bd'::uuid
            ELSE ps.id
        END AS status_tr,

        CASE
            WHEN s.vid_tr IS NULL
                THEN 'eb128658-e5a6-4d8b-9c77-baabc03e0406'::uuid
            ELSE ptp.id
        END AS vid_tr,

        CASE
            WHEN s.sposb_ukl IS NULL
                THEN '139d91e8-b472-48c5-b0e7-f3d0f3353216'::uuid
            ELSE pim.id
        END AS sposb_ukl,

        CASE
            WHEN s.tip_rab_sr IS NULL
                THEN '1a3926f9-0a24-4258-9737-028f7de930fc'::uuid
            ELSE pia.id
        END AS tip_rab_sr,

        s.mestp_nazn,
        s.vvd_eks,
        s.dataepb_pl,
        s.dataepb,
        s.srok_sluzb,
        s.protzh_tr,
        s.ispyt_davl,
        s.diam_tolsh,

        CASE
            WHEN NULLIF(btrim(s.rab_davl), '') IS NULL THEN NULL
            ELSE replace(btrim(s.rab_davl), ',', '.')::double precision
        END AS rab_davl,

        CASE
            WHEN NULLIF(btrim(s.sherohov), '') IS NULL THEN NULL
            ELSE replace(btrim(s.sherohov), ',', '.')::double precision
        END AS sherohov,

        opo.id AS opo,
        pmt.id AS tip_mat_tr,
        yn.id AS s_termoiz,
        it.id AS tip_izol,
        pht.id AS vid_obogr

    FROM _pipelines_source s

    LEFT JOIN public."PipelineStatuses" ps
        ON s.status_tr = ps.naim

    LEFT JOIN public."PipelineTypeByPurposes" ptp
        ON s.vid_tr = ptp.naim

    LEFT JOIN public."PipelineTypesByInstallationMethods" pim
        ON s.sposb_ukl = pim.naim

    LEFT JOIN public."ProductionInjectionAgents" pia
        ON s.tip_rab_sr = pia.naim

    LEFT JOIN public."PipelineMaterialTypes" pmt
        ON s.tip_mat_tr = pmt.naim

    LEFT JOIN public."StandardYesNoEnums" yn
        ON CASE lower(btrim(s.s_termoiz))
               WHEN 'да'  THEN 'Да'
               WHEN 'нет' THEN 'Нет'
               ELSE btrim(s.s_termoiz)
           END = yn.naim

    LEFT JOIN public."InsulationTypes" it
        ON s.tip_izol = it.naim

    LEFT JOIN public."PipelineHeatingTypes" pht
        ON s.vid_obogr = pht.naim

    LEFT JOIN public."DangerousIndustrialFacilities" opo
        ON (
              s.nomer_opo IS NOT NULL
              AND s.naim_opo IS NOT NULL
              AND opo.nomer_opo = s.nomer_opo
              AND opo.naim_opo = s.naim_opo
           )
        OR (
              s.nomer_opo IS NOT NULL
              AND s.naim_opo IS NULL
              AND opo.nomer_opo = s.nomer_opo
              AND opo.naim_opo IS NULL
           )
        OR (
              s.nomer_opo IS NULL
              AND s.naim_opo IS NOT NULL
              AND opo.nomer_opo IS NULL
              AND opo.naim_opo = s.naim_opo
           );

    GET DIAGNOSTICS v_inserted = ROW_COUNT;
    RAISE NOTICE 'Загрузка выполнена. Добавлено строк в public."Pipelines": %.', v_inserted;
END $$;

COMMIT;

