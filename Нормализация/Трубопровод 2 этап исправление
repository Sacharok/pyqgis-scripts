/* ============================================================
   10. ТАБЛИЦА ДЛЯ ВСЕХ ПРОБЛЕМ
   ============================================================ */

DROP TABLE IF EXISTS tmp_stage2_issues;

CREATE TEMP TABLE tmp_stage2_issues
(
    severity text,
    issue_type text,
    source_id uuid,
    field_name text,
    source_value text,
