/* ============================================================
   11. ПРОВЕРКА ID
   ============================================================ */

-- NULL id
INSERT INTO tmp_stage2_issues
SELECT
    'ERROR',
    'NULL_ID',
    NULL,
    'id',
    NULL,
    'В нормализованной таблице есть объект без id'
FROM tmp_point_source
WHERE id IS NULL;


-- Повторяющийся id в текущей нормализованной таблице
INSERT INTO tmp_stage2_issues
SELECT
    'ERROR',
    'DUPLICATE_ID',
    id,
    'id',
    id::text,
    'Один id встречается в исходной таблице ' || count(*) || ' раз(а)'
FROM tmp_point_source
WHERE id IS NOT NULL
GROUP BY id
HAVING count(*) > 1;


/* ============================================================
   12. ПРОВЕРКА CompositionOfLinearObject

   Если объект уже существует в neo_nsi,
   сравниваем основные поля.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT
    'WARNING',
    'OBJECT_ALREADY_EXISTS_DIFFERENT',
    s.id,
    'CompositionOfLinearObject',
    s.naim,
    'Объект уже существует в neo_nsi, но его данные отличаются. '
    || 'Старый ON CONFLICT DO NOTHING такие поля не обновит.'
FROM tmp_point_source s
JOIN tmp_nsi_composition n
    ON n.id = s.id
WHERE n.naim IS DISTINCT FROM s.naim
   OR n.teh_hrkt IS DISTINCT FROM s.teh_hrkt
   OR n.primechan IS DISTINCT FROM s.primechan;


/* ============================================================
   13. ПРОВЕРКА funk_nazn

   funk_nazn должен найти РОВНО ОДНУ запись
   в PurposesOfPipelineNetworkObjects.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT
    CASE
        WHEN count(p.id) = 0 THEN 'ERROR'
        ELSE 'ERROR'
    END,

    CASE
        WHEN count(p.id) = 0
            THEN 'PURPOSE_NOT_FOUND'
        ELSE
            'PURPOSE_AMBIGUOUS'
    END,

    s.id,
    'funk_nazn',
    s.funk_nazn,

    CASE
        WHEN count(p.id) = 0
            THEN 'Не найдено в PurposesOfPipelineNetworkObjects'
        ELSE
            'В PurposesOfPipelineNetworkObjects найдено несколько совпадений: '
            || count(p.id)
    END

FROM tmp_point_source s

LEFT JOIN tmp_nsi_purposes p
    ON p.naim = s.funk_nazn

WHERE s.funk_nazn IS NOT NULL

GROUP BY
    s.id,
    s.funk_nazn

HAVING count(p.id) <> 1;


/* ============================================================
   14. ПОКАЗЫВАЕМ, КАКОЙ UUID ПОЛУЧИТ funk_nazn

   Это НЕ ошибка.
   Просто предварительный просмотр.
   ============================================================ */

DROP TABLE IF EXISTS tmp_resolved_purposes;

CREATE TEMP TABLE tmp_resolved_purposes AS
SELECT
    s.id,
    s.funk_nazn,
    min(p.id::text)::uuid AS purpose_id
FROM tmp_point_source s
JOIN tmp_nsi_purposes p
    ON p.naim = s.funk_nazn
WHERE s.funk_nazn IS NOT NULL
GROUP BY
    s.id,
    s.funk_nazn
HAVING count(p.id) = 1;


/* ============================================================
   15. ПРОВЕРКА naim_tr -> Pipelines

   Очень важно:
   если в Pipelines есть несколько одинаковых naim_tr,
   НЕ выбираем один случайно.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT
    'ERROR',

    CASE
        WHEN count(p.id) = 0
            THEN 'PIPELINE_NOT_FOUND'
        ELSE
            'PIPELINE_AMBIGUOUS'
    END,

    s.id,
    'naim_tr',
    s.pipeline_name,

    CASE
        WHEN count(p.id) = 0
            THEN 'Трубопровод не найден в Pipelines по naim_tr'
        ELSE
            'По этому naim_tr найдено несколько Pipelines: '
            || count(p.id)
    END

FROM tmp_source_pipeline_names s

LEFT JOIN tmp_nsi_pipelines p
    ON trim(p.naim_tr) = trim(s.pipeline_name)

GROUP BY
    s.id,
    s.pipeline_name

HAVING count(p.id) <> 1;


/* ============================================================
   16. ГОТОВЫЕ АВТОМАТИЧЕСКИЕ СВЯЗИ
       ТОЧКА -> PIPELINE

   Сюда попадают ТОЛЬКО однозначные совпадения.
   ============================================================ */

DROP TABLE IF EXISTS tmp_resolved_pipeline_links;

CREATE TEMP TABLE tmp_resolved_pipeline_links AS
SELECT
    s.id,
    s.pipeline_name,
    min(p.id::text)::uuid AS pipeline_id
FROM tmp_source_pipeline_names s
JOIN tmp_nsi_pipelines p
    ON trim(p.naim_tr) = trim(s.pipeline_name)
GROUP BY
    s.id,
    s.pipeline_name
HAVING count(p.id) = 1;


/* ============================================================
   17. ПРОВЕРКА РУЧНЫХ СВЯЗЕЙ

   Проверяем только объекты,
   которые действительно находятся в текущей загрузке.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT
    'ERROR',
    'MANUAL_PIPELINE_NOT_FOUND',
    m.point_id,
    'naim_tr',
    m.pipeline_id::text,
    'В старом скрипте есть ручная связь, но такого Pipeline.id нет в neo_nsi'
FROM tmp_manual_pipeline_links m

JOIN tmp_point_source s
    ON s.id = m.point_id

LEFT JOIN tmp_nsi_pipelines p
    ON p.id = m.pipeline_id

WHERE p.id IS NULL;


/* ============================================================
   18. ПОКАЗЫВАЕМ АВТОМАТИЧЕСКИ НЕ НАЙДЕННЫЕ naim_tr,
       ДЛЯ КОТОРЫХ ЕСТЬ СТАРАЯ РУЧНАЯ СВЯЗЬ

   Это не скрываем.
   Пользователь должен видеть, что автоматическое
   сопоставление не сработало.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT DISTINCT
    'WARNING',
    'PIPELINE_MANUAL_LINK_AVAILABLE',
    s.id,
    'naim_tr',
    s.naim_tr,
    'Для объекта есть ручная связь из старого скрипта'
FROM tmp_point_source s

JOIN tmp_manual_pipeline_links m
    ON m.point_id = s.id

JOIN tmp_nsi_pipelines p
    ON p.id = m.pipeline_id;


/* ============================================================
   19. ПРОВЕРКА ПИКЕТОВ

   Показываем повторение одного пикета внутри
   текущего нормализованного объекта.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT
    'WARNING',
    'DUPLICATE_PIKET',
    id,
    'rasp_piket',
    rasp_piket,
    'Один и тот же пикет повторяется у объекта'
FROM
(
    SELECT
        s.id,
        trim(x.rasp_piket) AS rasp_piket,
        count(*) AS cnt
    FROM tmp_point_source s

    CROSS JOIN LATERAL
        unnest(string_to_array(s.rasp_piket, ';'))
        AS x(rasp_piket)

    WHERE s.rasp_piket IS NOT NULL
      AND NULLIF(trim(x.rasp_piket), '') IS NOT NULL

    GROUP BY
        s.id,
        trim(x.rasp_piket)
) q

WHERE cnt > 1;


/* ============================================================
   20. КАКИЕ ПИКЕТЫ УЖЕ ЕСТЬ В neo_nsi
   ============================================================ */

DROP TABLE IF EXISTS tmp_existing_pikets;

CREATE TEMP TABLE tmp_existing_pikets AS
SELECT
    s.id,
    s.rasp_piket
FROM tmp_source_pikets s
JOIN tmp_nsi_pikets n
    ON n.id = s.id
   AND trim(n.rasp_piket) = trim(s.rasp_piket);


/* ============================================================
   21. КАКИЕ ПИКЕТЫ БУДУТ НОВЫМИ
   ============================================================ */

DROP TABLE IF EXISTS tmp_new_pikets;

CREATE TEMP TABLE tmp_new_pikets AS
SELECT
    s.id,
    s.rasp_piket
FROM tmp_source_pikets s
WHERE NOT EXISTS
(
    SELECT 1
    FROM tmp_nsi_pikets n
    WHERE n.id = s.id
      AND trim(n.rasp_piket) = trim(s.rasp_piket)
);


/* ============================================================
   22. КАКИЕ АВТОМАТИЧЕСКИЕ СВЯЗИ УЖЕ ЕСТЬ
   ============================================================ */

DROP TABLE IF EXISTS tmp_existing_pipeline_links;

CREATE TEMP TABLE tmp_existing_pipeline_links AS
SELECT
    r.id,
    r.pipeline_name,
    r.pipeline_id
FROM tmp_resolved_pipeline_links r
JOIN tmp_nsi_pipeline_links n
    ON n.id = r.id
   AND n.naim_tr = r.pipeline_id;


/* ============================================================
   23. КАКИЕ АВТОМАТИЧЕСКИЕ СВЯЗИ БУДУТ НОВЫМИ
   ============================================================ */

DROP TABLE IF EXISTS tmp_new_pipeline_links;

CREATE TEMP TABLE tmp_new_pipeline_links AS
SELECT
    r.id,
    r.pipeline_name,
    r.pipeline_id
FROM tmp_resolved_pipeline_links r

WHERE NOT EXISTS
(
    SELECT 1
    FROM tmp_nsi_pipeline_links n
    WHERE n.id = r.id
      AND n.naim_tr = r.pipeline_id
);


/* ============================================================
   24. ТОЧКИ БЕЗ СВЯЗИ С ТРУБОПРОВОДОМ

   Смотрим ТОЛЬКО текущую локальную выборку.

   Связь считается существующей, если:
   1) она однозначно определилась по naim_tr;
   ИЛИ
   2) есть рабочая ручная связь;
   ИЛИ
   3) связь уже существует в neo_nsi.
   ============================================================ */

INSERT INTO tmp_stage2_issues
SELECT
    'WARNING',
    'NO_PIPELINE_RELATION',
    s.id,
    'naim_tr',
    s.naim_tr,
    'Для объекта не удалось определить ни одной связи с Pipelines'
FROM tmp_point_source s

WHERE NOT EXISTS
(
    SELECT 1
    FROM tmp_resolved_pipeline_links r
    WHERE r.id = s.id
)

AND NOT EXISTS
(
    SELECT 1
    FROM tmp_manual_pipeline_links m
    JOIN tmp_nsi_pipelines p
        ON p.id = m.pipeline_id
    WHERE m.point_id = s.id
)

AND NOT EXISTS
(
    SELECT 1
    FROM tmp_nsi_pipeline_links n
    WHERE n.id = s.id
);


/* ============================================================
   25. ИТОГ №1
   СКОЛЬКО ПРОБЛЕМ КАЖДОГО ТИПА
   ============================================================ */

SELECT
    severity,
    issue_type,
    count(*) AS count_rows
FROM tmp_stage2_issues
GROUP BY
    severity,
    issue_type
ORDER BY
    CASE severity
        WHEN 'ERROR' THEN 1
        WHEN 'WARNING' THEN 2
        ELSE 3
    END,
    issue_type;


/* ============================================================
   26. ИТОГ №2
   ВСЕ ПРОБЛЕМНЫЕ ОБЪЕКТЫ
   ============================================================ */

SELECT
    severity,
    issue_type,
    source_id,
    field_name,
    source_value,
    details
FROM tmp_stage2_issues
ORDER BY
    CASE severity
        WHEN 'ERROR' THEN 1
        WHEN 'WARNING' THEN 2
        ELSE 3
    END,
    issue_type,
    source_id;


/* ============================================================
   27. ИТОГ №3
   funk_nazn, КОТОРЫЕ НЕ НАШЛИСЬ В СПРАВОЧНИКЕ

   Здесь удобно принимать решение вручную.
   ============================================================ */

SELECT
    source_value AS funk_nazn,
    count(*) AS objects_count,
    max(details) AS problem
FROM tmp_stage2_issues
WHERE issue_type IN
(
    'PURPOSE_NOT_FOUND',
    'PURPOSE_AMBIGUOUS'
)
GROUP BY source_value
ORDER BY
    objects_count DESC,
    funk_nazn;


/* ============================================================
   28. ИТОГ №4
   naim_tr, КОТОРЫЕ НЕ СОПОСТАВИЛИСЬ С PIPELINES
   ============================================================ */

SELECT
    source_value AS naim_tr,
    count(*) AS objects_count,
    max(details) AS problem
FROM tmp_stage2_issues
WHERE issue_type IN
(
    'PIPELINE_NOT_FOUND',
    'PIPELINE_AMBIGUOUS'
)
GROUP BY source_value
ORDER BY
    objects_count DESC,
    naim_tr;


/* ============================================================
   29. ИТОГ №5
   ПРЕДВАРИТЕЛЬНОЕ СОПОСТАВЛЕНИЕ funk_nazn -> UUID
   ============================================================ */

SELECT
    id,
    funk_nazn,
    purpose_id
FROM tmp_resolved_purposes
ORDER BY
    funk_nazn,
    id;


/* ============================================================
   30. ИТОГ №6
   ПРЕДВАРИТЕЛЬНЫЕ СВЯЗИ
   ТОЧКА -> PIPELINE
   ============================================================ */

SELECT
    id,
    pipeline_name,
    pipeline_id
FROM tmp_resolved_pipeline_links
ORDER BY
    id,
    pipeline_name;


/* ============================================================
   31. ИТОГ №7
   НОВЫЕ ПИКЕТЫ, КОТОРЫЕ МОЖНО БУДЕТ ДОБАВИТЬ
   ============================================================ */

SELECT
    id,
    rasp_piket
FROM tmp_new_pikets
ORDER BY
    id,
    rasp_piket;


/* ============================================================
   32. ИТОГ №8
   НОВЫЕ СВЯЗИ С PIPELINES,
   КОТОРЫЕ МОЖНО БУДЕТ ДОБАВИТЬ
   ============================================================ */

SELECT
    id,
    pipeline_name,
    pipeline_id
FROM tmp_new_pipeline_links
ORDER BY
    id,
    pipeline_name;


/* ============================================================
   33. ИТОГ №9
   ТОЧКИ, ДЛЯ КОТОРЫХ ВООБЩЕ НЕТ СВЯЗИ С PIPELINE
   ============================================================ */

SELECT
    s.id,
    s.naim,
    s.naim_tr,
    s.funk_nazn
FROM tmp_point_source s

WHERE EXISTS
(
    SELECT 1
    FROM tmp_stage2_issues i
    WHERE i.source_id = s.id
      AND i.issue_type = 'NO_PIPELINE_RELATION'
)

