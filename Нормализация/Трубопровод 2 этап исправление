/* ============================================================
   ЭТАП 2. ПРЕДВАРИТЕЛЬНАЯ ПРОВЕРКА ТОЧЕЧНЫХ ОБЪЕКТОВ

   Запускать в ЛОКАЛЬНОЙ БД, где находится:
       public."OT_Truboprovod_P_klass_prav"

   neo_nsi используется ТОЛЬКО как источник данных.

   Скрипт НИЧЕГО не записывает в neo_nsi.
   Все tmp_* таблицы создаются локально и существуют
   только в текущей сессии PostgreSQL.
   ============================================================ */


/* ============================================================
   0. DBLINK
   ============================================================ */

-- Если расширение уже установлено, выполнять не обязательно.
-- Если прав на CREATE EXTENSION нет — просто закомментировать.
CREATE EXTENSION IF NOT EXISTS dblink;


-- Если соединение осталось от предыдущего запуска — закрываем его.
DO $$
BEGIN
    IF 'neo_nsi_conn' = ANY(
        COALESCE(dblink_get_connections(), ARRAY[]::text[])
    ) THEN
        PERFORM dblink_disconnect('neo_nsi_conn');
    END IF;
END $$;


-- ВАЖНО: указать параметры подключения к neo_nsi.
SELECT dblink_connect(
    'neo_nsi_conn',
    'host=ХОСТ port=5432 dbname=neo_nsi user=ПОЛЬЗОВАТЕЛЬ password=ПАРОЛЬ'
);


/* ============================================================
   1. ФИКСИРУЕМ ТЕКУЩИЕ НОРМАЛИЗОВАННЫЕ ДАННЫЕ

   Это локальная TEMP-таблица.
   Исходная OT_Truboprovod_P_klass_prav не изменяется.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_source;

CREATE TEMP TABLE tmp_point_source AS
SELECT
    id,
    naim,
    teh_hrkt,
    primechan,
    funk_nazn,
    rasp_piket,
    naim_tr,
    class_code,
    class_name,
    dzo
FROM public."OT_Truboprovod_P_klass_prav";


/* ============================================================
   2. ПОЛУЧАЕМ ИЗ neo_nsi СПРАВОЧНИК
      PurposesOfPipelineNetworkObjects

   Нужен для:
       funk_nazn -> UUID
   ============================================================ */

DROP TABLE IF EXISTS tmp_nsi_purposes;

CREATE TEMP TABLE tmp_nsi_purposes AS
SELECT *
FROM dblink(
    'neo_nsi_conn',
    '
        SELECT
            id,
            naim::text
        FROM public."PurposesOfPipelineNetworkObjects"
    '
)
AS t(
    id uuid,
    naim text
);


/* ============================================================
   3. ПОЛУЧАЕМ ТРУБОПРОВОДЫ

   Нужны для:
       naim_tr -> Pipelines.id
   ============================================================ */

DROP TABLE IF EXISTS tmp_nsi_pipelines;

CREATE TEMP TABLE tmp_nsi_pipelines AS
SELECT *
FROM dblink(
    'neo_nsi_conn',
    '
        SELECT
            id,
            naim_tr::text
        FROM public."Pipelines"
    '
)
AS t(
    id uuid,
    naim_tr text
);


/* ============================================================
   4. ПОЛУЧАЕМ УЖЕ СУЩЕСТВУЮЩИЕ ТОЧЕЧНЫЕ ОБЪЕКТЫ
   ============================================================ */

DROP TABLE IF EXISTS tmp_nsi_composition;

CREATE TEMP TABLE tmp_nsi_composition AS
SELECT *
FROM dblink(
    'neo_nsi_conn',
    '
        SELECT
            id,
            naim::text,
            teh_hrkt::text,
            primechan::text,
            funk_nazn::text
        FROM public."CompositionOfLinearObject"
    '
)
AS t(
    id uuid,
    naim text,
    teh_hrkt text,
    primechan text,
    funk_nazn text
);


/* ============================================================
   5. ПОЛУЧАЕМ СУЩЕСТВУЮЩИЕ ПИКЕТЫ

   Название таблицы оставлено именно таким,
   как в существующем рабочем скрипте:
       CompositionOfLinerObjectPikets
   ============================================================ */

DROP TABLE IF EXISTS tmp_nsi_pikets;

CREATE TEMP TABLE tmp_nsi_pikets AS
SELECT *
FROM dblink(
    'neo_nsi_conn',
    '
        SELECT
            id,
            rasp_piket::text
        FROM public."CompositionOfLinerObjectPikets"
    '
)
AS t(
    id uuid,
    rasp_piket text
);


/* ============================================================
   6. ПОЛУЧАЕМ СУЩЕСТВУЮЩИЕ СВЯЗИ
      ТОЧКА <-> ТРУБОПРОВОД
   ============================================================ */

DROP TABLE IF EXISTS tmp_nsi_pipeline_links;

CREATE TEMP TABLE tmp_nsi_pipeline_links AS
SELECT *
FROM dblink(
    'neo_nsi_conn',
    '
        SELECT
            id,
            naim_tr
        FROM public."CompositionOfLinearObjectPipelines"
    '
)
AS t(
    id uuid,
    naim_tr uuid
);


/* ============================================================
   7. РАЗБИВАЕМ ПИКЕТЫ

   Например:
       ПК1+00; ПК5+20

   превращается в две строки.
   ============================================================ */

DROP TABLE IF EXISTS tmp_source_pikets;

CREATE TEMP TABLE tmp_source_pikets AS
SELECT DISTINCT
    s.id,
    trim(x.rasp_piket) AS rasp_piket
FROM tmp_point_source s
CROSS JOIN LATERAL
    unnest(string_to_array(s.rasp_piket, ';')) AS x(rasp_piket)
WHERE s.rasp_piket IS NOT NULL
  AND NULLIF(trim(x.rasp_piket), '') IS NOT NULL;


/* ============================================================
   8. РАЗБИВАЕМ naim_tr

   Сохраняем логику старого этапа 2:
       одно поле может содержать несколько трубопроводов
       через ;
   ============================================================ */

DROP TABLE IF EXISTS tmp_source_pipeline_names;

CREATE TEMP TABLE tmp_source_pipeline_names AS
SELECT DISTINCT
    s.id,
    trim(x.pipeline_name) AS pipeline_name
FROM tmp_point_source s
CROSS JOIN LATERAL
    unnest(string_to_array(s.naim_tr, ';')) AS x(pipeline_name)
WHERE s.naim_tr IS NOT NULL
  AND NULLIF(trim(x.pipeline_name), '') IS NOT NULL;


