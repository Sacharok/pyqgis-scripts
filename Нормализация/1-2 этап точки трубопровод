/* ============================================================
   12. ПРИМЕНЯЕМ НАКОПЛЕННЫЕ ОБЩИЕ ИСПРАВЛЕНИЯ

   Сначала ищется правило конкретного ДЗО.
   Если его нет — глобальное правило dzo='*'.

   Сейчас реализуем поля:
       naim
       class_name
       teh_hrkt
       rasp_piket
       primechan
   ============================================================ */


/* ---------- NAIM ---------- */

WITH matches AS
(
    SELECT
        s.id,
        m.normalized_value,

        row_number() OVER
        (
            PARTITION BY s.id

            ORDER BY
                CASE
                    WHEN m.dzo = s.dzo THEN 1
                    ELSE 2
                END,
                m.map_id
        ) AS rn

    FROM public."OT_Truboprovod_P_klass_prav" s

    JOIN norm.point_value_map m
      ON m.field_name = 'naim'
     AND m.is_active
     AND m.dzo IN (s.dzo, '*')
     AND m.source_key = norm.text_key(s.naim)
)

UPDATE public."OT_Truboprovod_P_klass_prav" s

SET naim = m.normalized_value

FROM matches m

WHERE s.id = m.id
  AND m.rn = 1;


