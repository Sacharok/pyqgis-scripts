/* ============================================================
   18. СОПОСТАВЛЯЕМ funk_nazn

   ПРИОРИТЕТ:

   1. Уже сохранённое решение пользователя.
   2. Точное совпадение со справочником.
   3. Если одинаковых записей несколько —
      выбираем минимальный UUID.
   4. Если ничего нет — UNRESOLVED.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_resolution;

CREATE TEMP TABLE tmp_point_purpose_resolution AS

WITH exact_matches AS
(
    SELECT
        v.dzo,
        v.source_key,

        count(p.id) AS exact_count,

        min(p.id::text)::uuid AS chosen_id

    FROM tmp_point_purpose_values v

    LEFT JOIN tmp_point_nsi_purposes p
      ON p.match_key = v.source_key

    GROUP BY
        v.dzo,
        v.source_key
)

SELECT
    v.dzo,

    v.source_value,

    v.source_key,

    v.objects_count,

    e.exact_count,


    CASE

        /* Сохранённое решение существует
           и UUID всё ещё существует в НСИ */

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NOT NULL
        THEN saved.purpose_id


        /* Сохранённый UUID исчез из НСИ.
           Автоматически другой не выбираем. */

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NULL
        THEN NULL


        /* Сохранённого решения нет.
           Используем точное совпадение. */

        ELSE e.chosen_id

    END AS target_id,


    CASE

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NOT NULL
            THEN 'SAVED'

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NULL
            THEN 'SAVED_TARGET_MISSING'

        WHEN e.exact_count = 1
            THEN 'EXACT'

        WHEN e.exact_count > 1
            THEN 'EXACT_DUPLICATE'

        ELSE 'UNRESOLVED'

    END AS resolution_method


FROM tmp_point_purpose_values v

JOIN exact_matches e
  ON e.dzo = v.dzo
 AND e.source_key = v.source_key


LEFT JOIN norm.point_purpose_map saved
  ON saved.dzo = v.dzo
 AND saved.source_key = v.source_key
 AND saved.is_active


LEFT JOIN tmp_point_nsi_purposes saved_target
  ON saved_target.id = saved.purpose_id;


/* ============================================================
   19. funk_nazn:
       ПРИМЕНЯЕМ ТОЛЬКО НАДЁЖНЫЕ РЕШЕНИЯ

       SAVED
       EXACT
       EXACT_DUPLICATE

   Fuzzy здесь пока ничего не меняет.
   ============================================================ */

UPDATE public."OT_Truboprovod_P_klass_prav" s

SET funk_nazn = p.naim

FROM tmp_point_purpose_resolution r

JOIN tmp_point_nsi_purposes p
  ON p.id = r.target_id

WHERE s.dzo = r.dzo

  AND norm.text_key(s.funk_nazn)
      = r.source_key

  AND r.resolution_method IN
  (
      'SAVED',
      'EXACT',
      'EXACT_DUPLICATE'
  );


/* ============================================================
   20. РАЗБИВАЕМ naim_tr ПО ;

   Важно для точек, относящихся сразу
   к нескольким трубопроводам.

   WITH ORDINALITY сохраняет исходный порядок.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_parts;

CREATE TEMP TABLE tmp_point_pipeline_parts AS

SELECT
    s.id,

    s.dzo,

    part_no::integer AS part_no,

    btrim(part_value) AS source_value,

    norm.text_key(
        btrim(part_value)
    ) AS source_key

FROM public."OT_Truboprovod_P_klass_prav" s

CROSS JOIN LATERAL

    unnest(
        string_to_array(
            s.naim_tr,
            ';'
        )
    )

WITH ORDINALITY AS x
(
    part_value,
    part_no
)

WHERE s.naim_tr IS NOT NULL

  AND NULLIF(
      btrim(part_value),
      ''
  ) IS NOT NULL;


/* ============================================================
   21. УНИКАЛЬНЫЕ ЗНАЧЕНИЯ naim_tr
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_values;

CREATE TEMP TABLE tmp_point_pipeline_values AS

SELECT
    dzo,

    source_key,

    min(source_value) AS source_value,

    count(DISTINCT id) AS objects_count

FROM tmp_point_pipeline_parts

GROUP BY
    dzo,
    source_key;


/* ============================================================
   22. СОПОСТАВЛЕНИЕ naim_tr → Pipelines

   ПРИОРИТЕТ:

   SAVED
       пользователь уже принимал решение

   EXACT
       найден один Pipeline

   EXACT_DUPLICATE
       найдено несколько строк Pipelines
       с тем же названием

       → выбираем минимальный UUID
       → загрузку не блокируем
       → ниже показываем WARNING

   UNRESOLVED
       точного совпадения нет
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_resolution;

CREATE TEMP TABLE tmp_point_pipeline_resolution AS

WITH exact_matches AS
(
    SELECT
        v.dzo,

        v.source_key,

        count(p.id) AS exact_count,

        min(p.id::text)::uuid AS chosen_id

    FROM tmp_point_pipeline_values v

    LEFT JOIN tmp_point_nsi_pipelines p
      ON p.match_key = v.source_key

    GROUP BY
        v.dzo,
        v.source_key
)

SELECT
    v.dzo,

    v.source_value,

    v.source_key,

    v.objects_count,

    e.exact_count,


    CASE

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NOT NULL
            THEN saved.pipeline_id

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NULL
            THEN NULL

        ELSE e.chosen_id

    END AS target_id,


    CASE

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NOT NULL
            THEN 'SAVED'

        WHEN saved.map_id IS NOT NULL
         AND saved_target.id IS NULL
            THEN 'SAVED_TARGET_MISSING'

        WHEN e.exact_count = 1
            THEN 'EXACT'

        WHEN e.exact_count > 1
            THEN 'EXACT_DUPLICATE'

        ELSE 'UNRESOLVED'

    END AS resolution_method


FROM tmp_point_pipeline_values v

JOIN exact_matches e
  ON e.dzo = v.dzo
 AND e.source_key = v.source_key


LEFT JOIN norm.point_pipeline_map saved
  ON saved.dzo = v.dzo
 AND saved.source_key = v.source_key
 AND saved.is_active


LEFT JOIN tmp_point_nsi_pipelines saved_target
  ON saved_target.id = saved.pipeline_id;


/* ============================================================
   23. ВОССТАНАВЛИВАЕМ naim_tr

   Найденные значения заменяем на каноническое
   название из Pipelines.

   Ненайденное значение оставляем как есть.

   Если было:

       Трубопровод А; Трубопровод Б

   порядок сохраняется.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_rebuild;

CREATE TEMP TABLE tmp_point_pipeline_rebuild AS

SELECT
    part.id,

    string_agg
    (
        COALESCE
        (
            pipeline.naim_tr,
            part.source_value
        ),

        '; '

        ORDER BY part.part_no
    ) AS normalized_naim_tr


FROM tmp_point_pipeline_parts part


LEFT JOIN tmp_point_pipeline_resolution r
  ON r.dzo = part.dzo
 AND r.source_key = part.source_key


LEFT JOIN tmp_point_nsi_pipelines pipeline
  ON pipeline.id = r.target_id


GROUP BY part.id;


/* ============================================================
   24. ПРИМЕНЯЕМ НОРМАЛИЗОВАННЫЙ naim_tr
   ============================================================ */

UPDATE public."OT_Truboprovod_P_klass_prav" s

SET naim_tr = r.normalized_naim_tr

FROM tmp_point_pipeline_rebuild r

WHERE r.id = s.id;


/* ============================================================
   25. FUZZY-КАНДИДАТЫ ДЛЯ funk_nazn

   Только для тех значений,
   которые не удалось определить ранее.

   Берём максимум 5 наиболее похожих вариантов.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_candidates_raw;

CREATE TEMP TABLE tmp_point_purpose_candidates_raw AS

SELECT
    unresolved.dzo,

    unresolved.source_value,

    unresolved.source_key,

    unresolved.objects_count,

    candidate.id AS candidate_id,

    candidate.naim AS candidate_value,

    candidate.similarity_value

FROM tmp_point_purpose_resolution unresolved

JOIN LATERAL
(
    SELECT
        p.id,

        p.naim,

        similarity
        (
            unresolved.source_key,
            p.match_key
        ) AS similarity_value

    FROM tmp_point_nsi_purposes p

    WHERE similarity
    (
        unresolved.source_key,
        p.match_key
    ) >=
    (
        SELECT candidate_min_similarity
        FROM tmp_point_norm_config
        LIMIT 1
    )

    ORDER BY
        similarity_value DESC,
        p.id::text

    LIMIT 5

) candidate ON true

WHERE unresolved.resolution_method IN
(
    'UNRESOLVED',
    'SAVED_TARGET_MISSING'
);


/* ============================================================
   26. РАНЖИРУЕМ КАНДИДАТОВ funk_nazn
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_candidates;

CREATE TEMP TABLE tmp_point_purpose_candidates AS

WITH ranked AS
(
    SELECT
        c.*,

        row_number() OVER
        (
            PARTITION BY
                dzo,
                source_key

            ORDER BY
                similarity_value DESC,
                candidate_id::text
        ) AS candidate_rank

    FROM tmp_point_purpose_candidates_raw c
),

candidate_stats AS
(
    SELECT
        dzo,
        source_key,

        max(similarity_value)
            FILTER (
                WHERE candidate_rank = 1
            ) AS best_similarity,

        max(similarity_value)
            FILTER (
                WHERE candidate_rank = 2
            ) AS second_similarity

    FROM ranked

    GROUP BY
        dzo,
        source_key
)

SELECT
    r.dzo,

    r.source_value,

    r.objects_count,

    r.candidate_rank,

    r.candidate_id,

    r.candidate_value,

    round(
        r.similarity_value::numeric,
        4
    ) AS similarity_value,


    CASE

        WHEN r.candidate_rank <> 1
            THEN 'ALTERNATIVE'


        WHEN s.best_similarity >=
        (
            SELECT high_similarity
            FROM tmp_point_norm_config
            LIMIT 1
        )

        AND
        (
            s.second_similarity IS NULL

            OR

            s.best_similarity
            - s.second_similarity
            >=
            (
                SELECT high_similarity_gap
                FROM tmp_point_norm_config
                LIMIT 1
            )
        )
            THEN 'HIGH_CONFIDENCE'


        ELSE 'NEED_REVIEW'

    END AS decision_hint


FROM ranked r

JOIN candidate_stats s
  ON s.dzo = r.dzo
 AND s.source_key = r.source_key;


