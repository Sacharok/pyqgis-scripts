/* ============================================================
   9. ПРОВЕРЯЕМ РАБОЧУЮ ТАБЛИЦУ

   Она должна:
   - существовать;
   - содержать данные только одного ДЗО.
   ============================================================ */

DO $$
DECLARE
    v_dzo_count integer;
    v_dzo text;
BEGIN

    IF to_regclass(
        'public."OT_Truboprovod_P_klass_prav"'
    ) IS NULL THEN

        RAISE EXCEPTION
            'Не найдена таблица OT_Truboprovod_P_klass_prav';

    END IF;


    SELECT
        count(DISTINCT dzo),
        min(dzo)

    INTO
        v_dzo_count,
        v_dzo

    FROM public."OT_Truboprovod_P_klass_prav"
    WHERE dzo IS NOT NULL;


    IF v_dzo_count = 0 THEN

        RAISE EXCEPTION
            'В OT_Truboprovod_P_klass_prav не заполнено dzo';

    END IF;


    IF v_dzo_count > 1 THEN

        RAISE EXCEPTION
            'В таблице находится больше одного ДЗО';

    END IF;


    RAISE NOTICE
        'Нормализация POINT. Текущее ДЗО: %',
        v_dzo;

END $$;


