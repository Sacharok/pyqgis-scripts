       /* ============================================================
   НОРМАЛИЗАЦИЯ ТРУБОПРОВОДОВ
   ТОЧЕЧНЫЕ ОБЪЕКТЫ — POINT

   БЛОК 1Б.
   Сверка нормализованных данных со справочниками neo_nsi.

   ЗАПУСКАТЬ:
       ПОСЛЕ текущего скрипта нормализации
       ДО этапа 2 загрузки в neo_nsi.

   Рабочая таблица:
       public."OT_Truboprovod_P_klass_prav"

   ВАЖНО:
   - norm.point_* — постоянные локальные таблицы.
     Они хранят накопленные решения между запусками.

   - tmp_point_* — временные таблицы.
     Они исчезнут после закрытия текущей сессии.

   - В neo_nsi этот скрипт НИЧЕГО НЕ ЗАПИСЫВАЕТ.

   - При одинаковых naim_tr в Pipelines один UUID выбирается
     автоматически, как фактически происходило раньше.
     Но теперь выбор детерминированный: минимальный UUID.

   - Нечёткое (fuzzy) соответствие пока только предлагает
     кандидатов и ничего автоматически не меняет.
   ============================================================ */


/* ============================================================
   0. СЛУЖЕБНЫЕ РАСШИРЕНИЯ

   dblink  — подключение к neo_nsi.
   pg_trgm — поиск похожих строк.
   ============================================================ */

CREATE EXTENSION IF NOT EXISTS dblink;
CREATE EXTENSION IF NOT EXISTS pg_trgm;


/* ============================================================
   1. ОТДЕЛЬНАЯ СХЕМА ДЛЯ НАКОПЛЕННЫХ ПРАВИЛ

   norm.point_*     — точки
   norm.line_*      — будут линии
   norm.polygon_*   — будут площадные объекты
   ============================================================ */

CREATE SCHEMA IF NOT EXISTS norm;


/* ============================================================
   2. ФУНКЦИЯ ПОДГОТОВКИ ТЕКСТА ДЛЯ СРАВНЕНИЯ

   Она НЕ изменяет исходное поле.

   Используется только для поиска соответствий:

       лишние пробелы → один пробел
       Enter/TAB      → пробел
       регистр        → нижний
       ё              → е

   Пунктуацию и цифры не удаляем.
   ============================================================ */

CREATE OR REPLACE FUNCTION norm.text_key(p_text text)
RETURNS text
LANGUAGE sql
IMMUTABLE
PARALLEL SAFE
AS $$
    SELECT
        CASE
            WHEN p_text IS NULL THEN NULL
            ELSE replace(
                lower(
                    btrim(
                        regexp_replace(
                            replace(
                                regexp_replace(
                                    p_text,
                                    E'[\r\n\t]+',
                                    ' ',
                                    'g'
                                ),
                                chr(160),
                                ' '
                            ),
                            '[[:space:]]+',
                            ' ',
                            'g'
                        )
                    )
                ),
                'ё',
                'е'
            )
        END;
$$;


/* ============================================================
   3. ПОСТОЯННАЯ ТАБЛИЦА ОБЫЧНЫХ ИЗВЕСТНЫХ ИСПРАВЛЕНИЙ

   СЮДА ПОЗЖЕ БУДЕМ ПЕРЕНОСИТЬ СТАРЫЕ UPDATE.

   Например:

       кран К1 → Кран К1

   dzo = '*'
       правило действует для всех ДЗО.

   dzo = 'YGEO'
       только для YGEO.

   ВАЖНО:
   naim_tr и funk_nazn сюда НЕ помещаем.
   Для них ниже будут отдельные таблицы,
   поскольку они связаны с UUID справочников.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_value_map
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL DEFAULT '*',

    field_name varchar(50) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (norm.text_key(source_value))
        STORED,

    normalized_value text,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_value_map_field_chk
        CHECK (
            field_name IN
            (
                'naim',
                'class_name',
                'teh_hrkt',
                'rasp_piket',
                'primechan'
            )
        ),

    CONSTRAINT point_value_map_unique
        UNIQUE (dzo, field_name, source_key)
);


/* ============================================================
   4. РЕШЕНИЯ ПО funk_nazn

   Здесь хранится уже ПРИНЯТОЕ решение:

   исходный текст
       ↓
   UUID PurposesOfPipelineNetworkObjects

   Решение сохраняется между поставками.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_purpose_map
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (norm.text_key(source_value))
        STORED,

    purpose_id uuid NOT NULL,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_purpose_map_unique
        UNIQUE (dzo, source_key)
);


/* ============================================================
   5. РЕШЕНИЯ ПО naim_tr

   Исходное название
       ↓
   конкретный Pipelines.id

   Это особенно важно:
   решение сохраняем по UUID, а не просто
   "неправильное название → правильное название".
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_pipeline_map
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (norm.text_key(source_value))
        STORED,

    pipeline_id uuid NOT NULL,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_pipeline_map_unique
        UNIQUE (dzo, source_key)
);


/* ============================================================
   6. ИСКЛЮЧЕНИЯ ДЛЯ КОНКРЕТНОЙ ТОЧКИ

   Старый скрипт содержит много правил вида:

       конкретный трубопровод
       + конкретный пикет
       + конкретный объект
       → конкретная характеристика

   Это НЕ общие ошибки.

   Такие правила постепенно будем переносить сюда.

   Поскольку id точек у нас сохраняются,
   надёжнее привязывать исключение непосредственно к id.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_object_override
(
    object_id uuid NOT NULL,

    field_name varchar(50) NOT NULL,

    override_value text,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_object_override_pk
        PRIMARY KEY (object_id, field_name),

    CONSTRAINT point_object_override_field_chk
        CHECK (
            field_name IN
            (
                'naim',
                'naim_tr',
                'class_name',
                'class_code',
                'rasp_piket',
                'funk_nazn',
                'teh_hrkt',
                'primechan'
            )
        )
);


