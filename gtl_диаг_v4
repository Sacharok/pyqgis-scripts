# -*- coding: utf-8 -*-
"""
Диагностика v4 сопоставления исходного листа «Сегменты» с текущей таблицей GasPipeSegments.

Что делает скрипт:
- ТОЛЬКО читает данные из текущего проекта QGIS и исходный Excel/TSV;
- НЕ изменяет PostgreSQL и слои QGIS;
- сначала сопоставляет обычные физические строки как мультимножество;
- учитывает, что в БД StartGtsPointId/EndGtsPointId могут быть развернуты относительно Excel,
  при этом StartKilometer и Length остаются исходными;
- строки с «Обратное» и «кольцо» рассматривает как производное представление того же
  физического сегмента и разрешает им ссылаться на уже использованный GasPipeSegments;
- формирует отдельный XLSX с диагностикой.

Запуск:
1. В QGIS должны быть загружены: GasPipeSegments, GtsPoints, GasPipelines,
   TransGases, Regions.
2. Модули -> Консоль Python -> Показать редактор.
3. Открыть этот .py и нажать «Запустить сценарий».
4. Выбрать ИСХОДНЫЙ файл с таблицей «Сегменты» (.xlsx/.xlsm или .txt/.tsv).
5. Выбрать место сохранения диагностического XLSX.
"""

import csv
import math
import re
from collections import Counter, defaultdict, deque
from decimal import Decimal, InvalidOperation
from pathlib import Path

from qgis.core import QgsProject
from qgis.PyQt.QtCore import QDate, QDateTime, QUuid, QStandardPaths
from qgis.PyQt.QtWidgets import QFileDialog, QMessageBox

try:
    from openpyxl import Workbook, load_workbook
    from openpyxl.styles import Alignment, Font, PatternFill
    from openpyxl.utils import get_column_letter
except ImportError:
    QMessageBox.critical(
        None,
        "Не найден openpyxl",
        "В Python QGIS не установлена библиотека openpyxl."
    )
    raise


REQUIRED_LAYERS = [
    "GasPipeSegments",
    "GtsPoints",
    "GasPipelines",
    "TransGases",
    "Regions",
]

EXPECTED_SOURCE_COUNT = 5677
_FIELD_MAP_CACHE = {}


# ---------------------------------------------------------------------------
# БАЗОВЫЕ ФУНКЦИИ QGIS
# ---------------------------------------------------------------------------

def clean_value(value):
    if value is None:
        return None
    if isinstance(value, QDateTime):
        return value.toPyDateTime()
    if isinstance(value, QDate):
        return value.toPyDate()
    if isinstance(value, QUuid):
        return value.toString().strip("{}")
    if isinstance(value, float) and math.isnan(value):
        return None
    text = str(value).strip()
    if text.upper() in {"NULL", "NONE", "<NULL>"}:
        return None
    return value


def uuid_key(value):
    value = clean_value(value)
    if value is None:
        return None
    return str(value).strip().strip("{}").lower()


def get_layer(name):
    project = QgsProject.instance()
    exact = project.mapLayersByName(name)
    if exact:
        return exact[0]
    wanted = name.casefold()
    for layer in project.mapLayers().values():
        if layer.name().casefold() == wanted:
            return layer
    return None


def get_field_map(layer):
    if layer is None:
        return {}
    lid = layer.id()
    if lid not in _FIELD_MAP_CACHE:
        _FIELD_MAP_CACHE[lid] = {
            field.name().casefold(): field.name()
            for field in layer.fields()
        }
    return _FIELD_MAP_CACHE[lid]


def attr(layer, feature, *candidates, default=None):
    if layer is None or feature is None:
        return default
    fmap = get_field_map(layer)
    for candidate in candidates:
        actual = fmap.get(candidate.casefold())
        if actual is not None:
            value = clean_value(feature[actual])
            return default if value is None else value
    return default


def build_index(layer, *id_candidates):
    result = {}
    if layer is None:
        return result
    candidates = id_candidates or ("Id", "id")
    for feature in layer.getFeatures():
        value = attr(layer, feature, *candidates)
        key = uuid_key(value)
        if key:
            result[key] = feature
    return result


def lookup_feature(index, value):
    return index.get(uuid_key(value))


def display_value(layer, index, foreign_id, *field_candidates):
    feature = lookup_feature(index, foreign_id)
    if feature is None:
        return None
    return attr(layer, feature, *field_candidates)


# ---------------------------------------------------------------------------
# НОРМАЛИЗАЦИЯ ДЛЯ СОПОСТАВЛЕНИЯ
# ---------------------------------------------------------------------------

def norm_text(value):
    value = clean_value(value)
    if value is None:
        return ""
    text = str(value).replace("\xa0", " ")
    text = re.sub(r"\s+", " ", text).strip()
    return text.casefold()


def norm_num(value):
    value = clean_value(value)
    if value is None or str(value).strip() == "":
        return ""
    if isinstance(value, bool):
        return "1" if value else "0"
    text = str(value).replace("\xa0", "").replace(" ", "").replace(",", ".").strip()
    try:
        number = Decimal(text)
    except (InvalidOperation, ValueError):
        return norm_text(value)
    if number == 0:
        return "0"
    return format(number.normalize(), "f")


def display_clean(value):
    value = clean_value(value)
    if value is None:
        return None
    return value


STRUCTURAL_FIELDS = ["pipeline", "start_km", "start_point", "length", "end_point"]
EXTENDED_FIELDS = ["power", "pressure", "diameter", "state", "transgas", "remark", "region"]
ALL_ORDINARY_FIELDS = STRUCTURAL_FIELDS + EXTENDED_FIELDS


def record_key(record, fields):
    result = []
    for field in fields:
        if field in {"start_km", "length", "power", "pressure", "diameter"}:
            result.append(norm_num(record.get(field)))
        else:
            result.append(norm_text(record.get(field)))
    return tuple(result)


def structural_key(record):
    return record_key(record, STRUCTURAL_FIELDS)


def full_key(record):
    return record_key(record, ALL_ORDINARY_FIELDS)


def point_pair(record):
    a = norm_text(record.get("start_point"))
    b = norm_text(record.get("end_point"))
    return tuple(sorted((a, b)))


def structural_key_unordered(record):
    return (
        norm_text(record.get("pipeline")),
        norm_num(record.get("start_km")),
        point_pair(record),
        norm_num(record.get("length")),
    )


def full_key_unordered(record):
    return structural_key_unordered(record) + tuple(
        norm_num(record.get(field)) if field in {"power", "pressure", "diameter"}
        else norm_text(record.get(field))
        for field in EXTENDED_FIELDS
    )


def derived_key(record):
    # Для «Обратное»/«кольцо» StartKilometer может соответствовать другому концу
    # того же физического участка, поэтому его намеренно НЕ включаем.
    return (
        norm_text(record.get("pipeline")),
        point_pair(record),
        norm_num(record.get("length")),
    )


def is_derived_source(record):
    return norm_text(record.get("attr_field")) in {"обратное", "кольцо"}


def mismatch_fields(source, db):
    mismatches = []
    for field in EXTENDED_FIELDS:
        if field in {"power", "pressure", "diameter"}:
            left = norm_num(source.get(field))
            right = norm_num(db.get(field))
        else:
            left = norm_text(source.get(field))
            right = norm_text(db.get(field))
        if left != right:
            mismatches.append(field)
    return mismatches


# ---------------------------------------------------------------------------
# ЧТЕНИЕ ИСХОДНИКА
# ---------------------------------------------------------------------------

def normalize_header(value):
    if value is None:
        return ""
    return re.sub(r"\s+", " ", str(value).replace("\xa0", " ")).strip().casefold()


def detect_header(row):
    headers = [normalize_header(v) for v in row]
    return (
        "атрибутивное поле" in headers
        and "наименование" in headers
        and "начало участка, км" in headers
        and "точка начала" in headers
        and "длина, км" in headers
        and "точка конца" in headers
    )


def make_header_map(row):
    result = {}
    for idx, value in enumerate(row):
        h = normalize_header(value)
        if h == "атрибутивное поле":
            result["attr_field"] = idx
        elif h == "наименование":
            result["pipeline"] = idx
        elif h == "начало участка, км":
            result["start_km"] = idx
        elif h == "точка начала":
            result["start_point"] = idx
        elif h == "длина, км":
            result["length"] = idx
        elif h == "точка конца":
            result["end_point"] = idx
        elif h == "обратное направление":
            result["reverse_direction"] = idx
        elif h.startswith("мощность,"):
            result["power"] = idx
        elif h.startswith("давление,"):
            result["pressure"] = idx
        elif h.startswith("диаметр труб,"):
            result["diameter"] = idx
        elif h == "состояние газопровода":
            result["state"] = idx
        elif h == "принадлежность к трансгазу":
            result["transgas"] = idx
        elif h == "примечание":
            result["remark"] = idx
        elif h == "субъект рф":
            result["region"] = idx
        elif h.startswith("точки перемычки"):
            result["switch_flag"] = idx
    return result


def row_value(row, hmap, field):
    idx = hmap.get(field)
    if idx is None or idx >= len(row):
        return None
    return row[idx]


def parse_source_data(rows):
    header_index = None
    hmap = None
    for i, row in enumerate(rows[:50]):
        if detect_header(row):
            header_index = i
            hmap = make_header_map(row)
            break
    if header_index is None:
        raise RuntimeError("Не найдена строка заголовков таблицы «Сегменты».")

    required = set(STRUCTURAL_FIELDS)
    missing = sorted(required - set(hmap))
    if missing:
        raise RuntimeError("В исходнике не найдены колонки: " + ", ".join(missing))

    records = []
    for source_row_number, row in enumerate(rows[header_index + 1:], start=header_index + 2):
        record = {
            "source_row": source_row_number,
            "attr_field": row_value(row, hmap, "attr_field"),
            "pipeline": row_value(row, hmap, "pipeline"),
            "start_km": row_value(row, hmap, "start_km"),
            "start_point": row_value(row, hmap, "start_point"),
            "length": row_value(row, hmap, "length"),
            "end_point": row_value(row, hmap, "end_point"),
            "reverse_direction": row_value(row, hmap, "reverse_direction"),
            "power": row_value(row, hmap, "power"),
            "pressure": row_value(row, hmap, "pressure"),
            "diameter": row_value(row, hmap, "diameter"),
            "state": row_value(row, hmap, "state"),
            "transgas": row_value(row, hmap, "transgas"),
            "remark": row_value(row, hmap, "remark"),
            "region": row_value(row, hmap, "region"),
            "switch_flag": row_value(row, hmap, "switch_flag"),
        }

        # Реальная строка сегмента должна иметь хотя бы название и две точки.
        if not norm_text(record["pipeline"]):
            continue
        if not norm_text(record["start_point"]) and not norm_text(record["end_point"]):
            continue
        records.append(record)

    return records


def load_source_records(path):
    suffix = Path(path).suffix.lower()

    if suffix in {".xlsx", ".xlsm"}:
        wb = load_workbook(path, read_only=True, data_only=True)
        try:
            sheets = []
            if "Сегменты" in wb.sheetnames:
                sheets.append(wb["Сегменты"])
            sheets.extend(ws for ws in wb.worksheets if ws.title != "Сегменты")

            last_error = None
            for ws in sheets:
                rows = [list(row) for row in ws.iter_rows(values_only=True)]
                try:
                    return parse_source_data(rows), ws.title
                except RuntimeError as exc:
                    last_error = exc
            raise last_error or RuntimeError("Лист с таблицей «Сегменты» не найден.")
        finally:
            wb.close()

    if suffix in {".txt", ".tsv", ".csv"}:
        with open(path, "r", encoding="utf-8-sig", newline="") as f:
            rows = list(csv.reader(f, delimiter="\t", quotechar='"'))
        return parse_source_data(rows), Path(path).name

    raise RuntimeError("Поддерживаются .xlsx, .xlsm, .txt, .tsv.")


