def main():
    layers = {name: get_layer(name) for name in REQUIRED_LAYERS}
    missing = [name for name, layer in layers.items() if layer is None]
    if missing:
        QMessageBox.critical(
            None,
            "Не хватает слоёв",
            "Загрузите в проект QGIS:\n\n" + "\n".join(missing),
        )
        return

    source_path, _ = QFileDialog.getOpenFileName(
        None,
        "Выберите ИСХОДНЫЙ файл с таблицей «Сегменты»",
        "",
        "Источник (*.xlsx *.xlsm *.txt *.tsv);;Все файлы (*.*)",
    )
    if not source_path:
        return

    desktop = QStandardPaths.writableLocation(QStandardPaths.DesktopLocation)
    default_output = str(Path(desktop) / "Диагностика_сегментов_v4.xlsx")
    output_path, _ = QFileDialog.getSaveFileName(
        None,
        "Сохранить диагностику",
        default_output,
        "Excel (*.xlsx)",
    )
    if not output_path:
        return
    if not output_path.lower().endswith(".xlsx"):
        output_path += ".xlsx"

    try:
        source_records, source_name = load_source_records(source_path)
        db_records = build_db_records(layers)
        results, used_db, ambiguous = match_records(source_records, db_records)
        write_report(
            output_path,
            source_name,
            source_records,
            db_records,
            results,
            used_db,
            ambiguous,
        )
    except Exception as exc:
        QMessageBox.critical(
            None,
            "Ошибка диагностики",
            f"{type(exc).__name__}: {exc}",
        )
        raise

    counts = Counter(r["status"] for r in results)
    QMessageBox.information(
        None,
        "Диагностика готова",
        "Файл сохранён:\n"
        f"{output_path}\n\n"
        f"Исходник: {len(source_records)}\n"
        f"БД: {len(db_records)}\n"
        f"Точно (порядок): {counts.get('ТОЧНО_ПОРЯДОК', 0)}\n"
        f"Точно (разворот): {counts.get('ТОЧНО_РАЗВОРОТ', 0)}\n"
        f"Резерв: {counts.get('РЕЗЕРВ_ПОРЯДОК', 0) + counts.get('РЕЗЕРВ_РАЗВОРОТ', 0)}\n"
        f"Производные: {counts.get('ПРОИЗВОДНАЯ_ПОВТОР', 0) + counts.get('ПРОИЗВОДНАЯ_СЕГМЕНТ', 0)}\n"
        f"Неоднозначно: {counts.get('НЕОДНОЗНАЧНО', 0)}\n"
        f"Не найдено: {counts.get('НЕ НАЙДЕНО', 0)}\n"
        f"Не использовано БД: {len(db_records) - len(used_db)}",
    )


main()
