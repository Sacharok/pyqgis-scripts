def build_db_records(layers):
    segment_layer = layers["GasPipeSegments"]
    gts_layer = layers["GtsPoints"]
    pipeline_layer = layers["GasPipelines"]
    transgas_layer = layers["TransGases"]
    region_layer = layers["Regions"]

    gts_index = build_index(gts_layer)
    pipeline_index = build_index(pipeline_layer)
    transgas_index = build_index(transgas_layer)
    region_index = build_index(region_layer)

    records = []
    for feature in segment_layer.getFeatures():
        segment_id = attr(segment_layer, feature, "Id", "id")
        start_id = attr(segment_layer, feature, "StartGtsPointId")
        end_id = attr(segment_layer, feature, "EndGtsPointId")
        pipeline_id = attr(segment_layer, feature, "GasPipelineId")
        transgas_id = attr(segment_layer, feature, "TransGasId")
        region_id = attr(segment_layer, feature, "RegionId")

        record = {
            "segment_id": segment_id,
            "pipeline": display_value(pipeline_layer, pipeline_index, pipeline_id, "Name", "naim"),
            "start_km": attr(segment_layer, feature, "StartKilometer"),
            "start_point": display_value(gts_layer, gts_index, start_id, "Name", "naim"),
            "length": attr(segment_layer, feature, "Length"),
            "end_point": display_value(gts_layer, gts_index, end_id, "Name", "naim"),
            "power": attr(segment_layer, feature, "Power"),
            "pressure": attr(segment_layer, feature, "Pressure"),
            "diameter": attr(segment_layer, feature, "Diameter"),
            "state": attr(segment_layer, feature, "State"),
            "transgas": display_value(transgas_layer, transgas_index, transgas_id, "Name", "naim"),
            "remark": attr(segment_layer, feature, "Remark"),
            "region": display_value(region_layer, region_index, region_id, "Name", "naim"),
        }
        records.append(record)
    return records


# ---------------------------------------------------------------------------
# СОПОСТАВЛЕНИЕ КАК МУЛЬТИМНОЖЕСТВО
# ---------------------------------------------------------------------------

def match_records(source_records, db_records):
    ordered_full_pool = defaultdict(list)
    unordered_full_pool = defaultdict(list)
    ordered_struct_pool = defaultdict(list)
    unordered_struct_pool = defaultdict(list)
    derived_pool = defaultdict(list)

    for db_idx, db in enumerate(db_records):
        ordered_full_pool[full_key(db)].append(db_idx)
        unordered_full_pool[full_key_unordered(db)].append(db_idx)
        ordered_struct_pool[structural_key(db)].append(db_idx)
        unordered_struct_pool[structural_key_unordered(db)].append(db_idx)
        derived_pool[derived_key(db)].append(db_idx)

    used_db = set()
    results = [None] * len(source_records)
    ambiguous = []

    def choose_unique(candidates, src, allow_used=False):
        if not allow_used:
            candidates = [i for i in candidates if i not in used_db]
        if not candidates:
            return None, [], 0, False

        scored = []
        for db_idx in candidates:
            mismatches = mismatch_fields(src, db_records[db_idx])
            scored.append((len(mismatches), db_idx, mismatches))
        scored.sort(key=lambda x: (x[0], str(db_records[x[1]].get("segment_id") or "")))

        best_score = scored[0][0]
        best = [item for item in scored if item[0] == best_score]
        if len(best) == 1:
            return best[0][1], best[0][2], len(candidates), False

        # Если несколько кандидатов дают НОЛЬ отличий от исходной строки,
        # для Excel они эквивалентны: различается только UUID записи БД.
        if best_score == 0:
            return best[0][1], best[0][2], len(candidates), False

        # Если лучшие кандидаты одинаковы по обычным атрибутам, UUID не важен.
        signatures = {full_key_unordered(db_records[item[1]]) for item in best}
        if len(signatures) == 1:
            return best[0][1], best[0][2], len(candidates), False

        return None, [], len(candidates), True

    # ------------------------------------------------------------------
    # ШАГИ 1–4: физические строки (не «Обратное» и не «кольцо»).
    # ------------------------------------------------------------------
    for src_idx, src in enumerate(source_records):
        if is_derived_source(src):
            continue

        # 1. Полное совпадение с тем же порядком точек.
        candidates = ordered_full_pool.get(full_key(src), [])
        db_idx, mismatches, count, amb = choose_unique(candidates, src)
        if db_idx is not None:
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "ТОЧНО_ПОРЯДОК",
                "db_idx": db_idx,
                "mismatches": mismatches,
                "candidate_count": count,
            }
            continue

        # 2. Полное совпадение, но точки начала/конца в БД могут быть развернуты.
        candidates = unordered_full_pool.get(full_key_unordered(src), [])
        db_idx, mismatches, count, amb = choose_unique(candidates, src)
        if db_idx is not None:
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "ТОЧНО_РАЗВОРОТ",
                "db_idx": db_idx,
                "mismatches": mismatches,
                "candidate_count": count,
            }
            continue

        # 3. Резерв: структурный ключ с тем же порядком.
        candidates = ordered_struct_pool.get(structural_key(src), [])
        db_idx, mismatches, count, amb = choose_unique(candidates, src)
        if db_idx is not None:
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "РЕЗЕРВ_ПОРЯДОК",
                "db_idx": db_idx,
                "mismatches": mismatches,
                "candidate_count": count,
            }
            continue

        # 4. Резерв: структурный ключ без учета направления точек.
        candidates = unordered_struct_pool.get(structural_key_unordered(src), [])
        db_idx, mismatches, count, amb = choose_unique(candidates, src)
        if db_idx is not None:
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "РЕЗЕРВ_РАЗВОРОТ",
                "db_idx": db_idx,
                "mismatches": mismatches,
                "candidate_count": count,
            }
            continue

        # Если кандидаты были, но остались реально неоднозначными.
        all_candidates = [
            i for i in unordered_struct_pool.get(structural_key_unordered(src), [])
            if i not in used_db
        ]
        if all_candidates:
            scored = []
            for i in all_candidates:
                mm = mismatch_fields(src, db_records[i])
                scored.append((len(mm), i, mm))
            results[src_idx] = {
                "status": "НЕОДНОЗНАЧНО",
                "db_idx": None,
                "mismatches": [],
                "candidate_count": len(all_candidates),
            }
            ambiguous.append((src_idx, scored))
        else:
            results[src_idx] = {
                "status": "НЕ НАЙДЕНО",
                "db_idx": None,
                "mismatches": [],
                "candidate_count": 0,
            }

    # ------------------------------------------------------------------
    # ШАГ 5: производные строки «Обратное»/«кольцо».
    # Они могут ссылаться на ТОТ ЖЕ GasPipeSegments, который уже использован.
    # StartKilometer не участвует в ключе: у обратной строки он может быть
    # километражом другого конца физического участка.
    # ------------------------------------------------------------------
    for src_idx, src in enumerate(source_records):
        if not is_derived_source(src):
            continue

        candidates = derived_pool.get(derived_key(src), [])
        if not candidates:
            results[src_idx] = {
                "status": "НЕ НАЙДЕНО",
                "db_idx": None,
                "mismatches": [],
                "candidate_count": 0,
            }
            continue

        # Сначала предпочитаем уже использованный физический сегмент:
        used_candidates = [i for i in candidates if i in used_db]
        pool = used_candidates if used_candidates else candidates
        db_idx, mismatches, count, amb = choose_unique(pool, src, allow_used=True)

        if db_idx is not None:
            was_used = db_idx in used_db
            used_db.add(db_idx)
            results[src_idx] = {
                "status": "ПРОИЗВОДНАЯ_ПОВТОР" if was_used else "ПРОИЗВОДНАЯ_СЕГМЕНТ",
                "db_idx": db_idx,
                "mismatches": mismatches,
                "candidate_count": len(candidates),
            }
        else:
            scored = []
            for i in pool:
                mm = mismatch_fields(src, db_records[i])
                scored.append((len(mm), i, mm))
            results[src_idx] = {
                "status": "НЕОДНОЗНАЧНО",
                "db_idx": None,
                "mismatches": [],
                "candidate_count": len(pool),
            }
            ambiguous.append((src_idx, scored))

    return results, used_db, ambiguous


def endpoint_pair_key(record):
    """Газопровод + две конечные точки без учета направления."""
    return (
        norm_text(record.get("pipeline")),
        point_pair(record),
    )


def pipeline_point_key(record, point_field):
    return (
        norm_text(record.get("pipeline")),
        norm_text(record.get(point_field)),
    )


def analyze_not_found(source_records, db_records, results, used_db):
    """
    Уточняет причины строк НЕ НАЙДЕНО.

    Для строк, где прямая связь между теми же двумя точками в БД есть,
    отдельно различает:
    - КАНДИДАТ_УЖЕ_ИСПОЛЬЗОВАН: все такие DB-сегменты уже заняты другой
      исходной строкой;
    - ОТЛИЧАЕТСЯ_START_KM;
    - ОТЛИЧАЕТСЯ_LENGTH;
    - ОТЛИЧАЕТСЯ_START_KM_LENGTH.

    Остальные категории:
    - ОБЕ_ТОЧКИ_ЕСТЬ_БЕЗ_ПРЯМОЙ;
    - ТОЛЬКО_ОДНА_ТОЧКА;
    - ТОЧКИ_НЕ_НАЙДЕНЫ.
    """
    pair_pool = defaultdict(list)
    point_pool = defaultdict(list)

    for db_idx, db in enumerate(db_records):
        pair_pool[endpoint_pair_key(db)].append(db_idx)
        pipeline = norm_text(db.get("pipeline"))
        a = norm_text(db.get("start_point"))
        b = norm_text(db.get("end_point"))
        if a:
            point_pool[(pipeline, a)].append(db_idx)
        if b:
            point_pool[(pipeline, b)].append(db_idx)

    analysis = []

    for src_idx, (src, result) in enumerate(zip(source_records, results)):
        if result["status"] != "НЕ НАЙДЕНО":
            continue

        direct = pair_pool.get(endpoint_pair_key(src), [])
        unused_direct = [i for i in direct if i not in used_db]

        pipeline = norm_text(src.get("pipeline"))
        start_name = norm_text(src.get("start_point"))
        end_name = norm_text(src.get("end_point"))
        start_incident = point_pool.get((pipeline, start_name), []) if start_name else []
        end_incident = point_pool.get((pipeline, end_name), []) if end_name else []

        scored = []
        best_db_idx = None
        diff_fields_all = []

        if direct:
            # Показываем лучший физический кандидат независимо от того,
            # занят он другой строкой или нет.
            candidate_pool = unused_direct if unused_direct else direct
            for db_idx in candidate_pool:
                db = db_records[db_idx]

                diff_fields = []
                if norm_num(src.get("start_km")) != norm_num(db.get("start_km")):
                    diff_fields.append("start_km")
                if norm_num(src.get("length")) != norm_num(db.get("length")):
                    diff_fields.append("length")
                diff_fields.extend(mismatch_fields(src, db))

                scored.append((len(diff_fields), db_idx, diff_fields))

            scored.sort(key=lambda x: (x[0], str(db_records[x[1]].get("segment_id") or "")))
            best_score, best_db_idx, diff_fields_all = scored[0]

            if not unused_direct:
                category = "КАНДИДАТ_УЖЕ_ИСПОЛЬЗОВАН"
            else:
                km_diff = "start_km" in diff_fields_all
                len_diff = "length" in diff_fields_all
                if km_diff and len_diff:
                    category = "ОТЛИЧАЕТСЯ_START_KM_LENGTH"
                elif km_diff:
                    category = "ОТЛИЧАЕТСЯ_START_KM"
                elif len_diff:
                    category = "ОТЛИЧАЕТСЯ_LENGTH"
                else:
                    # Теоретически сюда попадать не должны: если start_km и length
                    # совпадают, резервный структурный ключ v3 уже нашел бы строку.
                    category = "ПРОЧЕЕ_ПРЯМАЯ_СВЯЗЬ"
        elif start_incident and end_incident:
            category = "ОБЕ_ТОЧКИ_ЕСТЬ_БЕЗ_ПРЯМОЙ"
        elif start_incident or end_incident:
            category = "ТОЛЬКО_ОДНА_ТОЧКА"
        else:
            category = "ТОЧКИ_НЕ_НАЙДЕНЫ"

        analysis.append({
            "src_idx": src_idx,
            "category": category,
            "direct": direct,
            "unused_direct": unused_direct,
            "scored": scored,
            "best_db_idx": best_db_idx,
            "best_diff_fields": diff_fields_all,
            "start_incident": start_incident,
            "end_incident": end_incident,
        })

    return analysis


