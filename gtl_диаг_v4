def style_sheet(ws, freeze="A2"):
    ws.freeze_panes = freeze
    ws.sheet_view.showGridLines = False
    fill = PatternFill("solid", fgColor="1F4E78")
    font = Font(color="FFFFFF", bold=True)
    for cell in ws[1]:
        cell.fill = fill
        cell.font = font
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    for column_cells in ws.columns:
        values = [str(c.value) for c in column_cells if c.value is not None]
        if not values:
            continue
        width = min(max(max(len(v) for v in values) + 2, 10), 45)
        ws.column_dimensions[get_column_letter(column_cells[0].column)].width = width


def append_record_values(ws, prefix, record):
    ws.append(prefix + [
        display_clean(record.get("attr_field")),
        display_clean(record.get("pipeline")),
        display_clean(record.get("start_km")),
        display_clean(record.get("start_point")),
        display_clean(record.get("length")),
        display_clean(record.get("end_point")),
        display_clean(record.get("reverse_direction")),
        display_clean(record.get("power")),
        display_clean(record.get("pressure")),
        display_clean(record.get("diameter")),
        display_clean(record.get("state")),
        display_clean(record.get("transgas")),
        display_clean(record.get("remark")),
        display_clean(record.get("region")),
        display_clean(record.get("switch_flag")),
    ])


def write_report(path, source_name, source_records, db_records, results, used_db, ambiguous):
    wb = Workbook()
    wb.remove(wb.active)

    status_counts = Counter(r["status"] for r in results)
    not_found_analysis = analyze_not_found(source_records, db_records, results, used_db)
    cause_counts = Counter(item["category"] for item in not_found_analysis)

    # 1. Итог
    ws = wb.create_sheet("Итог")
    ws.append(["Показатель", "Значение"])
    summary = [
        ("Источник", source_name),
        ("Строк исходника", len(source_records)),
        ("Ожидалось строк исходника", EXPECTED_SOURCE_COUNT),
        ("GasPipeSegments в БД", len(db_records)),
        ("ТОЧНО_ПОРЯДОК", status_counts.get("ТОЧНО_ПОРЯДОК", 0)),
        ("ТОЧНО_РАЗВОРОТ", status_counts.get("ТОЧНО_РАЗВОРОТ", 0)),
        ("РЕЗЕРВ_ПОРЯДОК", status_counts.get("РЕЗЕРВ_ПОРЯДОК", 0)),
        ("РЕЗЕРВ_РАЗВОРОТ", status_counts.get("РЕЗЕРВ_РАЗВОРОТ", 0)),
        ("ПРОИЗВОДНАЯ_ПОВТОР", status_counts.get("ПРОИЗВОДНАЯ_ПОВТОР", 0)),
        ("ПРОИЗВОДНАЯ_СЕГМЕНТ", status_counts.get("ПРОИЗВОДНАЯ_СЕГМЕНТ", 0)),
        ("НЕОДНОЗНАЧНО", status_counts.get("НЕОДНОЗНАЧНО", 0)),
        ("НЕ НАЙДЕНО", status_counts.get("НЕ НАЙДЕНО", 0)),
        ("--- причины НЕ НАЙДЕНО ---", ""),
        ("КАНДИДАТ_УЖЕ_ИСПОЛЬЗОВАН", cause_counts.get("КАНДИДАТ_УЖЕ_ИСПОЛЬЗОВАН", 0)),
        ("ОТЛИЧАЕТСЯ_START_KM", cause_counts.get("ОТЛИЧАЕТСЯ_START_KM", 0)),
        ("ОТЛИЧАЕТСЯ_LENGTH", cause_counts.get("ОТЛИЧАЕТСЯ_LENGTH", 0)),
        ("ОТЛИЧАЕТСЯ_START_KM_LENGTH", cause_counts.get("ОТЛИЧАЕТСЯ_START_KM_LENGTH", 0)),
        ("ПРОЧЕЕ_ПРЯМАЯ_СВЯЗЬ", cause_counts.get("ПРОЧЕЕ_ПРЯМАЯ_СВЯЗЬ", 0)),
        ("ОБЕ_ТОЧКИ_ЕСТЬ_БЕЗ_ПРЯМОЙ", cause_counts.get("ОБЕ_ТОЧКИ_ЕСТЬ_БЕЗ_ПРЯМОЙ", 0)),
        ("ТОЛЬКО_ОДНА_ТОЧКА", cause_counts.get("ТОЛЬКО_ОДНА_ТОЧКА", 0)),
        ("ТОЧКИ_НЕ_НАЙДЕНЫ", cause_counts.get("ТОЧКИ_НЕ_НАЙДЕНЫ", 0)),
        ("Использовано строк БД", len(used_db)),
        ("Не использовано строк БД", len(db_records) - len(used_db)),
    ]
    for row in summary:
        ws.append(row)
    style_sheet(ws)

    # Общие заголовки исходной строки.
    src_headers = [
        "Атрибутивное поле", "Наименование", "Начало участка, км", "Точка начала",
        "Длина, км", "Точка конца", "Обратное направление", "Мощность",
        "Давление", "Диаметр", "Состояние", "ТрансГаз", "Примечание",
        "Субъект РФ", "Флаг перемычки",
    ]

    # 2. Все сопоставления.
    ws = wb.create_sheet("Сопоставление")
    ws.append([
        "Строка исходника", "Статус", "SegmentId", "Кандидатов",
        "Отличаются поля",
    ] + src_headers)
    for src, result in zip(source_records, results):
        db_idx = result["db_idx"]
        segment_id = db_records[db_idx].get("segment_id") if db_idx is not None else None
        append_record_values(
            ws,
            [
                src["source_row"], result["status"], segment_id,
                result["candidate_count"], ", ".join(result["mismatches"]),
            ],
            src,
        )
    style_sheet(ws)

    # 3. Не найдено.
    ws = wb.create_sheet("Не_найдено")
    ws.append(["Строка исходника", "Статус"] + src_headers)
    for src, result in zip(source_records, results):
        if result["status"] == "НЕ НАЙДЕНО":
            append_record_values(ws, [src["source_row"], result["status"]], src)
    style_sheet(ws)

    # 4. Неоднозначно — показываем каждого кандидата.
    ws = wb.create_sheet("Неоднозначно")
    ws.append([
        "Строка исходника", "Кандидатов", "SegmentId кандидата", "Число отличий",
        "Отличаются поля", "Наименование", "Начало участка, км", "Точка начала",
        "Длина, км", "Точка конца", "Мощность БД", "Давление БД", "Диаметр БД",
        "Состояние БД", "ТрансГаз БД", "Примечание БД", "Субъект РФ БД",
    ])
    for src_idx, scored in ambiguous:
        src = source_records[src_idx]
        for score, db_idx, mismatches in scored:
            db = db_records[db_idx]
            ws.append([
                src["source_row"], len(scored), db.get("segment_id"), score,
                ", ".join(mismatches), src.get("pipeline"), src.get("start_km"),
                src.get("start_point"), src.get("length"), src.get("end_point"),
                db.get("power"), db.get("pressure"), db.get("diameter"), db.get("state"),
                db.get("transgas"), db.get("remark"), db.get("region"),
            ])
    style_sheet(ws)

    # 5. Причины строк "НЕ НАЙДЕНО".
    ws = wb.create_sheet("Причины_не_найдено")
    ws.append([
        "Строка исходника", "Категория", "Прямых кандидатов",
        "Свободных прямых кандидатов", "Лучший SegmentId",
        "Отличаются поля",
        "Сегментов у точки начала", "Сегментов у точки конца",
        "Атрибутивное поле", "Наименование", "Начало участка, км",
        "Точка начала", "Длина, км", "Точка конца", "Обратное направление",
        "Флаг перемычки",
    ])
    for item in not_found_analysis:
        src = source_records[item["src_idx"]]
        best_id = ""
        if item.get("best_db_idx") is not None:
            best_id = db_records[item["best_db_idx"]].get("segment_id")
        ws.append([
            src["source_row"], item["category"], len(item["direct"]),
            len(item.get("unused_direct", [])), best_id,
            ", ".join(item.get("best_diff_fields", [])),
            len(item["start_incident"]), len(item["end_incident"]),
            src.get("attr_field"), src.get("pipeline"), src.get("start_km"),
            src.get("start_point"), src.get("length"), src.get("end_point"),
            src.get("reverse_direction"), src.get("switch_flag"),
        ])
    style_sheet(ws)

    # 6. Если прямая связь между исходными точками в БД есть,
    # показываем реальные значения кандидатов и то, чем они отличаются.
    ws = wb.create_sheet("Прямые_кандидаты")
    ws.append([
        "Строка исходника", "Категория", "Кандидатов", "Свободных кандидатов",
        "SegmentId", "Кандидат уже использован", "Число отличий",
        "Отличаются поля",
        "Исходник: начало км", "БД: начало км",
        "Исходник: точка начала", "БД: точка начала",
        "Исходник: длина", "БД: длина",
        "Исходник: точка конца", "БД: точка конца",
        "Мощность БД", "Давление БД", "Диаметр БД",
        "Состояние БД", "ТрансГаз БД", "Примечание БД", "Субъект РФ БД",
    ])
    for item in not_found_analysis:
        if not item["direct"]:
            continue
        src = source_records[item["src_idx"]]
        for score, db_idx, mismatches in item["scored"]:
            db = db_records[db_idx]
            ws.append([
                src["source_row"], item["category"], len(item["direct"]),
                len(item.get("unused_direct", [])), db.get("segment_id"),
                "ДА" if db_idx in used_db else "",
                score, ", ".join(mismatches),
                src.get("start_km"), db.get("start_km"),
                src.get("start_point"), db.get("start_point"),
                src.get("length"), db.get("length"),
                src.get("end_point"), db.get("end_point"),
                db.get("power"), db.get("pressure"), db.get("diameter"),
                db.get("state"), db.get("transgas"), db.get("remark"), db.get("region"),
            ])
    style_sheet(ws)

    # 7. Неиспользованные строки БД.
    ws = wb.create_sheet("Лишние_БД")
    ws.append([
        "SegmentId", "Наименование", "Начало участка, км", "Точка начала", "Длина, км",
        "Точка конца", "Мощность", "Давление", "Диаметр", "Состояние", "ТрансГаз",
        "Примечание", "Субъект РФ",
    ])
    for i, db in enumerate(db_records):
        if i in used_db:
            continue
        ws.append([
            db.get("segment_id"), db.get("pipeline"), db.get("start_km"), db.get("start_point"),
            db.get("length"), db.get("end_point"), db.get("power"), db.get("pressure"),
            db.get("diameter"), db.get("state"), db.get("transgas"), db.get("remark"),
            db.get("region"),
        ])
    style_sheet(ws)

    # 8. Разница кратности по структурному ключу.
    source_counter = Counter(structural_key(r) for r in source_records)
    db_counter = Counter(structural_key(r) for r in db_records)
    keys = sorted(
        set(source_counter) | set(db_counter),
        key=lambda k: tuple(str(x) for x in k),
    )

    ws = wb.create_sheet("Кратность")
    ws.append([
        "Наименование(norm)", "Начало км(norm)", "Точка начала(norm)",
        "Длина(norm)", "Точка конца(norm)", "Исходник", "БД", "БД-Исходник",
    ])
    for key in keys:
        src_count = source_counter.get(key, 0)
        db_count = db_counter.get(key, 0)
        if src_count == db_count:
            continue
        ws.append(list(key) + [src_count, db_count, db_count - src_count])
    style_sheet(ws)

    wb.save(path)


