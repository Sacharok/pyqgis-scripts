/* ============================================================
   04_POINT_BGD_PUBLISH

   Запись готовых точек:

       bgd_PAO
       +
       bgd_<DZO>

   НИКАКИХ TRUNCATE.

   Новый id      -> INSERT
   Существующий  -> UPDATE
   ============================================================ */


DROP TABLE IF EXISTS tmp_point_bgd_config;

CREATE TEMP TABLE tmp_point_bgd_config
(
    host_name text NOT NULL,

    port_no integer NOT NULL,

    user_name text NOT NULL,

    user_password text NOT NULL,

    pao_database text NOT NULL
);


