/* ============================================================
   31. ИТОГ №8 — ТОЧНЫЕ ДУБЛИ PIPELINES

   Это НЕ ошибка.

   selected_pipeline_id уже выбран автоматически.
   ============================================================ */

SELECT
    dzo,
    source_value,
    objects_count,
    exact_count,
    selected_pipeline_id

FROM tmp_point_pipeline_resolution

