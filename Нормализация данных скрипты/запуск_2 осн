/* ============================================================
   2. ПРОВЕРКА: ЕСТЬ ЛИ ДАННЫЕ
   ============================================================ */

DO $$
DECLARE
    v_count bigint;
BEGIN

    SELECT count(*)
    INTO v_count
    FROM public."OT_Truboprovod_P_input";


    IF v_count = 0 THEN

        RAISE EXCEPTION
            'OT_Truboprovod_P_input пуста. Сначала загрузите SHP через QGIS.';

    END IF;

END $$;


/* ============================================================
   3. ПРОВЕРКА DZO

   Неизвестное или NULL DZO блокирует дальнейшую обработку.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_bad_dzo;

CREATE TEMP TABLE tmp_point_bad_dzo AS

SELECT
    i.id,
    i.dzo,
    i.naim,
    i.naim_tr

FROM public."OT_Truboprovod_P_input" i

LEFT JOIN norm.point_dzo d
    ON d.dzo = i.dzo
   AND d.is_active

WHERE i.dzo IS NULL
   OR d.dzo IS NULL;


DO $$
DECLARE
    v_count bigint;
BEGIN

    SELECT count(*)
    INTO v_count
    FROM tmp_point_bad_dzo;


    IF v_count > 0 THEN

        RAISE EXCEPTION
            'Обнаружено строк с пустым/неизвестным DZO: %. Посмотрите tmp_point_bad_dzo.',
            v_count;

    END IF;

END $$;


/* ============================================================
   4. ФИКСИРУЕМ ПРОИСХОЖДЕНИЕ ID

   Если id уже был:
       SOURCE

   Если id NULL:
       сначала помечаем GENERATED,
       затем создаём UUID.

   При повторном запуске значение уже не меняется.
   ============================================================ */

UPDATE public."OT_Truboprovod_P_input"
SET id_origin = 'SOURCE'
WHERE id IS NOT NULL
  AND id_origin IS NULL;


UPDATE public."OT_Truboprovod_P_input"
SET
    id = uuid_generate_v4(),
    id_origin = 'GENERATED'
WHERE id IS NULL;


/* ============================================================
   5. ПРОВЕРЯЕМ ДУБЛИ ID ВНУТРИ ПОСТАВКИ
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_duplicate_ids;

CREATE TEMP TABLE tmp_point_duplicate_ids AS

SELECT
    id,
    count(*) AS rows_count

FROM public."OT_Truboprovod_P_input"

GROUP BY id

HAVING count(*) > 1;


DO $$
DECLARE
    v_count bigint;
BEGIN

    SELECT count(*)
    INTO v_count
    FROM tmp_point_duplicate_ids;


    IF v_count > 0 THEN

        RAISE EXCEPTION
            'В поставке есть повторяющиеся id. Посмотрите tmp_point_duplicate_ids.';

    END IF;

END $$;


/* ============================================================
   6. СОЗДАЁМ READY ИЗ INPUT

   INPUT дальше не нормализуем.

   Все изменения выполняются только в READY.
   ============================================================ */

TRUNCATE TABLE ready."OT_Truboprovod_P_klass_prav";


INSERT INTO ready."OT_Truboprovod_P_klass_prav"
(
    id,
    geom,
    class_code,
    class_name,
    naim_tr,
    naim,
    rasp_piket,
    funk_nazn,
    teh_hrkt,
    primechan,
    dzo
)

SELECT
    id,
    geom,
    class_code,
    class_name,
    naim_tr,
    naim,
    rasp_piket,
    funk_nazn,
    teh_hrkt,
    primechan,
    dzo

FROM public."OT_Truboprovod_P_input";


/* ============================================================
   7. УНИВЕРСАЛЬНАЯ ТЕХНИЧЕСКАЯ ОЧИСТКА

   Здесь только безопасные операции.
   ============================================================ */


/* ---------- Enter / Tab / повторные пробелы ---------- */

UPDATE ready."OT_Truboprovod_P_klass_prav"

SET
    class_name = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(class_name, E'[\r\n\t]+', ' ', 'g'),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    naim_tr = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(naim_tr, E'[\r\n\t]+', ' ', 'g'),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    naim = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(naim, E'[\r\n\t]+', ' ', 'g'),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    rasp_piket = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(rasp_piket, E'[\r\t]+', ' ', 'g'),
                '[ ]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    funk_nazn = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(funk_nazn, E'[\r\n\t]+', ' ', 'g'),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    teh_hrkt = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(teh_hrkt, E'[\r\n\t]+', ' ', 'g'),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    primechan = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(primechan, E'[\r\n\t]+', ' ', 'g'),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    );


/* ---------- служебные "-" и "—" -> NULL ---------- */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET
    class_name =
        CASE WHEN class_name IN ('-', '—') THEN NULL ELSE class_name END,

    naim_tr =
        CASE WHEN naim_tr IN ('-', '—') THEN NULL ELSE naim_tr END,

    naim =
        CASE WHEN naim IN ('-', '—') THEN NULL ELSE naim END,

    rasp_piket =
        CASE WHEN rasp_piket IN ('-', '—') THEN NULL ELSE rasp_piket END,

    funk_nazn =
        CASE WHEN funk_nazn IN ('-', '—') THEN NULL ELSE funk_nazn END,

    teh_hrkt =
        CASE WHEN teh_hrkt IN ('-', '—') THEN NULL ELSE teh_hrkt END,

    primechan =
        CASE WHEN primechan IN ('-', '—') THEN NULL ELSE primechan END;


/* ---------- внешние двойные кавычки ---------- */

UPDATE ready."OT_Truboprovod_P_klass_prav"

SET
    naim_tr = btrim(naim_tr, '"'),
    naim = btrim(naim, '"'),
    funk_nazn = btrim(funk_nazn, '"'),
    teh_hrkt = btrim(teh_hrkt, '"');


/* ---------- заглавная первая буква ---------- */

UPDATE ready."OT_Truboprovod_P_klass_prav"

SET naim =
    upper(left(naim, 1))
    || substring(naim, 2)

WHERE naim ~ '^[а-яё]';


UPDATE ready."OT_Truboprovod_P_klass_prav"

SET funk_nazn =
    upper(left(funk_nazn, 1))
    || substring(funk_nazn, 2)

WHERE funk_nazn ~ '^[а-яё]';


/* ---------- teh_hrkt ---------- */

UPDATE ready."OT_Truboprovod_P_klass_prav"

SET teh_hrkt =
    replace(
        replace(
            teh_hrkt,
            'Ленейный',
            'Линейный'
        ),
        'Pу',
        'Ру'
    )

WHERE teh_hrkt IS NOT NULL;


/* ---------- лишняя запятая в конце ---------- */

UPDATE ready."OT_Truboprovod_P_klass_prav"

SET teh_hrkt =
    regexp_replace(
        teh_hrkt,
        ',\s*$',
        ''
    )

WHERE teh_hrkt ~ ',\s*$';


/* ============================================================
   8. БАЗОВАЯ НОРМАЛИЗАЦИЯ ПИКЕТОВ
   ============================================================ */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket = replace(rasp_piket, '.', ',')
WHERE rasp_piket IS NOT NULL;


UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        E'[\n]+',
        '; ',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '\s+[Ии]\s+',
        '; ',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* П12 -> ПК12 */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        'П(\d+)',
        'ПК\1',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* ПК12 -> ПК12+00 */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(^|;\s*)(ПК\d+)(?=;|$)',
        '\1\2+00',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* ПК12+0 -> ПК12+00 */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '\+0(?=\D|$)',
        '+00',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* Убираем пробелы внутри ПК */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(ПК)\s*(\d+)\s*\+\s*(\d+)',
        '\1\2+\3',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* 12+50 -> ПК12+50 */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '^(\d+\+\d+)',
        'ПК\1'
    )
WHERE rasp_piket IS NOT NULL;


/* ПК12-15 -> ПК12+00; ПК15+00 */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(ПК\s*\d+)-(\d+)',
        '\1+00; ПК\2+00',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* разделитель / или - между полноценными пикетами */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(ПК\d+(?:\+\d+)?(?:,\d+)?)\s*[/-]\s*(?:ПК)?(\d+(?:\+\d+)?(?:,\d+)?)',
        '\1; ПК\2',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* Приводим ; к единому виду */

UPDATE ready."OT_Truboprovod_P_klass_prav"
SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '\s*;\s*',
        '; ',
        'g'
    )
WHERE rasp_piket IS NOT NULL;


/* ============================================================
   9. КЛАССЫ
   ============================================================ */

UPDATE ready."OT_Truboprovod_P_klass_prav" s

SET
    class_name = m.class_name,
    class_code = m.class_code

FROM norm.point_class_map m

WHERE m.is_active

  AND norm.text_key(s.class_name)
      = norm.text_key(m.class_name);


