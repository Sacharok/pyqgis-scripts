/* ============================================================
   33. СООТВЕТСТВИЕ naim_tr -> Pipeline UUID

   ПРИОРИТЕТ:

   1. SAVED
      ранее подтверждённое решение;

   2. EXACT
      обычное точное совпадение;

   3. EXACT_DUPLICATE
      несколько абсолютно одинаковых Pipelines;

   4. TECHNICAL_EXACT
      совпадение после технической нормализации;

   5. TECHNICAL_EXACT_DUPLICATE
      несколько технически одинаковых Pipelines;

   6. UNRESOLVED
      переходим к fuzzy.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_resolution;

CREATE TEMP TABLE tmp_point_pipeline_resolution AS

WITH strict_match AS
(
    SELECT
        v.dzo,
        v.source_key,

        count(n.id)
            AS strict_count,

        min(n.id::text)::uuid
            AS strict_id

    FROM tmp_point_pipeline_values v

    LEFT JOIN tmp_point_nsi_pipelines n
      ON n.match_key = v.source_key

    GROUP BY
        v.dzo,
        v.source_key
),

technical_match AS
(
    SELECT
        v.dzo,
        v.source_key,

        count(n.id)
            AS technical_count,

        min(n.id::text)::uuid
            AS technical_id

    FROM tmp_point_pipeline_values v

    LEFT JOIN tmp_point_nsi_pipelines n

      ON n.technical_key =
         v.technical_key

     /*
        Если в исходном названии присутствуют числа,
        они должны совпасть.
     */
     AND
     (
         v.numeric_signature IS NULL

         OR

         n.numeric_signature =
         v.numeric_signature
     )

    GROUP BY
        v.dzo,
        v.source_key
),

saved_ranked AS
(
    SELECT
        v.dzo,
        v.source_key,

        m.pipeline_id,

        row_number() OVER
        (
            PARTITION BY
                v.dzo,
                v.source_key

            ORDER BY
                CASE
                    WHEN m.dzo = v.dzo
                        THEN 1
                    ELSE 2
                END,

                m.map_id
        ) AS rn

    FROM tmp_point_pipeline_values v

    JOIN normalization."OT_Truboprovod_P_pipeline_map" m

      ON m.is_active

     AND m.dzo IN
         (
             v.dzo,
             '*'
         )

     AND m.source_key =
         v.source_key
),

saved AS
(
    SELECT
        dzo,
        source_key,
        pipeline_id

    FROM saved_ranked

    WHERE rn = 1
)

SELECT
    v.dzo,

    v.source_key,

    v.technical_key,

    v.numeric_signature,

    v.source_value,

    v.objects_count,

    s.strict_count
        AS exact_count,

    t.technical_count,


    CASE

        /* Ранее сохранённое решение */

        WHEN saved.pipeline_id IS NOT NULL
         AND saved_target.id IS NOT NULL
            THEN saved.pipeline_id


        /* Сохранённый UUID исчез из neo_nsi */

        WHEN saved.pipeline_id IS NOT NULL
         AND saved_target.id IS NULL
            THEN NULL


        /* Обычное точное совпадение */

        WHEN s.strict_count > 0
            THEN s.strict_id


        /* Техническое точное совпадение */

        WHEN t.technical_count > 0
            THEN t.technical_id


        ELSE NULL

    END AS selected_pipeline_id,


    CASE

        WHEN saved.pipeline_id IS NOT NULL
         AND saved_target.id IS NOT NULL
            THEN 'SAVED'


        WHEN saved.pipeline_id IS NOT NULL
         AND saved_target.id IS NULL
            THEN 'SAVED_TARGET_MISSING'


        WHEN s.strict_count = 1
            THEN 'EXACT'


        WHEN s.strict_count > 1
            THEN 'EXACT_DUPLICATE'


        WHEN t.technical_count = 1
            THEN 'TECHNICAL_EXACT'


        WHEN t.technical_count > 1
            THEN 'TECHNICAL_EXACT_DUPLICATE'


        ELSE 'UNRESOLVED'

    END AS resolution_method


FROM tmp_point_pipeline_values v

JOIN strict_match s
  ON s.dzo = v.dzo
 AND s.source_key = v.source_key

JOIN technical_match t
  ON t.dzo = v.dzo
 AND t.source_key = v.source_key

LEFT JOIN saved
  ON saved.dzo = v.dzo
 AND saved.source_key = v.source_key

LEFT JOIN tmp_point_nsi_pipelines saved_target
  ON saved_target.id =
     saved.pipeline_id;

/* ============================================================
   34. FUZZY-КАНДИДАТЫ funk_nazn
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_candidates;

CREATE TEMP TABLE tmp_point_purpose_candidates AS

WITH ranked AS
(
    SELECT

        u.dzo,

        u.source_key,

        u.source_value,

        u.objects_count,

        n.id
            AS candidate_id,

        n.naim
            AS candidate_value,

        similarity(
            u.source_key,
            n.match_key
        )
        AS similarity_value,

        row_number() OVER
        (
            PARTITION BY
                u.dzo,
                u.source_key

            ORDER BY
                similarity(
                    u.source_key,
                    n.match_key
                ) DESC,

                n.id::text
        )
        AS candidate_rank

    FROM tmp_point_purpose_resolution u

    JOIN tmp_point_nsi_purposes n

      ON similarity(
             u.source_key,
             n.match_key
         )
         >=
         (
             SELECT fuzzy_min
             FROM tmp_point_config
             LIMIT 1
         )

    WHERE u.resolution_method IN
    (
        'UNRESOLVED',
        'SAVED_TARGET_MISSING'
    )
),

top_ranked AS
(
    SELECT *

    FROM ranked

    WHERE candidate_rank <=
    (
        SELECT fuzzy_top
        FROM tmp_point_config
        LIMIT 1
    )
),

candidate_stats AS
(
    SELECT

        dzo,
        source_key,

        max(similarity_value)
            FILTER
            (
                WHERE candidate_rank = 1
            )
            AS best_similarity,

        max(similarity_value)
            FILTER
            (
                WHERE candidate_rank = 2
            )
            AS second_similarity

    FROM top_ranked

    GROUP BY
        dzo,
        source_key
)

SELECT

    r.dzo,

    r.source_key,

    r.source_value,

    r.objects_count,

    r.candidate_rank,

    r.candidate_id,

    r.candidate_value,

    r.similarity_value,


    CASE

        WHEN r.candidate_rank <> 1
            THEN 'ALTERNATIVE'


        WHEN s.best_similarity >=
        (
            SELECT fuzzy_high
            FROM tmp_point_config
            LIMIT 1
        )

        AND
        (
            s.second_similarity IS NULL

            OR

            s.best_similarity
            -
            s.second_similarity

            >=
            (
                SELECT fuzzy_gap
                FROM tmp_point_config
                LIMIT 1
            )
        )

            THEN 'HIGH_CONFIDENCE'


        ELSE 'NEED_REVIEW'

    END
    AS decision_hint


FROM top_ranked r

JOIN candidate_stats s
  ON s.dzo = r.dzo
 AND s.source_key = r.source_key;


/* ============================================================
   35. FUZZY-КАНДИДАТЫ naim_tr

   Теперь учитываем не только similarity,
   но и совпадение числовых обозначений.

   Если источник содержит числа:
       кандидат с другими числами
       никогда не становится HIGH_CONFIDENCE.

   При ранжировании кандидат с совпадающими числами
   ставится выше кандидата с конфликтующими числами.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_candidates;

CREATE TEMP TABLE tmp_point_pipeline_candidates AS

WITH scored AS
(
    SELECT
        u.dzo,

        u.source_key,

        u.source_value,

        u.objects_count,

        u.numeric_signature
            AS source_numbers,

        n.id
            AS candidate_id,

        n.naim_tr
            AS candidate_value,

        n.numeric_signature
            AS candidate_numbers,

        similarity(
            u.source_key,
            n.match_key
        )
        AS similarity_value,


        CASE

            /*
               Если в исходном названии чисел нет,
               числового конфликта определить нельзя.
            */

            WHEN u.numeric_signature IS NULL
                THEN true


            WHEN n.numeric_signature =
                 u.numeric_signature
                THEN true


            ELSE false

        END AS numeric_compatible


    FROM tmp_point_pipeline_resolution u

    JOIN tmp_point_nsi_pipelines n

      ON similarity(
             u.source_key,
             n.match_key
         )
         >=
         (
             SELECT fuzzy_min
             FROM tmp_point_config
             LIMIT 1
         )


    WHERE u.resolution_method IN
    (
        'UNRESOLVED',
        'SAVED_TARGET_MISSING'
    )
),

ranked AS
(
    SELECT
        s.*,


        row_number() OVER
        (
            PARTITION BY
                dzo,
                source_key

            ORDER BY

                /*
                   Сначала кандидаты без конфликта номеров.
                */

                numeric_compatible DESC,

                similarity_value DESC,

                candidate_id::text
        )
        AS candidate_rank,


        /*
           Для лучшего кандидата узнаём similarity
           следующего кандидата с таким же состоянием
           numeric_compatible.
        */

        lead(similarity_value) OVER
        (
            PARTITION BY
                dzo,
                source_key,
                numeric_compatible

            ORDER BY
                similarity_value DESC,
                candidate_id::text
        )
        AS next_similarity


    FROM scored s
),

top_ranked AS
(
    SELECT *

    FROM ranked

    WHERE candidate_rank <=
    (
        SELECT fuzzy_top
        FROM tmp_point_config
        LIMIT 1
    )
)

SELECT
    dzo,

    source_key,

    source_value,

    objects_count,

    candidate_rank,

    candidate_id,

    candidate_value,

    source_numbers,

    candidate_numbers,

    numeric_compatible,

    similarity_value,


    CASE

        WHEN candidate_rank <> 1
            THEN 'ALTERNATIVE'


        /*
           Самый похожий текст,
           но конфликтуют номера.
        */

        WHEN NOT numeric_compatible
            THEN 'NUMBER_CONFLICT'


        /*
           Автоматически хороший кандидат только если:
           - номера не конфликтуют;
           - similarity высокий;
           - следующий подходящий кандидат заметно хуже.
        */

        WHEN similarity_value >=
        (
            SELECT fuzzy_high
            FROM tmp_point_config
            LIMIT 1
        )

        AND
        (
            next_similarity IS NULL

            OR

            similarity_value
            -
            next_similarity

            >=
            (
                SELECT fuzzy_gap
                FROM tmp_point_config
                LIMIT 1
            )
        )

            THEN 'HIGH_CONFIDENCE'


        ELSE 'NEED_REVIEW'

    END
    AS decision_hint


FROM top_ranked;


