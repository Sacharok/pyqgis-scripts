ORDER BY
    objects_count DESC,
    source_value;


/* ============================================================
   32. ИТОГ №9 — ПОДОЗРИТЕЛЬНЫЕ ПИКЕТЫ
   ============================================================ */

SELECT
    id,
    dzo,
    naim,
    rasp_piket

FROM ready."OT_Truboprovod_P_klass_prav"

WHERE rasp_piket IS NOT NULL

  AND
  (
       rasp_piket ~ E'[\r\n\t]'

    OR rasp_piket ~ '/'

    OR rasp_piket ~ '\s{2,}'

    OR rasp_piket !~
       '^ПК\d+\+\d+(?:,\d+)?(?:;\s*ПК\d+\+\d+(?:,\d+)?)*$'
  )

ORDER BY
    dzo,
    id;


/* ============================================================
   33. ОБЩАЯ СТАТИСТИКА
   ============================================================ */

SELECT

    (
        SELECT count(*)
        FROM ready."OT_Truboprovod_P_klass_prav"
    ) AS total_objects,

    (
        SELECT count(*)
        FROM tmp_point_operation
        WHERE operation = 'NEW'
    ) AS new_objects,

    (
        SELECT count(*)
        FROM tmp_point_operation
        WHERE operation = 'UPDATE'
    ) AS update_objects,

    (
        SELECT count(*)
        FROM tmp_point_operation
        WHERE operation LIKE 'REVIEW%'
    ) AS review_id_objects,

    (
        SELECT count(*)
        FROM tmp_point_purpose_resolution
        WHERE resolution_method = 'UNRESOLVED'
    ) AS unresolved_purposes,

    (
        SELECT count(*)
        FROM tmp_point_pipeline_resolution
        WHERE resolution_method = 'UNRESOLVED'
    ) AS unresolved_pipelines;
