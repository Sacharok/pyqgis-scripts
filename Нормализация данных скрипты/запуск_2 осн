/* ============================================================
   8. ПРОВЕРКА ДУБЛЕЙ ID ВНУТРИ ТЕКУЩЕЙ ПОСТАВКИ
   ============================================================ */

INSERT INTO normalization."OT_Truboprovod_P_issues"
(
    severity,
    issue_type,
    object_id,
    field_name,
    source_value,
    details
)

SELECT
    'ERROR',
    'DUPLICATE_ID',
    id,
    'id',
    id::text,
    'Один UUID встречается в текущей поставке '
        || count(*) || ' раз(а)'

FROM normalization."OT_Truboprovod_P_input"

GROUP BY id

HAVING count(*) > 1;


/*
 Если есть дубли, READY с PRIMARY KEY создать нельзя.
 Поэтому останавливаем выполнение.
*/

DO $$
DECLARE
    v_count bigint;
BEGIN

    SELECT count(*)
    INTO v_count

    FROM normalization."OT_Truboprovod_P_issues"

    WHERE issue_type = 'DUPLICATE_ID';


    IF v_count > 0
    THEN

        RAISE EXCEPTION
            'В текущей поставке есть повторяющиеся id. Посмотрите normalization.OT_Truboprovod_P_issues';

    END IF;

END $$;


/* ============================================================
   9. ПРОВЕРКА DZO
   ============================================================ */

INSERT INTO normalization."OT_Truboprovod_P_issues"
(
    severity,
    issue_type,
    object_id,
    dzo,
    field_name,
    source_value,
    details
)

SELECT

    'ERROR',

    CASE
        WHEN i.dzo IS NULL
            THEN 'DZO_NULL'
        ELSE 'DZO_UNKNOWN'
    END,

    i.id,

    i.dzo,

    'dzo',

    i.dzo,

    CASE
        WHEN i.dzo IS NULL
            THEN 'Для объекта не определено ДЗО'
        ELSE
            'ДЗО отсутствует в normalization.DZO'
    END

FROM normalization."OT_Truboprovod_P_input" i

LEFT JOIN normalization."DZO" d
       ON d.dzo = i.dzo
      AND d.is_active

WHERE i.dzo IS NULL
   OR d.dzo IS NULL;


/* ============================================================
   10. ПРОВЕРКА ГЕОМЕТРИИ
   ============================================================ */

INSERT INTO normalization."OT_Truboprovod_P_issues"
(
    severity,
    issue_type,
    object_id,
    dzo,
    field_name,
    details
)

SELECT
    'ERROR',
