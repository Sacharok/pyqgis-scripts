/* ============================================================
   01_POINT_PREPARE_CHECK

   ТРУБОПРОВОДЫ — ТОЧЕЧНЫЕ ОБЪЕКТЫ

   ГЛАВНЫЙ ПРОВЕРОЧНЫЙ ЗАПУСК ПОСТАВКИ.

   Выполняется В ЛОКАЛЬНОЙ БД.

   ------------------------------------------------------------
   ИСТОЧНИК:
       normalization."OT_Truboprovod_P_import"

   КАНОНИЧЕСКАЯ ПОСТАВКА:
       normalization."OT_Truboprovod_P_input"

   НОРМАЛИЗОВАННЫЙ РЕЗУЛЬТАТ:
       normalization."OT_Truboprovod_P_ready"

   ------------------------------------------------------------
   ЧТО ДЕЛАЕТ:

   1. Проверяет структуру импортированного SHP.
   2. Если input пустая:
        import -> input.
   3. Сохраняет пришедшие id.
   4. Новым объектам без id генерирует UUID.
   5. UUID закрепляется в input.
   6. Определяет ДЗО.
   7. Создаёт ready.
   8. Выполняет безопасную техническую нормализацию.
   9. Применяет накопленные правила.
   10. Читает существующие объекты из bgd_PAO.
   11. Определяет:
          NEW
          UPDATE
          NO_CHANGE
          REVIEW_UNKNOWN_ID
   12. Читает справочники из neo_nsi.
   13. Сопоставляет funk_nazn.
   14. Сопоставляет naim_tr с Pipelines.
   15. При точных дублях Pipeline автоматически
       выбирает один UUID.
   16. Для ненайденных значений строит fuzzy-кандидатов.
   17. Записывает проблемы и кандидатов в постоянные
       таблицы normalization.

   ------------------------------------------------------------
   ЧЕГО НЕ ДЕЛАЕТ:

   НИЧЕГО НЕ:
       INSERT
       UPDATE
       DELETE
   в:
       neo_nsi
       bgd_PAO
       bgd_<DZO>

   Удалённые БД используются только на чтение.
   ============================================================ */


/* ============================================================
   1. НАСТРОЙКИ ТЕКУЩЕГО ЗАПУСКА
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_config;

CREATE TEMP TABLE tmp_point_config
(
    /* Если весь файл относится к одному ДЗО:
       например 'YGEO'.

       Если в import уже есть заполненный столбец dzo
       и там могут быть разные ДЗО:
       поставить NULL.
    */
    default_dzo varchar(8),

    neo_nsi_conn text NOT NULL,

    bgd_pao_conn text NOT NULL,

    /* Ниже этого сходства кандидата даже не показываем */
    fuzzy_min double precision NOT NULL,

    /* Очень высокое сходство */
    fuzzy_high double precision NOT NULL,

    /* Насколько лучший кандидат должен быть
       лучше второго */
    fuzzy_gap double precision NOT NULL,

    /* Сколько кандидатов показывать */
    fuzzy_top integer NOT NULL,

    /* ПОКА ОСТАВЛЯЕМ FALSE.

       true в будущем позволит автоматически применять
       однозначные fuzzy-совпадения высокой уверенности.

       Сначала посмотрим реальные результаты.
    */
    apply_high_fuzzy boolean NOT NULL
);


