/* ============================================================
   37. ОПЦИОНАЛЬНОЕ АВТОМАТИЧЕСКОЕ FUZZY

   По умолчанию:
       apply_high_fuzzy = false

   Значит этот блок ничего не поменяет.

   Позднее сможем включить.
   ============================================================ */

UPDATE tmp_point_purpose_resolution r

SET
    selected_purpose_id = c.candidate_id,
    resolution_method = 'FUZZY_AUTO'

FROM tmp_point_purpose_candidates c

WHERE
    (
        SELECT apply_high_fuzzy
        FROM tmp_point_config
        LIMIT 1
    )

  AND r.dzo = c.dzo

  AND r.source_key = c.source_key

  AND r.resolution_method = 'UNRESOLVED'

  AND c.candidate_rank = 1

  AND c.decision_hint =
      'HIGH_CONFIDENCE';


UPDATE tmp_point_pipeline_resolution r

SET
    selected_pipeline_id = c.candidate_id,
    resolution_method = 'FUZZY_AUTO'

FROM tmp_point_pipeline_candidates c

WHERE
    (
        SELECT apply_high_fuzzy
        FROM tmp_point_config
        LIMIT 1
    )

  AND r.dzo = c.dzo

  AND r.source_key = c.source_key

  AND r.resolution_method = 'UNRESOLVED'

  AND c.candidate_rank = 1

  AND c.decision_hint =
      'HIGH_CONFIDENCE';


