/* ============================================================
   38. КАНОНИЧЕСКОЕ funk_nazn

   В READY остаётся ТЕКСТ,
   а не UUID.

   UUID понадобится позднее при NSI_SYNC.
   ============================================================ */

UPDATE normalization."OT_Truboprovod_P_ready" r

SET funk_nazn = n.naim

FROM tmp_point_purpose_resolution x

JOIN tmp_point_nsi_purposes n
  ON n.id = x.selected_purpose_id

WHERE r.dzo = x.dzo

  AND normalization.text_key(
          r.funk_nazn
      )
      =
      x.source_key

  AND x.resolution_method IN
  (
      'SAVED',
      'EXACT',
      'EXACT_DUPLICATE',
      'FUZZY_AUTO'
  );


/* ============================================================
   39. ВОССТАНАВЛИВАЕМ КАНОНИЧЕСКИЙ naim_tr

   Если значение определилось:
       используем название из Pipelines.

   Если нет:
       оставляем исходное.

   Порядок частей через ";" сохраняется.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_rebuild;

CREATE TEMP TABLE tmp_point_pipeline_rebuild AS

SELECT

    p.id,

    string_agg
    (
        COALESCE(
            target.naim_tr,
            p.source_value
        ),

        '; '

        ORDER BY p.part_no
    )
    AS normalized_naim_tr


FROM tmp_point_pipeline_parts p

LEFT JOIN tmp_point_pipeline_resolution r

       ON r.dzo = p.dzo

      AND r.source_key =
          p.source_key


LEFT JOIN tmp_point_nsi_pipelines target

       ON target.id =
          r.selected_pipeline_id


GROUP BY p.id;


UPDATE normalization."OT_Truboprovod_P_ready" r

SET naim_tr =
    p.normalized_naim_tr

FROM tmp_point_pipeline_rebuild p

WHERE p.id = r.id;


