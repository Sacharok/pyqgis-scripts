/* ============================================================
   24. СОПОСТАВЛЕНИЕ С bgd_PAO

   NEW
       UUID создан нами и такого UUID в BGD нет.

   UPDATE
       UUID пришёл из источника,
       существует в BGD,
       данные отличаются.

   NO_CHANGE
       UUID существует,
       но изменений после нормализации нет.

   REVIEW_UNKNOWN_ID
       UUID пришёл из источника,
       но такого UUID нет в BGD.

   ERROR_ID_COLLISION
       UUID был создан нами,
       но уже существует в BGD.
       Практически невозможная ситуация.
   ============================================================ */

WITH compared AS
(
    SELECT

        r.id,
        r.dzo,
        i.id_origin,

        b.id AS bgd_id,


        (
               b.class_code IS DISTINCT FROM r.class_code

            OR b.class_name IS DISTINCT FROM r.class_name

            OR b.naim_tr IS DISTINCT FROM r.naim_tr

            OR b.naim IS DISTINCT FROM r.naim

            OR b.rasp_piket IS DISTINCT FROM r.rasp_piket

            OR b.funk_nazn IS DISTINCT FROM r.funk_nazn

            OR b.teh_hrkt IS DISTINCT FROM r.teh_hrkt

            OR b.primechan IS DISTINCT FROM r.primechan
        )
        AS attribute_changed,


        CASE

            WHEN b.id IS NULL
                THEN NULL

            WHEN b.geom IS NULL
             AND r.geom IS NULL
                THEN false

            WHEN b.geom IS NULL
              OR r.geom IS NULL
                THEN true

            ELSE NOT ST_Equals(
                b.geom,
                r.geom
            )

        END
        AS geometry_changed


    FROM normalization."OT_Truboprovod_P_ready" r

    JOIN normalization."OT_Truboprovod_P_input" i
      ON i.id = r.id

    LEFT JOIN tmp_point_bgd_pao b
      ON b.id = r.id
)

INSERT INTO normalization."OT_Truboprovod_P_changes"
(
    id,
    dzo,
    id_origin,
    operation,
    has_attribute_changes,
    has_geometry_changes,
    details
)

SELECT

    id,
    dzo,
    id_origin,


    CASE

        WHEN id_origin = 'GENERATED'
         AND bgd_id IS NULL
            THEN 'NEW'


        WHEN id_origin = 'GENERATED'
         AND bgd_id IS NOT NULL
            THEN 'ERROR_ID_COLLISION'


        WHEN id_origin = 'SOURCE'
         AND bgd_id IS NULL
            THEN 'REVIEW_UNKNOWN_ID'


        WHEN id_origin = 'SOURCE'
         AND bgd_id IS NOT NULL

         AND
         (
             attribute_changed
             OR geometry_changed
         )
            THEN 'UPDATE'


        WHEN id_origin = 'SOURCE'
         AND bgd_id IS NOT NULL
            THEN 'NO_CHANGE'


        ELSE 'REVIEW'

    END,


    attribute_changed,

    geometry_changed,


    CASE

        WHEN id_origin = 'GENERATED'
         AND bgd_id IS NULL

            THEN 'Новый объект. UUID создан локально.'


        WHEN id_origin = 'SOURCE'
         AND bgd_id IS NULL

            THEN 'UUID пришёл из исходных данных, но отсутствует в bgd_PAO.'


        WHEN id_origin = 'SOURCE'
         AND bgd_id IS NOT NULL

         AND
         (
             attribute_changed
             OR geometry_changed
         )

            THEN 'Существующий объект отличается от bgd_PAO.'


        WHEN id_origin = 'SOURCE'
         AND bgd_id IS NOT NULL

            THEN 'Существующий объект совпадает с bgd_PAO.'


        WHEN id_origin = 'GENERATED'
         AND bgd_id IS NOT NULL

            THEN 'Сгенерированный UUID уже существует в bgd_PAO.'


        ELSE 'Не удалось однозначно определить операцию.'

    END

FROM compared;


