/* ============================================================
   17. УНИКАЛЬНЫЕ funk_nazn ПО ПОСТАВКЕ
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_values;

CREATE TEMP TABLE tmp_point_purpose_values AS

SELECT
    dzo,

    norm.text_key(funk_nazn)
        AS source_key,

    min(funk_nazn)
        AS source_value,

    count(*)
        AS objects_count

FROM ready."OT_Truboprovod_P_klass_prav"

WHERE funk_nazn IS NOT NULL

GROUP BY
    dzo,
    norm.text_key(funk_nazn);


/* ============================================================
   18. ТОЧНОЕ СОПОСТАВЛЕНИЕ funk_nazn
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_resolution;

CREATE TEMP TABLE tmp_point_purpose_resolution AS

SELECT
    v.dzo,

    v.source_key,

    v.source_value,

    v.objects_count,

    count(p.id)
        AS exact_count,

    min(p.id::text)::uuid
        AS selected_purpose_id,

    CASE

        WHEN count(p.id) = 1
            THEN 'EXACT'

        WHEN count(p.id) > 1
            THEN 'EXACT_DUPLICATE'

        ELSE 'UNRESOLVED'

    END AS resolution_method

FROM tmp_point_purpose_values v

LEFT JOIN tmp_point_nsi_purposes p
    ON p.match_key = v.source_key

GROUP BY
    v.dzo,
    v.source_key,
    v.source_value,
    v.objects_count;


/* ============================================================
   19. КАНОНИЧЕСКОЕ funk_nazn
   ============================================================ */

UPDATE ready."OT_Truboprovod_P_klass_prav" r

SET funk_nazn = n.naim

FROM tmp_point_purpose_resolution x

JOIN tmp_point_nsi_purposes n
    ON n.id = x.selected_purpose_id

WHERE r.dzo = x.dzo

  AND norm.text_key(r.funk_nazn)
      = x.source_key

  AND x.resolution_method IN
      (
          'EXACT',
          'EXACT_DUPLICATE'
      );


/* ============================================================
   20. РАЗБИВАЕМ naim_tr ПО ";"
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_parts;

CREATE TEMP TABLE tmp_point_pipeline_parts AS

SELECT
    r.id,

    r.dzo,

    x.ordinality::integer
        AS part_no,

    btrim(x.pipeline_name)
        AS source_value,

    norm.text_key(
        btrim(x.pipeline_name)
    ) AS source_key

FROM ready."OT_Truboprovod_P_klass_prav" r

CROSS JOIN LATERAL

    unnest(
        string_to_array(
            r.naim_tr,
            ';'
        )
    )

WITH ORDINALITY AS x
(
    pipeline_name,
    ordinality
)

WHERE r.naim_tr IS NOT NULL

  AND NULLIF(
        btrim(x.pipeline_name),
        ''
      ) IS NOT NULL;


/* ============================================================
   21. ТОЧНОЕ СОПОСТАВЛЕНИЕ PIPELINES

   При нескольких одинаковых названиях:
       автоматически выбираем минимальный UUID.

   Это сохраняет старую бизнес-логику,
   но теперь выбор стабильный.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_resolution;

CREATE TEMP TABLE tmp_point_pipeline_resolution AS

SELECT
    p.dzo,

    p.source_key,

    min(p.source_value)
        AS source_value,

    count(DISTINCT p.id)
        AS objects_count,

    count(n.id)
        AS exact_count,

    min(n.id::text)::uuid
        AS selected_pipeline_id,

    CASE

        WHEN count(n.id) = 1
            THEN 'EXACT'

        WHEN count(n.id) > 1
            THEN 'EXACT_DUPLICATE'

        ELSE 'UNRESOLVED'

    END AS resolution_method

FROM
(
    SELECT DISTINCT
        id,
        dzo,
        source_key,
        source_value

    FROM tmp_point_pipeline_parts
) p

LEFT JOIN tmp_point_nsi_pipelines n
    ON n.match_key = p.source_key

GROUP BY
    p.dzo,
    p.source_key;


/* ============================================================
   22. FUZZY-КАНДИДАТЫ funk_nazn
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_candidates;

CREATE TEMP TABLE tmp_point_purpose_candidates AS

SELECT
    u.dzo,

    u.source_value,

    u.objects_count,

    c.candidate_rank,

    c.candidate_id,

    c.candidate_value,

    round(
        c.similarity_value::numeric,
        4
    ) AS similarity_value

FROM tmp_point_purpose_resolution u

JOIN LATERAL
(
    SELECT
        n.id AS candidate_id,

        n.naim AS candidate_value,

        similarity(
            u.source_key,
            n.match_key
        ) AS similarity_value,

        row_number() OVER
        (
            ORDER BY
                similarity(
                    u.source_key,
                    n.match_key
                ) DESC,

                n.id::text
        ) AS candidate_rank

    FROM tmp_point_nsi_purposes n

    WHERE similarity(
        u.source_key,
        n.match_key
    ) >=
    (
        SELECT fuzzy_min
        FROM tmp_point_config
    )

    ORDER BY
        similarity_value DESC,
        n.id::text

    LIMIT
    (
        SELECT fuzzy_top
        FROM tmp_point_config
    )

) c ON true

WHERE u.resolution_method = 'UNRESOLVED';


