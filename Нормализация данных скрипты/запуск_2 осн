SELECT dblink_disconnect('point_bgd_pao');


/* ============================================================
   12. КЛАССИФИКАЦИЯ NEW / UPDATE / REVIEW

   GENERATED:
       новый объект.

   SOURCE + id найден:
       существующий объект -> UPDATE.

   SOURCE + id НЕ найден:
       REVIEW.

   Такой объект автоматически новым не считаем.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_operation;

CREATE TEMP TABLE tmp_point_operation AS

SELECT
    i.id,

    i.id_origin,

    i.dzo,

    CASE

        WHEN i.id_origin = 'GENERATED'
         AND b.id IS NULL
            THEN 'NEW'

        WHEN i.id_origin = 'GENERATED'
         AND b.id IS NOT NULL
            THEN 'GENERATED_ID_COLLISION'

        WHEN i.id_origin = 'SOURCE'
         AND b.id IS NOT NULL
            THEN 'UPDATE'

        WHEN i.id_origin = 'SOURCE'
         AND b.id IS NULL
            THEN 'REVIEW_UNKNOWN_ID'

        ELSE 'REVIEW'

    END AS operation

FROM public."OT_Truboprovod_P_input" i

LEFT JOIN tmp_point_bgd_pao b
    ON b.id = i.id;


/* ============================================================
   13. ПОКАЗЫВАЕМ, ЧТО ИМЕННО ИЗМЕНИЛОСЬ У UPDATE

   Это очень важный контроль для изменённых объектов.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_update_diff;

CREATE TEMP TABLE tmp_point_update_diff AS

SELECT
    n.id,

    n.dzo,

    b.naim AS old_naim,
    n.naim AS new_naim,

    b.naim_tr AS old_naim_tr,
    n.naim_tr AS new_naim_tr,

    b.rasp_piket AS old_rasp_piket,
    n.rasp_piket AS new_rasp_piket,

    b.funk_nazn AS old_funk_nazn,
    n.funk_nazn AS new_funk_nazn,

    b.teh_hrkt AS old_teh_hrkt,
    n.teh_hrkt AS new_teh_hrkt,

    b.primechan AS old_primechan,
    n.primechan AS new_primechan,

    ST_Equals(
        b.geom,
        n.geom
    ) AS geometry_equal

FROM ready."OT_Truboprovod_P_klass_prav" n

JOIN tmp_point_operation o
    ON o.id = n.id
   AND o.operation = 'UPDATE'

JOIN tmp_point_bgd_pao b
    ON b.id = n.id

WHERE
       b.naim IS DISTINCT FROM n.naim

    OR b.naim_tr IS DISTINCT FROM n.naim_tr

    OR b.rasp_piket IS DISTINCT FROM n.rasp_piket

    OR b.funk_nazn IS DISTINCT FROM n.funk_nazn

    OR b.teh_hrkt IS DISTINCT FROM n.teh_hrkt

    OR b.primechan IS DISTINCT FROM n.primechan

    OR NOT ST_Equals(b.geom, n.geom);


