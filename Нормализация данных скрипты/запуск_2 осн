    dzo,
    'geom',
    'У точечного объекта отсутствует геометрия'

FROM normalization."OT_Truboprovod_P_input"

WHERE geom IS NULL;


INSERT INTO normalization."OT_Truboprovod_P_issues"
(
    severity,
    issue_type,
    object_id,
    dzo,
    field_name,
    source_value,
    details
)

SELECT
    'ERROR',
    'GEOMETRY_WRONG_SRID',
