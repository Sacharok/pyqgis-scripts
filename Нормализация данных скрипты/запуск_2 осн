        btrim(x.pipeline_name)
    ) AS numeric_signature

FROM normalization."OT_Truboprovod_P_ready" r

CROSS JOIN LATERAL

    unnest(
        string_to_array(
            r.naim_tr,
            ';'
        )
    )

WITH ORDINALITY AS x
(
    pipeline_name,
    ordinality
)

WHERE r.naim_tr IS NOT NULL

  AND NULLIF(
      btrim(x.pipeline_name),
      ''
  ) IS NOT NULL;


