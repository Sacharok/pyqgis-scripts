/* ============================================================
   01_POINT_PREPARE_CHECK.sql

   ПЕРВЫЙ ЗАПУСК НОВОЙ ПОСТАВКИ

   ЗАПУСКАТЬ В ЛОКАЛЬНОЙ БД.

   ЧТО ДЕЛАЕТ:

     1. проверяет DZO;
     2. сохраняет входящие id;
     3. новым объектам без id генерирует UUID;
     4. определяет SOURCE / GENERATED;
     5. создаёт локальный READY;
     6. выполняет безопасную техническую нормализацию;
     7. читает существующие объекты из bgd_PAO;
     8. определяет NEW / UPDATE / REVIEW;
     9. читает PurposesOfPipelineNetworkObjects;
    10. читает Pipelines;
    11. выполняет точные сопоставления;
    12. при точных дублях Pipeline выбирает один UUID;
    13. для остальных строит fuzzy-кандидатов;
    14. показывает проблемы.

   НЕ ДЕЛАЕТ:

     - INSERT/UPDATE/DELETE в neo_nsi;
     - INSERT/UPDATE/DELETE в bgd_PAO;
     - INSERT/UPDATE/DELETE в bgd_<DZO>.
   ============================================================ */


/* ============================================================
   1. ПАРАМЕТРЫ ПОДКЛЮЧЕНИЯ

   ЗАМЕНИТЬ параметры соединения.

   Пароли в постоянные таблицы не сохраняем.
   Эта TEMP-таблица исчезнет после закрытия сессии.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_config;

CREATE TEMP TABLE tmp_point_config
(
    neo_nsi_conn text NOT NULL,

    bgd_pao_conn text NOT NULL,

    fuzzy_min double precision NOT NULL,

    fuzzy_top integer NOT NULL
);


