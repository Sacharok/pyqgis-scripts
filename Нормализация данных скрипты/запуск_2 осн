/* ============================================================
   30. СООТВЕТСТВИЕ funk_nazn

   ПРИОРИТЕТ:

   1. Сохранённое решение пользователя.
   2. Точное совпадение со справочником.
   3. Точный дубль -> минимальный UUID.
   4. Иначе unresolved.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_purpose_resolution;

CREATE TEMP TABLE tmp_point_purpose_resolution AS

WITH exact_match AS
(
    SELECT

        v.dzo,
        v.source_key,

        count(n.id)
            AS exact_count,

        min(n.id::text)::uuid
            AS exact_id

    FROM tmp_point_purpose_values v

    LEFT JOIN tmp_point_nsi_purposes n
      ON n.match_key = v.source_key

    GROUP BY
        v.dzo,
        v.source_key
),

saved_ranked AS
(
    SELECT

        v.dzo,
        v.source_key,

        m.purpose_id,

        row_number() OVER
        (
            PARTITION BY
                v.dzo,
                v.source_key

            ORDER BY
                CASE
                    WHEN m.dzo = v.dzo
                        THEN 1
                    ELSE 2
                END,

                m.map_id
        ) AS rn

    FROM tmp_point_purpose_values v

    JOIN normalization."OT_Truboprovod_P_purpose_map" m

      ON m.is_active

     AND m.dzo IN
         (
             v.dzo,
             '*'
         )

     AND m.source_key =
         v.source_key
),

saved AS
(
    SELECT
        dzo,
        source_key,
        purpose_id

    FROM saved_ranked

    WHERE rn = 1
)

SELECT

    v.dzo,

    v.source_key,

    v.source_value,

    v.objects_count,

    e.exact_count,


    CASE

        WHEN s.purpose_id IS NOT NULL
         AND saved_target.id IS NOT NULL

            THEN s.purpose_id


        WHEN s.purpose_id IS NOT NULL
         AND saved_target.id IS NULL

            THEN NULL


        ELSE e.exact_id

    END AS selected_purpose_id,


    CASE

        WHEN s.purpose_id IS NOT NULL
         AND saved_target.id IS NOT NULL

            THEN 'SAVED'


        WHEN s.purpose_id IS NOT NULL
         AND saved_target.id IS NULL

            THEN 'SAVED_TARGET_MISSING'


        WHEN e.exact_count = 1

            THEN 'EXACT'


        WHEN e.exact_count > 1

            THEN 'EXACT_DUPLICATE'


        ELSE 'UNRESOLVED'

    END AS resolution_method


FROM tmp_point_purpose_values v

JOIN exact_match e
  ON e.dzo = v.dzo
 AND e.source_key = v.source_key

LEFT JOIN saved s
  ON s.dzo = v.dzo
 AND s.source_key = v.source_key

LEFT JOIN tmp_point_nsi_purposes saved_target
  ON saved_target.id = s.purpose_id;


/* ============================================================
   31. РАЗБИВАЕМ naim_tr ПО ";"

   Дополнительно создаём:
       source_key
       technical_key
       numeric_signature
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_pipeline_parts;

CREATE TEMP TABLE tmp_point_pipeline_parts AS

SELECT
