    'Ожидается EPSG:3857'

FROM normalization."OT_Truboprovod_P_input"

WHERE geom IS NOT NULL
  AND ST_SRID(geom) <> 3857;


/* ============================================================
   11. INPUT -> READY

   Теперь исходная INPUT больше не изменяется.

   Вся нормализация только в READY.
   ============================================================ */

INSERT INTO normalization."OT_Truboprovod_P_ready"
(
    id,
    geom,
    class_code,
    class_name,
    naim_tr,
    naim,
    rasp_piket,
    funk_nazn,
    teh_hrkt,
    primechan,
    dzo
)

SELECT
    id,
    geom,
    class_code,
    class_name,
    naim_tr,
    naim,
    rasp_piket,
    funk_nazn,
    teh_hrkt,
    primechan,
    dzo

FROM normalization."OT_Truboprovod_P_input";


/* ============================================================
   12. ОБЩАЯ ТЕХНИЧЕСКАЯ ОЧИСТКА

   Это только безопасные операции:
       Enter / Tab
       повторные пробелы
       trim
       пустые значения
   ============================================================ */

UPDATE normalization."OT_Truboprovod_P_ready"

SET

    class_name = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(
                    class_name,
                    E'[\r\n\t]+',
                    ' ',
                    'g'
                ),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    naim_tr = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(
                    naim_tr,
                    E'[\r\n\t]+',
                    ' ',
                    'g'
                ),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    naim = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(
                    naim,
                    E'[\r\n\t]+',
                    ' ',
                    'g'
                ),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    funk_nazn = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(
                    funk_nazn,
                    E'[\r\n\t]+',
                    ' ',
                    'g'
                ),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    teh_hrkt = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(
                    teh_hrkt,
                    E'[\r\n\t]+',
                    ' ',
                    'g'
                ),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    ),

    primechan = NULLIF(
        btrim(
            regexp_replace(
                regexp_replace(
                    primechan,
                    E'[\r\n\t]+',
                    ' ',
                    'g'
                ),
                '[[:space:]]+',
                ' ',
                'g'
            )
        ),
        ''
    );


/* ============================================================
   13. "-", "—" -> NULL
   ============================================================ */

UPDATE normalization."OT_Truboprovod_P_ready"

SET

    class_name =
        CASE
            WHEN class_name IN ('-', '—')
                THEN NULL
            ELSE class_name
        END,

    naim_tr =
        CASE
            WHEN naim_tr IN ('-', '—')
                THEN NULL
            ELSE naim_tr
        END,

    naim =
        CASE
            WHEN naim IN ('-', '—')
                THEN NULL
            ELSE naim
        END,

    rasp_piket =
        CASE
            WHEN btrim(rasp_piket) IN ('', '-', '—')
                THEN NULL
            ELSE rasp_piket
        END,

    funk_nazn =
        CASE
            WHEN funk_nazn IN ('-', '—')
                THEN NULL
            ELSE funk_nazn
        END,

    teh_hrkt =
        CASE
            WHEN teh_hrkt IN ('-', '—')
                THEN NULL
            ELSE teh_hrkt
        END,

    primechan =
        CASE
            WHEN primechan IN ('-', '—')
                THEN NULL
            ELSE primechan
        END;


/* ============================================================
   14. ВНЕШНИЕ КАВЫЧКИ
   ============================================================ */

UPDATE normalization."OT_Truboprovod_P_ready"

SET
    naim_tr =
        NULLIF(btrim(btrim(naim_tr), '"'), ''),

    naim =
        NULLIF(btrim(btrim(naim), '"'), ''),

    funk_nazn =
        NULLIF(btrim(btrim(funk_nazn), '"'), ''),

    teh_hrkt =
        NULLIF(btrim(btrim(teh_hrkt), '"'), '');


/* ============================================================
   15. ПЕРВАЯ БУКВА
   ============================================================ */

UPDATE normalization."OT_Truboprovod_P_ready"

SET naim =
    upper(left(naim, 1))
    || substring(naim, 2)

WHERE naim ~ '^[а-яё]';


UPDATE normalization."OT_Truboprovod_P_ready"

SET funk_nazn =
    upper(left(funk_nazn, 1))
    || substring(funk_nazn, 2)

WHERE funk_nazn ~ '^[а-яё]';


/* ============================================================
   16. ТЕХНИЧЕСКИЕ ХАРАКТЕРИСТИКИ
   ============================================================ */

UPDATE normalization."OT_Truboprovod_P_ready"

SET teh_hrkt =
    replace(
        replace(
            teh_hrkt,
            'Ленейный',
            'Линейный'
        ),
        'Pу',
        'Ру'
    )

WHERE teh_hrkt IS NOT NULL;


/* Запятая в конце */

UPDATE normalization."OT_Truboprovod_P_ready"

SET teh_hrkt =
    regexp_replace(
        teh_hrkt,
        ',\s*$',
        ''
    )

WHERE teh_hrkt ~ ',\s*$';


/* Пробел после "Линейный," */

UPDATE normalization."OT_Truboprovod_P_ready"

SET teh_hrkt =
    regexp_replace(
        teh_hrkt,
        '^Линейный,\s*',
        'Линейный, '
    )

WHERE teh_hrkt LIKE 'Линейный,%';


/* ============================================================
   17. НОРМАЛИЗАЦИЯ ПИКЕТАЖА
   ============================================================ */


/* decimal point -> comma */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    replace(
        rasp_piket,
        '.',
        ','
    )

WHERE rasp_piket IS NOT NULL;


/* Enter -> ; */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        E'[\r\n]+',
        '; ',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* " и " -> ; */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '\s+[Ии]\s+',
        '; ',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* П12 -> ПК12 */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        'П(\d+)',
        'ПК\1',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* Пробелы внутри ПК */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(ПК)\s*(\d+)\s*\+\s*(\d+)',
        '\1\2+\3',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* 12+50 -> ПК12+50 */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '^(\d+\+\d+)',
        'ПК\1'
    )

WHERE rasp_piket IS NOT NULL;


/* ПК12-15 -> ПК12+00; ПК15+00 */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(ПК\s*\d+)-(\d+)',
        '\1+00; ПК\2+00',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* Полноценные пикеты через / или - */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(ПК\d+(?:\+\d+)?(?:,\d+)?)\s*[/-]\s*(?:ПК)?(\d+(?:\+\d+)?(?:,\d+)?)',
        '\1; ПК\2',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* ПК12 -> ПК12+00 */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '(^|;\s*)(ПК\d+)(;|$)',
        '\1\2+00\3',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* ПК12+0 -> ПК12+00 */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '\+0(\D|$)',
        '+00\1',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* Единый вид ";" */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    regexp_replace(
        rasp_piket,
        '\s*;\s*',
        '; ',
        'g'
    )

WHERE rasp_piket IS NOT NULL;


/* trim */

UPDATE normalization."OT_Truboprovod_P_ready"

SET rasp_piket =
    NULLIF(
        btrim(rasp_piket),
        ''
    )

WHERE rasp_piket IS NOT NULL;


/* ============================================================
   18. ПРИМЕНЯЕМ НАКОПЛЕННЫЕ ОБЩИЕ ПРАВИЛА

   Приоритет:
       правило конкретного ДЗО
       затем правило '*'
   ============================================================ */

DO $$
DECLARE
    v_field text;
BEGIN

    FOREACH v_field IN ARRAY ARRAY
    [
        'naim',
        'class_name',
        'naim_tr',
        'rasp_piket',
        'funk_nazn',
        'teh_hrkt',
        'primechan'
    ]

    LOOP

        EXECUTE format(
        $SQL$

            WITH matched AS
            (
                SELECT
                    r.id,

                    m.normalized_value,

                    row_number() OVER
                    (
                        PARTITION BY r.id

                        ORDER BY
                            CASE
                                WHEN m.dzo = r.dzo
                                    THEN 1
                                ELSE 2
                            END,

                            m.map_id
                    ) AS rn

                FROM normalization."OT_Truboprovod_P_ready" r

                JOIN normalization."OT_Truboprovod_P_value_map" m

                  ON m.field_name = %L

                 AND m.is_active

                 AND m.dzo IN
                     (
                         r.dzo,
                         '*'
                     )

                 AND m.source_key =
                     normalization.text_key(r.%I)
            )

            UPDATE normalization."OT_Truboprovod_P_ready" r

            SET %I = matched.normalized_value

            FROM matched

            WHERE r.id = matched.id
              AND matched.rn = 1;

        $SQL$,

            v_field,
            v_field,
            v_field
        );

    END LOOP;

END $$;


/* ============================================================
   19. ИСКЛЮЧЕНИЯ КОНКРЕТНЫХ ОБЪЕКТОВ
   ============================================================ */

DO $$
DECLARE
    v_field text;
BEGIN

    FOREACH v_field IN ARRAY ARRAY
    [
        'class_code',
        'class_name',
        'naim_tr',
        'naim',
        'rasp_piket',
        'funk_nazn',
