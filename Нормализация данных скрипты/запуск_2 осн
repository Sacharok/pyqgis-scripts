    source_value,
    objects_count,
    candidate_rank,
    candidate_value,
    candidate_id,
    similarity_value,
    decision_hint

FROM normalization."OT_Truboprovod_P_candidates"

ORDER BY
    field_name,
    objects_count DESC,
    source_value,
    candidate_rank;


/* ============================================================
   50. ИТОГ №7
   ОБЩАЯ СТАТИСТИКА
   ============================================================ */

SELECT

    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_ready"
    )
    AS total_objects,


    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_changes"
        WHERE operation = 'NEW'
    )
    AS new_objects,


    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_changes"
        WHERE operation = 'UPDATE'
    )
    AS update_objects,


    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_changes"
        WHERE operation = 'NO_CHANGE'
    )
    AS unchanged_objects,


    (
        SELECT count(*)

        FROM normalization."OT_Truboprovod_P_issues"

        WHERE severity = 'ERROR'
    )
    AS errors,


    (
        SELECT count(*)

        FROM normalization."OT_Truboprovod_P_issues"

        WHERE severity = 'REVIEW'
    )
    AS requires_review,


    (
        SELECT count(*)

        FROM normalization."OT_Truboprovod_P_issues"

        WHERE severity = 'WARNING'
    )
    AS warnings;


