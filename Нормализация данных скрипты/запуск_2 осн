/* ============================================================
   2. ПРОВЕРКА РАСШИРЕНИЙ

   Ничего здесь не устанавливаем.

   Они должны быть подготовлены один раз заранее.
   ============================================================ */

DO $$
BEGIN

    IF NOT EXISTS
    (
        SELECT 1
        FROM pg_extension
        WHERE extname = 'dblink'
    )
    THEN
        RAISE EXCEPTION
            'В локальной БД отсутствует расширение dblink';
    END IF;


    IF NOT EXISTS
    (
        SELECT 1
        FROM pg_extension
        WHERE extname = 'pg_trgm'
    )
    THEN
        RAISE EXCEPTION
            'В локальной БД отсутствует расширение pg_trgm';
    END IF;

END $$;


/* ============================================================
   3. ПРОВЕРКА НАЛИЧИЯ IMPORT
   ============================================================ */

DO $$
BEGIN

    IF to_regclass(
        'normalization."OT_Truboprovod_P_import"'
    ) IS NULL
    THEN

        RAISE EXCEPTION
            'Не найдена normalization.OT_Truboprovod_P_import. Сначала загрузите SHP через QGIS.';

    END IF;

END $$;


/* ============================================================
   4. ПРОВЕРКА ОБЯЗАТЕЛЬНЫХ СТОЛБЦОВ IMPORT

   id        — НЕ обязателен;
   dzo       — НЕ обязателен;
   primechan — НЕ обязателен.

   Остальные ожидаем.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_missing_columns;

CREATE TEMP TABLE tmp_point_missing_columns
(
    column_name text
);


INSERT INTO tmp_point_missing_columns(column_name)

SELECT v.column_name

FROM
(
    VALUES
        ('geom'),
        ('class_code'),
        ('class_name'),
        ('naim_tr'),
        ('naim'),
        ('rasp_piket'),
        ('funk_nazn'),
        ('teh_hrkt')
)
AS v(column_name)

WHERE NOT EXISTS
(
    SELECT 1

    FROM information_schema.columns c

    WHERE c.table_schema = 'normalization'

      AND c.table_name =
          'OT_Truboprovod_P_import'

      AND c.column_name = v.column_name
);


DO $$
DECLARE
    v_columns text;
BEGIN

    SELECT string_agg(column_name, ', ')
    INTO v_columns
    FROM tmp_point_missing_columns;


    IF v_columns IS NOT NULL
    THEN

        RAISE EXCEPTION
            'В импортированном SHP отсутствуют обязательные столбцы: %',
            v_columns;

    END IF;

END $$;


/* ============================================================
   5. СМОТРИМ, ЕСТЬ ЛИ В IMPORT:

       id
       dzo
       primechan

   Скрипт сам подстроится.
   ============================================================ */

DROP TABLE IF EXISTS tmp_point_import_structure;

CREATE TEMP TABLE tmp_point_import_structure AS

SELECT
    EXISTS
    (
        SELECT 1
        FROM information_schema.columns
        WHERE table_schema = 'normalization'
          AND table_name =
              'OT_Truboprovod_P_import'
          AND column_name = 'id'
    ) AS has_id,

    EXISTS
    (
        SELECT 1
        FROM information_schema.columns
        WHERE table_schema = 'normalization'
          AND table_name =
              'OT_Truboprovod_P_import'
          AND column_name = 'dzo'
    ) AS has_dzo,

    EXISTS
    (
        SELECT 1
        FROM information_schema.columns
        WHERE table_schema = 'normalization'
          AND table_name =
              'OT_Truboprovod_P_import'
          AND column_name = 'primechan'
    ) AS has_primechan;


/* ============================================================
   6. ЗАГРУЗКА IMPORT -> INPUT

   ВАЖНАЯ ЗАЩИТА:

   Если INPUT уже содержит данные,
   повторно IMPORT НЕ загружаем.

   Это нужно, чтобы при повторном запуске новые объекты
   сохранили уже созданные UUID.

   Перед СОВЕРШЕННО НОВОЙ поставкой пользователь сам делает:

       TRUNCATE normalization."OT_Truboprovod_P_input";

   ============================================================ */

DO $$
DECLARE

    v_input_count bigint;

    v_has_id boolean;
    v_has_dzo boolean;
    v_has_primechan boolean;

    v_default_dzo text;

    v_id_expression text;
    v_origin_expression text;
    v_dzo_expression text;
    v_primechan_expression text;

    v_sql text;

BEGIN

    SELECT count(*)
    INTO v_input_count
    FROM normalization."OT_Truboprovod_P_input";


    IF v_input_count > 0
    THEN

        RAISE NOTICE
            'INPUT уже содержит % строк. Повторная загрузка IMPORT пропущена. Используются закреплённые ранее id.',
            v_input_count;

        RETURN;

    END IF;


    SELECT
        has_id,
        has_dzo,
        has_primechan

    INTO
        v_has_id,
        v_has_dzo,
        v_has_primechan

    FROM tmp_point_import_structure;


    SELECT default_dzo
    INTO v_default_dzo
    FROM tmp_point_config
    LIMIT 1;


    /* ----------------------------------------
       ID
       ---------------------------------------- */

    IF v_has_id
    THEN

        /*
         Если ID есть и заполнен:
             сохраняем.

         Если столбец есть, но значение NULL/пустое:
             создаём новый UUID.
        */

        v_id_expression :=
        '
        COALESCE(
            NULLIF(btrim(id::text), '''')::uuid,
            gen_random_uuid()
        )
        ';


        v_origin_expression :=
        '
        CASE
            WHEN NULLIF(btrim(id::text), '''') IS NULL
                THEN ''GENERATED''
            ELSE ''SOURCE''
        END
        ';

    ELSE

        /*
         Столбца id вообще нет.
         Значит все объекты новые.
        */

        v_id_expression :=
            'gen_random_uuid()';

        v_origin_expression :=
            '''GENERATED''';

    END IF;


    /* ----------------------------------------
       DZO
       ---------------------------------------- */

    IF v_has_dzo
    THEN

        v_dzo_expression := format(
            '
            COALESCE(
                NULLIF(btrim(dzo::text), ''''),
                %L
            )
            ',
            v_default_dzo
        );

    ELSE

        v_dzo_expression := format(
            '%L::text',
            v_default_dzo
        );

    END IF;


    /* ----------------------------------------
       PRIMECHAN
       ---------------------------------------- */

    IF v_has_primechan
    THEN

        v_primechan_expression :=
            'primechan::text';

    ELSE

        v_primechan_expression :=
            'NULL::text';

    END IF;


    /* ----------------------------------------
       ФОРМИРУЕМ INSERT
       ---------------------------------------- */

    v_sql := format(
    $SQL$

        INSERT INTO normalization."OT_Truboprovod_P_input"
        (
            id,
            id_origin,
            geom,
            class_code,
            class_name,
            naim_tr,
            naim,
            rasp_piket,
            funk_nazn,
            teh_hrkt,
            primechan,
            dzo
        )

        SELECT

            %s,
            %s,

            geom,

            class_code::varchar(10),

            class_name::varchar(100),

            naim_tr::text,

            naim::varchar(255),

            rasp_piket::text,

            funk_nazn::varchar(255),

            teh_hrkt::text,

            %s,

            %s

        FROM normalization."OT_Truboprovod_P_import";

    $SQL$,

        v_id_expression,
        v_origin_expression,
        v_primechan_expression,
        v_dzo_expression
    );


    EXECUTE v_sql;


    RAISE NOTICE
        'IMPORT успешно перенесён в INPUT';

END $$;


/* ============================================================
   7. ОЧИЩАЕМ РЕЗУЛЬТАТЫ ПРЕДЫДУЩЕЙ ПРОВЕРКИ

   INPUT НЕ ТРОГАЕМ.
   ============================================================ */

