/* ============================================================
   24. ИТОГ №1 — NEW / UPDATE / REVIEW
   ============================================================ */

SELECT
    operation,
    count(*) AS objects_count

FROM tmp_point_operation

GROUP BY operation

ORDER BY operation;


/* ============================================================
   25. ИТОГ №2 — НЕИЗВЕСТНЫЕ ВХОДЯЩИЕ ID

   Такие строки пока требуют решения.
   ============================================================ */

SELECT
    r.*

FROM ready."OT_Truboprovod_P_klass_prav" r

JOIN tmp_point_operation o
    ON o.id = r.id

WHERE o.operation IN
(
    'REVIEW_UNKNOWN_ID',
    'GENERATED_ID_COLLISION',
    'REVIEW'
)

ORDER BY
    r.dzo,
    r.id;


/* ============================================================
   26. ИТОГ №3 — ЧТО ИЗМЕНИЛОСЬ У СУЩЕСТВУЮЩИХ ОБЪЕКТОВ
   ============================================================ */

SELECT *
FROM tmp_point_update_diff

ORDER BY
    dzo,
    id;


