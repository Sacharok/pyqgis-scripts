/* ============================================================
   0.8. ИЗВЕСТНЫЕ ОБЩИЕ ИСПРАВЛЕНИЯ

   Сюда постепенно перенесём старые UPDATE типа:

       кран К1 -> Кран К1
       старое написание -> правильное написание

   dzo = '*'
       правило действует на все ДЗО.

   dzo = 'YGEO'
       правило только YGEO.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_value_map
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL DEFAULT '*',

    field_name varchar(50) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (norm.text_key(source_value))
        STORED,

    normalized_value text,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_value_map_field_chk
        CHECK
        (
            field_name IN
            (
                'naim',
                'class_name',
                'naim_tr',
                'rasp_piket',
                'funk_nazn',
                'teh_hrkt',
                'primechan'
            )
        ),

    CONSTRAINT point_value_map_unique
        UNIQUE
        (
            dzo,
            field_name,
            source_key
        )
);


/* ============================================================
   0.9. РУЧНЫЕ РЕШЕНИЯ funk_nazn -> UUID НСИ

   Это память системы.

   Если пользователь однажды подтвердил:

       "старое значение"
           ->
       PurposesOfPipelineNetworkObjects.id

   в следующих поставках решение будет применяться само.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_purpose_map
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (norm.text_key(source_value))
        STORED,

    purpose_id uuid NOT NULL,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_purpose_map_unique
        UNIQUE
        (
            dzo,
            source_key
        )
);


/* ============================================================
   0.10. РУЧНЫЕ РЕШЕНИЯ naim_tr -> Pipelines.id

   Аналогично сохраняем однажды принятое решение.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_pipeline_map
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (norm.text_key(source_value))
        STORED,

    pipeline_id uuid NOT NULL,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT point_pipeline_map_unique
        UNIQUE
        (
            dzo,
            source_key
        )
);


/* ============================================================
   0.11. ИСКЛЮЧЕНИЯ КОНКРЕТНЫХ ОБЪЕКТОВ

   Например:

       конкретная точка
       имеет особую teh_hrkt

   Это НЕ общее правило.

   Поэтому сохраняем по UUID объекта.
   ============================================================ */

CREATE TABLE IF NOT EXISTS norm.point_object_override
(
    object_id uuid NOT NULL,

    field_name varchar(50) NOT NULL,

    override_value text,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    PRIMARY KEY
    (
        object_id,
        field_name
    )
);


