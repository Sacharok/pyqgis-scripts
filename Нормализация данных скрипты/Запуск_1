/* ============================================================
   00_SETUP_POINT.sql

   НАСТРОЙКА ЛОКАЛЬНОЙ СИСТЕМЫ НОРМАЛИЗАЦИИ
   ТРУБОПРОВОДЫ — ТОЧЕЧНЫЕ ОБЪЕКТЫ (P)

   Выполняется ОДИН РАЗ в локальной PostgreSQL.

   Создаёт:
     1. входную таблицу для загрузки из QGIS;
     2. результирующую таблицу READY;
     3. служебные таблицы накопленных правил;
     4. список допустимых ДЗО;
     5. функции для сравнения текста.

   Никаких подключений к удалённым БД здесь нет.
   ============================================================ */


/* ============================================================
   0.1. Расширения

   dblink:
       нужен для чтения neo_nsi / bgd_PAO / bgd_<DZO>.

   pg_trgm:
       нужен для поиска похожих строк.

   uuid-ossp:
       нужен для генерации UUID новым объектам.
   ============================================================ */

CREATE EXTENSION IF NOT EXISTS dblink;
CREATE EXTENSION IF NOT EXISTS pg_trgm;
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";


/* ============================================================
   0.2. Служебные схемы
   ============================================================ */

CREATE SCHEMA IF NOT EXISTS norm;
CREATE SCHEMA IF NOT EXISTS ready;


/* ============================================================
   0.3. Функция для сравнения текста

   ВАЖНО:
   это НЕ окончательная нормализация строки.

   Функция делает только технический ключ,
   чтобы одинаковые по смыслу строки можно было сравнить:

       - переводит в нижний регистр;
       - ё -> е;
       - Enter / Tab -> пробел;
       - неразрывный пробел -> обычный;
       - несколько пробелов -> один;
       - trim.

   Исходный текст эта функция не изменяет.
   ============================================================ */

CREATE OR REPLACE FUNCTION norm.text_key(p_text text)
RETURNS text
LANGUAGE sql
IMMUTABLE
PARALLEL SAFE
AS $$
SELECT
    CASE
        WHEN p_text IS NULL THEN NULL

        ELSE replace(
            lower(
                btrim(
                    regexp_replace(
                        replace(
                            regexp_replace(
                                p_text,
                                E'[\r\n\t]+',
                                ' ',
                                'g'
                            ),
                            chr(160),
                            ' '
                        ),
                        '[[:space:]]+',
                        ' ',
                        'g'
                    )
                )
            ),
            'ё',
            'е'
        )
    END;
$$;


/* ============================================================
   0.4. ВХОДНАЯ ТАБЛИЦА

   Именно сюда загружаем SHP через QGIS.

   ВАЖНО:
   id НЕ имеет DEFAULT uuid_generate_v4().

   Это принципиально.

   Если объект пришёл:
       с id    -> сохраняем его;
       без id  -> 01_PREPARE_CHECK создаст UUID.

   id_origin:
       SOURCE    - id пришёл из исходного файла;
       GENERATED - id создан нами.

   dzo:
       обязательно заполняем перед запуском нормализации.

   naim_tr и rasp_piket сразу TEXT.
   ============================================================ */

CREATE TABLE IF NOT EXISTS public."OT_Truboprovod_P_input"
(
    id uuid NULL,

    id_origin varchar(12) NULL,

    geom geometry(Point, 3857) NULL,

    class_code varchar(10) NULL,

    class_name varchar(100) NULL,

    naim_tr text NULL,

    naim varchar(255) NULL,

    rasp_piket text NULL,

    funk_nazn varchar(255) NULL,

    teh_hrkt text NULL,

    primechan text NULL,

    dzo varchar(8) NULL
);


/* ============================================================
   0.5. РЕЗУЛЬТАТ НОРМАЛИЗАЦИИ

   Это таблица, которая заменяет старую:
       OT_Truboprovod_P_klass_prav

   Но теперь:
       naim_tr    = TEXT
       rasp_piket = TEXT

   project_id здесь специально отсутствует.

   Он будет определяться только при публикации
   в конкретную BGD.
   ============================================================ */

CREATE TABLE IF NOT EXISTS ready."OT_Truboprovod_P_klass_prav"
(
    id uuid NOT NULL,

    geom geometry(Point, 3857) NULL,

    class_code varchar(10) NULL,

    class_name varchar(100) NULL,

    naim_tr text NULL,

    naim varchar(255) NULL,

    rasp_piket text NULL,

    funk_nazn varchar(255) NULL,

    teh_hrkt text NULL,

    primechan text NULL,

    dzo varchar(8) NULL,

    CONSTRAINT "OT_Truboprovod_P_klass_prav_pkey"
        PRIMARY KEY (id)
);


/* ============================================================
