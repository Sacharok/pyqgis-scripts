insert into public."Roads"
(id, naim, shir_pokr, shir_proez, protzh, kol_polos, ogranichen, primechan)
select n.id, n.naim, n.shir_pokr, n.shir_proez, n.protzh, n.kol_polos, n.ogranichen, n.primechan
from dblink('dbname=normalize',
	'select id, naim, shir_pokr, shir_proez, protzh, kol_polos, ogranichen, primechan
	 from ready."DS_Dorogi_L_klass_prav"')
as n(id uuid, naim varchar(255), shir_pokr float8, shir_proez float8, protzh float8, kol_polos int4, ogranichen varchar(255), primechan varchar(255))
on conflict (id)
do update set
	naim = excluded.naim,
	shir_pokr = excluded.shir_pokr,
	shir_proez = excluded.shir_proez,
	protzh = excluded.protzh,
	kol_polos = excluded.kol_polos,
	ogranichen = excluded.ogranichen,
	primechan = excluded.primechan;


-- заполнение значений Собственика с заменой на uuid -- 
update public."Roads" road
set sobstvnk = con.id
from dblink('dbname=normalize', 'select id, sobstvnk from ready."DS_Dorogi_L_klass_prav" where sobstvnk is not null')
as n(id uuid, sobstvnk text)
left join public."Counterparties" con on
	lower(split_part(con.krat_naim, '"', 2)) || lower(trim(split_part(con.krat_naim, '"', 1))) =
	replace(lower(split_part(n.sobstvnk, ',', 1)), 'гапром', 'газпром') || lower(trim(split_part(n.sobstvnk, ',', 2)))
where n.id = road.id;

-- заполнение значений тех. категории дорог с заменой на uuid --
update public."Roads" r
set teh_ktg = nr.id
from dblink('dbname=normalize',
	'select id, teh_ktg
	 from ready."DS_Dorogi_L_klass_prav" where teh_ktg is not null')
as n(id uuid, teh_ktg varchar(255))
join public."NormativeClassOfRoad" nr on n.teh_ktg = nr.naim 
where r.id  = n.id;

-- заполнение значений Материала покрытия с заменой на uuid --
update public."Roads" r
set mat_pokr = cm.id
from dblink('dbname=normalize',
	'select id, mat_pokr
	 from ready."DS_Dorogi_L_klass_prav" where teh_ktg is not null')
as n(id uuid, mat_pokr varchar(255))
join public."CoatingMaterials" cm on n.mat_pokr = cm.naim 
where r.id  = n.id;

