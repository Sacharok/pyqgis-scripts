-- create extension if not exists dblink;
-- Заполнение bgd_PAO
do $$
declare
	v_source_table text := 'DS_Dorogi_L_klass_prav';
	v_target_table text  := 'DS_Dorogi_L';
	v_db text;
	v_conn_str text;
	v_sql text;
	v_count text;
remote_sql text;
dblink_sql text;
begin
		v_conn_str := format('host=tmn-nst-test-db.tm.novatek.int port=5432 dbname=normalize user=admin password=admin123', '');
		v_sql := format('
			insert into %I (id, geom, class_code, class_name, naim, mat_pokr, sobstvnk, shir_pokr, shir_proez, protzh, kol_polos, teh_ktg, ogranichen, primechan)
			select id, geom, class_code, class_name, naim, mat_pokr, sobstvnk, shir_pokr, shir_proez, protzh, kol_polos, teh_ktg, ogranichen, primechan
			from dblink(''%s'', 
				''select id, geom, class_code, class_name, naim, mat_pokr, sobstvnk, shir_pokr, shir_proez, protzh, kol_polos, teh_ktg, ogranichen, primechan
				from ready.%I'')
			as t(id uuid, geom geometry, class_code character varying, class_name character varying, naim character varying,
				 mat_pokr character varying, sobstvnk character varying, shir_pokr float8, shir_proez float8, protzh float8,
				 kol_polos int4, teh_ktg character varying, ogranichen character varying, primechan character varying)',
			v_target_table,
			v_conn_str,
			v_source_table
		);

		remote_sql := format('select dblink_exec(
			''host=tmn-nst-test-db.tm.novatek.int port=5432 dbname=bgd_PAO user=admin password=admin123'', 
			%L);', v_sql);
				
		raise notice 'SQL for db %: %', v_db, v_sql;
		
		begin 
			execute remote_sql;
			get diagnostics v_count = ROW_COUNT;
			raise notice 'Inserted % rows into %', v_count, v_db;

		exception when others then
			raise warning 'Error inserting into %: %', v_db, sqlerrm;
		end;
end $$;

