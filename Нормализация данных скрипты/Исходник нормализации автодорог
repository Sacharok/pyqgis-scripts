CREATE TABLE public."DS_Dorogi_L_klass_prav" (
	id uuid DEFAULT uuid_generate_v4() NOT NULL,
	project_id uuid NULL,
	geom public.geometry(multilinestring, 3857) NULL,
	class_code varchar(10) NULL,
	class_name varchar(100) NULL,
	naim varchar(255) NULL,
	mat_pokr varchar(255) NULL,
	sobstvnk varchar(255) NULL,
	shir_pokr float8 NULL,
	shir_proez float8 NULL,
	protzh float8 NULL,
	kol_polos int4 NULL,
	teh_ktg varchar(255) NULL,
	ogranichen varchar(255) NULL,
	primechan varchar(255) NULL,
	CONSTRAINT "DS_Dorogi_L_id_key" PRIMARY KEY (id)
);

--Получить все колонки таблицы--
select string_agg(column_name, ', ' order by ordinal_position) as columns_with_commas 
from information_schema.columns
where table_schema = 'public' 
	and table_name = 'DS_Dorogi_L_klass_prav';

-- Динамически создаём столбец ДО/ДЗО (на всякий) и заполняем его --
do $$
declare
	tname text := 'DS_Dorogi_L';
	codes text[] := ARRAY['AGAZ', 'ASPG2', 'NGAZ', 'OGHK', 'TSNG', 'YGEO', 'YSPG', 'YUNG'];
	code text;
begin
	execute format('ALTER TABLE public."%s_klass_prav" ADD COLUMN dzo varchar(5) NULL;', tname);
	foreach code in array codes 
	loop
		execute format('ALTER TABLE public."%s_%s_klass_prav" ADD COLUMN dzo varchar(5) NULL;', tname, code); 
		execute format('UPDATE public."%s_%s_klass_prav" set dzo = %L;', tname, code, code);
		execute format('INSERT INTO public."%s_klass_prav"
(geom, class_code, class_name, naim, mat_pokr, sobstvnk, shir_pokr, shir_proez, protzh, kol_polos, teh_ktg, ogranichen, primechan, dzo)
select geom, class_code, class_name, naim, mat_pokr, sobstvnk, shir_pokr, shir_proez, protzh, kol_polos, teh_ktg, ogranichen, primechan, dzo
from "%s_%s_klass_prav";', tname, tname, code);
	end loop;
end $$;

