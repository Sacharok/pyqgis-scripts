/* ============================================================
   00_SETUP
   ЛОКАЛЬНАЯ СИСТЕМА НОРМАЛИЗАЦИИ

   Все постоянные рабочие таблицы находятся
   в одной схеме:
       normalization

   Этот скрипт выполняется ОДИН РАЗ.

   Никакие удалённые базы он не изменяет.
   ============================================================ */


/* ============================================================
   1. СХЕМА
   ============================================================ */

CREATE SCHEMA IF NOT EXISTS normalization;

COMMENT ON SCHEMA normalization IS
'Локальная схема подготовки и нормализации пространственных данных перед загрузкой в neo_nsi и BGD. Здесь хранятся исходные поставки, нормализованные данные, результаты проверок и накопленные правила.';


/* ============================================================
   2. ПРОВЕРЯЕМ НЕОБХОДИМЫЕ РАСШИРЕНИЯ

   dblink  — работа с удалёнными PostgreSQL.
   pg_trgm — поиск похожих текстовых значений.

   gen_random_uuid() уже доступен отдельно.
   ============================================================ */

SELECT
    extname
FROM pg_extension
WHERE extname IN
(
    'dblink',
    'pg_trgm'
)
ORDER BY extname;


/* ============================================================
   3. ФУНКЦИЯ ПОДГОТОВКИ ТЕКСТА ДЛЯ СРАВНЕНИЯ

   Она НЕ изменяет данные.

   Используется только для поиска совпадений:
   - нижний регистр;
   - ё -> е;
   - Enter/TAB -> пробел;
   - несколько пробелов -> один;
   - trim.
   ============================================================ */

CREATE OR REPLACE FUNCTION normalization.text_key(p_text text)
RETURNS text
LANGUAGE sql
IMMUTABLE
PARALLEL SAFE
AS $$
SELECT
    CASE

        WHEN p_text IS NULL
            THEN NULL

        ELSE replace(
            lower(
                btrim(
                    regexp_replace(
                        replace(
                            regexp_replace(
                                p_text,
                                E'[\r\n\t]+',
                                ' ',
                                'g'
                            ),
                            chr(160),
                            ' '
                        ),
                        '[[:space:]]+',
                        ' ',
                        'g'
                    )
                )
            ),
            'ё',
            'е'
        )

    END;
$$;

COMMENT ON FUNCTION normalization.text_key(text) IS
'Формирует технический ключ для сравнения текстов. Исходное значение не изменяет.';


