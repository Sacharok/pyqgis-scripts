/* ============================================================
   6. КАНОНИЧЕСКАЯ ВХОДНАЯ ТАБЛИЦА ТОЧЕК

   QGIS сначала загружает SHP в:
       normalization.OT_Truboprovod_P_import

   Затем 01_PREPARE_CHECK переносит данные сюда.

   Именно здесь:
   - сохраняется пришедший UUID;
   - генерируется UUID новым объектам;
   - фиксируется происхождение UUID;
   - заполняется DZO.

   Эта таблица относится только к ТЕКУЩЕЙ ПОСТАВКЕ.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_input"
(
    id uuid,

    id_origin varchar(12),

    geom geometry(Point,3857),

    class_code varchar(10),

    class_name varchar(100),

    naim_tr text,

    naim varchar(255),

    rasp_piket text,

    funk_nazn varchar(255),

    teh_hrkt text,

    primechan text,

    dzo varchar(8)
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_input" IS
'Каноническая входная таблица текущей поставки точечных объектов трубопроводов. До нормализации.';


COMMENT ON COLUMN normalization."OT_Truboprovod_P_input".id IS
'Постоянный UUID объекта. Для новых объектов генерируется один раз локально.';


COMMENT ON COLUMN normalization."OT_Truboprovod_P_input".id_origin IS
'SOURCE — UUID пришёл в исходных данных; GENERATED — UUID создан локальной системой нормализации.';


COMMENT ON COLUMN normalization."OT_Truboprovod_P_input".dzo IS
'ДЗО-владелец объекта. Используется для маршрутизации в соответствующую bgd_<DZO>.';


/* ============================================================
   7. ФИНАЛЬНАЯ НОРМАЛИЗОВАННАЯ ТАБЛИЦА

   Именно из неё позже:
       - создаём SHP сотрудникам;
       - загружаем данные в neo_nsi;
       - загружаем данные в BGD.

   project_id здесь НЕ нужен.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_ready"
(
    id uuid NOT NULL,

    geom geometry(Point,3857),

    class_code varchar(10),

    class_name varchar(100),

    naim_tr text,

    naim varchar(255),

    rasp_piket text,

    funk_nazn varchar(255),

    teh_hrkt text,

    primechan text,

    dzo varchar(8),

    CONSTRAINT "OT_Truboprovod_P_ready_pkey"
        PRIMARY KEY (id)
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_ready" IS
'Финальный нормализованный набор точечных объектов трубопроводов, готовый к публикации и экспорту в SHP.';


/* ============================================================
   8. РЕЗУЛЬТАТ СРАВНЕНИЯ С BGD

   Здесь после первого запуска будет понятно:

       NEW
       UPDATE
       REVIEW_UNKNOWN_ID
       и т.д.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_changes"
(
    id uuid PRIMARY KEY,

    dzo varchar(8),

    id_origin varchar(12),

    operation varchar(50),

    has_attribute_changes boolean,

    has_geometry_changes boolean,

    details text
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_changes" IS
'Результат сравнения текущей поставки точек с существующими объектами bgd_PAO: новый объект, изменение существующего или объект, требующий проверки.';


/* ============================================================
   9. ОШИБКИ И ПРЕДУПРЕЖДЕНИЯ

   Перед новым запуском таблица очищается.

   Благодаря постоянной таблице результаты можно смотреть
   даже после закрытия SQL-редактора.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_issues"
(
    issue_id bigserial PRIMARY KEY,

    created_at timestamptz NOT NULL DEFAULT now(),

    severity varchar(20),

    issue_type varchar(100),

    object_id uuid,

    dzo varchar(8),

    field_name varchar(100),

    source_value text,

    details text
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_issues" IS
'Ошибки, предупреждения и значения, требующие ручного решения при нормализации точечных объектов трубопроводов.';


/* ============================================================
   10. FUZZY-КАНДИДАТЫ

   Сюда записываются возможные соответствия
   из удалённых справочников.

   Например:
       исходный naim_tr
       → 5 наиболее похожих Pipelines.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_candidates"
(
    candidate_row_id bigserial PRIMARY KEY,

    field_name varchar(100),

    dzo varchar(8),

    source_value text,

    objects_count integer,

    candidate_rank integer,

    candidate_id uuid,

    candidate_value text,

    similarity_value numeric(6,4),

    decision_hint varchar(50)
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_candidates" IS
'Кандидаты для ручного выбора при отсутствии точного соответствия funk_nazn или naim_tr справочникам neo_nsi.';


