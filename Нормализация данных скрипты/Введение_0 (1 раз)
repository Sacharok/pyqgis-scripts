/* ============================================================
   12. НАКОПЛЕННЫЕ ОБЩИЕ ИСПРАВЛЕНИЯ

   Здесь постепенно вытесняем старые многочисленные UPDATE.

   Пример:
       поле naim
       "кран К1"
       → "Кран К1"

   dzo = '*'
       правило для всех ДЗО.

   dzo = 'YGEO'
       только YGEO.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_value_map"
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL DEFAULT '*',

    field_name varchar(50) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (
            normalization.text_key(source_value)
        )
        STORED,

    normalized_value text,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    UNIQUE
    (
        dzo,
        field_name,
        source_key
    )
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_value_map" IS
'Накопленные универсальные исправления текстовых значений точечных объектов трубопроводов.';


/* ============================================================
   13. ПРИНЯТЫЕ РЕШЕНИЯ funk_nazn

   Сохраняем UUID справочника neo_nsi.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_purpose_map"
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (
            normalization.text_key(source_value)
        )
        STORED,

    purpose_id uuid NOT NULL,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    UNIQUE
    (
        dzo,
        source_key
    )
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_purpose_map" IS
'Подтверждённые пользователем соответствия исходного funk_nazn UUID справочника PurposesOfPipelineNetworkObjects.';


/* ============================================================
   14. ПРИНЯТЫЕ РЕШЕНИЯ naim_tr

   source naim_tr -> Pipelines.id
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_pipeline_map"
(
    map_id bigserial PRIMARY KEY,

    dzo varchar(8) NOT NULL,

    source_value text NOT NULL,

    source_key text
        GENERATED ALWAYS AS
        (
            normalization.text_key(source_value)
        )
        STORED,

    pipeline_id uuid NOT NULL,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    UNIQUE
    (
        dzo,
        source_key
    )
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_pipeline_map" IS
'Подтверждённые соответствия исходного naim_tr конкретному Pipelines.id в neo_nsi.';


/* ============================================================
   15. ИСКЛЮЧЕНИЯ КОНКРЕТНЫХ ТОЧЕК

   Например определённой точке с конкретным UUID
   требуется особая teh_hrkt.

   Это не универсальное правило.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."OT_Truboprovod_P_object_override"
(
    object_id uuid NOT NULL,

    field_name varchar(50) NOT NULL,

    override_value text,

    note text,

    is_active boolean NOT NULL DEFAULT true,

    created_at timestamptz NOT NULL DEFAULT now(),

    updated_at timestamptz NOT NULL DEFAULT now(),

    PRIMARY KEY
    (
        object_id,
        field_name
    )
);


COMMENT ON TABLE normalization."OT_Truboprovod_P_object_override" IS
'Ручные исключения для конкретных точечных объектов трубопроводов по UUID.';


