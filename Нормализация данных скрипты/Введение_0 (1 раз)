/* ============================================================
   5. НАСТРОЙКИ ПРОЕКТОВ BGD

   UUID здесь НЕ храним.

   Мы установили, что один и тот же проект имеет
   разные Guid в разных BGD.

   Поэтому при публикации ищем Projects.Guid
   по названию проекта внутри конкретной БД.
   ============================================================ */

CREATE TABLE IF NOT EXISTS normalization."Projects"
(
    object_group varchar(100) PRIMARY KEY,

    project_name text NOT NULL,

    is_active boolean NOT NULL DEFAULT true,

    description text
);


COMMENT ON TABLE normalization."Projects" IS
'Настройки тематических проектов BGD. Хранится название проекта, а конкретный project_id определяется отдельно в каждой целевой базе.';


