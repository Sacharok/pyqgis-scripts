alter table public."OT_Truboprovod_P_YSPG_klass_prav" add column primechan varchar(255) null;
do $$
declare
	codes text[] := ARRAY['AGAZ', 'ASPG2', 'NGAZ', 'NGAZ_v2', 'TSNG', 'YGEO', 'YGEO_v2', 'YSPG','YUNG'];
	code text;
begin
	foreach code in array codes 
	loop
		--execute format('ALTER TABLE public."OT_Truboprovod_P_%s_klass_prav" ADD COLUMN dzo varchar(8) NULL;', code); 
		--execute format('UPDATE public."OT_Truboprovod_P_%s_klass_prav" set dzo = %L;', code, code);
		execute format('INSERT INTO public."OT_Truboprovod_P_klass_prav"
(geom, class_code, class_name, naim_tr, naim, rasp_piket, funk_nazn, teh_hrkt, primechan, dzo)
