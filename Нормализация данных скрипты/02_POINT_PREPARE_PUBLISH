/* ============================================================
   14. ИТОГОВЫЕ ОШИБКИ ЭТАПА 02
   ============================================================ */

SELECT
    severity,
    issue_type,
    count(*) AS issues_count

FROM normalization."OT_Truboprovod_P_publish_issues"

GROUP BY
    severity,
    issue_type

ORDER BY
    severity,
    issue_type;


/* ============================================================
   15. ЧТО ПРОИЗОЙДЁТ С CompositionOfLinearObject
   ============================================================ */

SELECT
    operation,
    count(*) AS objects_count

FROM
(
    SELECT

        n.id,

        CASE

            WHEN e.id IS NULL
                THEN 'INSERT'

            WHEN
                   e.naim
                   IS DISTINCT FROM n.naim

                OR e.funk_nazn
                   IS DISTINCT FROM n.funk_nazn

                OR e.teh_hrkt
                   IS DISTINCT FROM n.teh_hrkt

                OR e.primechan
                   IS DISTINCT FROM n.primechan

                THEN 'UPDATE'

            ELSE 'NO_CHANGE'

        END AS operation

    FROM normalization."OT_Truboprovod_P_nsi_object" n

    LEFT JOIN tmp_existing_composition e
        ON e.id = n.id

) q

GROUP BY operation

ORDER BY operation;


/* ============================================================
   16. ЧТО ПРОИЗОЙДЁТ С ПИКЕТАМИ
   ============================================================ */

SELECT
    (
        SELECT count(*)
        FROM
        (
            SELECT id, rasp_piket
            FROM normalization."OT_Truboprovod_P_nsi_pikets"

            EXCEPT

            SELECT id, rasp_piket
            FROM tmp_existing_pikets
        ) q
    ) AS pikets_to_insert,

    (
        SELECT count(*)
        FROM
        (
            SELECT e.id, e.rasp_piket
            FROM tmp_existing_pikets e

            JOIN normalization."OT_Truboprovod_P_ready" r
                ON r.id = e.id

            EXCEPT

            SELECT id, rasp_piket
            FROM normalization."OT_Truboprovod_P_nsi_pikets"
        ) q
    ) AS pikets_to_delete;


/* ============================================================
   17. ЧТО ПРОИЗОЙДЁТ СО СВЯЗЯМИ PIPELINES
   ============================================================ */

SELECT
    (
        SELECT count(*)
        FROM
        (
            SELECT id, pipeline_id
            FROM normalization."OT_Truboprovod_P_nsi_pipelines"

            EXCEPT

            SELECT id, naim_tr
            FROM tmp_existing_pipeline_links
        ) q
    ) AS links_to_insert,

    (
        SELECT count(*)
        FROM
        (
            SELECT e.id, e.naim_tr
            FROM tmp_existing_pipeline_links e

            JOIN normalization."OT_Truboprovod_P_ready" r
                ON r.id = e.id

            EXCEPT

            SELECT id, pipeline_id
            FROM normalization."OT_Truboprovod_P_nsi_pipelines"
        ) q
    ) AS links_to_delete;


/* ============================================================
   18. ОБЩЕЕ КОЛИЧЕСТВО ПОДГОТОВЛЕННЫХ ДАННЫХ
   ============================================================ */

SELECT
    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_ready"
    ) AS ready_objects,

    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_nsi_object"
    ) AS nsi_objects,

    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_nsi_pikets"
    ) AS nsi_pikets,

    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_nsi_pipelines"
    ) AS nsi_pipeline_links,

    (
        SELECT count(*)
        FROM normalization."OT_Truboprovod_P_publish_issues"
        WHERE severity = 'ERROR'
    ) AS publish_errors;
