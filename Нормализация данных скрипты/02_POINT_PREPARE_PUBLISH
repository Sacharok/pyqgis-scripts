/* ============================================================
   11. РАЗБИРАЕМ ПИКЕТЫ

   Значение не обязано быть ПК...
   Здесь просто разбивается строка по ";",
   как это делал старый этап.
   ============================================================ */

DROP TABLE IF EXISTS tmp_publish_pikets;

CREATE TEMP TABLE tmp_publish_pikets AS

SELECT DISTINCT
    r.id,

    btrim(x.value)
        AS rasp_piket

FROM normalization."OT_Truboprovod_P_ready" r

CROSS JOIN LATERAL
    unnest(
        string_to_array(
            r.rasp_piket,
            ';'
        )
    )
AS x(value)

WHERE r.rasp_piket IS NOT NULL

  AND NULLIF(
        btrim(x.value),
        ''
      ) IS NOT NULL;


