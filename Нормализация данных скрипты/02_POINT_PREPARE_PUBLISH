/* ============================================================
   12. РАЗБИРАЕМ naim_tr
   ============================================================ */

DROP TABLE IF EXISTS tmp_publish_pipeline_parts;

CREATE TEMP TABLE tmp_publish_pipeline_parts AS

SELECT
    r.id,

    btrim(x.value)
        AS source_value,

    normalization.text_key(
        btrim(x.value)
    ) AS source_key,

    normalization.pipeline_match_key(
        btrim(x.value)
    ) AS technical_key,

    normalization.numeric_signature(
        btrim(x.value)
    ) AS numbers

FROM normalization."OT_Truboprovod_P_ready" r

CROSS JOIN LATERAL
    unnest(
        string_to_array(
            r.naim_tr,
            ';'
        )
    )
AS x(value)

WHERE r.naim_tr IS NOT NULL

  AND NULLIF(
        btrim(x.value),
        ''
      ) IS NOT NULL;


/* ============================================================
   13. СОПОСТАВЛЯЕМ С Pipelines

   1. сначала обычное точное;
   2. затем технически точное;
   3. если найдено несколько одинаковых —
      оставляем старое согласованное поведение:
      берём минимальный UUID.
   ============================================================ */

DROP TABLE IF EXISTS tmp_publish_pipeline_match;

CREATE TEMP TABLE tmp_publish_pipeline_match AS

SELECT
    p.id,

    p.source_value,

    s.strict_count,

    t.technical_count,

    CASE

        WHEN s.strict_count > 0
            THEN s.pipeline_id

        WHEN t.technical_count > 0
            THEN t.pipeline_id

        ELSE NULL

    END AS pipeline_id,

    CASE

        WHEN s.strict_count = 1
            THEN 'EXACT'

        WHEN s.strict_count > 1
            THEN 'EXACT_DUPLICATE'

        WHEN t.technical_count = 1
            THEN 'TECHNICAL_EXACT'

        WHEN t.technical_count > 1
            THEN 'TECHNICAL_EXACT_DUPLICATE'

        ELSE 'NOT_FOUND'

    END AS resolution_method

FROM tmp_publish_pipeline_parts p

LEFT JOIN LATERAL
(
    SELECT
        count(*) AS strict_count,

        min(n.id::text)::uuid
            AS pipeline_id

    FROM tmp_publish_pipelines n

    WHERE normalization.text_key(n.naim_tr)
          =
          p.source_key

) s ON true

LEFT JOIN LATERAL
(
    SELECT
        count(*) AS technical_count,

        min(n.id::text)::uuid
            AS pipeline_id

    FROM tmp_publish_pipelines n

    WHERE normalization.pipeline_match_key(n.naim_tr)
          =
          p.technical_key

      AND
      (
          p.numbers IS NULL

          OR

          normalization.numeric_signature(n.naim_tr)
          =
          p.numbers
      )

) t ON true;


