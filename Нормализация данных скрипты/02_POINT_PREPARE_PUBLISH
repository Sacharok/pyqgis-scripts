BEGIN

    IF 'point_publish_nsi'
       =
       ANY
       (
           COALESCE(
               dblink_get_connections(),
               ARRAY[]::text[]
           )
       )
    THEN

        PERFORM dblink_disconnect(
            'point_publish_nsi'
        );

    END IF;

END $$;


