/* ============================================================
   2. БЛОКИРУЕМ ЭТАП, ЕСЛИ 01 ЕЩЁ НЕ ЗАВЕРШЁН
   ============================================================ */

DO $$
DECLARE
    v_count bigint;
BEGIN

    SELECT count(*)
    INTO v_count
    FROM normalization."OT_Truboprovod_P_issues"
    WHERE severity IN ('ERROR', 'REVIEW');

    IF v_count > 0 THEN

        RAISE EXCEPTION
            'Публикация пока запрещена. После 01 остаётся % ERROR/REVIEW.',
            v_count;

    END IF;

END $$;


