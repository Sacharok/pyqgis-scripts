# -*- coding: utf-8 -*-
"""
Самостоятельная выгрузка «Координаты отдельных объектов» — v2.1.

Источник: только текущие таблицы/слои QGIS/PostgreSQL.
Исходный Excel НЕ используется.

Согласованная логика:
1. Все ConnectionPoints выгружаются как отдельные записи БД.
   Одинаковые имена НЕ схлопываются.
2. 7 новых ConnectionPoints исключаются.
3. Добавляются 20 подтверждённых GasDeliveryPoints (ТСГ).
   Префикс «ТСГ » снимается только при выводе имени.
4. Для 4 подтверждённых узлов добавляется ещё одна строка.
   Если в GtsPoints есть второй объект с таким же именем, берутся его
   актуальные координаты; иначе повторяется актуальная строка из БД.
5. Никакого специального правила для 182 км Уренгой-Новопсков и
   5 км отвод на Клинцы нет.

Ожидаемый результат при текущем составе БД: 4558 строк.
"""

import re
from pathlib import Path
from collections import defaultdict

from qgis.core import QgsProject
from qgis.PyQt.QtCore import QStandardPaths
from qgis.PyQt.QtWidgets import QFileDialog, QMessageBox

try:
    from openpyxl import Workbook
    from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
except Exception as exc:
    raise RuntimeError(
        "Не удалось импортировать openpyxl.\n"
        f"{exc}"
    )


EXPECTED_CONNECTION_COUNT = 4541
EXPECTED_FINAL_COUNT = 4558

# Эти ConnectionPoints появились позднее и в обратную выгрузку не входят.
EXCLUDED_CONNECTIONS = {
    "1 км отвод на Обнинск",
    "162 км Тула-Торжок",
    "17,9 км отвод на Николаевку (ВЛГ)",
    "212 км Тула-Торжок",
    "3 км отвод на Нижнетверская",
    "30,544 км отвод на Михайлов",
    "36 км Якшуновская СПХГ-КС Белоусово",
}

# 20 позиций ТСГ, которые должны быть дополнительно представлены
# на листе координат.
#
# Для Ставролен/Ставрополь разрешены оба варианта написания ТОЛЬКО
# для поиска объекта в БД. В Excel выводится фактическое имя из БД.
TSG_SLOTS = [
    ("0 км Астраханский ГПЗ-Замьяны",),
    ("0 км Астраханский ГПЗ-Камыш-Бурун",),
    ("0 км Бованенково-Ухта",),
    ("0 км Заполярное-Уренгой",),
    ("0 км Коробки-Лог",),
    ("0 км Медвежье-Надым",),
    ("0 км Миннибаево-Ижевск",),
    ("0 км Миннибаево-Казань",),
    ("0 км Нефтегорский ГПЗ-Самара",),
    ("0 км Нижневартовский ГПЗ-Парабель",),
    ("0 км Отрадненский ГПЗ-Тольятти",),
    (
        "0 км Ставролен-КС Невинномысская",
        "0 км Ставрополь-КС Невинномысская",
    ),
    ("0 км УКПГ-15-КС Ямбургская",),
    ("0 км Усинский ГПЗ-КС Ухта",),
    ("16,5 км УКПГ-15-КС Ямбургская",),
    ("254 км Шкапово-Ишимбай",),
    ("31 км УКПГ-15-КС Ямбургская",),
    ("622,51 км Уренгой-Челябинск",),
    ("0 км Оренбург-Заинск",),
    ("0 км Выгнапуровский ГПЗ-Уренгой-Челябинск",),
]

# Эти четыре узла должны быть представлены второй строкой сверх
# базовой строки ConnectionPoint.
#
# Это автономное правило экспорта: исходный Excel при запуске не читается.
ADDITIONAL_JUNCTION_ROWS = [
    "107,3 км Торжок-Минск-Ивацевичи",
    "215 км Средняя Азия-Центр III,IV",
    "73 км ДКБМ-Калуга-Белоусово",
    "99 км Коломна-Рязань",
]


def clean_text(value):
    if value is None:
        return ""
    return str(value).replace("\u00a0", " ").strip()


def strip_tsg_prefix(value):
    text = clean_text(value)
    return re.sub(r"^\s*ТСГ\s+", "", text, flags=re.IGNORECASE).strip()


def name_key(value):
    """
    Ключ используется только для поиска/сопоставления.
    В выгружаемое имя изменения не вносятся, кроме снятия начального «ТСГ ».
    """
    text = strip_tsg_prefix(value)
    text = text.replace("–", "-").replace("—", "-").replace("−", "-")
    text = re.sub(r"\s*-\s*", "-", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text.casefold()


_FIELD_MAP_CACHE = {}


def field_map(layer):
    cache_key = layer.id()
    cached = _FIELD_MAP_CACHE.get(cache_key)
    if cached is None:
        cached = {f.name().casefold(): f.name() for f in layer.fields()}
        _FIELD_MAP_CACHE[cache_key] = cached
    return cached


def attr(layer, feature, *names, default=None):
    fmap = field_map(layer)
    for name in names:
        actual = fmap.get(str(name).casefold())
        if actual is not None:
            value = feature[actual]
            return default if value is None else value
    return default


def uuid_key(value):
    if value is None:
        return ""
    return str(value).strip().lower().strip("{}")


def get_layer(name):
    wanted = name.casefold()
    exact = []
    fallback = []

    for layer in QgsProject.instance().mapLayers().values():
        if layer is None or not layer.isValid():
            continue

        if layer.name().casefold() == wanted:
            exact.append(layer)
            continue

        source = (layer.source() or "").casefold()
        if (
            f'table="{wanted}"' in source
            or f"table={wanted}" in source
            or f'"{wanted}"' in source
        ):
            fallback.append(layer)

    if exact:
        return exact[0]
    if fallback:
        return fallback[0]
    return None


def point_data(gts_layer, feature):
    return {
        "id": attr(gts_layer, feature, "Id", "id"),
        "name": clean_text(attr(gts_layer, feature, "Name", "name")),
        "latitude": attr(gts_layer, feature, "Latitude", "latitude"),
        "longitude": attr(gts_layer, feature, "Longitude", "longitude"),
    }


def main():
    project = QgsProject.instance()

    gts_layer = get_layer("GtsPoints")
    connection_layer = get_layer("ConnectionPoints")
    delivery_layer = get_layer("GasDeliveryPoints")

    missing = []
    if gts_layer is None:
        missing.append("GtsPoints")
    if connection_layer is None:
        missing.append("ConnectionPoints")
    if delivery_layer is None:
        missing.append("GasDeliveryPoints")

    if missing:
        QMessageBox.critical(
            None,
            "Не хватает таблиц",
            "Не найдены:\n" + "\n".join(missing),
        )
        return

    try:
        from qgis.utils import iface
        parent = iface.mainWindow()
    except Exception:
        parent = None

    desktop = QStandardPaths.writableLocation(QStandardPaths.DesktopLocation)
    default_path = str(
        Path(desktop) / "Координаты_отдельных_объектов_v2_1.xlsx"
    )

    output_path, _ = QFileDialog.getSaveFileName(
        parent,
        "Сохранить координаты отдельных объектов",
        default_path,
        "Excel (*.xlsx)",
    )
    if not output_path:
        return
    if not output_path.lower().endswith(".xlsx"):
        output_path += ".xlsx"

    # ---------------------------------------------------------------
    # Индексы GtsPoints.
    # ---------------------------------------------------------------
    gts_by_id = {}
    gts_by_name = defaultdict(list)

    for feature in gts_layer.getFeatures():
        data = point_data(gts_layer, feature)
        id_key = uuid_key(data["id"])
        if id_key:
            gts_by_id[id_key] = data

        key = name_key(data["name"])
        if key:
            gts_by_name[key].append(data)

    rows = []
    diagnostics = []

    # Для выбора второго GtsPoint у 4 дополнительных узлов.
    used_gts_ids = set()

    # ---------------------------------------------------------------
    # 1. Все ConnectionPoints, кроме 7 исключаемых.
    # ВАЖНО: одинаковые имена здесь НЕ схлопываются.
    # ---------------------------------------------------------------
    excluded_keys = {name_key(x) for x in EXCLUDED_CONNECTIONS}
    excluded_found = set()

    connection_count = 0
    base_connection_rows = 0

    # Сохраняем строки CP по имени, чтобы при необходимости повторить
    # актуальную строку для дополнительного узла.
    exported_cp_by_name = defaultdict(list)

    for feature in connection_layer.getFeatures():
        connection_count += 1

        object_id = attr(connection_layer, feature, "Id", "id")
        data = gts_by_id.get(uuid_key(object_id))

        if data is None:
            diagnostics.append([
                "ОШИБКА",
                "ConnectionPoint",
                "",
                clean_text(object_id),
                "ConnectionPoints.Id не найден в GtsPoints.",
            ])
            continue

        key = name_key(data["name"])

        if key in excluded_keys:
            excluded_found.add(key)
            diagnostics.append([
                "ИСКЛЮЧЕН",
                "ConnectionPoint",
                data["name"],
                clean_text(data["id"]),
                "Новая точка; по согласованному правилу не выгружается.",
            ])
            continue

        export_row = {
            "attr_field": None,
            "name": strip_tsg_prefix(data["name"]),
            "latitude": data["latitude"],
            "longitude": data["longitude"],
            "id": data["id"],
            "kind": "ConnectionPoint",
        }
        rows.append(export_row)
        exported_cp_by_name[key].append(export_row)
        used_gts_ids.add(uuid_key(data["id"]))
        base_connection_rows += 1

    # ---------------------------------------------------------------
    # 2. Добавляем 20 ТСГ.
    # Каждая позиция TSG_SLOTS должна дать ровно одну строку.
    # ---------------------------------------------------------------
    delivery_candidates = []

    for feature in delivery_layer.getFeatures():
        object_id = attr(delivery_layer, feature, "Id", "id")
        data = gts_by_id.get(uuid_key(object_id))
        if data is not None:
            delivery_candidates.append(data)

    tsg_added = 0
    tsg_missing = []

    for slot_no, aliases in enumerate(TSG_SLOTS, start=1):
        alias_keys = {name_key(x) for x in aliases}

        matches = [
            data for data in delivery_candidates
            if name_key(data["name"]) in alias_keys
        ]

        # Резерв: если связь GasDeliveryPoints почему-то не прочиталась,
        # ищем тот же объект непосредственно в GtsPoints.
        if not matches:
            seen_ids = set()
            for alias in aliases:
                for data in gts_by_name.get(name_key(alias), []):
                    key_id = uuid_key(data["id"])
                    if key_id not in seen_ids:
                        matches.append(data)
                        seen_ids.add(key_id)

        if not matches:
            tsg_missing.append(aliases[0])
            diagnostics.append([
                "НЕ_НАЙДЕН",
                "ТСГ",
                " / ".join(aliases),
                "",
                "Не найден ни через GasDeliveryPoints, ни напрямую в GtsPoints.",
            ])
            continue

        # Если вдруг найдено несколько вариантов, выбираем первый,
        # но фиксируем это в контроле.
        data = matches[0]
        if len(matches) > 1:
            diagnostics.append([
                "НЕСКОЛЬКО_КАНДИДАТОВ",
                "ТСГ",
                strip_tsg_prefix(data["name"]),
                clean_text(data["id"]),
                f"Для позиции №{slot_no} найдено кандидатов: {len(matches)}; "
                "выбран первый.",
            ])

        rows.append({
            "attr_field": None,
            "name": strip_tsg_prefix(data["name"]),
            "latitude": data["latitude"],
            "longitude": data["longitude"],
            "id": data["id"],
            "kind": "GasDeliveryPoint/ТСГ",
        })
        used_gts_ids.add(uuid_key(data["id"]))
        tsg_added += 1

    # ---------------------------------------------------------------
    # 3. Четыре дополнительные строки узлов.
    #
    # Сначала стараемся взять ДРУГОЙ GtsPoint с тем же именем, который
    # ещё не был выгружен. Это особенно важно для 73 км
    # ДКБМ-Калуга-Белоусово, где две записи могут иметь разные координаты.
    #
    # Если второго GtsPoint в БД уже нет, повторяем актуальную строку CP.
    # ---------------------------------------------------------------
    junction_added = 0

    for expected_name in ADDITIONAL_JUNCTION_ROWS:
        key = name_key(expected_name)
        candidates = gts_by_name.get(key, [])

        unused = [
            data for data in candidates
            if uuid_key(data["id"]) not in used_gts_ids
        ]

        if unused:
            data = unused[0]
            rows.append({
                "attr_field": None,
                "name": strip_tsg_prefix(data["name"]),
                "latitude": data["latitude"],
                "longitude": data["longitude"],
                "id": data["id"],
                "kind": "Дополнительный GtsPoint",
            })
            used_gts_ids.add(uuid_key(data["id"]))
            junction_added += 1

            diagnostics.append([
                "ДОБАВЛЕН",
                "Дополнительный узел",
                data["name"],
                clean_text(data["id"]),
                "Найден отдельный GtsPoint с тем же именем.",
            ])
            continue

        # Если отдельного объекта уже нет, повторяем текущую актуальную
        # строку ConnectionPoint. Это не чтение исходного Excel.
        existing = exported_cp_by_name.get(key, [])
        if existing:
            base = existing[0]
            rows.append({
                "attr_field": None,
                "name": base["name"],
                "latitude": base["latitude"],
                "longitude": base["longitude"],
                "id": base["id"],
                "kind": "Дополнительная строка узла",
            })
            junction_added += 1

            diagnostics.append([
                "ПОВТОРЕН",
                "Дополнительный узел",
                base["name"],
                clean_text(base["id"]),
                "Отдельного второго GtsPoint нет; повторена актуальная "
                "строка ConnectionPoint.",
            ])
            continue

        diagnostics.append([
            "НЕ_НАЙДЕН",
            "Дополнительный узел",
            expected_name,
            "",
            "Нет ни отдельного GtsPoint, ни базовой строки ConnectionPoint.",
        ])

    # ---------------------------------------------------------------
    # 4. Сортировка.
    # Не удаляем строки с одинаковыми именами.
    # Python sort стабилен, поэтому одинаковые имена сохраняются обе.
    # ---------------------------------------------------------------
    rows.sort(
        key=lambda row: (
            name_key(row["name"]),
            str(row["latitude"] if row["latitude"] is not None else ""),
            str(row["longitude"] if row["longitude"] is not None else ""),
            row["kind"],
        )
    )

    # ---------------------------------------------------------------
    # 5. Excel.
    # ---------------------------------------------------------------
    wb = Workbook()
    ws = wb.active
    ws.title = "Координаты отдельных объектов"

    headers = [
        "Атрибутивное поле",
        "Наименование",
        "Широта WGS84",
        "Долгота WGS84",
    ]
    ws.append(headers)

    for row in rows:
        ws.append([
            row["attr_field"],
            row["name"],
            row["latitude"],
            row["longitude"],
        ])

    ctrl = wb.create_sheet("Контроль")
    ctrl.append(["Показатель", "Значение"])
    ctrl.append(["ConnectionPoints в БД", connection_count])
    ctrl.append(["Ожидалось ConnectionPoints", EXPECTED_CONNECTION_COUNT])
    ctrl.append(["ConnectionPoints после исключения 7", base_connection_rows])
    ctrl.append(["Найдено исключаемых из 7", len(excluded_found)])
    ctrl.append(["Добавлено специальных ТСГ", tsg_added])
    ctrl.append(["Ожидалось специальных ТСГ", len(TSG_SLOTS)])
    ctrl.append(["Добавлено дополнительных узлов", junction_added])
    ctrl.append(["Ожидалось дополнительных узлов", len(ADDITIONAL_JUNCTION_ROWS)])
    ctrl.append(["Итоговых строк", len(rows)])
    ctrl.append(["Ожидалось итоговых строк", EXPECTED_FINAL_COUNT])
    ctrl.append([
        "Статус количества",
        "OK" if len(rows) == EXPECTED_FINAL_COUNT else "ПРОВЕРИТЬ",
    ])
    ctrl.append([])
    ctrl.append(["Статус", "Тип", "Наименование", "Id", "Комментарий"])

    for item in diagnostics:
        ctrl.append(item)

    header_fill = PatternFill("solid", fgColor="1F4E78")
    header_font = Font(color="FFFFFF", bold=True)
    thin = Side(style="thin", color="D9E1F2")

    for sheet in (ws, ctrl):
        for cell in sheet[1]:
            cell.fill = header_fill
            cell.font = header_font
            cell.alignment = Alignment(horizontal="center", vertical="center")
        for row_cells in sheet.iter_rows():
            for cell in row_cells:
                cell.border = Border(bottom=thin)
                cell.alignment = Alignment(vertical="top", wrap_text=True)

    # Заголовок подробного контроля.
    for cell in ctrl[14]:
        cell.fill = header_fill
        cell.font = header_font

    ws.freeze_panes = "A2"
    ctrl.freeze_panes = "A2"

    ws.column_dimensions["A"].width = 22
    ws.column_dimensions["B"].width = 58
    ws.column_dimensions["C"].width = 18
    ws.column_dimensions["D"].width = 18

    ctrl.column_dimensions["A"].width = 30
    ctrl.column_dimensions["B"].width = 28
    ctrl.column_dimensions["C"].width = 62
    ctrl.column_dimensions["D"].width = 40
    ctrl.column_dimensions["E"].width = 80

    wb.save(output_path)

    msg = (
        f"Готово.\n\n"
        f"ConnectionPoints в БД: {connection_count}\n"
        f"После исключения 7: {base_connection_rows}\n"
        f"Добавлено ТСГ: {tsg_added} из {len(TSG_SLOTS)}\n"
        f"Добавлено дополнительных узлов: "
        f"{junction_added} из {len(ADDITIONAL_JUNCTION_ROWS)}\n"
        f"Итог: {len(rows)} строк "
        f"(ожидалось {EXPECTED_FINAL_COUNT})\n\n"
        f"Файл:\n{output_path}"
    )

    if tsg_missing:
        msg += "\n\nНе найдены ТСГ:\n" + "\n".join(tsg_missing)

    if len(rows) == EXPECTED_FINAL_COUNT:
        QMessageBox.information(None, "Выгрузка завершена", msg)
    else:
        QMessageBox.warning(
            None,
            "Выгрузка завершена с контролем",
            msg + "\n\nСмотрите лист «Контроль».",
        )


# Для редактора Python QGIS запускаем напрямую.
main()
