SELECT
    id,
    class_code,
    class_name,
    naim_tr,
    naim,
    rasp_piket,
    funk_nazn,
    teh_hrkt,
    primechan
FROM public."OT_Truboprovod_P"
ORDER BY class_name, naim
LIMIT 50;


SELECT
    id,
    class_code,
    class_name,
    naim_tr,
    naim,
    rasp_piket,
    funk_nazn,
    teh_hrkt,
    primechan
FROM public."OT_Truboprovod_A"
ORDER BY class_name, naim
LIMIT 50;


SELECT
    'P' AS geometry_type,
    class_code,
    class_name,
    count(*) AS cnt
FROM public."OT_Truboprovod_P"
GROUP BY class_code, class_name

UNION ALL

SELECT
    'A',
    class_code,
    class_name,
    count(*)
FROM public."OT_Truboprovod_A"
GROUP BY class_code, class_name

ORDER BY geometry_type, class_name;
