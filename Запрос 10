SELECT
    (SELECT count(*) FROM tmp_truboprovod_p) AS source_count,

    (
        SELECT count(*)
        FROM public."CompositionOfLinearObject" target
        JOIN tmp_truboprovod_p source
            ON source.id = target.id
    ) AS object_count,

    (
        SELECT count(*)
        FROM public."CompositionOfLinearObjectPipelines" target
        JOIN tmp_truboprovod_p source
            ON source.id = target.id
    ) AS link_count;
