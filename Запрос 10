SELECT
    count(*) AS total_rows,
    count(*) FILTER (WHERE naim IS NULL) AS no_naim,
    count(*) FILTER (WHERE naim_tr IS NULL) AS no_pipeline,
    count(*) FILTER (WHERE funk_nazn IS NULL) AS no_funk_nazn
FROM public."OT_Truboprovod_P_klass_prav";



DROP TABLE IF EXISTS tmp_truboprovod_p;

CREATE TEMP TABLE tmp_truboprovod_p AS
SELECT *
FROM dblink(
    'host=... port=5432 dbname=normalization user=... password=...',
    $query$
        SELECT
            id,
            naim,
            funk_nazn,
            teh_hrkt,
            primechan,
            naim_tr
        FROM public."OT_Truboprovod_P_klass_prav"
    $query$
) AS source
(
    id uuid,
    naim varchar(255),
    funk_nazn varchar(255),
    teh_hrkt text,
    primechan text,
    naim_tr varchar(255)
);



SELECT
    source.naim_tr,
    count(pipeline.id) AS pipeline_count
FROM (
    SELECT DISTINCT naim_tr
    FROM tmp_truboprovod_p
    WHERE naim_tr IS NOT NULL
) source
LEFT JOIN public."Pipelines" pipeline
    ON lower(btrim(pipeline.naim_tr))
       = lower(btrim(source.naim_tr))
GROUP BY source.naim_tr
HAVING count(pipeline.id) <> 1
ORDER BY source.naim_tr;




