INSERT INTO public."CompositionOfLinearObject"
(
    id,
    naim,
    funk_nazn,
    teh_hrkt,
    primechan
)
SELECT
    source.id,
    source.naim,
    reference.id,
    source.teh_hrkt,
    source.primechan
FROM tmp_truboprovod_p source
LEFT JOIN public."PurposesOfPipelineNetworkObjects" reference
    ON lower(btrim(reference.naim))
       = lower(btrim(source.funk_nazn))
ON CONFLICT (id) DO UPDATE
SET
    naim = EXCLUDED.naim,
    funk_nazn = EXCLUDED.funk_nazn,
    teh_hrkt = EXCLUDED.teh_hrkt,
    primechan = EXCLUDED.primechan;


