INSERT INTO public."CompositionOfLinearObjectPipelines"
(
    id,
    naim_tr,
    "IsBlocked"
)
SELECT
    source.id,
    pipeline.id,
    false
FROM tmp_truboprovod_p source
JOIN public."Pipelines" pipeline
    ON lower(btrim(pipeline.naim_tr))
       = lower(btrim(source.naim_tr))
ON CONFLICT (id) DO UPDATE
SET
    naim_tr = EXCLUDED.naim_tr;



