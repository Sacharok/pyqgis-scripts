WITH RECURSIVE start_gis AS (
    SELECT
        g."Id" AS gis_id,
        p."Name" AS gis_name
    FROM "GasMeasuringStations" g
    JOIN "GtsPoints" p
        ON p."Id" = g."Id"
    WHERE p."Name" ILIKE '%НАЗВАНИЕ ГИС%'
),
walk AS (
    SELECT
        s.gis_id,
        s.gis_name,
        s.gis_id AS point_id,
        s.gis_name AS point_name,
        0 AS depth,
        ARRAY[s.gis_id] AS visited,
        ARRAY[s.gis_name::text] AS point_path
    FROM start_gis s

    UNION ALL

    SELECT
        w.gis_id,
        w.gis_name,
        next_point."Id",
        next_point."Name",
        w.depth + 1,
        w.visited || next_point."Id",
        w.point_path || next_point."Name"::text
    FROM walk w
    JOIN "GasPipeSegments" segment
        ON segment."StartGtsPointId" = w.point_id
        OR segment."EndGtsPointId" = w.point_id
    JOIN "GtsPoints" next_point
        ON next_point."Id" =
            CASE
                WHEN segment."StartGtsPointId" = w.point_id
                    THEN segment."EndGtsPointId"
                ELSE segment."StartGtsPointId"
            END
    WHERE w.depth < 10
      AND NOT next_point."Id" = ANY(w.visited)
)
SELECT
    w.gis_name,
    w.depth,
    w.point_name AS point_with_zone,
    iz."Name" AS in_zone,
    oz."Number" AS out_zone,
    array_to_string(w.point_path, ' → ') AS connection_path
FROM walk w
JOIN "GtsPoints" p
    ON p."Id" = w.point_id
LEFT JOIN "InZones" iz
    ON iz."Id" = p."InZoneId"
LEFT JOIN "OutZones" oz
    ON oz."Id" = p."OutZoneId"
WHERE w.depth > 0
  AND (
      p."InZoneId" IS NOT NULL
      OR p."OutZoneId" IS NOT NULL
  )
ORDER BY w.depth, w.point_name;
