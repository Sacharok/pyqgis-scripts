    )

    # Индексы.
    indexes = {
        name: build_index(layer)
        for name, layer in layers.items()
        if layer is not None
    }

    gts_layer = layers["GtsPoints"]
    gts_index = indexes.get("GtsPoints", {})
    region_layer = layers["Regions"]
    region_index = indexes.get("Regions", {})
    transgas_layer = layers["TransGases"]
    transgas_index = indexes.get("TransGases", {})
    inzone_layer = layers["InZones"]
    inzone_index = indexes.get("InZones", {})
    outzone_layer = layers["OutZones"]
    outzone_index = indexes.get("OutZones", {})
    pipeline_layer = layers["GasPipelines"]
    pipeline_index = indexes.get("GasPipelines", {})

    fieldpoints_layer = layers["FieldPoints"]
    fieldpoints_index = indexes.get("FieldPoints", {})

    # Типы значимых объектов используются только для разбиения маршрутов.
    # ConnectionPoints намеренно не включены: это технические точки,
    # через которые маршрут должен продолжаться.
    point_types = defaultdict(set)
    significant_layers = {
        "CompressionStations": "КС",
        "GasDistributionStations": "ГРС",
        "GasMeasuringStations": "ГИС",
        "UndergroundGasStorages": "ПХГ",
        "BalancePoints": "БП",
        "GasDeliveryPoints": "ТСГ",
    }

    for layer_name, type_name in significant_layers.items():
        layer = layers.get(layer_name)
        if layer is None:
            continue
        for feature in layer.getFeatures():
            point_id = attr(layer, feature, "Id")
            point_key = uuid_key(point_id)
            if point_key:
                point_types[point_key].add(type_name)

    lic_layer = layers["LicUch"]
    lic_index = indexes.get("LicUch", {})
    user_layer = layers["SubsoilUsers"]
    user_index = indexes.get("SubsoilUsers", {})

    def point_data(point_feature):
        if point_feature is None:
            return {
                "id": None,
                "name": None,
                "latitude": None,
                "longitude": None,
                "in_zone": None,
                "out_zone": None,
                "out_zone_name": None,
                "transgas": None,
                "remark": None,
                "updated": None,
            }

        point_id = attr(gts_layer, point_feature, "Id", "id")
        in_zone_id = attr(gts_layer, point_feature, "InZoneId")
        out_zone_id = attr(gts_layer, point_feature, "OutZoneId")
        transgas_id = attr(gts_layer, point_feature, "TransGasId")

        in_zone = display_value(
            inzone_layer,
            inzone_index,
            in_zone_id,
            "Number",
            "Name",
        )
        out_zone = display_value(
            outzone_layer,
            outzone_index,
            out_zone_id,
            "Number",
        )
        out_zone_name = display_value(
            outzone_layer,
            outzone_index,
            out_zone_id,
            "Name",
        )
        transgas = display_value(
            transgas_layer,
            transgas_index,
            transgas_id,
            "Name",
        )

        return {
            "id": point_id,
            "name": attr(gts_layer, point_feature, "Name"),
            "latitude": attr(gts_layer, point_feature, "Latitude"),
            "longitude": attr(gts_layer, point_feature, "Longitude"),
            "in_zone": in_zone,
            "out_zone": out_zone,
            "out_zone_name": out_zone_name,
            "transgas": transgas,
            "remark": attr(gts_layer, point_feature, "Remark"),
            "updated": attr(gts_layer, point_feature, "UpdatedDate"),
        }

    def region_name(region_id):
        return display_value(
            region_layer,
            region_index,
            region_id,
            "Name",
        )

    def point_name(point_id):
        point = lookup_feature(gts_index, point_id)
        return attr(gts_layer, point, "Name")

    def pipeline_name(pipeline_id):
        return display_value(
            pipeline_layer,
            pipeline_index,
            pipeline_id,
            "Name",
        )

    # Прямые связи точек с сегментами.
    # Ключ — UUID точки, значение — список примыкающих GasPipeSegments.
    segment_layer = layers["GasPipeSegments"]
    adjacent_segments_by_point = defaultdict(list)

    for segment_feature in segment_layer.getFeatures():
        start_point_id = attr(
            segment_layer,
            segment_feature,
            "StartGtsPointId",
        )
        end_point_id = attr(
            segment_layer,
            segment_feature,
            "EndGtsPointId",
        )

        start_key = uuid_key(start_point_id)
        end_key = uuid_key(end_point_id)

        if start_key:
            adjacent_segments_by_point[start_key].append(segment_feature)
        if end_key and end_key != start_key:
            adjacent_segments_by_point[end_key].append(segment_feature)

    def direct_point_connections(point_id):
        """
        Возвращает все прямые связи точки с GasPipeSegments.

        Для каждой связи:
        - pipeline_name: GasPipelines.Name;
        - start_kilometer: GasPipeSegments.StartKilometer;
        - length: GasPipeSegments.Length;
        - connected_point_name: GtsPoints.Name противоположного конца;
        - connected_point_id: UUID противоположного конца.
        """
        result = []
        point_key = uuid_key(point_id)

        for segment in adjacent_segments_by_point.get(point_key, []):
            segment_id = attr(segment_layer, segment, "Id")
            start_id = attr(
                segment_layer,
                segment,
                "StartGtsPointId",
            )
            end_id = attr(
                segment_layer,
                segment,
                "EndGtsPointId",
            )

            if uuid_key(start_id) == point_key:
                connected_id = end_id
            else:
                connected_id = start_id

            pipeline_id = attr(
                segment_layer,
                segment,
                "GasPipelineId",
            )

            result.append({
                "segment_id": segment_id,
                "pipeline_id": pipeline_id,
                "pipeline_name": pipeline_name(pipeline_id),
                "start_kilometer": attr(
                    segment_layer,
                    segment,
                    "StartKilometer",
                ),
                "length": attr(
                    segment_layer,
                    segment,
                    "Length",
                ),
                "connected_point_id": connected_id,
                "connected_point_name": point_name(connected_id),
            })

        result.sort(
            key=lambda item: (
                str(item["pipeline_name"] or ""),
                as_float(item["start_kilometer"]) or 0,
                str(item["connected_point_name"] or ""),
                str(item["segment_id"] or ""),
            )
        )
        return result

    def field_point_name_and_guid(field_point_id):
        """
        FieldPoints.Id одновременно является ссылкой на GtsPoints.Id.
        Название берём непосредственно из GtsPoints.Name.
        Пустой FieldPointId является допустимым значением.
        """
        if field_point_id is None:
            return None, None

        field_feature = lookup_feature(fieldpoints_index, field_point_id)
        base_point = lookup_feature(gts_index, field_point_id)

        if field_feature is None:
            add_error(
                "Связи объектов",
                field_point_id,
                "Нет FieldPoints",
                "Идентификатор не найден в FieldPoints.",
            )

        if base_point is None:
            add_error(
                "Связи объектов",
                field_point_id,
                "Нет GtsPoints",
                "FieldPoints.Id не найден в GtsPoints.",
            )

        return attr(gts_layer, base_point, "Name"), clean_value(field_point_id)

    # Длины коллекторов по FieldPointId.
    collector_lengths = defaultdict(list)
    collectors_layer = layers["Collectors"]
    if collectors_layer is not None:
        for feature in collectors_layer.getFeatures():
            field_id = attr(collectors_layer, feature, "FieldPointId")
            key = uuid_key(field_id)
            length = attr(collectors_layer, feature, "Length")
            if key and length is not None:
                collector_lengths[key].append(length)

    workbook = Workbook()
    workbook.remove(workbook.active)

    # 1. Сегменты.
    ws = create_sheet(
        workbook,
        "Сегменты",
        "Таблица 1. Сегменты газопроводов",
        [
            "Атрибутивное поле",
            "Наименование",
            "Начало участка, км",
            "Точка начала",
            "Длина, км",
            "Точка конца",
            "Обратное направление",
            "Мощность, млрд. куб. м в год",
            "Давление, МПа",
            "Диаметр труб, мм",
            "Состояние газопровода",
            "Принадлежность к ТрансГазу",
            "Примечание",
            "Субъект РФ",
            "Точки перемычки, которые не должны игнорироваться (помечены единицей)",
        ],
    )

    segment_layer = layers["GasPipeSegments"]
    segment_records = []

    for feature in segment_layer.getFeatures():
        segment_id = attr(segment_layer, feature, "Id")
        start_id = attr(segment_layer, feature, "StartGtsPointId")
        end_id = attr(segment_layer, feature, "EndGtsPointId")
        pipeline_id = attr(segment_layer, feature, "GasPipelineId")
        transgas_id = attr(segment_layer, feature, "TransGasId")
        region_id = attr(segment_layer, feature, "RegionId")

        pipeline = pipeline_name(pipeline_id)
        start_km = attr(segment_layer, feature, "StartKilometer")
        start_point = point_name(start_id)
        length = attr(segment_layer, feature, "Length")
        end_point = point_name(end_id)
        power = attr(segment_layer, feature, "Power")
        pressure = attr(segment_layer, feature, "Pressure")
        diameter = attr(segment_layer, feature, "Diameter")
        state = attr(segment_layer, feature, "State")
        transgas = display_value(
            transgas_layer, transgas_index, transgas_id, "Name"
        )
        remark = attr(segment_layer, feature, "Remark")
        region = region_name(region_id)

        if not start_point:
            add_error("Сегменты", segment_id, "Нет точки начала", str(start_id))
        if not end_point:
            add_error("Сегменты", segment_id, "Нет точки конца", str(end_id))

        segment_records.append({
            "feature": feature,
            "segment_id": segment_id,
            "pipeline": pipeline,
            "start_km": start_km,
            "start_point": start_point,
            "length": length,
            "end_point": end_point,
            "power": power,
            "pressure": pressure,
            "diameter": diameter,
            "state": state,
            "transgas": transgas,
            "remark": remark,
            "region": region,
            "basic_key": segment_basic_reference_key(
                pipeline, start_km, start_point, length, end_point
            ),
            "full_key": segment_full_reference_key(
                pipeline, start_km, start_point, length, end_point,
                power, pressure, diameter, state, transgas, remark, region
            ),
            "special": None,
            "match_mode": None,
        })

    # Специальные значения сначала распределяем по полному ключу. Это важно
    # для одинаковых геометрически строк, которые различаются, например, регионом.
    source_specials = load_segment_special_reference()
    by_full = defaultdict(list)
    by_basic = defaultdict(list)
    for ref_id, ref in enumerate(source_specials):
        by_full[ref["full_key"]].append(ref_id)
        by_basic[ref["basic_key"]].append(ref_id)

    used_refs = set()
    exact_matches = 0
    fallback_matches = 0

    def take_reference(index, key):
        for ref_id in index.get(key, []):
            if ref_id not in used_refs:
                used_refs.add(ref_id)
                return source_specials[ref_id]
        return None

    # Проход 1 — точное совпадение обычных атрибутов.
    for record in segment_records:
        ref = take_reference(by_full, record["full_key"])
        if ref is not None:
            record["special"] = ref
            record["match_mode"] = "FULL"
            exact_matches += 1

    # Проход 2 — резервный ключ. Применяется только к ещё не размеченным
    # сегментам и только к ещё не использованным строкам исходника.
    for record in segment_records:
        if record["special"] is not None:
            continue
        ref = take_reference(by_basic, record["basic_key"])
        if ref is not None:
            record["special"] = ref
            record["match_mode"] = "BASIC"
            fallback_matches += 1

    unmatched_refs = [
        ref for ref_id, ref in enumerate(source_specials)
        if ref_id not in used_refs
    ]

    segment_records.sort(
        key=lambda r: (
            str(r["pipeline"] or ""),
            as_float(r["start_km"]) if as_float(r["start_km"]) is not None else -1e100,
            str(r["start_point"] or ""),
            as_float(r["length"]) if as_float(r["length"]) is not None else -1e100,
            str(r["end_point"] or ""),
            str(r["segment_id"] or ""),
        )
    )

    for record in segment_records:
        special = record["special"] or {}
        append_row(
            ws,
            [
                excel_flag(special.get("attr_field"))
                if special.get("attr_field") in {"0", "1"}
                else special.get("attr_field"),
                record["pipeline"],
                record["start_km"],
                record["start_point"],
                record["length"],
                record["end_point"],
                excel_flag(special.get("reverse_direction")),
                record["power"],
                record["pressure"],
                record["diameter"],
                record["state"],
                record["transgas"],
                record["remark"],
                record["region"],
                excel_flag(special.get("switch_flag")),
            ],
        )
    finalize_sheet(ws)

    # Контроль сопоставления специальных строк исходного листа.
    ws_segment_control = create_sheet(
        workbook,
        "Сегменты_контроль",
        "Контроль восстановления специальных полей сегментов",
        [
            "Статус",
            "Атрибутивное поле",
            "Наименование",
            "Начало участка, км",
            "Точка начала",
            "Длина, км",
            "Точка конца",
            "Обратное направление",
            "Флаг перемычки",
        ],
    )
    if unmatched_refs:
        for ref in unmatched_refs:
            append_row(
                ws_segment_control,
                [
                    "НЕ СОПОСТАВЛЕНО",
                    ref["attr_field"],
                    ref["pipeline"],
                    as_float(ref["start_km"]),
                    ref["start_point"],
                    as_float(ref["length"]),
                    ref["end_point"],
                    excel_flag(ref["reverse_direction"]),
                    excel_flag(ref["switch_flag"]),
                ],
            )
    else:
        append_row(
            ws_segment_control,
            ["OK — все 878 специальных строк исходника сопоставлены"],
        )
    finalize_sheet(ws_segment_control, max_width=70)

    add_error(
        "Сегменты",
